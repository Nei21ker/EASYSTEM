{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types",
      "vitest/importMeta"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/server/**/*.ts",
    "src/pages/api/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/codigos.ts",
    "tests/server/**/*.ts",
    "node_modules/@cloudflare/vitest-plugin/types/cloudflare-test.d.ts",
    "src/lib/catalogo-modelos.ts",
    "src/lib/constantes-locales.ts",
    "src/utils/cuadre.ts",
    "src/utils/pagos.ts",
    "src/utils/ventasResumen.ts"
  ]
}
