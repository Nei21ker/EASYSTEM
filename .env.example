# Copia este archivo a .env y completa tus credenciales de Supabase
# (Project Settings > API en tu dashboard de supabase.com).
#
# Si dejas estas variables vacías, EASYSTEM sigue funcionando: src/lib/inventoryService.ts
# detecta la ausencia de credenciales y usa LocalStorage como respaldo (ver README).
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
