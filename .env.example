# Variables del sitio (se leen al compilar con `astro build`).
#
# Sin esta variable, EASYSTEM funciona en MODO DEMO (solo LocalStorage, sin servidor ni cuentas reales).
# Con ella en "true", el sitio habla con la API del Worker de Cloudflare (D1 + R2 + Better-Auth).
PUBLIC_USAR_API=true
#
# El secreto de las sesiones NO va aquí: en desarrollo está en .dev.vars (BETTER_AUTH_SECRET=...) y en producción se
# guarda con `npx wrangler secret put BETTER_AUTH_SECRET`.
