{
  "name": "easystem",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:cf": "astro build && wrangler dev",
    "db:local": "wrangler d1 migrations apply easystem --local",
    "check:server": "tsc -p tsconfig.server.json",
    "check:all": "astro check && npm run check:server",
    "crear-admin": "node scripts/crear-admin.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@nanostores/persistent": "^1.3.5",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "better-auth": "^1.7.16",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.4",
    "html5-qrcode": "^2.3.8",
    "nanostores": "^1.5.3",
    "qrcode-generator": "^2.0.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  }
}
