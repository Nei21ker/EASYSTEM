---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import CamaraEscaner from '../components/CamaraEscaner.astro';

const claseCampo =
  'mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white';
const claseEtiqueta = 'block text-xs font-medium text-slate-600 dark:text-slate-400';
---

<DashboardLayout titulo="Nueva Venta" subtitulo="Punto de venta (POS) — Edward Accesorios">
  <div id="pos-app" class="grid grid-cols-1 gap-6 pb-20 lg:h-[calc(100dvh-10rem)] lg:min-h-[30rem] lg:grid-cols-5 lg:grid-rows-1 lg:pb-0 print:hidden">
    <!-- Buscador + resultados -->
    <div class="min-h-0 lg:col-span-3">
      <div class="flex flex-col rounded-xl border border-slate-200 bg-white shadow-sm lg:h-full dark:border-slate-800 dark:bg-slate-900">
        <div class="shrink-0 border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Buscar producto</h2>
          <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
            Escanea el código de barras o escribe nombre / modelo de teléfono compatible. Enter agrega una coincidencia exacta de código.
          </p>
          <div class="relative mt-3">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
              <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" stroke-linecap="round" />
            </svg>
            <input
              id="pos-buscador"
              type="text"
              autocomplete="off"
              placeholder="Código de barras, nombre o modelo..."
              class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-9 pr-11 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white"
            />
            <button
              type="button"
              data-abrir-escaner
              aria-label="Escanear código de barras con la cámara"
              title="Escanear con la cámara"
              class="absolute right-2 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-brand-600 dark:hover:bg-slate-700 dark:hover:text-brand-400"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                <path d="M3 9V7a2 2 0 0 1 2-2h2M3 15v2a2 2 0 0 0 2 2h2M21 9V7a2 2 0 0 0-2-2h-2M21 15v2a2 2 0 0 1-2 2h-2" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="12" cy="12" r="3" stroke-linecap="round" />
              </svg>
            </button>
          </div>
        </div>

        <ul id="pos-resultados" class="empty:hidden max-h-[28rem] divide-y divide-slate-100 overflow-y-auto lg:max-h-none lg:min-h-0 lg:flex-1 dark:divide-slate-800"></ul>
        <p id="pos-cargando" class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">Cargando catálogo...</p>
        <p id="pos-sin-resultados" class="hidden px-5 py-6 text-sm text-slate-500 dark:text-slate-400">
          No se encontraron productos con esa búsqueda.
        </p>
      </div>
    </div>

    <!-- Carrito -->
    <div class="min-h-0 lg:col-span-2">
      <div class="flex flex-col rounded-xl border border-slate-200 bg-white shadow-sm lg:h-full dark:border-slate-800 dark:bg-slate-900">
        <div class="flex shrink-0 items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Carrito de venta</h2>
          <span id="pos-carrito-contador" class="text-xs text-slate-500 dark:text-slate-400">0 líneas</span>
        </div>

        <ul id="pos-carrito" class="empty:hidden max-h-96 divide-y divide-slate-100 overflow-y-auto lg:max-h-none lg:min-h-0 lg:flex-1 dark:divide-slate-800"></ul>
        <p id="pos-carrito-vacio" class="px-5 py-6 text-sm lg:flex-1 text-slate-500 dark:text-slate-400">
          Agrega productos desde el buscador para iniciar una venta.
        </p>

        <div class="shrink-0 space-y-3 border-t border-slate-200 px-5 py-4 lg:mt-auto dark:border-slate-800">
          <div class="flex items-center justify-between text-base font-semibold text-slate-900 dark:text-white">
            <span>Total</span>
            <span id="pos-total" class="inline-block origin-right">$0.00</span>
          </div>
          <p id="pos-total-bs" class="-mt-2 text-right text-xs font-medium tabular-nums text-slate-500 dark:text-slate-400"></p>
          <p id="pos-error" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
          <button
            id="pos-procesar"
            type="button"
            disabled
            class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Procesar venta
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra inferior fija (solo móvil): total siempre visible + cobrar sin scrollear -->
  <div id="pos-barra-movil" class="fixed inset-x-0 bottom-0 z-20 flex items-center gap-3 border-t border-slate-200 bg-white px-4 py-3 shadow-[0_-4px_12px_rgba(0,0,0,0.05)] lg:hidden print:hidden dark:border-slate-800 dark:bg-slate-900">
    <div class="min-w-0 flex-1">
      <p id="pos-barra-contador" class="text-xs text-slate-500 dark:text-slate-400">0 líneas</p>
      <p id="pos-barra-total" class="origin-left text-lg font-semibold text-slate-900 dark:text-white">$0.00</p>
      <p id="pos-barra-total-bs" class="text-xs font-medium tabular-nums text-slate-500 dark:text-slate-400"></p>
    </div>
    <button
      id="pos-barra-cobrar"
      type="button"
      disabled
      class="shrink-0 rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-50"
    >
      Cobrar
    </button>
  </div>

  <!-- Ticket: oculto hasta procesar una venta; es lo único visible al imprimir -->
  <div id="pos-ticket" class="hidden">
    <div class="mx-auto max-w-sm rounded-xl border border-slate-200 bg-white p-6 shadow-sm print:max-w-full print:rounded-none print:border-none print:shadow-none dark:border-slate-800 dark:bg-slate-900 print:dark:bg-white">
      <div class="text-center">
        <img src="/logo.png" alt="Edward Accesorios" width="480" height="234" class="mx-auto mb-2 h-12 w-auto" />
        <p class="text-sm font-semibold text-slate-900 dark:text-white print:text-black">Edward Accesorios</p>
        <p class="text-xs text-slate-500 dark:text-slate-400 print:text-black">Ticket de venta</p>
        <p id="ticket-folio" class="mt-2 text-xs text-slate-500 dark:text-slate-400 print:text-black"></p>
        <p id="ticket-fecha" class="text-xs text-slate-500 dark:text-slate-400 print:text-black"></p>
        <p id="ticket-cliente" class="mt-2 text-xs text-slate-600 dark:text-slate-300 print:text-black"></p>
      </div>
      <div class="my-4 border-t border-dashed border-slate-300 dark:border-slate-700 print:border-black"></div>
      <ul id="ticket-lineas" class="space-y-2 text-sm text-slate-700 dark:text-slate-300 print:text-black"></ul>
      <div class="my-4 border-t border-dashed border-slate-300 dark:border-slate-700 print:border-black"></div>
      <div class="flex justify-between text-base font-semibold text-slate-900 dark:text-white print:text-black">
        <span>Total</span>
        <span id="ticket-total"></span>
      </div>
      <div id="ticket-bs" class="mt-1 hidden justify-between text-sm font-semibold text-slate-900 dark:text-white print:text-black">
        <span>Cobrado en bolívares</span>
        <span id="ticket-total-bs"></span>
      </div>
      <p id="ticket-tasa" class="mt-1 text-right text-xs text-slate-500 dark:text-slate-400 print:text-black"></p>
      <div class="mt-3 border-t border-dashed border-slate-300 pt-3 dark:border-slate-700 print:border-black">
        <p class="text-xs font-semibold text-slate-600 dark:text-slate-300 print:text-black">Forma de pago</p>
        <ul id="ticket-pagos" class="mt-1 space-y-0.5 text-xs text-slate-600 dark:text-slate-300 print:text-black"></ul>
      </div>
      <p class="mt-4 text-center text-xs text-slate-400 print:text-black">¡Gracias por su compra!</p>
    </div>

    <div class="mx-auto mt-4 flex max-w-sm gap-3 print:hidden">
      <button
        id="pos-imprimir"
        type="button"
        class="flex-1 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
      >
        Imprimir ticket
      </button>
      <button
        id="pos-nueva-venta"
        type="button"
        class="flex-1 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700"
      >
        Nueva venta
      </button>
    </div>
  </div>

  <!-- Confirmación antes de procesar la venta + datos del cliente y tipo de cobro -->
  <dialog
    id="pos-confirmar"
    aria-labelledby="pos-confirmar-titulo"
    class="anim-escalar m-auto w-[min(30rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
  >
    <form id="pos-confirmar-form" class="flex max-h-[92dvh] flex-col" novalidate>
      <div class="space-y-4 overflow-y-auto px-5 pb-4 pt-5">
        <div class="flex items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700 dark:bg-brand-500/15 dark:text-brand-300" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
              <circle cx="12" cy="12" r="9" /><path d="M12 8v4m0 4h.01" stroke-linecap="round" />
            </svg>
          </span>
          <div class="min-w-0">
            <h2 id="pos-confirmar-titulo" class="text-base font-semibold">¿Procesar esta venta?</h2>
            <p id="pos-confirmar-resumen" class="mt-0.5 text-sm text-slate-500 dark:text-slate-400"></p>
          </div>
        </div>

        <div>
          <ul id="pos-confirmar-lineas" class="max-h-32 divide-y divide-slate-100 overflow-y-auto rounded-lg border border-slate-200 text-sm dark:divide-slate-800 dark:border-slate-700"></ul>
          <div class="mt-3 flex items-center justify-between text-base font-semibold">
            <span>Total a cobrar</span>
            <span id="pos-confirmar-total"></span>
          </div>
          <p id="pos-confirmar-total-bs" class="text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"></p>
        </div>

        <fieldset class="space-y-3 border-t border-slate-200 pt-4 dark:border-slate-800">
          <legend class="sr-only">Datos del cliente</legend>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Datos del cliente</p>

          <div>
            <label for="pos-cli-cedula" class={claseEtiqueta}>Cédula *</label>
            <div class="mt-1 flex gap-2">
              <select id="pos-cli-nac" aria-label="Nacionalidad" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2.5 text-base text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                <option value="V">V</option>
                <option value="E">E</option>
              </select>
              <input id="pos-cli-cedula" type="text" inputmode="numeric" autocomplete="off" maxlength="9" placeholder="12345678" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <label for="pos-cli-nombre" class={claseEtiqueta}>Nombre *</label>
              <input id="pos-cli-nombre" type="text" autocomplete="off" maxlength="60" class={claseCampo} />
            </div>
            <div>
              <label for="pos-cli-apellido" class={claseEtiqueta}>Apellido *</label>
              <input id="pos-cli-apellido" type="text" autocomplete="off" maxlength="60" class={claseCampo} />
            </div>
          </div>

          <div>
            <label for="pos-cli-telefono" class={claseEtiqueta}>Número de teléfono *</label>
            <input id="pos-cli-telefono" type="tel" inputmode="tel" autocomplete="off" maxlength="20" placeholder="0414-1234567" class={claseCampo} />
          </div>
        </fieldset>

        <!-- Formas de pago y vuelto (utils/formularioPagos.ts) -->
        <div id="pos-formulario-pagos"></div>

        <p id="pos-confirmar-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
        <p class="text-xs text-slate-500 dark:text-slate-400">Al confirmar, el stock se descontará del inventario.</p>
      </div>

      <div class="flex gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-800/40">
        <button id="pos-confirmar-no" type="button" class="flex-1 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
          Cancelar
        </button>
        <button id="pos-confirmar-si" type="submit" class="bg-marca flex-1 rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:brightness-110">
          Sí, procesar venta
        </button>
      </div>
    </form>
  </dialog>

  <CamaraEscaner />
</DashboardLayout>

<script>
  import * as inventoryService from '../lib/inventoryService';
  import type { VentaRegistrada } from '../lib/inventoryService';
  import { obtenerSesionActual } from '../lib/auth';
  import { etiquetaMetodoPago, pagosDeVenta } from '../utils/pagos';
  import { FormularioPagos } from '../utils/formularioPagos';
  import { tasaActual } from '../stores/tasa';
  import { convertirABs, estadoStock, formatearBolivares, formatearMoneda, htmlPrecioDual } from '../utils/format';
  import { animarLista, reanimar } from '../utils/animaciones';
  import { htmlMiniatura } from '../utils/imagenes';
  import type { ClienteVenta, DineroEntregado, PagoVenta, ProductoConRelaciones, VentaItem } from '../types/database.types';

  interface LineaCarrito {
    producto: ProductoConRelaciones;
    cantidad: number;
  }

  let productos: ProductoConRelaciones[] = [];
  let carrito: LineaCarrito[] = [];

  const buscador = document.getElementById('pos-buscador') as HTMLInputElement;
  const resultados = document.getElementById('pos-resultados') as HTMLUListElement;
  const cargando = document.getElementById('pos-cargando') as HTMLParagraphElement;
  const sinResultados = document.getElementById('pos-sin-resultados') as HTMLParagraphElement;
  const listaCarrito = document.getElementById('pos-carrito') as HTMLUListElement;
  const carritoVacio = document.getElementById('pos-carrito-vacio') as HTMLParagraphElement;
  const carritoContador = document.getElementById('pos-carrito-contador') as HTMLSpanElement;
  const totalEl = document.getElementById('pos-total') as HTMLSpanElement;
  const errorEl = document.getElementById('pos-error') as HTMLParagraphElement;
  const botonProcesar = document.getElementById('pos-procesar') as HTMLButtonElement;
  const posApp = document.getElementById('pos-app') as HTMLDivElement;
  const ticket = document.getElementById('pos-ticket') as HTMLDivElement;
  const barraMovil = document.getElementById('pos-barra-movil') as HTMLDivElement;
  const barraContador = document.getElementById('pos-barra-contador') as HTMLParagraphElement;
  const barraTotal = document.getElementById('pos-barra-total') as HTMLParagraphElement;
  const barraCobrar = document.getElementById('pos-barra-cobrar') as HTMLButtonElement;

  function escaparHtml(texto: string): string {
    const div = document.createElement('div');
    div.textContent = texto;
    return div.innerHTML;
  }

  /** "$5.00 · Bs. 182,50" (solo "$5.00" mientras no haya tasa). */
  function precioEnLinea(usd: number): string {
    const tasa = tasaActual.get();
    return tasa ? `${formatearMoneda(usd)} · ${formatearBolivares(convertirABs(usd, tasa))}` : formatearMoneda(usd);
  }

  function mostrarError(mensaje: string) {
    errorEl.textContent = mensaje;
    errorEl.classList.remove('hidden');
  }

  function limpiarError() {
    errorEl.classList.add('hidden');
    errorEl.textContent = '';
  }

  function cantidadEnCarrito(productoId: string): number {
    return carrito.find((l) => l.producto.id === productoId)?.cantidad ?? 0;
  }

  function filtrarProductos(texto: string): ProductoConRelaciones[] {
    const q = texto.trim().toLowerCase();
    const coincidencias = !q
      ? productos
      : productos.filter(
          (p) =>
            p.nombre.toLowerCase().includes(q) ||
            p.codigo_barras.toLowerCase().includes(q) ||
            p.categoria.toLowerCase().includes(q) ||
            p.modelos_compatibles.some((m) => `${m.marca} ${m.modelo}`.toLowerCase().includes(q))
        );
    // Lo que se puede vender (stock > 0) va primero; el orden alfabético se conserva dentro de cada grupo.
    return [...coincidencias].sort((a, b) => Number(b.stock_actual > 0) - Number(a.stock_actual > 0));
  }

  // Con cientos de productos, pintarlos todos en cada tecla es lento en un teléfono.
  const LIMITE_RESULTADOS = 80;

  const estilosBadge: Record<string, string> = {
    ok: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400',
    bajo: 'bg-amber-100 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400',
    critico: 'bg-red-100 text-red-700 dark:bg-red-500/10 dark:text-red-400',
  };

  function renderResultados(texto: string) {
    const lista = filtrarProductos(texto);
    sinResultados.classList.toggle('hidden', lista.length > 0);

    const recortada = lista.length > LIMITE_RESULTADOS;
    resultados.innerHTML = lista
      .slice(0, LIMITE_RESULTADOS)
      .map((producto) => {
        const disponible = producto.stock_actual - cantidadEnCarrito(producto.id);
        const estado = estadoStock(producto.stock_actual, producto.stock_minimo);
        const compatibles = producto.modelos_compatibles.length
          ? producto.modelos_compatibles.map((m) => `${m.marca} ${m.modelo}`).join(', ')
          : 'Universal';

        return `
          <li class="flex items-center justify-between gap-3 px-5 py-3">
            ${htmlMiniatura(producto.imagen_url, producto.nombre, 'h-12 w-12')}
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium text-slate-900 dark:text-white">${escaparHtml(producto.nombre)}</p>
              <p class="truncate text-xs text-slate-500 dark:text-slate-400">
                ${escaparHtml(producto.codigo_barras)} · ${escaparHtml(producto.categoria)} · ${escaparHtml(compatibles)}
              </p>
              <p class="mt-1 text-xs">
                <span class="rounded-full px-2 py-0.5 font-medium ${estilosBadge[estado]}">${disponible} disponible${disponible === 1 ? '' : 's'}</span>
                <span class="ml-1 text-slate-500 dark:text-slate-400">${precioEnLinea(producto.precio_venta)}</span>
              </p>
            </div>
            <button
              type="button"
              data-agregar="${producto.id}"
              ${disponible <= 0 ? 'disabled' : ''}
              class="shrink-0 rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:dark:bg-slate-700"
            >
              + Agregar
            </button>
          </li>
        `;
      })
      .join('') +
      (recortada
        ? `<li class="px-5 py-3 text-xs text-slate-500 dark:text-slate-400">Mostrando ${LIMITE_RESULTADOS} de ${lista.length}. Escribe más del nombre, modelo o código para afinar.</li>`
        : '');
  }

  function renderCarrito() {
    carritoVacio.classList.toggle('hidden', carrito.length > 0);
    carritoContador.textContent = `${carrito.length} línea${carrito.length === 1 ? '' : 's'}`;
    botonProcesar.disabled = carrito.length === 0;

    listaCarrito.innerHTML = carrito
      .map(({ producto, cantidad }) => {
        const subtotal = producto.precio_venta * cantidad;
        const alMaximo = cantidad >= producto.stock_actual;
        return `
          <li data-linea="${producto.id}" class="flex items-center justify-between gap-3 px-5 py-3">
            ${htmlMiniatura(producto.imagen_url, producto.nombre, 'h-10 w-10')}
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium text-slate-900 dark:text-white">${escaparHtml(producto.nombre)}</p>
              <p class="text-xs text-slate-500 dark:text-slate-400">${precioEnLinea(producto.precio_venta)} c/u</p>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <button type="button" data-restar="${producto.id}" class="h-6 w-6 rounded border border-slate-200 text-sm leading-none text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">−</button>
              <span class="w-6 text-center text-sm text-slate-900 dark:text-white">${cantidad}</span>
              <button type="button" data-sumar="${producto.id}" ${alMaximo ? 'disabled' : ''} class="h-6 w-6 rounded border border-slate-200 text-sm leading-none text-slate-600 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">+</button>
              <span class="min-w-16 text-right text-sm font-semibold text-slate-900 dark:text-white">${htmlPrecioDual(subtotal, tasaActual.get())}</span>
              <button type="button" data-eliminar="${producto.id}" aria-label="Quitar" class="text-slate-400 hover:text-red-600">✕</button>
            </div>
          </li>
        `;
      })
      .join('');

    const total = carrito.reduce((acc, l) => acc + l.producto.precio_venta * l.cantidad, 0);
    const tasa = tasaActual.get();
    const totalBs = tasa && carrito.length > 0 ? formatearBolivares(convertirABs(total, tasa)) : '';
    totalEl.textContent = formatearMoneda(total);
    document.getElementById('pos-total-bs')!.textContent = totalBs;

    barraContador.textContent = `${carrito.length} línea${carrito.length === 1 ? '' : 's'}`;
    barraTotal.textContent = formatearMoneda(total);
    document.getElementById('pos-barra-total-bs')!.textContent = totalBs;
    barraCobrar.disabled = carrito.length === 0;
  }

  function agregarAlCarrito(productoId: string) {
    limpiarError();
    const producto = productos.find((p) => p.id === productoId);
    if (!producto) return;

    const linea = carrito.find((l) => l.producto.id === productoId);
    const cantidadActual = linea?.cantidad ?? 0;

    if (cantidadActual + 1 > producto.stock_actual) {
      mostrarError(`No hay más stock disponible de "${producto.nombre}".`);
      return;
    }

    if (linea) linea.cantidad += 1;
    else carrito.push({ producto, cantidad: 1 });

    renderCarrito();
    renderResultados(buscador.value);
    destacarLinea(productoId);
  }

  // Feedback visual: la línea tocada destella y el total "late".
  function destacarLinea(productoId: string) {
    reanimar(listaCarrito.querySelector<HTMLElement>(`[data-linea="${productoId}"]`), 'anim-destello');
    reanimar(totalEl, 'anim-pulso-valor');
    reanimar(barraTotal, 'anim-pulso-valor');
  }

  function cambiarCantidad(productoId: string, delta: number) {
    limpiarError();
    const linea = carrito.find((l) => l.producto.id === productoId);
    if (!linea) return;

    const nuevaCantidad = linea.cantidad + delta;
    if (nuevaCantidad <= 0) {
      carrito = carrito.filter((l) => l.producto.id !== productoId);
    } else if (nuevaCantidad > linea.producto.stock_actual) {
      mostrarError(`No hay más stock disponible de "${linea.producto.nombre}".`);
      return;
    } else {
      linea.cantidad = nuevaCantidad;
    }

    renderCarrito();
    renderResultados(buscador.value);
    destacarLinea(productoId);
  }

  function eliminarDelCarrito(productoId: string) {
    limpiarError();
    carrito = carrito.filter((l) => l.producto.id !== productoId);
    renderCarrito();
    renderResultados(buscador.value);
  }

  function mostrarTicket(venta: VentaRegistrada) {
    document.getElementById('ticket-folio')!.textContent = venta.folio
      ? `Folio #${venta.folio.toString().padStart(4, '0')}`
      : 'Folio pendiente (se asigna al sincronizar)';
    document.getElementById('ticket-fecha')!.textContent = new Date(venta.fecha).toLocaleString('es-GT', {
      dateStyle: 'medium',
      timeStyle: 'short',
    });
    document.getElementById('ticket-cliente')!.textContent = `Cliente: ${venta.cliente_nombre} · ${venta.cliente_cedula}`;

    document.getElementById('ticket-lineas')!.innerHTML = venta.items
      .map(
        (item) => `
          <li class="flex justify-between gap-2">
            <span>${escaparHtml(item.nombre)} <span class="text-slate-400">x${item.cantidad}</span></span>
            <span>${formatearMoneda(item.precio_unitario * item.cantidad)}</span>
          </li>
        `
      )
      .join('');
    document.getElementById('ticket-total')!.textContent = formatearMoneda(venta.total);
    const filaBs = document.getElementById('ticket-bs')!;
    const cobraEnBs = venta.total_bs != null;
    filaBs.classList.toggle('hidden', !cobraEnBs);
    filaBs.classList.toggle('flex', cobraEnBs);
    document.getElementById('ticket-total-bs')!.textContent = cobraEnBs ? formatearBolivares(venta.total_bs!) : '';
    document.getElementById('ticket-pagos')!.innerHTML = pagosDeVenta(venta)
      .map(
        (p) => `
          <li class="flex justify-between gap-2">
            <span>${escaparHtml(etiquetaMetodoPago(p.metodo))}</span>
            <span>${p.monto_bs != null ? `${formatearBolivares(p.monto_bs)} <span class="text-slate-400 print:text-black">(${formatearMoneda(p.monto_usd)})</span>` : formatearMoneda(p.monto_usd)}</span>
          </li>`
      )
      .join('');
    if (venta.vuelto) {
      const v = venta.vuelto;
      document.getElementById('ticket-pagos')!.insertAdjacentHTML(
        'beforeend',
        `<li class="flex justify-between gap-2 font-medium">
          <span>Vuelto (${escaparHtml(etiquetaMetodoPago(v.metodo))})</span>
          <span>−${v.monto_bs != null ? `${formatearBolivares(v.monto_bs)} <span class="text-slate-400 print:text-black">(${formatearMoneda(v.monto_usd)})</span>` : formatearMoneda(v.monto_usd)}</span>
        </li>`
      );
    }
    document.getElementById('ticket-tasa')!.textContent = venta.tasa_cambio ? `Tasa del día: ${formatearBolivares(venta.tasa_cambio)} por $1` : '';

    posApp.classList.add('hidden');
    barraMovil.classList.add('hidden');
    barraMovil.classList.remove('flex');
    ticket.classList.remove('hidden');
    reanimar(ticket, 'anim-subir');
    ticket.scrollIntoView({ behavior: 'smooth' });
  }

  const dialogoConfirmar = document.getElementById('pos-confirmar') as HTMLDialogElement;
  const formConfirmar = document.getElementById('pos-confirmar-form') as HTMLFormElement;
  const errorConfirmar = document.getElementById('pos-confirmar-error') as HTMLParagraphElement;
  const campo = (id: string) => document.getElementById(id) as HTMLInputElement & HTMLSelectElement;
  const campoNac = campo('pos-cli-nac');
  const campoCedula = campo('pos-cli-cedula');
  const campoNombre = campo('pos-cli-nombre');
  const campoApellido = campo('pos-cli-apellido');
  const campoTelefono = campo('pos-cli-telefono');

  // Formas de pago (una o varias) y vuelto: lo maneja utils/formularioPagos.ts
  const formPagos = new FormularioPagos(document.getElementById('pos-formulario-pagos')!);
  let totalAConfirmar = 0;

  // Los datos del cliente solo viven mientras dura la venta (se borran al cobrar).
  function limpiarDatosCliente() {
    for (const c of [campoCedula, campoNombre, campoApellido, campoTelefono]) c.value = '';
    campoNac.value = 'V';
    errorConfirmar.classList.add('hidden');
    formPagos.reiniciar();
  }

  /** Devuelve los datos del cliente y los pagos ya validados, o muestra el primer error y devuelve null. */
  function leerDatosCliente(): { cliente: ClienteVenta; pagos: PagoVenta[]; vuelto: DineroEntregado | null } | null {
    const fallar = (mensaje: string, el: HTMLElement | null | undefined) => {
      errorConfirmar.textContent = mensaje;
      errorConfirmar.classList.remove('hidden');
      el?.focus();
      return null;
    };
    const cedula = campoCedula.value.replace(/\D/g, '');
    const nombre = campoNombre.value.trim().replace(/\s+/g, ' ');
    const apellido = campoApellido.value.trim().replace(/\s+/g, ' ');
    const telefono = campoTelefono.value.trim();
    const patronNombre = /^[\p{L}][\p{L} '.-]*$/u;

    if (!/^\d{5,9}$/.test(cedula)) return fallar('La cédula debe tener entre 5 y 9 dígitos (solo números).', campoCedula);
    if (nombre.length < 2 || !patronNombre.test(nombre)) return fallar('Escribe el nombre del cliente.', campoNombre);
    if (apellido.length < 2 || !patronNombre.test(apellido)) return fallar('Escribe el apellido del cliente.', campoApellido);
    const digitos = telefono.replace(/\D/g, '');
    if (!/^[\d\s+()-]+$/.test(telefono) || digitos.length < 10 || digitos.length > 13) {
      return fallar('El teléfono debe tener entre 10 y 13 dígitos (ej. 0414-1234567).', campoTelefono);
    }

    const lectura = formPagos.leer();
    if (!lectura.ok) return fallar(lectura.mensaje, lectura.foco);

    errorConfirmar.classList.add('hidden');
    return {
      cliente: { cedula: `${campoNac.value}-${cedula}`, nombre: `${nombre} ${apellido}`, telefono },
      pagos: lectura.pagos,
      vuelto: lectura.vuelto,
    };
  }

  /** Paso previo: muestra el resumen y pide los datos del cliente; la venta solo se registra al confirmar. */
  function pedirConfirmacion() {
    if (carrito.length === 0 || dialogoConfirmar.open) return;
    const unidades = carrito.reduce((suma, l) => suma + l.cantidad, 0);
    const total = carrito.reduce((suma, l) => suma + l.producto.precio_venta * l.cantidad, 0);

    document.getElementById('pos-confirmar-resumen')!.textContent =
      `${carrito.length} línea${carrito.length === 1 ? '' : 's'} · ${unidades} unidad${unidades === 1 ? '' : 'es'}`;
    document.getElementById('pos-confirmar-total')!.textContent = formatearMoneda(total);
    totalAConfirmar = total;
    formPagos.establecerTotal(total);
    const tasaDia = tasaActual.get();
    document.getElementById('pos-confirmar-total-bs')!.textContent = tasaDia ? `≈ ${formatearBolivares(convertirABs(total, tasaDia))} (tasa ${formatearBolivares(tasaDia)})` : '';
    document.getElementById('pos-confirmar-lineas')!.innerHTML = carrito
      .map(
        ({ producto, cantidad }) => `
          <li class="flex items-center justify-between gap-3 px-3 py-2">
            <span class="min-w-0 flex-1 truncate text-slate-700 dark:text-slate-300">${cantidad} × ${escaparHtml(producto.nombre)}</span>
            <span class="shrink-0 font-medium text-slate-900 dark:text-white">${formatearMoneda(producto.precio_venta * cantidad)}</span>
          </li>`
      )
      .join('');

    errorConfirmar.classList.add('hidden');
    dialogoConfirmar.showModal();
    // Foco en la cédula: la pistola lectora no cobra nada (Enter con datos incompletos solo muestra un aviso).
    campoCedula.focus();
  }

  function pedirConfirmacionActualiza() {
    const tasaDia = tasaActual.get();
    document.getElementById('pos-confirmar-total-bs')!.textContent = tasaDia ? `≈ ${formatearBolivares(convertirABs(totalAConfirmar, tasaDia))} (tasa ${formatearBolivares(tasaDia)})` : '';
    formPagos.refrescar();
  }

  document.getElementById('pos-confirmar-no')!.addEventListener('click', () => dialogoConfirmar.close());
  // Clic en el fondo oscuro = cancelar (los datos escritos se conservan si se reabre)
  dialogoConfirmar.addEventListener('click', (e) => {
    if (e.target === dialogoConfirmar) dialogoConfirmar.close();
  });
  formConfirmar.addEventListener('input', () => errorConfirmar.classList.add('hidden'));
  campoCedula.addEventListener('input', () => (campoCedula.value = campoCedula.value.replace(/\D/g, '')));
  formConfirmar.addEventListener('submit', (e) => {
    e.preventDefault();
    const datos = leerDatosCliente();
    if (!datos) return;
    dialogoConfirmar.close();
    procesarVenta(datos);
  });

  async function procesarVenta(datos: { cliente: ClienteVenta; pagos: PagoVenta[]; vuelto: DineroEntregado | null }) {
    if (carrito.length === 0) return;
    limpiarError();
    const tasa = tasaActual.get();
    if (!tasa) {
      mostrarError('Falta la tasa del dólar del día. Regístrala para poder vender.');
      window.dispatchEvent(new Event('easystem:abrir-tasa'));
      return;
    }
    botonProcesar.disabled = true;
    botonProcesar.textContent = 'Procesando...';
    barraCobrar.disabled = true;

    try {
      const items: VentaItem[] = carrito.map((l) => ({
        producto_id: l.producto.id,
        nombre: l.producto.nombre,
        codigo_barras: l.producto.codigo_barras,
        cantidad: l.cantidad,
        precio_unitario: l.producto.precio_venta,
      }));
      const sesion = await obtenerSesionActual();
      const venta = await inventoryService.registrarVenta(items, { ...datos, tasa_cambio: tasa, vendedor_nombre: sesion?.nombre });
      mostrarTicket(venta);
      carrito = [];
      limpiarDatosCliente();
      await cargarProductos();
    } catch (err) {
      if (err instanceof inventoryService.VentaIncompletaError) {
        // Esas líneas ya salieron del inventario: se quitan del carrito para no cobrarlas dos veces.
        carrito = carrito.filter((l) => !err.productosRegistrados.includes(l.producto.id));
        if (carrito.length === 0) limpiarDatosCliente();
        else formPagos.reiniciar(); // el total cambió: hay que volver a repartir los pagos
        await cargarProductos();
        renderCarrito();
      }
      mostrarError(err instanceof Error ? err.message : 'No se pudo procesar la venta.');
    } finally {
      botonProcesar.textContent = 'Procesar venta';
      botonProcesar.disabled = carrito.length === 0;
      barraCobrar.disabled = carrito.length === 0;
    }
  }

  // La tasa cambió: recalcula todos los Bs. visibles (y el monto a cobrar si el diálogo está abierto)
  tasaActual.listen(() => {
    renderResultados(buscador.value);
    renderCarrito();
    if (dialogoConfirmar.open) {
      pedirConfirmacionActualiza();
    }
  });

  function iniciarNuevaVenta() {
    ticket.classList.add('hidden');
    posApp.classList.remove('hidden');
    barraMovil.classList.remove('hidden');
    barraMovil.classList.add('flex');
    renderCarrito();
    renderResultados(buscador.value);
    buscador.focus();
  }

  let primeraCarga = true;

  async function cargarProductos() {
    productos = await inventoryService.listarProductos();
    cargando.classList.add('hidden');
    if (primeraCarga) {
      primeraCarga = false;
      animarLista(resultados);
    }
    renderResultados(buscador.value);
  }

  // Delegación de eventos: los botones de resultados/carrito se regeneran en cada render
  resultados.addEventListener('click', (e) => {
    const boton = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-agregar]');
    if (boton?.dataset.agregar) agregarAlCarrito(boton.dataset.agregar);
  });

  listaCarrito.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;
    const sumar = objetivo.closest<HTMLButtonElement>('[data-sumar]');
    const restar = objetivo.closest<HTMLButtonElement>('[data-restar]');
    const eliminar = objetivo.closest<HTMLButtonElement>('[data-eliminar]');
    if (sumar?.dataset.sumar) cambiarCantidad(sumar.dataset.sumar, 1);
    else if (restar?.dataset.restar) cambiarCantidad(restar.dataset.restar, -1);
    else if (eliminar?.dataset.eliminar) eliminarDelCarrito(eliminar.dataset.eliminar);
  });

  buscador.addEventListener('input', () => renderResultados(buscador.value));

  /** Busca un código de barras exacto (tecleado + Enter, lector físico USB, o cámara) y lo agrega al carrito. */
  async function buscarYAgregarPorCodigo(codigo: string) {
    const coincidenciaLocal = productos.find((p) => p.codigo_barras === codigo);
    if (!coincidenciaLocal) {
      mostrarError(`No se encontró ningún producto con el código "${codigo}".`);
      return;
    }

    // Relee el producto por si su stock cambió desde otra sesión/pestaña
    const fresco = await inventoryService.obtenerProductoPorCodigoBarras(codigo);
    if (fresco) {
      productos = productos.map((p) => (p.id === fresco.id ? fresco : p));
      agregarAlCarrito(fresco.id);
      buscador.value = '';
      renderResultados('');
    }
  }

  buscador.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const codigo = buscador.value.trim();
    if (codigo) void buscarYAgregarPorCodigo(codigo);
  });

  // Escaneo con cámara (ver src/components/CamaraEscaner.astro): agrega directo al carrito.
  window.addEventListener('easystem:codigo-escaneado', ((e: CustomEvent<{ codigo: string }>) => {
    void buscarYAgregarPorCodigo(e.detail.codigo);
  }) as EventListener);

  botonProcesar.addEventListener('click', pedirConfirmacion);
  barraCobrar.addEventListener('click', pedirConfirmacion);
  document.getElementById('pos-imprimir')?.addEventListener('click', () => window.print());
  document.getElementById('pos-nueva-venta')?.addEventListener('click', iniciarNuevaVenta);

  cargarProductos();
</script>
