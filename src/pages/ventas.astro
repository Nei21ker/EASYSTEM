---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import CamaraEscaner from '../components/CamaraEscaner.astro';
import { BANCOS_SUGERIDOS } from '../utils/promotor';

const claseCampo =
  'mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white';
const claseEtiqueta = 'block text-xs font-medium text-slate-600 dark:text-slate-400';
---

<DashboardLayout titulo="Nueva Venta" subtitulo="Punto de venta (POS) — Edward Accesorios">
  <!-- Vista "Todos los locales" (administrador): una venta se registra en un local concreto -->
  <div id="pos-sin-local" class="hidden rounded-xl border border-amber-300 bg-amber-50 p-6 text-center dark:border-amber-500/40 dark:bg-amber-500/10 print:hidden">
    <p class="text-base font-semibold text-amber-900 dark:text-amber-200">Elige un local para vender</p>
    <p class="mt-1 text-sm text-amber-800 dark:text-amber-300">
      Estás viendo "Todos los locales". Cada venta descuenta el inventario de un local, así que elige uno en el selector del encabezado.
    </p>
  </div>

  <div id="pos-app" class="grid grid-cols-1 gap-6 pb-20 lg:h-[calc(100dvh-10rem)] lg:min-h-[30rem] lg:grid-cols-5 lg:grid-rows-1 lg:pb-0 print:hidden">
    <!-- Buscador + resultados -->
    <div class="min-h-0 lg:col-span-3">
      <div class="flex flex-col rounded-xl border border-slate-200 bg-white shadow-sm lg:h-full dark:border-slate-800 dark:bg-slate-900">
        <div class="shrink-0 border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <!-- Un solo campo: escanear (lector o cámara), escribir el código de una etiqueta o buscar por nombre, categoría o modelo -->
          <div>
            <div class="relative">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
                <path d="M4 5v14M8 5v14M12 5v14M17 5v14M20 5v14" stroke-linecap="round" />
              </svg>
              <input
                id="pos-codigo"
                type="text"
                enterkeyhint="search"
                autocomplete="off"
                autocapitalize="off"
                autocorrect="off"
                spellcheck="false"
                aria-label="Escanear el código de una etiqueta o buscar por nombre, categoría o modelo"
                placeholder="Escanea o busca por nombre..."
                class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-9 pr-11 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
              <button
                type="button"
                data-abrir-escaner
                aria-label="Escanear código con la cámara"
                title="Escanear con la cámara"
                class="absolute right-2 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-brand-600 dark:hover:bg-slate-700 dark:hover:text-brand-400"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                  <path d="M3 9V7a2 2 0 0 1 2-2h2M3 15v2a2 2 0 0 0 2 2h2M21 9V7a2 2 0 0 0-2-2h-2M21 15v2a2 2 0 0 1-2 2h-2" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="12" cy="12" r="3" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <button
              id="pos-seleccionar-codigo"
              type="button"
              title="Si no puedes escanear: elige el producto y escoge la unidad de la lista"
              class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke-linecap="round" />
              </svg>
              Seleccionar código
            </button>
          </div>
        </div>

        <ul id="pos-resultados" class="empty:hidden max-h-[28rem] divide-y divide-slate-100 overflow-y-auto lg:max-h-none lg:min-h-0 lg:flex-1 dark:divide-slate-800"></ul>
        <p id="pos-cargando" class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">Cargando catálogo...</p>
        <p id="pos-sin-resultados" class="hidden px-5 py-6 text-sm text-slate-500 dark:text-slate-400">
          No se encontraron productos con esa búsqueda.
        </p>
      </div>
    </div>

    <!-- Carrito -->
    <div class="min-h-0 lg:col-span-2">
      <div id="pos-carrito-seccion" class="flex scroll-mt-4 flex-col rounded-xl border border-slate-200 bg-white shadow-sm lg:h-full dark:border-slate-800 dark:bg-slate-900">
        <div class="flex shrink-0 items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Carrito de venta</h2>
          <div class="flex items-center gap-3">
            <button id="pos-espera-abrir" type="button" class="hidden rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800 hover:bg-amber-100 dark:border-amber-500/40 dark:bg-amber-500/10 dark:text-amber-300">
              En espera (<span id="pos-espera-n">0</span>)
            </button>
            <span id="pos-carrito-contador" class="text-xs text-slate-500 dark:text-slate-400">0 líneas</span>
          </div>
        </div>
        <div id="pos-espera-banner" class="hidden items-center justify-between gap-3 border-b border-amber-200 bg-amber-50 px-5 py-2 text-xs text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200">
          <span id="pos-espera-banner-texto"></span>
          <button id="pos-espera-banner-cancelar" type="button" class="shrink-0 font-semibold underline">Vaciar</button>
        </div>

        <ul id="pos-carrito" class="empty:hidden max-h-96 divide-y divide-slate-100 overflow-y-auto lg:max-h-none lg:min-h-0 lg:flex-1 dark:divide-slate-800"></ul>
        <p id="pos-carrito-vacio" class="px-5 py-6 text-sm lg:flex-1 text-slate-500 dark:text-slate-400">
          Escanea o busca un producto para iniciar una venta.
        </p>

        <div class="shrink-0 space-y-3 border-t border-slate-200 px-5 py-4 lg:mt-auto dark:border-slate-800">
          <div class="flex items-center justify-between text-base font-semibold text-slate-900 dark:text-white">
            <span>Total</span>
            <span id="pos-total" class="inline-block origin-right">$0.00</span>
          </div>
          <p id="pos-total-bs" class="-mt-2 text-right text-xs font-medium tabular-nums text-slate-500 dark:text-slate-400"></p>
          <p id="pos-espera-aviso" role="status" class="hidden rounded-lg bg-emerald-50 px-3 py-2 text-xs font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300"></p>
          <p id="pos-error" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
          <button
            id="pos-procesar"
            type="button"
            disabled
            class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Procesar venta
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra inferior fija (solo móvil): total siempre visible + cobrar sin scrollear -->
  <div id="pos-barra-movil" class="fixed inset-x-0 bottom-0 z-20 mb-0 flex items-center gap-3 border-t border-slate-200 bg-white px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 shadow-[0_-4px_12px_rgba(0,0,0,0.05)] lg:hidden print:hidden dark:border-slate-800 dark:bg-slate-900">
    <button id="pos-barra-ver" type="button" class="min-w-0 flex-1 text-left" aria-label="Ver el carrito para cambiar cantidades o quitar productos">
      <p id="pos-barra-contador" class="text-xs text-slate-500 dark:text-slate-400">0 líneas</p>
      <p id="pos-barra-total" class="origin-left text-lg font-semibold text-slate-900 dark:text-white">$0.00</p>
      <p id="pos-barra-total-bs" class="text-xs font-medium tabular-nums text-slate-500 dark:text-slate-400"></p>
    </button>
    <button
      id="pos-barra-carrito"
      type="button"
      class="shrink-0 rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
    >
      Ver carrito
    </button>
    <button
      id="pos-barra-cobrar"
      type="button"
      disabled
      class="shrink-0 rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-50"
    >
      Cobrar
    </button>
  </div>

  <!-- Ticket: oculto hasta procesar una venta; es lo único visible al imprimir -->
  <div id="pos-ticket" class="hidden">
    <div class="mx-auto max-w-sm rounded-xl border border-slate-200 bg-white p-6 shadow-sm print:max-w-full print:rounded-none print:border-none print:shadow-none dark:border-slate-800 dark:bg-slate-900 print:dark:bg-white">
      <div class="text-center">
        <img src="/logo.png" alt="Edward Accesorios" width="480" height="234" class="mx-auto mb-2 h-12 w-auto" />
        <p class="text-sm font-semibold text-slate-900 dark:text-white print:text-black">Edward Accesorios</p>
        <p class="text-xs text-slate-500 dark:text-slate-400 print:text-black">Ticket de venta</p>
        <p id="ticket-folio" class="mt-2 text-xs text-slate-500 dark:text-slate-400 print:text-black"></p>
        <p id="ticket-fecha" class="text-xs text-slate-500 dark:text-slate-400 print:text-black"></p>
        <p id="ticket-cliente" class="mt-2 text-xs text-slate-600 dark:text-slate-300 print:text-black"></p>
      </div>
      <div class="my-4 border-t border-dashed border-slate-300 dark:border-slate-700 print:border-black"></div>
      <ul id="ticket-lineas" class="space-y-2 text-sm text-slate-700 dark:text-slate-300 print:text-black"></ul>
      <div class="my-4 border-t border-dashed border-slate-300 dark:border-slate-700 print:border-black"></div>
      <div class="flex justify-between text-base font-semibold text-slate-900 dark:text-white print:text-black">
        <span>Total</span>
        <span id="ticket-total"></span>
      </div>
      <div id="ticket-bs" class="mt-1 hidden justify-between text-sm font-semibold text-slate-900 dark:text-white print:text-black">
        <span>Cobrado en bolívares</span>
        <span id="ticket-total-bs"></span>
      </div>
      <p id="ticket-tasa" class="mt-1 text-right text-xs text-slate-500 dark:text-slate-400 print:text-black"></p>
      <div class="mt-3 border-t border-dashed border-slate-300 pt-3 dark:border-slate-700 print:border-black">
        <p class="text-xs font-semibold text-slate-600 dark:text-slate-300 print:text-black">Forma de pago</p>
        <ul id="ticket-pagos" class="mt-1 space-y-0.5 text-xs text-slate-600 dark:text-slate-300 print:text-black"></ul>
      </div>
      <p class="mt-4 text-center text-xs text-slate-400 print:text-black">¡Gracias por su compra!</p>
    </div>

    <div class="mx-auto mt-4 max-w-sm print:hidden">
      <button
        id="pos-whatsapp"
        type="button"
        class="flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M12.04 2a9.93 9.93 0 0 0-8.5 15.07L2 22l5.07-1.5A9.94 9.94 0 1 0 12.04 2Zm0 1.8a8.14 8.14 0 1 1-4.2 15.1l-.3-.18-3 .88.9-2.92-.2-.3A8.13 8.13 0 0 1 12.04 3.8Zm-3.2 4.2c-.17 0-.45.06-.69.32-.24.26-.9.88-.9 2.15s.93 2.5 1.06 2.67c.13.17 1.8 2.86 4.45 3.9 2.2.87 2.65.7 3.13.65.48-.04 1.55-.63 1.77-1.24.22-.6.22-1.13.15-1.24-.06-.11-.24-.17-.5-.3-.26-.13-1.55-.77-1.8-.85-.24-.09-.41-.13-.59.13-.17.26-.67.85-.82 1.02-.15.18-.3.2-.57.07-.26-.13-1.1-.4-2.1-1.3-.77-.69-1.3-1.55-1.45-1.8-.15-.27-.02-.4.11-.53.12-.12.26-.3.4-.46.13-.15.17-.26.26-.44.09-.17.04-.33-.02-.46-.07-.13-.59-1.43-.81-1.95-.21-.5-.43-.43-.59-.44h-.5Z"/></svg>
        Enviar ticket por WhatsApp (imagen)
      </button>
      <button
        id="pos-compartir"
        type="button"
        class="mt-2 w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700"
      >
        Compartir imagen (elegir el chat yo mismo)
      </button>
      <p id="pos-whatsapp-aviso" role="status" class="mt-1 hidden text-center text-xs"></p>
    </div>

    <div class="mx-auto mt-3 flex max-w-sm gap-3 print:hidden">
      <button
        id="pos-imprimir"
        type="button"
        class="flex-1 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
      >
        Imprimir ticket
      </button>
      <button
        id="pos-nueva-venta"
        type="button"
        class="flex-1 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700"
      >
        Nueva venta
      </button>
    </div>
  </div>

  <!-- Alerta grande cuando el QR/código leído no se puede vender (ya vendido, inexistente, de otro local…) -->
  <dialog
    id="pos-alerta"
    aria-labelledby="pos-alerta-titulo"
    class="anim-escalar m-auto w-[min(24rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-red-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-red-500/40 dark:bg-slate-900 dark:text-slate-100"
  >
    <div class="space-y-3 px-5 pb-4 pt-5 text-center">
      <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-red-100 text-red-600 dark:bg-red-500/15 dark:text-red-400" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
          <path d="M12 9v4m0 4h.01M10.3 3.9 2.4 17.6A2 2 0 0 0 4.1 20.6h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <h2 id="pos-alerta-titulo" class="text-lg font-semibold"></h2>
      <p id="pos-alerta-detalle" class="text-sm text-slate-600 dark:text-slate-300"></p>
    </div>
    <div class="border-t border-slate-200 px-5 py-4 dark:border-slate-800">
      <button id="pos-alerta-ok" type="button" class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Entendido</button>
    </div>
  </dialog>

  <!-- Botar 3 o más piezas defectuosas en una venta (productos por cantidad): pide la contraseña de un gerente o administrador -->
  <dialog
    id="pos-danados"
    aria-labelledby="pos-danados-titulo"
    class="anim-escalar m-auto w-[min(24rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
  >
    <form id="pos-danados-form" class="space-y-3 px-5 pb-4 pt-5" novalidate>
      <h2 id="pos-danados-titulo" class="text-base font-semibold">Piezas defectuosas: hace falta una clave</h2>
      <p id="pos-danados-texto" class="oculto-con-teclado text-sm text-slate-600 dark:text-slate-300"></p>
      <input id="pos-danados-clave" type="password" autocomplete="new-password" placeholder="Contraseña de un gerente o administrador" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
      <p id="pos-danados-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
      <div class="flex gap-2 pt-1">
        <button id="pos-danados-cancelar" type="button" class="flex-1 rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Cancelar</button>
        <button id="pos-danados-ok" type="submit" class="flex-1 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 disabled:opacity-60">Autorizar</button>
      </div>
    </form>
  </dialog>

  <!-- Confirmación antes de procesar la venta + datos del cliente y tipo de cobro -->
  <dialog
    id="pos-confirmar"
    aria-labelledby="pos-confirmar-titulo"
    class="group anim-escalar m-auto w-[min(30rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
  >
    <form id="pos-confirmar-form" class="flex max-h-[92dvh] flex-col" novalidate>
      <div class="space-y-4 overflow-y-auto px-5 pb-4 pt-5">
        <div class="flex items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700 dark:bg-brand-500/15 dark:text-brand-300" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
              <circle cx="12" cy="12" r="9" /><path d="M12 8v4m0 4h.01" stroke-linecap="round" />
            </svg>
          </span>
          <div class="min-w-0">
            <h2 id="pos-confirmar-titulo" class="text-base font-semibold">Procesar venta</h2>
            <p id="pos-confirmar-resumen" class="mt-0.5 text-sm text-slate-500 dark:text-slate-400"></p>
          </div>
        </div>
        <ol id="pos-pasos" class="flex gap-1.5" aria-label="Pasos de la venta"></ol>

        <div>
          <ul id="pos-confirmar-lineas" class="hidden group-data-[teclado=true]:hidden max-h-56 divide-y divide-slate-100 overflow-y-auto rounded-lg border border-slate-200 text-sm dark:divide-slate-800 dark:border-slate-700"></ul>
          <div class="mt-3 flex items-center justify-between text-base font-semibold">
            <span>Total a cobrar</span>
            <button id="pos-confirmar-total-btn" type="button" title="Modificar el precio" aria-label="Modificar el precio de la venta" class="inline-flex items-center gap-1.5 rounded-md px-1.5 py-0.5 -mr-1.5 decoration-dotted underline-offset-4 hover:bg-slate-100 hover:underline dark:hover:bg-slate-800">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5 text-slate-400" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span id="pos-confirmar-total"></span>
            </button>
          </div>
          <p id="pos-confirmar-total-bs" class="group-data-[teclado=true]:hidden text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"></p>
          <p id="pos-confirmar-precio-nota" class="group-data-[teclado=true]:hidden text-right text-[11px] text-slate-400 dark:text-slate-500">Toca el total para modificar el precio</p>
        </div>

        <section data-paso="escaneo" class="hidden space-y-3 border-t border-slate-200 pt-4 dark:border-slate-800">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Escanea lo que vas a vender</p>
          </div>
          <ul id="pos-escaneo-lista" class="divide-y divide-slate-100 rounded-lg border border-slate-200 text-sm dark:divide-slate-800 dark:border-slate-700"></ul>
          <div class="relative">
            <input id="pos-escaneo-codigo" type="text" inputmode="numeric" autocomplete="off" placeholder="Escanea o escribe el código de la etiqueta..." aria-label="Código de la unidad" class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-3 pr-12 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            <button type="button" data-abrir-escaner aria-label="Escanear con la cámara" title="Escanear con la cámara" class="absolute right-1.5 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-brand-600 dark:hover:bg-slate-700 dark:hover:text-brand-400">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M3 9V7a2 2 0 0 1 2-2h2M3 15v2a2 2 0 0 0 2 2h2M21 9V7a2 2 0 0 0-2-2h-2M21 15v2a2 2 0 0 1-2 2h-2" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="12" r="3" stroke-linecap="round" /></svg>
            </button>
          </div>
          <p id="pos-escaneo-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
          <button id="pos-escaneo-sinconexion" type="button" class="hidden w-full rounded-lg border border-amber-300 px-4 py-2.5 text-sm font-semibold text-amber-700 hover:bg-amber-50 dark:border-amber-500/40 dark:text-amber-300 dark:hover:bg-slate-800">Continuar sin escanear (sin conexión)</button>
        </section>

        <fieldset data-paso="cliente" class="hidden space-y-3 border-t border-slate-200 pt-4 dark:border-slate-800">
          <legend class="sr-only">Datos del cliente</legend>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Datos del cliente</p>

          <div>
            <label for="pos-cli-cedula" class={claseEtiqueta}>Cédula *</label>
            <div class="mt-1 flex gap-2">
              <select id="pos-cli-nac" aria-label="Nacionalidad" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2.5 text-base text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                <option value="V">V</option>
                <option value="E">E</option>
              </select>
              <input id="pos-cli-cedula" type="text" inputmode="numeric" autocomplete="off" maxlength="9" placeholder="12345678" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <p id="pos-cli-aviso" role="status" class="mt-1 hidden rounded-lg bg-emerald-50 px-3 py-1.5 text-xs text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"></p>
          </div>

          <div>
            <label for="pos-cli-nombre" class={claseEtiqueta}>Nombre y apellido *</label>
            <input id="pos-cli-nombre" type="text" autocomplete="off" autocapitalize="words" maxlength="120" placeholder="Ej: María Pérez" class={claseCampo} />
          </div>

          <div>
            <label for="pos-cli-telefono" class={claseEtiqueta}>Número de teléfono *</label>
            <input id="pos-cli-telefono" type="tel" inputmode="tel" autocomplete="off" maxlength="20" placeholder="0414-1234567" class={claseCampo} />
          </div>
        </fieldset>

        <!-- Formas de pago y vuelto (utils/formularioPagos.ts) -->
        <div data-paso="pago" class="hidden space-y-3 border-t border-slate-200 pt-4 dark:border-slate-800">
          <div id="pos-formulario-pagos"></div>

          <!-- Referencia del pago móvil: obligatoria si algún cobro es "Bs pago móvil" (se muestra solo entonces) -->
          <div id="pos-comprobante" class="hidden space-y-2 rounded-lg border border-amber-200 bg-amber-50/70 p-3 dark:border-amber-500/30 dark:bg-amber-500/10">
            <label for="pos-comprobante-ref" class="block text-xs font-semibold uppercase tracking-wide text-amber-800 dark:text-amber-300">Referencia del pago móvil *</label>
            <p class="text-xs text-amber-800 dark:text-amber-300">Escribe los <strong>4 últimos dígitos</strong> de la referencia. Sin esto no se puede procesar la venta.</p>
            <input id="pos-comprobante-ref" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="off" placeholder="0000" class="w-32 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-center font-mono text-lg tracking-[0.3em] text-slate-900 placeholder:text-slate-300 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            <p id="pos-comprobante-error" role="alert" class="hidden text-xs text-red-700 dark:text-red-400"></p>
          </div>

          <!-- Cobro rápido (Local Vidrios): datos del cliente opcionales, plegados; el paso «Datos del cliente» se mueve aquí -->
          <div id="pos-cli-opcional-bloque" class="hidden border-t border-slate-200 pt-3 dark:border-slate-800">
            <button id="pos-cli-toggle" type="button" aria-expanded="false" class="text-sm font-semibold text-brand-700 hover:underline dark:text-brand-300">+ Datos del cliente (opcional)</button>
            <div id="pos-cli-opcional" class="mt-3 hidden">
              <p class="mb-2 text-xs text-slate-500 dark:text-slate-400">Déjalo en blanco si el cliente no quiere dar sus datos. Si escribes algo, completa cédula, nombre y teléfono.</p>
            </div>
          </div>
        </div>

        <p id="pos-confirmar-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
        <p id="pos-confirmar-nota" class="hidden text-xs text-slate-500 dark:text-slate-400">Al confirmar, el stock se descontará del inventario.</p>
      </div>

      <div class="flex flex-wrap gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-800/40">
        <button id="pos-confirmar-espera" type="button" class="hidden basis-full rounded-lg border border-amber-300 bg-amber-50 px-4 py-2.5 text-sm font-semibold text-amber-800 hover:bg-amber-100 dark:border-amber-500/40 dark:bg-amber-500/10 dark:text-amber-300">
          Dejar en espera
        </button>
        <button id="pos-confirmar-no" type="button" class="flex-1 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
          Cancelar
        </button>
        <button id="pos-confirmar-si" type="submit" class="bg-marca flex-1 rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:brightness-110">
          Sí, procesar venta
        </button>
      </div>
    </form>
  </dialog>

  <!-- Dejar la venta en espera (Local Vidrios): el promotor se llevó el vidrio y vuelve a pagar; el carrito queda guardado y reservado -->
  <dialog
    id="pos-espera"
    aria-labelledby="pos-espera-titulo"
    class="group anim-escalar m-auto w-[min(26rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
  >
    <form id="pos-espera-form" class="flex max-h-[92dvh] flex-col" novalidate>
      <div class="space-y-3 overflow-y-auto px-5 pb-4 pt-5">
        <div>
          <h2 id="pos-espera-titulo" class="text-base font-semibold">Dejar la venta en espera</h2>
          <p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">El carrito queda guardado y la mercancía reservada; atiende al siguiente cliente. Cuando el promotor vuelva, retómala desde «En espera».</p>
        </div>
        <div>
          <label for="pos-espera-nombre" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">¿Quién vendrá a pagar? (opcional)</label>
          <input id="pos-espera-nombre" type="text" autocomplete="off" autocapitalize="words" maxlength="80" placeholder="Nombre del promotor" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
        </div>
        <div class="oculto-con-teclado">
          <label for="pos-espera-nota" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Nota (opcional)</label>
          <input id="pos-espera-nota" type="text" autocomplete="off" maxlength="200" placeholder="Ej: viene en 10 minutos" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
        </div>
        <p id="pos-espera-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
      </div>
      <div class="flex gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-800/40">
        <button id="pos-espera-cancelar" type="button" class="flex-1 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">Cancelar</button>
        <button id="pos-espera-guardar" type="submit" class="bg-marca flex-1 rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:brightness-110">Dejar en espera</button>
      </div>
    </form>
  </dialog>

  <!-- Ventas en espera del local: retomar para cobrar, o liberar -->
  <dialog
    id="pos-espera-lista"
    aria-labelledby="pos-espera-lista-titulo"
    class="group anim-escalar m-auto w-[min(30rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
  >
    <div class="flex max-h-[88dvh] flex-col">
      <div class="flex shrink-0 items-start justify-between gap-3 border-b border-slate-200 px-5 pb-3 pt-5 dark:border-slate-800">
        <div class="min-w-0">
          <h2 id="pos-espera-lista-titulo" class="text-base font-semibold">Ventas en espera</h2>
          <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Su mercancía está reservada. «Retomar» la pone en el carrito para cobrarla.</p>
        </div>
        <button id="pos-espera-lista-cerrar" type="button" aria-label="Cerrar" class="shrink-0 rounded-md p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200">✕</button>
      </div>
      <p id="pos-espera-lista-error" role="alert" class="mx-5 mt-3 hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
      <ul id="pos-espera-items" class="min-h-0 flex-1 divide-y divide-slate-100 overflow-y-auto dark:divide-slate-800"></ul>
      <p id="pos-espera-vacia" class="hidden px-5 py-6 text-sm text-slate-500 dark:text-slate-400">No hay ventas en espera.</p>
    </div>
  </dialog>

  <!-- Seleccionar código: producto → lista de los códigos de sus unidades disponibles (por si no se puede escanear) -->
  <dialog
    id="pos-selector"
    aria-labelledby="pos-selector-titulo"
    class="anim-escalar m-auto w-[min(32rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
  >
    <div class="flex max-h-[88dvh] flex-col">
      <div class="shrink-0 space-y-3 border-b border-slate-200 px-5 pb-4 pt-5 dark:border-slate-800">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h2 id="pos-selector-titulo" class="text-base font-semibold">Seleccionar código</h2>
            <p id="pos-selector-ayuda" class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Busca el producto y elige la unidad que vas a vender.</p>
          </div>
          <button id="pos-selector-cerrar" type="button" aria-label="Cerrar" class="shrink-0 rounded-md p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200">✕</button>
        </div>
        <button id="pos-selector-volver" type="button" class="hidden text-xs font-medium text-brand-700 hover:underline dark:text-brand-300">← Elegir otro producto</button>
        <input
          id="pos-selector-buscar"
          type="search"
          autocomplete="off"
          placeholder="Nombre, categoría o modelo..."
          class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white"
        />
        <div id="pos-selector-clave-bloque" class="hidden space-y-2 rounded-lg border border-amber-200 bg-amber-50/70 p-3 dark:border-amber-500/30 dark:bg-amber-500/10">
          <p class="text-xs font-semibold text-amber-800 dark:text-amber-300">Elegir un código a mano necesita la contraseña de un encargado, gerente o administrador</p>
          <input id="pos-selector-clave" type="password" autocomplete="new-password" placeholder="Su contraseña del sistema" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
        </div>
        <p id="pos-selector-autorizado" class="hidden rounded-lg bg-emerald-50 px-3 py-2 text-xs font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300"></p>
        <p id="pos-selector-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
      </div>
      <ul id="pos-selector-lista" class="min-h-0 flex-1 divide-y divide-slate-100 overflow-y-auto dark:divide-slate-800"></ul>
      <div class="shrink-0 border-t border-slate-200 bg-slate-50 px-5 py-3 dark:border-slate-800 dark:bg-slate-800/40">
        <button id="pos-selector-listo" type="button" class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Listo</button>
      </div>
    </div>
  </dialog>

  <!-- Elegir a mano el código de una unidad (la etiqueta no se lee): lista de sus códigos disponibles; exige la contraseña de un supervisor -->
  <dialog
    id="pos-manual"
    aria-labelledby="pos-manual-titulo"
    class="anim-escalar m-auto w-[min(28rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
  >
    <div class="flex max-h-[90dvh] flex-col">
      <div class="shrink-0 border-b border-slate-200 px-5 pb-3 pt-5 dark:border-slate-800">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h2 id="pos-manual-titulo" class="text-base font-semibold">Elegir código a mano</h2>
            <p id="pos-manual-producto" class="mt-0.5 break-words text-sm text-slate-600 dark:text-slate-300"></p>
          </div>
          <button id="pos-manual-cerrar" type="button" aria-label="Cerrar" class="shrink-0 rounded-md p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200">✕</button>
        </div>
      </div>
      <div class="shrink-0 space-y-2 border-b border-slate-200 px-5 py-3 dark:border-slate-800">
        <div id="pos-manual-clave-bloque" class="space-y-2">
          <p class="text-xs font-semibold text-slate-700 dark:text-slate-200">Contraseña de un encargado, gerente o administrador</p>
          <input id="pos-manual-clave" type="password" autocomplete="new-password" placeholder="Su contraseña del sistema" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
        </div>
        <p id="pos-manual-autorizado" class="hidden rounded-lg bg-emerald-50 px-3 py-2 text-xs font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300"></p>
        <p id="pos-manual-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
        <input id="pos-manual-buscar" type="search" inputmode="numeric" autocomplete="off" placeholder="Filtrar por código (ej. los últimos dígitos)..." class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
      </div>
      <ul id="pos-manual-lista" class="min-h-0 flex-1 divide-y divide-slate-100 overflow-y-auto dark:divide-slate-800"></ul>
    </div>
  </dialog>

  <!-- Modificar el precio de la venta (precio de promotor): el cliente paga más que el catálogo y la diferencia es la comisión del promotor.
       Se abre tocando el total en el cobro; lo autoriza SOLO con su contraseña un encargado de este local, un gerente o un administrador -->
  <!-- Qué precio se va a modificar: el de un promotor (el cliente paga más y hay comisión) o el del local (la tienda cambia el precio) -->
  <dialog
    id="pos-precio-modo"
    aria-labelledby="pos-precio-modo-titulo"
    class="anim-escalar m-auto w-[min(26rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
  >
    <div class="border-b border-slate-200 px-5 pb-3 pt-5 dark:border-slate-800">
      <h2 id="pos-precio-modo-titulo" class="text-base font-semibold">¿Qué precio vas a modificar?</h2>
      <p class="mt-0.5 text-sm text-slate-600 dark:text-slate-300">Elige cómo se cambia el precio de esta venta.</p>
    </div>
    <div class="space-y-3 px-5 py-4">
        <button type="button" data-modo-precio="promotor" class="block w-full rounded-xl border border-slate-200 p-4 text-left transition hover:border-brand-500 hover:bg-brand-50 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:hover:bg-slate-800">
          <span class="block text-sm font-semibold text-slate-900 dark:text-white">Precio de promotor</span>
          <span class="mt-1 block text-xs text-slate-600 dark:text-slate-300">El cliente paga más que el catálogo y la diferencia es la comisión del promotor (la tienda se la paga aparte).</span>
          <span class="mt-1 block text-[11px] text-slate-500 dark:text-slate-400">Lo autoriza un encargado, un gerente o un administrador.</span>
        </button>
        <button type="button" data-modo-precio="local" class="block w-full rounded-xl border border-slate-200 p-4 text-left transition hover:border-brand-500 hover:bg-brand-50 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:hover:bg-slate-800">
          <span class="block text-sm font-semibold text-slate-900 dark:text-white">Precio del local</span>
          <span class="mt-1 block text-xs text-slate-600 dark:text-slate-300">La tienda cambia el precio por su cuenta: más caro o con descuento, sin promotor ni comisión.</span>
          <span class="mt-1 block text-[11px] text-slate-500 dark:text-slate-400">Más caro: un encargado, un gerente o un administrador. Con descuento: solo un gerente o un administrador.</span>
        </button>
    </div>
    <div class="border-t border-slate-200 bg-slate-50 px-5 py-3 dark:border-slate-800 dark:bg-slate-800/40">
      <button id="pos-precio-modo-cancelar" type="button" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800">Cancelar</button>
    </div>
  </dialog>

  <dialog
    id="pos-precio"
    aria-labelledby="pos-precio-titulo"
    class="anim-escalar m-auto w-[min(26rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
  >
    <form id="pos-precio-form" class="flex max-h-[90dvh] flex-col" autocomplete="off" novalidate>
      <div class="shrink-0 border-b border-slate-200 px-5 pb-3 pt-5 dark:border-slate-800">
        <h2 id="pos-precio-titulo" class="text-base font-semibold">Precio de promotor</h2>
        <p id="pos-precio-descripcion" class="mt-0.5 text-sm text-slate-600 dark:text-slate-300">Escribe el precio al que paga el cliente.</p>
      </div>
      <div class="min-h-0 flex-1 space-y-3 overflow-y-auto px-5 py-4">
