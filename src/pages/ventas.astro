---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import CamaraEscaner from '../components/CamaraEscaner.astro';

const claseCampo =
  'mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white';
const claseEtiqueta = 'block text-xs font-medium text-slate-600 dark:text-slate-400';
---

<DashboardLayout titulo="Nueva Venta" subtitulo="Punto de venta (POS) — Edward Accesorios">
  <!-- Vista "Todos los locales" (administrador): una venta se registra en un local concreto -->
  <div id="pos-sin-local" class="hidden rounded-xl border border-amber-300 bg-amber-50 p-6 text-center dark:border-amber-500/40 dark:bg-amber-500/10 print:hidden">
    <p class="text-base font-semibold text-amber-900 dark:text-amber-200">Elige un local para vender</p>
    <p class="mt-1 text-sm text-amber-800 dark:text-amber-300">
      Estás viendo "Todos los locales". Cada venta descuenta el inventario de un local, así que elige uno en el selector del encabezado.
    </p>
  </div>

  <div id="pos-app" class="grid grid-cols-1 gap-6 pb-20 lg:h-[calc(100dvh-10rem)] lg:min-h-[30rem] lg:grid-cols-5 lg:grid-rows-1 lg:pb-0 print:hidden">
    <!-- Buscador + resultados -->
    <div class="min-h-0 lg:col-span-3">
      <div class="flex flex-col rounded-xl border border-slate-200 bg-white shadow-sm lg:h-full dark:border-slate-800 dark:bg-slate-900">
        <div class="shrink-0 border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <!-- Un solo campo: escanear (lector o cámara), escribir el código de una etiqueta o buscar por nombre, categoría o modelo -->
          <div>
            <div class="relative">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
                <path d="M4 5v14M8 5v14M12 5v14M17 5v14M20 5v14" stroke-linecap="round" />
              </svg>
              <input
                id="pos-codigo"
                type="text"
                enterkeyhint="search"
                autocomplete="off"
                autocapitalize="off"
                autocorrect="off"
                spellcheck="false"
                aria-label="Escanear el código de una etiqueta o buscar por nombre, categoría o modelo"
                placeholder="Escanea o busca por nombre..."
                class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-9 pr-11 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
              <button
                type="button"
                data-abrir-escaner
                aria-label="Escanear código con la cámara"
                title="Escanear con la cámara"
                class="absolute right-2 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-brand-600 dark:hover:bg-slate-700 dark:hover:text-brand-400"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                  <path d="M3 9V7a2 2 0 0 1 2-2h2M3 15v2a2 2 0 0 0 2 2h2M21 9V7a2 2 0 0 0-2-2h-2M21 15v2a2 2 0 0 1-2 2h-2" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="12" cy="12" r="3" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <button
              id="pos-seleccionar-codigo"
              type="button"
              title="Si no puedes escanear: elige el producto y escoge la unidad de la lista"
              class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke-linecap="round" />
              </svg>
              Seleccionar código
            </button>
          </div>
        </div>

        <ul id="pos-resultados" class="empty:hidden max-h-[28rem] divide-y divide-slate-100 overflow-y-auto lg:max-h-none lg:min-h-0 lg:flex-1 dark:divide-slate-800"></ul>
        <p id="pos-cargando" class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">Cargando catálogo...</p>
        <p id="pos-sin-resultados" class="hidden px-5 py-6 text-sm text-slate-500 dark:text-slate-400">
          No se encontraron productos con esa búsqueda.
        </p>
      </div>
    </div>

    <!-- Carrito -->
    <div class="min-h-0 lg:col-span-2">
      <div id="pos-carrito-seccion" class="flex scroll-mt-4 flex-col rounded-xl border border-slate-200 bg-white shadow-sm lg:h-full dark:border-slate-800 dark:bg-slate-900">
        <div class="flex shrink-0 items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Carrito de venta</h2>
          <span id="pos-carrito-contador" class="text-xs text-slate-500 dark:text-slate-400">0 líneas</span>
        </div>

        <ul id="pos-carrito" class="empty:hidden max-h-96 divide-y divide-slate-100 overflow-y-auto lg:max-h-none lg:min-h-0 lg:flex-1 dark:divide-slate-800"></ul>
        <p id="pos-carrito-vacio" class="px-5 py-6 text-sm lg:flex-1 text-slate-500 dark:text-slate-400">
          Escanea o busca un producto para iniciar una venta.
        </p>

        <div class="shrink-0 space-y-3 border-t border-slate-200 px-5 py-4 lg:mt-auto dark:border-slate-800">
          <div class="flex items-center justify-between text-base font-semibold text-slate-900 dark:text-white">
            <span>Total</span>
            <span id="pos-total" class="inline-block origin-right">$0.00</span>
          </div>
          <p id="pos-total-bs" class="-mt-2 text-right text-xs font-medium tabular-nums text-slate-500 dark:text-slate-400"></p>
          <p id="pos-error" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
          <button
            id="pos-procesar"
            type="button"
            disabled
            class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Procesar venta
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra inferior fija (solo móvil): total siempre visible + cobrar sin scrollear -->
  <div id="pos-barra-movil" class="fixed inset-x-0 bottom-0 z-20 mb-0 flex items-center gap-3 border-t border-slate-200 bg-white px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 shadow-[0_-4px_12px_rgba(0,0,0,0.05)] lg:hidden print:hidden dark:border-slate-800 dark:bg-slate-900">
    <button id="pos-barra-ver" type="button" class="min-w-0 flex-1 text-left" aria-label="Ver el carrito para cambiar cantidades o quitar productos">
      <p id="pos-barra-contador" class="text-xs text-slate-500 dark:text-slate-400">0 líneas</p>
      <p id="pos-barra-total" class="origin-left text-lg font-semibold text-slate-900 dark:text-white">$0.00</p>
      <p id="pos-barra-total-bs" class="text-xs font-medium tabular-nums text-slate-500 dark:text-slate-400"></p>
    </button>
    <button
      id="pos-barra-carrito"
      type="button"
      class="shrink-0 rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
    >
      Ver carrito
    </button>
    <button
      id="pos-barra-cobrar"
      type="button"
      disabled
      class="shrink-0 rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-50"
    >
      Cobrar
    </button>
  </div>

  <!-- Ticket: oculto hasta procesar una venta; es lo único visible al imprimir -->
  <div id="pos-ticket" class="hidden">
    <div class="mx-auto max-w-sm rounded-xl border border-slate-200 bg-white p-6 shadow-sm print:max-w-full print:rounded-none print:border-none print:shadow-none dark:border-slate-800 dark:bg-slate-900 print:dark:bg-white">
      <div class="text-center">
        <img src="/logo.png" alt="Edward Accesorios" width="480" height="234" class="mx-auto mb-2 h-12 w-auto" />
        <p class="text-sm font-semibold text-slate-900 dark:text-white print:text-black">Edward Accesorios</p>
        <p class="text-xs text-slate-500 dark:text-slate-400 print:text-black">Ticket de venta</p>
        <p id="ticket-folio" class="mt-2 text-xs text-slate-500 dark:text-slate-400 print:text-black"></p>
        <p id="ticket-fecha" class="text-xs text-slate-500 dark:text-slate-400 print:text-black"></p>
        <p id="ticket-cliente" class="mt-2 text-xs text-slate-600 dark:text-slate-300 print:text-black"></p>
      </div>
      <div class="my-4 border-t border-dashed border-slate-300 dark:border-slate-700 print:border-black"></div>
      <ul id="ticket-lineas" class="space-y-2 text-sm text-slate-700 dark:text-slate-300 print:text-black"></ul>
      <div class="my-4 border-t border-dashed border-slate-300 dark:border-slate-700 print:border-black"></div>
      <div class="flex justify-between text-base font-semibold text-slate-900 dark:text-white print:text-black">
        <span>Total</span>
        <span id="ticket-total"></span>
      </div>
      <div id="ticket-bs" class="mt-1 hidden justify-between text-sm font-semibold text-slate-900 dark:text-white print:text-black">
        <span>Cobrado en bolívares</span>
        <span id="ticket-total-bs"></span>
      </div>
      <p id="ticket-tasa" class="mt-1 text-right text-xs text-slate-500 dark:text-slate-400 print:text-black"></p>
      <div class="mt-3 border-t border-dashed border-slate-300 pt-3 dark:border-slate-700 print:border-black">
        <p class="text-xs font-semibold text-slate-600 dark:text-slate-300 print:text-black">Forma de pago</p>
        <ul id="ticket-pagos" class="mt-1 space-y-0.5 text-xs text-slate-600 dark:text-slate-300 print:text-black"></ul>
      </div>
      <p class="mt-4 text-center text-xs text-slate-400 print:text-black">¡Gracias por su compra!</p>
    </div>

    <div class="mx-auto mt-4 max-w-sm print:hidden">
      <button
        id="pos-whatsapp"
        type="button"
        class="flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M12.04 2a9.93 9.93 0 0 0-8.5 15.07L2 22l5.07-1.5A9.94 9.94 0 1 0 12.04 2Zm0 1.8a8.14 8.14 0 1 1-4.2 15.1l-.3-.18-3 .88.9-2.92-.2-.3A8.13 8.13 0 0 1 12.04 3.8Zm-3.2 4.2c-.17 0-.45.06-.69.32-.24.26-.9.88-.9 2.15s.93 2.5 1.06 2.67c.13.17 1.8 2.86 4.45 3.9 2.2.87 2.65.7 3.13.65.48-.04 1.55-.63 1.77-1.24.22-.6.22-1.13.15-1.24-.06-.11-.24-.17-.5-.3-.26-.13-1.55-.77-1.8-.85-.24-.09-.41-.13-.59.13-.17.26-.67.85-.82 1.02-.15.18-.3.2-.57.07-.26-.13-1.1-.4-2.1-1.3-.77-.69-1.3-1.55-1.45-1.8-.15-.27-.02-.4.11-.53.12-.12.26-.3.4-.46.13-.15.17-.26.26-.44.09-.17.04-.33-.02-.46-.07-.13-.59-1.43-.81-1.95-.21-.5-.43-.43-.59-.44h-.5Z"/></svg>
        Enviar ticket por WhatsApp (imagen)
      </button>
      <button
        id="pos-compartir"
        type="button"
        class="mt-2 w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700"
      >
        Compartir imagen (elegir el chat yo mismo)
      </button>
      <p id="pos-whatsapp-aviso" role="status" class="mt-1 hidden text-center text-xs"></p>
    </div>

    <div class="mx-auto mt-3 flex max-w-sm gap-3 print:hidden">
      <button
        id="pos-imprimir"
        type="button"
        class="flex-1 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
      >
        Imprimir ticket
      </button>
      <button
        id="pos-nueva-venta"
        type="button"
        class="flex-1 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700"
      >
        Nueva venta
      </button>
    </div>
  </div>

  <!-- Alerta grande cuando el QR/código leído no se puede vender (ya vendido, inexistente, de otro local…) -->
  <dialog
    id="pos-alerta"
    aria-labelledby="pos-alerta-titulo"
    class="anim-escalar m-auto w-[min(24rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-red-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-red-500/40 dark:bg-slate-900 dark:text-slate-100"
  >
    <div class="space-y-3 px-5 pb-4 pt-5 text-center">
      <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-red-100 text-red-600 dark:bg-red-500/15 dark:text-red-400" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
          <path d="M12 9v4m0 4h.01M10.3 3.9 2.4 17.6A2 2 0 0 0 4.1 20.6h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <h2 id="pos-alerta-titulo" class="text-lg font-semibold"></h2>
      <p id="pos-alerta-detalle" class="text-sm text-slate-600 dark:text-slate-300"></p>
    </div>
    <div class="border-t border-slate-200 px-5 py-4 dark:border-slate-800">
      <button id="pos-alerta-ok" type="button" class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Entendido</button>
    </div>
  </dialog>

  <!-- Confirmación antes de procesar la venta + datos del cliente y tipo de cobro -->
  <dialog
    id="pos-confirmar"
    aria-labelledby="pos-confirmar-titulo"
    class="group anim-escalar m-auto w-[min(30rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
  >
    <form id="pos-confirmar-form" class="flex max-h-[92dvh] flex-col" novalidate>
      <div class="space-y-4 overflow-y-auto px-5 pb-4 pt-5">
        <div class="flex items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700 dark:bg-brand-500/15 dark:text-brand-300" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
              <circle cx="12" cy="12" r="9" /><path d="M12 8v4m0 4h.01" stroke-linecap="round" />
            </svg>
          </span>
          <div class="min-w-0">
            <h2 id="pos-confirmar-titulo" class="text-base font-semibold">Procesar venta</h2>
            <p id="pos-confirmar-resumen" class="mt-0.5 text-sm text-slate-500 dark:text-slate-400"></p>
          </div>
        </div>
        <ol id="pos-pasos" class="flex gap-1.5" aria-label="Pasos de la venta"></ol>

        <div>
          <ul id="pos-confirmar-lineas" class="hidden group-data-[teclado=true]:hidden max-h-32 divide-y divide-slate-100 overflow-y-auto rounded-lg border border-slate-200 text-sm dark:divide-slate-800 dark:border-slate-700"></ul>
          <div class="mt-3 flex items-center justify-between text-base font-semibold">
            <span>Total a cobrar</span>
            <button id="pos-confirmar-total-btn" type="button" title="Modificar el precio" aria-label="Modificar el precio de la venta" class="inline-flex items-center gap-1.5 rounded-md px-1.5 py-0.5 -mr-1.5 decoration-dotted underline-offset-4 hover:bg-slate-100 hover:underline dark:hover:bg-slate-800">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5 text-slate-400" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span id="pos-confirmar-total"></span>
            </button>
          </div>
          <p id="pos-confirmar-total-bs" class="group-data-[teclado=true]:hidden text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"></p>
          <p id="pos-confirmar-precio-nota" class="group-data-[teclado=true]:hidden text-right text-[11px] text-slate-400 dark:text-slate-500">Toca el total para modificar el precio</p>
        </div>

        <section data-paso="escaneo" class="hidden space-y-3 border-t border-slate-200 pt-4 dark:border-slate-800">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Escanea lo que vas a vender</p>
          </div>
          <ul id="pos-escaneo-lista" class="divide-y divide-slate-100 rounded-lg border border-slate-200 text-sm dark:divide-slate-800 dark:border-slate-700"></ul>
          <div class="relative">
            <input id="pos-escaneo-codigo" type="text" inputmode="numeric" autocomplete="off" placeholder="Escanea o escribe el código de la etiqueta..." aria-label="Código de la unidad" class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-3 pr-12 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            <button type="button" data-abrir-escaner aria-label="Escanear con la cámara" title="Escanear con la cámara" class="absolute right-1.5 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-brand-600 dark:hover:bg-slate-700 dark:hover:text-brand-400">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M3 9V7a2 2 0 0 1 2-2h2M3 15v2a2 2 0 0 0 2 2h2M21 9V7a2 2 0 0 0-2-2h-2M21 15v2a2 2 0 0 1-2 2h-2" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="12" r="3" stroke-linecap="round" /></svg>
            </button>
          </div>
          <p id="pos-escaneo-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
          <button id="pos-escaneo-sinconexion" type="button" class="hidden w-full rounded-lg border border-amber-300 px-4 py-2.5 text-sm font-semibold text-amber-700 hover:bg-amber-50 dark:border-amber-500/40 dark:text-amber-300 dark:hover:bg-slate-800">Continuar sin escanear (sin conexión)</button>
        </section>

        <fieldset data-paso="cliente" class="hidden space-y-3 border-t border-slate-200 pt-4 dark:border-slate-800">
          <legend class="sr-only">Datos del cliente</legend>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Datos del cliente</p>

          <div>
            <label for="pos-cli-cedula" class={claseEtiqueta}>Cédula *</label>
            <div class="mt-1 flex gap-2">
              <select id="pos-cli-nac" aria-label="Nacionalidad" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2.5 text-base text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                <option value="V">V</option>
                <option value="E">E</option>
              </select>
              <input id="pos-cli-cedula" type="text" inputmode="numeric" autocomplete="off" maxlength="9" placeholder="12345678" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <p id="pos-cli-aviso" role="status" class="mt-1 hidden rounded-lg bg-emerald-50 px-3 py-1.5 text-xs text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"></p>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <label for="pos-cli-nombre" class={claseEtiqueta}>Nombre *</label>
              <input id="pos-cli-nombre" type="text" autocomplete="off" maxlength="60" class={claseCampo} />
            </div>
            <div>
              <label for="pos-cli-apellido" class={claseEtiqueta}>Apellido *</label>
              <input id="pos-cli-apellido" type="text" autocomplete="off" maxlength="60" class={claseCampo} />
