---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import CamaraEscaner from '../components/CamaraEscaner.astro';

const claseCampo =
  'mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white';
const claseEtiqueta = 'block text-xs font-medium text-slate-600 dark:text-slate-400';
---

<DashboardLayout titulo="Nueva Venta" subtitulo="Punto de venta (POS) — Edward Accesorios">
  <!-- Vista "Todos los locales" (administrador): una venta se registra en un local concreto -->
  <div id="pos-sin-local" class="hidden rounded-xl border border-amber-300 bg-amber-50 p-6 text-center dark:border-amber-500/40 dark:bg-amber-500/10 print:hidden">
    <p class="text-base font-semibold text-amber-900 dark:text-amber-200">Elige un local para vender</p>
    <p class="mt-1 text-sm text-amber-800 dark:text-amber-300">
      Estás viendo "Todos los locales". Cada venta descuenta el inventario de un local, así que elige uno en el selector del encabezado.
    </p>
  </div>

  <div id="pos-app" class="grid grid-cols-1 gap-6 pb-20 lg:h-[calc(100dvh-10rem)] lg:min-h-[30rem] lg:grid-cols-5 lg:grid-rows-1 lg:pb-0 print:hidden">
    <!-- Buscador + resultados -->
    <div class="min-h-0 lg:col-span-3">
      <div class="flex flex-col rounded-xl border border-slate-200 bg-white shadow-sm lg:h-full dark:border-slate-800 dark:bg-slate-900">
        <div class="shrink-0 space-y-4 border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <!-- 1. Código de la unidad: lector, cámara del teléfono o selección manual -->
          <div>
            <label for="pos-codigo" class="text-sm font-semibold text-slate-900 dark:text-white">Código de la unidad</label>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
              Cada unidad tiene su propia etiqueta (código de barras o QR). Escanéala con el lector o la cámara del teléfono y se agrega esa unidad exacta.
            </p>
            <div class="relative mt-3">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
                <path d="M4 5v14M8 5v14M12 5v14M17 5v14M20 5v14" stroke-linecap="round" />
              </svg>
              <input
                id="pos-codigo"
                type="text"
                inputmode="numeric"
                autocomplete="off"
                placeholder="Escanea o escribe el código..."
                class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-9 pr-11 font-mono text-base text-slate-900 placeholder:font-sans placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
              <button
                type="button"
                data-abrir-escaner
                aria-label="Escanear código con la cámara"
                title="Escanear con la cámara"
                class="absolute right-2 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-brand-600 dark:hover:bg-slate-700 dark:hover:text-brand-400"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                  <path d="M3 9V7a2 2 0 0 1 2-2h2M3 15v2a2 2 0 0 0 2 2h2M21 9V7a2 2 0 0 0-2-2h-2M21 15v2a2 2 0 0 1-2 2h-2" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="12" cy="12" r="3" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <button
              id="pos-seleccionar-codigo"
              type="button"
              class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke-linecap="round" />
              </svg>
              Seleccionar código
            </button>
            <p class="mt-1 text-center text-[11px] text-slate-500 dark:text-slate-400">Si no puedes escanear, elige el producto y escoge la unidad de la lista.</p>
          </div>

          <!-- 2. Búsqueda por nombre o modelo -->
          <div class="border-t border-slate-100 pt-3 dark:border-slate-800">
            <label for="pos-buscador" class="block text-xs font-medium text-slate-600 dark:text-slate-400">O busca por nombre o modelo de teléfono compatible</label>
            <div class="relative mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
                <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" stroke-linecap="round" />
              </svg>
              <input
                id="pos-buscador"
                type="text"
                autocomplete="off"
                placeholder="Nombre, categoría o modelo..."
                class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-9 pr-3 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white"
              />
            </div>
          </div>
        </div>

        <ul id="pos-resultados" class="empty:hidden max-h-[28rem] divide-y divide-slate-100 overflow-y-auto lg:max-h-none lg:min-h-0 lg:flex-1 dark:divide-slate-800"></ul>
        <p id="pos-cargando" class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">Cargando catálogo...</p>
        <p id="pos-sin-resultados" class="hidden px-5 py-6 text-sm text-slate-500 dark:text-slate-400">
          No se encontraron productos con esa búsqueda.
        </p>
      </div>
    </div>

    <!-- Carrito -->
    <div class="min-h-0 lg:col-span-2">
      <div id="pos-carrito-seccion" class="flex scroll-mt-4 flex-col rounded-xl border border-slate-200 bg-white shadow-sm lg:h-full dark:border-slate-800 dark:bg-slate-900">
        <div class="flex shrink-0 items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Carrito de venta</h2>
          <span id="pos-carrito-contador" class="text-xs text-slate-500 dark:text-slate-400">0 líneas</span>
        </div>

        <ul id="pos-carrito" class="empty:hidden max-h-96 divide-y divide-slate-100 overflow-y-auto lg:max-h-none lg:min-h-0 lg:flex-1 dark:divide-slate-800"></ul>
        <p id="pos-carrito-vacio" class="px-5 py-6 text-sm lg:flex-1 text-slate-500 dark:text-slate-400">
          Agrega productos desde el buscador para iniciar una venta.
        </p>

        <div class="shrink-0 space-y-3 border-t border-slate-200 px-5 py-4 lg:mt-auto dark:border-slate-800">
          <div class="flex items-center justify-between text-base font-semibold text-slate-900 dark:text-white">
            <span>Total</span>
            <span id="pos-total" class="inline-block origin-right">$0.00</span>
          </div>
          <p id="pos-total-bs" class="-mt-2 text-right text-xs font-medium tabular-nums text-slate-500 dark:text-slate-400"></p>
          <p id="pos-error" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
          <button
            id="pos-procesar"
            type="button"
            disabled
            class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Procesar venta
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra inferior fija (solo móvil): total siempre visible + cobrar sin scrollear -->
  <div id="pos-barra-movil" class="fixed inset-x-0 bottom-0 z-20 flex items-center gap-3 border-t border-slate-200 bg-white px-4 py-3 shadow-[0_-4px_12px_rgba(0,0,0,0.05)] lg:hidden print:hidden dark:border-slate-800 dark:bg-slate-900">
    <button id="pos-barra-ver" type="button" class="min-w-0 flex-1 text-left" aria-label="Ver el carrito para cambiar cantidades o quitar productos">
      <p id="pos-barra-contador" class="text-xs text-slate-500 dark:text-slate-400">0 líneas</p>
      <p id="pos-barra-total" class="origin-left text-lg font-semibold text-slate-900 dark:text-white">$0.00</p>
      <p id="pos-barra-total-bs" class="text-xs font-medium tabular-nums text-slate-500 dark:text-slate-400"></p>
    </button>
    <button
      id="pos-barra-carrito"
      type="button"
      class="shrink-0 rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
    >
      Ver carrito
    </button>
    <button
      id="pos-barra-cobrar"
      type="button"
      disabled
      class="shrink-0 rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-50"
    >
      Cobrar
    </button>
  </div>

  <!-- Ticket: oculto hasta procesar una venta; es lo único visible al imprimir -->
  <div id="pos-ticket" class="hidden">
    <div class="mx-auto max-w-sm rounded-xl border border-slate-200 bg-white p-6 shadow-sm print:max-w-full print:rounded-none print:border-none print:shadow-none dark:border-slate-800 dark:bg-slate-900 print:dark:bg-white">
      <div class="text-center">
        <img src="/logo.png" alt="Edward Accesorios" width="480" height="234" class="mx-auto mb-2 h-12 w-auto" />
        <p class="text-sm font-semibold text-slate-900 dark:text-white print:text-black">Edward Accesorios</p>
        <p class="text-xs text-slate-500 dark:text-slate-400 print:text-black">Ticket de venta</p>
        <p id="ticket-folio" class="mt-2 text-xs text-slate-500 dark:text-slate-400 print:text-black"></p>
        <p id="ticket-fecha" class="text-xs text-slate-500 dark:text-slate-400 print:text-black"></p>
        <p id="ticket-cliente" class="mt-2 text-xs text-slate-600 dark:text-slate-300 print:text-black"></p>
      </div>
      <div class="my-4 border-t border-dashed border-slate-300 dark:border-slate-700 print:border-black"></div>
      <ul id="ticket-lineas" class="space-y-2 text-sm text-slate-700 dark:text-slate-300 print:text-black"></ul>
      <div class="my-4 border-t border-dashed border-slate-300 dark:border-slate-700 print:border-black"></div>
      <div class="flex justify-between text-base font-semibold text-slate-900 dark:text-white print:text-black">
        <span>Total</span>
        <span id="ticket-total"></span>
      </div>
      <div id="ticket-bs" class="mt-1 hidden justify-between text-sm font-semibold text-slate-900 dark:text-white print:text-black">
        <span>Cobrado en bolívares</span>
        <span id="ticket-total-bs"></span>
      </div>
      <p id="ticket-tasa" class="mt-1 text-right text-xs text-slate-500 dark:text-slate-400 print:text-black"></p>
      <div class="mt-3 border-t border-dashed border-slate-300 pt-3 dark:border-slate-700 print:border-black">
        <p class="text-xs font-semibold text-slate-600 dark:text-slate-300 print:text-black">Forma de pago</p>
        <ul id="ticket-pagos" class="mt-1 space-y-0.5 text-xs text-slate-600 dark:text-slate-300 print:text-black"></ul>
      </div>
      <p class="mt-4 text-center text-xs text-slate-400 print:text-black">¡Gracias por su compra!</p>
    </div>

    <div class="mx-auto mt-4 max-w-sm print:hidden">
      <button
        id="pos-whatsapp"
        type="button"
        class="flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M12.04 2a9.93 9.93 0 0 0-8.5 15.07L2 22l5.07-1.5A9.94 9.94 0 1 0 12.04 2Zm0 1.8a8.14 8.14 0 1 1-4.2 15.1l-.3-.18-3 .88.9-2.92-.2-.3A8.13 8.13 0 0 1 12.04 3.8Zm-3.2 4.2c-.17 0-.45.06-.69.32-.24.26-.9.88-.9 2.15s.93 2.5 1.06 2.67c.13.17 1.8 2.86 4.45 3.9 2.2.87 2.65.7 3.13.65.48-.04 1.55-.63 1.77-1.24.22-.6.22-1.13.15-1.24-.06-.11-.24-.17-.5-.3-.26-.13-1.55-.77-1.8-.85-.24-.09-.41-.13-.59.13-.17.26-.67.85-.82 1.02-.15.18-.3.2-.57.07-.26-.13-1.1-.4-2.1-1.3-.77-.69-1.3-1.55-1.45-1.8-.15-.27-.02-.4.11-.53.12-.12.26-.3.4-.46.13-.15.17-.26.26-.44.09-.17.04-.33-.02-.46-.07-.13-.59-1.43-.81-1.95-.21-.5-.43-.43-.59-.44h-.5Z"/></svg>
        Enviar ticket por WhatsApp (imagen)
      </button>
      <p id="pos-whatsapp-aviso" role="status" class="mt-1 hidden text-center text-xs"></p>
    </div>

    <div class="mx-auto mt-3 flex max-w-sm gap-3 print:hidden">
      <button
        id="pos-imprimir"
        type="button"
        class="flex-1 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
      >
        Imprimir ticket
      </button>
      <button
        id="pos-nueva-venta"
        type="button"
        class="flex-1 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700"
      >
        Nueva venta
      </button>
    </div>
  </div>

  <!-- Confirmación antes de procesar la venta + datos del cliente y tipo de cobro -->
  <dialog
    id="pos-confirmar"
    aria-labelledby="pos-confirmar-titulo"
    class="anim-escalar m-auto w-[min(30rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
  >
    <form id="pos-confirmar-form" class="flex max-h-[92dvh] flex-col" novalidate>
      <div class="space-y-4 overflow-y-auto px-5 pb-4 pt-5">
        <div class="flex items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700 dark:bg-brand-500/15 dark:text-brand-300" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
              <circle cx="12" cy="12" r="9" /><path d="M12 8v4m0 4h.01" stroke-linecap="round" />
            </svg>
          </span>
          <div class="min-w-0">
            <h2 id="pos-confirmar-titulo" class="text-base font-semibold">Procesar venta</h2>
            <p id="pos-confirmar-resumen" class="mt-0.5 text-sm text-slate-500 dark:text-slate-400"></p>
          </div>
        </div>
        <ol id="pos-pasos" class="flex gap-1.5" aria-label="Pasos de la venta"></ol>

        <div>
          <ul id="pos-confirmar-lineas" class="hidden max-h-32 divide-y divide-slate-100 overflow-y-auto rounded-lg border border-slate-200 text-sm dark:divide-slate-800 dark:border-slate-700"></ul>
          <div class="mt-3 flex items-center justify-between text-base font-semibold">
            <span>Total a cobrar</span>
            <span id="pos-confirmar-total"></span>
          </div>
          <p id="pos-confirmar-total-bs" class="text-right text-sm tabular-nums text-slate-500 dark:text-slate-400"></p>
        </div>

        <section data-paso="escaneo" class="hidden space-y-3 border-t border-slate-200 pt-4 dark:border-slate-800">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Escanea lo que vas a vender</p>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Escanea el QR de la etiqueta de cada unidad: así queda registrado exactamente cuál se vendió.</p>
          </div>
          <ul id="pos-escaneo-lista" class="divide-y divide-slate-100 rounded-lg border border-slate-200 text-sm dark:divide-slate-800 dark:border-slate-700"></ul>
          <div class="relative">
            <input id="pos-escaneo-codigo" type="text" inputmode="numeric" autocomplete="off" placeholder="Escanea o escribe el código de la etiqueta..." aria-label="Código de la unidad" class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-3 pr-12 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            <button type="button" data-abrir-escaner aria-label="Escanear con la cámara" title="Escanear con la cámara" class="absolute right-1.5 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-brand-600 dark:hover:bg-slate-700 dark:hover:text-brand-400">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M3 9V7a2 2 0 0 1 2-2h2M3 15v2a2 2 0 0 0 2 2h2M21 9V7a2 2 0 0 0-2-2h-2M21 15v2a2 2 0 0 1-2 2h-2" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="12" r="3" stroke-linecap="round" /></svg>
            </button>
          </div>
          <p id="pos-escaneo-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
          <button id="pos-escaneo-sinconexion" type="button" class="hidden w-full rounded-lg border border-amber-300 px-4 py-2.5 text-sm font-semibold text-amber-700 hover:bg-amber-50 dark:border-amber-500/40 dark:text-amber-300 dark:hover:bg-slate-800">Continuar sin escanear (sin conexión)</button>
        </section>

        <fieldset data-paso="cliente" class="hidden space-y-3 border-t border-slate-200 pt-4 dark:border-slate-800">
          <legend class="sr-only">Datos del cliente</legend>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Datos del cliente</p>

          <div>
            <label for="pos-cli-cedula" class={claseEtiqueta}>Cédula *</label>
            <div class="mt-1 flex gap-2">
              <select id="pos-cli-nac" aria-label="Nacionalidad" class="rounded-lg border border-slate-200 bg-white px-2.5 py-2.5 text-base text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                <option value="V">V</option>
                <option value="E">E</option>
              </select>
              <input id="pos-cli-cedula" type="text" inputmode="numeric" autocomplete="off" maxlength="9" placeholder="12345678" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </div>
            <p id="pos-cli-aviso" role="status" class="mt-1 hidden rounded-lg bg-emerald-50 px-3 py-1.5 text-xs text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"></p>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <label for="pos-cli-nombre" class={claseEtiqueta}>Nombre *</label>
              <input id="pos-cli-nombre" type="text" autocomplete="off" maxlength="60" class={claseCampo} />
            </div>
            <div>
              <label for="pos-cli-apellido" class={claseEtiqueta}>Apellido *</label>
              <input id="pos-cli-apellido" type="text" autocomplete="off" maxlength="60" class={claseCampo} />
            </div>
          </div>

          <div>
            <label for="pos-cli-telefono" class={claseEtiqueta}>Número de teléfono *</label>
            <input id="pos-cli-telefono" type="tel" inputmode="tel" autocomplete="off" maxlength="20" placeholder="0414-1234567" class={claseCampo} />
          </div>
        </fieldset>

        <!-- Formas de pago y vuelto (utils/formularioPagos.ts) -->
        <div data-paso="pago" class="hidden space-y-3 border-t border-slate-200 pt-4 dark:border-slate-800">
          <div id="pos-formulario-pagos"></div>
        </div>

        <p id="pos-confirmar-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
        <p id="pos-confirmar-nota" class="hidden text-xs text-slate-500 dark:text-slate-400">Al confirmar, el stock se descontará del inventario.</p>
      </div>

      <div class="flex gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-800/40">
        <button id="pos-confirmar-no" type="button" class="flex-1 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
          Cancelar
        </button>
        <button id="pos-confirmar-si" type="submit" class="bg-marca flex-1 rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:brightness-110">
          Sí, procesar venta
        </button>
      </div>
    </form>
  </dialog>

  <!-- Seleccionar código: producto → lista de los códigos de sus unidades disponibles (por si no se puede escanear) -->
  <dialog
    id="pos-selector"
    aria-labelledby="pos-selector-titulo"
    class="anim-escalar m-auto w-[min(32rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
  >
    <div class="flex max-h-[88dvh] flex-col">
      <div class="shrink-0 space-y-3 border-b border-slate-200 px-5 pb-4 pt-5 dark:border-slate-800">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h2 id="pos-selector-titulo" class="text-base font-semibold">Seleccionar código</h2>
            <p id="pos-selector-ayuda" class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Busca el producto y elige la unidad que vas a vender.</p>
          </div>
          <button id="pos-selector-cerrar" type="button" aria-label="Cerrar" class="shrink-0 rounded-md p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200">✕</button>
        </div>
        <button id="pos-selector-volver" type="button" class="hidden text-xs font-medium text-brand-700 hover:underline dark:text-brand-300">← Elegir otro producto</button>
        <input
          id="pos-selector-buscar"
          type="search"
          autocomplete="off"
          placeholder="Nombre, categoría o modelo..."
          class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white"
        />
      </div>
      <ul id="pos-selector-lista" class="min-h-0 flex-1 divide-y divide-slate-100 overflow-y-auto dark:divide-slate-800"></ul>
      <div class="shrink-0 border-t border-slate-200 bg-slate-50 px-5 py-3 dark:border-slate-800 dark:bg-slate-800/40">
        <button id="pos-selector-listo" type="button" class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Listo</button>
      </div>
    </div>
  </dialog>

  <CamaraEscaner />
</DashboardLayout>

<script>
  import * as inventoryService from '../lib/inventoryService';
  import type { VentaRegistrada } from '../lib/inventoryService';
  import { obtenerSesionActual } from '../lib/auth';
  import { etiquetaMetodoPago, pagosDeVenta } from '../utils/pagos';
  import { FormularioPagos } from '../utils/formularioPagos';
  import { tasaActual } from '../stores/tasa';
  import { convertirABs, estadoStock, formatearBolivares, formatearMoneda, htmlPrecioDual } from '../utils/format';
  import { animarLista, reanimar } from '../utils/animaciones';
import { alCambiarDatos } from '../lib/realtime';
  import { htmlMiniatura } from '../utils/imagenes';
  import { codigoDeNumeroCorto, esCodigoUnidad } from '../utils/codigos';
  import { esErrorDeRed } from '../utils/red';
  import { urlWhatsApp } from '../utils/ticketWhatsApp';
  import { archivoDeTicket } from '../utils/ticketImagen';
  import { compartirArchivos, descargarArchivos, puedeCompartirArchivos } from '../utils/etiquetaImagen';
  import type { ClienteVenta, DineroEntregado, PagoVenta, ProductoConRelaciones, UnidadProducto, VentaItem } from '../types/database.types';

  interface LineaCarrito {
    producto: ProductoConRelaciones;
    cantidad: number;
    /** Unidades concretas escaneadas o elegidas (cada una con su código); el resto de la cantidad sale por orden de llegada */
    unidades: string[];
  }

  let productos: ProductoConRelaciones[] = [];
  let carrito: LineaCarrito[] = [];
  let localActivoId = '';

  const buscador = document.getElementById('pos-buscador') as HTMLInputElement;
  const campoCodigo = document.getElementById('pos-codigo') as HTMLInputElement;
  const resultados = document.getElementById('pos-resultados') as HTMLUListElement;
  const cargando = document.getElementById('pos-cargando') as HTMLParagraphElement;
  const sinResultados = document.getElementById('pos-sin-resultados') as HTMLParagraphElement;
  const listaCarrito = document.getElementById('pos-carrito') as HTMLUListElement;
  const carritoVacio = document.getElementById('pos-carrito-vacio') as HTMLParagraphElement;
  const carritoContador = document.getElementById('pos-carrito-contador') as HTMLSpanElement;
  const totalEl = document.getElementById('pos-total') as HTMLSpanElement;
  const errorEl = document.getElementById('pos-error') as HTMLParagraphElement;
  const botonProcesar = document.getElementById('pos-procesar') as HTMLButtonElement;
  const posApp = document.getElementById('pos-app') as HTMLDivElement;
  const ticket = document.getElementById('pos-ticket') as HTMLDivElement;
  const barraMovil = document.getElementById('pos-barra-movil') as HTMLDivElement;
  const barraContador = document.getElementById('pos-barra-contador') as HTMLParagraphElement;
  const barraTotal = document.getElementById('pos-barra-total') as HTMLParagraphElement;
  const barraCobrar = document.getElementById('pos-barra-cobrar') as HTMLButtonElement;

  function escaparHtml(texto: string): string {
    const div = document.createElement('div');
    div.textContent = texto;
    return div.innerHTML;
  }

  /** "$5.00 · Bs. 182,50" (solo "$5.00" mientras no haya tasa). */
  function precioEnLinea(usd: number): string {
    const tasa = tasaActual.get();
    return tasa ? `${formatearMoneda(usd)} · ${formatearBolivares(convertirABs(usd, tasa))}` : formatearMoneda(usd);
  }

  function mostrarError(mensaje: string) {
    errorEl.textContent = mensaje;
    errorEl.classList.remove('hidden');
  }

  function limpiarError() {
    errorEl.classList.add('hidden');
    errorEl.textContent = '';
  }

  function cantidadEnCarrito(productoId: string): number {
    return carrito.find((l) => l.producto.id === productoId)?.cantidad ?? 0;
  }

  function filtrarProductos(texto: string): ProductoConRelaciones[] {
    const q = texto.trim().toLowerCase();
    const coincidencias = !q
      ? productos
      : productos.filter(
          (p) =>
            p.nombre.toLowerCase().includes(q) ||
            p.codigo_barras.toLowerCase().includes(q) ||
            p.categoria.toLowerCase().includes(q) ||
            p.modelos_compatibles.some((m) => `${m.marca} ${m.modelo}`.toLowerCase().includes(q))
        );
    // Lo que se puede vender (stock > 0) va primero; el orden alfabético se conserva dentro de cada grupo.
    return [...coincidencias].sort((a, b) => Number(b.stock_actual > 0) - Number(a.stock_actual > 0));
  }

  // Con cientos de productos, pintarlos todos en cada tecla es lento en un teléfono.
  const LIMITE_RESULTADOS = 80;

  const estilosBadge: Record<string, string> = {
    ok: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400',
    bajo: 'bg-amber-100 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400',
    critico: 'bg-red-100 text-red-700 dark:bg-red-500/10 dark:text-red-400',
  };

  function renderResultados(texto: string) {
    const lista = filtrarProductos(texto);
    sinResultados.classList.toggle('hidden', lista.length > 0);

    const recortada = lista.length > LIMITE_RESULTADOS;
    resultados.innerHTML = lista
      .slice(0, LIMITE_RESULTADOS)
      .map((producto) => {
        const disponible = producto.stock_actual - cantidadEnCarrito(producto.id);
        const estado = estadoStock(producto.stock_actual, producto.stock_minimo);
        const compatibles = producto.modelos_compatibles.length
          ? producto.modelos_compatibles.map((m) => `${m.marca} ${m.modelo}`).join(', ')
          : 'Universal';

        return `
          <li class="flex items-center justify-between gap-3 px-5 py-3">
            ${htmlMiniatura(producto.imagen_url, producto.nombre, 'h-12 w-12')}
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium text-slate-900 dark:text-white">${escaparHtml(producto.nombre)}</p>
              <p class="truncate text-xs text-slate-500 dark:text-slate-400">
                ${escaparHtml(producto.codigo_barras)} · ${escaparHtml(producto.categoria)} · ${escaparHtml(compatibles)}
              </p>
              <p class="mt-1 text-xs">
                <span class="rounded-full px-2 py-0.5 font-medium ${estilosBadge[estado]}">${disponible} disponible${disponible === 1 ? '' : 's'}</span>
                <span class="ml-1 text-slate-500 dark:text-slate-400">${precioEnLinea(producto.precio_venta)}</span>
              </p>
            </div>
            <button
              type="button"
              data-agregar="${producto.id}"
              ${disponible <= 0 ? 'disabled' : ''}
              class="shrink-0 rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:dark:bg-slate-700"
            >
              + Agregar
            </button>
          </li>
        `;
      })
      .join('') +
      (recortada
        ? `<li class="px-5 py-3 text-xs text-slate-500 dark:text-slate-400">Mostrando ${LIMITE_RESULTADOS} de ${lista.length}. Escribe más del nombre, modelo o código para afinar.</li>`
        : '');
  }

  function renderCarrito() {
    carritoVacio.classList.toggle('hidden', carrito.length > 0);
    carritoContador.textContent = `${carrito.length} línea${carrito.length === 1 ? '' : 's'}`;
    botonProcesar.disabled = carrito.length === 0;

    listaCarrito.innerHTML = carrito
      .map(({ producto, cantidad, unidades }) => {
        const subtotal = producto.precio_venta * cantidad;
        const alMaximo = cantidad >= producto.stock_actual;
        const codigos = unidades.length
          ? `<div class="mt-1 flex flex-wrap gap-1">${unidades
              .map(
                (c) =>
                  `<span class="inline-flex items-center gap-1 rounded bg-slate-100 px-1.5 py-0.5 font-mono text-[10px] text-slate-600 dark:bg-slate-800 dark:text-slate-300">${escaparHtml(c)}<button type="button" data-quitar-unidad="${producto.id}" data-codigo="${escaparHtml(c)}" aria-label="Quitar la unidad ${escaparHtml(c)}" class="text-slate-400 hover:text-red-600">✕</button></span>`
              )
              .join('')}</div>`
          : '';
        return `
          <li data-linea="${producto.id}" class="px-4 py-3 sm:px-5">
            <div class="flex items-start gap-3">
              ${htmlMiniatura(producto.imagen_url, producto.nombre, 'h-12 w-12')}
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium leading-snug text-slate-900 dark:text-white">${escaparHtml(producto.nombre)}</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">${precioEnLinea(producto.precio_venta)} c/u</p>
                ${codigos}
              </div>
              <span class="shrink-0 text-right text-sm font-semibold text-slate-900 dark:text-white">${htmlPrecioDual(subtotal, tasaActual.get())}</span>
            </div>
            <div class="mt-2 flex items-center justify-between gap-3">
              <div class="flex items-center gap-1">
                <button type="button" data-restar="${producto.id}" aria-label="Quitar una unidad" class="h-10 w-10 rounded-lg border border-slate-200 text-lg leading-none text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">−</button>
                <span class="w-10 text-center text-base font-semibold text-slate-900 dark:text-white">${cantidad}</span>
                <button type="button" data-sumar="${producto.id}" ${alMaximo ? 'disabled' : ''} aria-label="Agregar una unidad" class="h-10 w-10 rounded-lg border border-slate-200 text-lg leading-none text-slate-700 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">+</button>
              </div>
              <button type="button" data-eliminar="${producto.id}" aria-label="Quitar ${escaparHtml(producto.nombre)} del carrito" class="flex items-center gap-1.5 rounded-lg border border-red-200 px-3 py-2 text-sm font-semibold text-red-600 hover:bg-red-50 dark:border-red-500/40 dark:text-red-400 dark:hover:bg-red-500/10">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14M10 11v6m4-6v6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Quitar
              </button>
            </div>
          </li>
        `;
      })
      .join('');

    const total = carrito.reduce((acc, l) => acc + l.producto.precio_venta * l.cantidad, 0);
    const tasa = tasaActual.get();
    const totalBs = tasa && carrito.length > 0 ? formatearBolivares(convertirABs(total, tasa)) : '';
    totalEl.textContent = formatearMoneda(total);
    document.getElementById('pos-total-bs')!.textContent = totalBs;

    barraContador.textContent = `${carrito.length} línea${carrito.length === 1 ? '' : 's'}`;
    barraTotal.textContent = formatearMoneda(total);
    document.getElementById('pos-barra-total-bs')!.textContent = totalBs;
    barraCobrar.disabled = carrito.length === 0;
  }

  function agregarAlCarrito(productoId: string) {
    limpiarError();
    const producto = productos.find((p) => p.id === productoId);
    if (!producto) return;

    const linea = carrito.find((l) => l.producto.id === productoId);
    const cantidadActual = linea?.cantidad ?? 0;

    if (cantidadActual + 1 > producto.stock_actual) {
      mostrarError(`No hay más stock disponible de "${producto.nombre}".`);
      return;
    }

    if (linea) linea.cantidad += 1;
    else carrito.push({ producto, cantidad: 1, unidades: [] });

    renderCarrito();
    renderResultados(buscador.value);
    destacarLinea(productoId);
  }

  /** Agrega al carrito ESA unidad (la del código escaneado o elegido en la lista). Devuelve false si no se pudo. */
  function agregarUnidad(producto: ProductoConRelaciones, codigo: string): boolean {
    limpiarError();
    if (carrito.some((l) => l.unidades.includes(codigo))) {
      mostrarError(`La unidad ${codigo} ya está en el carrito.`);
      return false;
    }
    const linea = carrito.find((l) => l.producto.id === producto.id);
    if ((linea?.cantidad ?? 0) + 1 > producto.stock_actual) {
      mostrarError(`No hay más stock disponible de "${producto.nombre}".`);
      return false;
    }
    if (linea) {
      linea.cantidad += 1;
      linea.unidades.push(codigo);
    } else {
      carrito.push({ producto, cantidad: 1, unidades: [codigo] });
    }
    renderCarrito();
    renderResultados(buscador.value);
    destacarLinea(producto.id);
    return true;
  }

  /** Quita del carrito una unidad concreta (la ✕ junto a su código). */
  function quitarUnidad(productoId: string, codigo: string) {
    limpiarError();
    const linea = carrito.find((l) => l.producto.id === productoId);
    if (!linea || !linea.unidades.includes(codigo)) return;
    linea.unidades = linea.unidades.filter((c) => c !== codigo);
    linea.cantidad -= 1;
    if (linea.cantidad <= 0) carrito = carrito.filter((l) => l !== linea);
    renderCarrito();
    renderResultados(buscador.value);
  }

  // Feedback visual: la línea tocada destella y el total "late".
  function destacarLinea(productoId: string) {
    reanimar(listaCarrito.querySelector<HTMLElement>(`[data-linea="${productoId}"]`), 'anim-destello');
    reanimar(totalEl, 'anim-pulso-valor');
    reanimar(barraTotal, 'anim-pulso-valor');
  }

  function cambiarCantidad(productoId: string, delta: number) {
    limpiarError();
    const linea = carrito.find((l) => l.producto.id === productoId);
    if (!linea) return;

    const nuevaCantidad = linea.cantidad + delta;
    // Al restar, primero salen las unidades escaneadas (la última que se agregó)
    if (delta < 0 && linea.unidades.length >= linea.cantidad) linea.unidades.pop();
    if (nuevaCantidad <= 0) {
      carrito = carrito.filter((l) => l.producto.id !== productoId);
    } else if (nuevaCantidad > linea.producto.stock_actual) {
      mostrarError(`No hay más stock disponible de "${linea.producto.nombre}".`);
      return;
    } else {
      linea.cantidad = nuevaCantidad;
    }

    renderCarrito();
    renderResultados(buscador.value);
    destacarLinea(productoId);
  }

  function eliminarDelCarrito(productoId: string) {
    limpiarError();
    carrito = carrito.filter((l) => l.producto.id !== productoId);
    renderCarrito();
    renderResultados(buscador.value);
  }

  // El ticket de la última venta, para enviarlo por WhatsApp como imagen (nota de entrega y garantía del cliente)
  let ultimaVenta: VentaRegistrada | null = null;
  // La imagen se dibuja apenas se muestra el ticket: el menú "Compartir" del teléfono exige que se abra justo al tocar el botón
  let imagenTicket: Promise<File> | null = null;

  function avisoWhatsApp(mensaje: string, error = false) {
    const aviso = document.getElementById('pos-whatsapp-aviso')!;
    aviso.textContent = mensaje;
    aviso.classList.toggle('hidden', !mensaje);
    aviso.classList.toggle('text-red-600', error);
    aviso.classList.toggle('dark:text-red-400', error);
    aviso.classList.toggle('text-slate-500', !error);
    aviso.classList.toggle('dark:text-slate-400', !error);
  }

  /** Los códigos de las unidades vendidas, debajo del nombre del producto en el ticket (identifican la pieza para la garantía). */
  function htmlCodigosUnidades(unidades: string[] | undefined): string {
    if (!unidades || unidades.length === 0) return '';
    return `<span class="mt-0.5 block font-mono text-xs leading-snug text-slate-500 dark:text-slate-400 print:text-black">${unidades.map((u) => escaparHtml(u)).join(' · ')}</span>`;
  }

  function mostrarTicket(venta: VentaRegistrada) {
    ultimaVenta = venta;
    avisoWhatsApp('');
    imagenTicket = archivoDeTicket(venta);
    imagenTicket.catch(() => {}); // si falla, se vuelve a intentar al tocar el botón y ahí sí se avisa
    document.getElementById('ticket-folio')!.textContent = venta.folio
      ? `Folio #${venta.folio.toString().padStart(4, '0')}`
      : 'Folio pendiente (se asigna al sincronizar)';
    document.getElementById('ticket-fecha')!.textContent = new Date(venta.fecha).toLocaleString('es-GT', {
      dateStyle: 'medium',
      timeStyle: 'short',
    });
    document.getElementById('ticket-cliente')!.textContent = `Cliente: ${venta.cliente_nombre} · ${venta.cliente_cedula}`;

    document.getElementById('ticket-lineas')!.innerHTML = venta.items
      .map(
        (item) => `
          <li class="flex justify-between gap-2">
            <span>${escaparHtml(item.nombre)} <span class="text-slate-400 print:text-black">x${item.cantidad}</span>${htmlCodigosUnidades(item.unidades)}</span>
            <span>${formatearMoneda(item.precio_unitario * item.cantidad)}</span>
          </li>
        `
      )
      .join('');
    document.getElementById('ticket-total')!.textContent = formatearMoneda(venta.total);
    const filaBs = document.getElementById('ticket-bs')!;
    const cobraEnBs = venta.total_bs != null;
    filaBs.classList.toggle('hidden', !cobraEnBs);
    filaBs.classList.toggle('flex', cobraEnBs);
    document.getElementById('ticket-total-bs')!.textContent = cobraEnBs ? formatearBolivares(venta.total_bs!) : '';
    document.getElementById('ticket-pagos')!.innerHTML = pagosDeVenta(venta)
      .map(
        (p) => `
          <li class="flex justify-between gap-2">
            <span>${escaparHtml(etiquetaMetodoPago(p.metodo))}</span>
            <span>${p.monto_bs != null ? `${formatearBolivares(p.monto_bs)} <span class="text-slate-400 print:text-black">(${formatearMoneda(p.monto_usd)})</span>` : formatearMoneda(p.monto_usd)}</span>
          </li>`
      )
      .join('');
    if (venta.vuelto) {
      const v = venta.vuelto;
      document.getElementById('ticket-pagos')!.insertAdjacentHTML(
        'beforeend',
        `<li class="flex justify-between gap-2 font-medium">
          <span>Vuelto (${escaparHtml(etiquetaMetodoPago(v.metodo))})</span>
          <span>−${v.monto_bs != null ? `${formatearBolivares(v.monto_bs)} <span class="text-slate-400 print:text-black">(${formatearMoneda(v.monto_usd)})</span>` : formatearMoneda(v.monto_usd)}</span>
        </li>`
      );
    }
    document.getElementById('ticket-tasa')!.textContent = venta.tasa_cambio ? `Tasa del día: ${formatearBolivares(venta.tasa_cambio)} por $1` : '';

    posApp.classList.add('hidden');
    barraMovil.classList.add('hidden');
    barraMovil.classList.remove('flex');
    ticket.classList.remove('hidden');
    reanimar(ticket, 'anim-subir');
    ticket.scrollIntoView({ behavior: 'smooth' });
  }

  const dialogoConfirmar = document.getElementById('pos-confirmar') as HTMLDialogElement;
  const formConfirmar = document.getElementById('pos-confirmar-form') as HTMLFormElement;
  const errorConfirmar = document.getElementById('pos-confirmar-error') as HTMLParagraphElement;
  const campo = (id: string) => document.getElementById(id) as HTMLInputElement & HTMLSelectElement;
  const campoNac = campo('pos-cli-nac');
  const campoCedula = campo('pos-cli-cedula');
  const campoNombre = campo('pos-cli-nombre');
  const campoApellido = campo('pos-cli-apellido');
  const campoTelefono = campo('pos-cli-telefono');
  const avisoCliente = document.getElementById('pos-cli-aviso') as HTMLParagraphElement;

  // --- Cliente que ya compró: al escribir su cédula se rellenan sus datos de la compra anterior -------------------------------
  let autollenado: { cedula: string; nombre: string; apellido: string; telefono: string } | null = null;
  let consultaCliente = 0;
  let temporizadorCliente: number | undefined;

  function limpiarAutollenado() {
    // Si los datos siguen siendo los rellenados (nadie los editó), se vacían para no dejar los de OTRO cliente
    if (autollenado && campoNombre.value === autollenado.nombre && campoApellido.value === autollenado.apellido && campoTelefono.value === autollenado.telefono) {
      campoNombre.value = '';
      campoApellido.value = '';
      campoTelefono.value = '';
    }
    autollenado = null;
    avisoCliente.classList.add('hidden');
  }

  async function buscarClienteConocido() {
    const digitos = campoCedula.value.replace(/\D/g, '');
    const cedulaCompleta = `${campoNac.value}-${digitos}`;
    if (autollenado && autollenado.cedula !== cedulaCompleta) limpiarAutollenado();
    if (!/^\d{5,9}$/.test(digitos)) return;
    const turno = ++consultaCliente;
    const cliente = await inventoryService.buscarCliente(cedulaCompleta);
    if (turno !== consultaCliente || !cliente) return; // llegó una consulta más nueva, o es un cliente nuevo
    // Solo se rellena lo que está vacío: lo que el cajero ya escribió no se pisa
    if (!campoNombre.value.trim()) campoNombre.value = cliente.nombre;
    if (!campoApellido.value.trim()) campoApellido.value = cliente.apellido;
    if (!campoTelefono.value.trim()) campoTelefono.value = cliente.telefono;
    autollenado = { cedula: cedulaCompleta, nombre: campoNombre.value, apellido: campoApellido.value, telefono: campoTelefono.value };
    avisoCliente.textContent = 'Cliente registrado: se cargaron los datos de su compra anterior. Revísalos y corrígelos si cambiaron.';
    avisoCliente.classList.remove('hidden');
  }

  function programarBusquedaCliente() {
    window.clearTimeout(temporizadorCliente);
    temporizadorCliente = window.setTimeout(() => void buscarClienteConocido(), 300);
  }

  // Formas de pago (una o varias) y vuelto: lo maneja utils/formularioPagos.ts
  const formPagos = new FormularioPagos(document.getElementById('pos-formulario-pagos')!);
  let totalAConfirmar = 0;

  // Los datos del cliente solo viven mientras dura la venta (se borran al cobrar).
  function limpiarDatosCliente() {
    for (const c of [campoCedula, campoNombre, campoApellido, campoTelefono]) c.value = '';
    campoNac.value = 'V';
    autollenado = null;
    avisoCliente.classList.add('hidden');
    errorConfirmar.classList.add('hidden');
    formPagos.reiniciar();
  }

  const fallar = (mensaje: string, el: HTMLElement | null | undefined) => {
    errorConfirmar.textContent = mensaje;
    errorConfirmar.classList.remove('hidden');
    el?.focus();
    return null;
  };

  /** Los datos del cliente ya validados, o muestra el primer error y devuelve null. */
  function validarCliente(): ClienteVenta | null {
    const cedula = campoCedula.value.replace(/\D/g, '');
    const nombre = campoNombre.value.trim().replace(/\s+/g, ' ');
    const apellido = campoApellido.value.trim().replace(/\s+/g, ' ');
    const telefono = campoTelefono.value.trim();
    const patronNombre = /^[\p{L}][\p{L} '.-]*$/u;

    if (!/^\d{5,9}$/.test(cedula)) return fallar('La cédula debe tener entre 5 y 9 dígitos (solo números).', campoCedula);
    if (nombre.length < 2 || !patronNombre.test(nombre)) return fallar('Escribe el nombre del cliente.', campoNombre);
    if (apellido.length < 2 || !patronNombre.test(apellido)) return fallar('Escribe el apellido del cliente.', campoApellido);
    const digitos = telefono.replace(/\D/g, '');
    if (!/^[\d\s+()-]+$/.test(telefono) || digitos.length < 10 || digitos.length > 13) {
      return fallar('El teléfono debe tener entre 10 y 13 dígitos (ej. 0414-1234567).', campoTelefono);
    }

    errorConfirmar.classList.add('hidden');
    return { cedula: `${campoNac.value}-${cedula}`, nombre: `${nombre} ${apellido}`, apellido, telefono };
  }

  /** Devuelve los datos del cliente y los pagos ya validados, o muestra el primer error y devuelve null. */
  function leerDatosCliente(): { cliente: ClienteVenta; pagos: PagoVenta[]; vuelto: DineroEntregado | null } | null {
    const cliente = validarCliente();
    if (!cliente) {
      irAlPaso('cliente'); // el error estaba en los datos del cliente: se vuelve a ese paso
      validarCliente();
      return null;
    }
    const lectura = formPagos.leer();
    if (!lectura.ok) return fallar(lectura.mensaje, lectura.foco);
    errorConfirmar.classList.add('hidden');
    return { cliente, pagos: lectura.pagos, vuelto: lectura.vuelto };
  }

  /** Paso previo: muestra el resumen y pide los datos del cliente; la venta solo se registra al confirmar. */
  function pedirConfirmacion() {
    if (carrito.length === 0 || dialogoConfirmar.open) return;
    const unidades = carrito.reduce((suma, l) => suma + l.cantidad, 0);
    const total = carrito.reduce((suma, l) => suma + l.producto.precio_venta * l.cantidad, 0);

    document.getElementById('pos-confirmar-resumen')!.textContent =
      `${carrito.length} línea${carrito.length === 1 ? '' : 's'} · ${unidades} unidad${unidades === 1 ? '' : 'es'}`;
    document.getElementById('pos-confirmar-total')!.textContent = formatearMoneda(total);
    totalAConfirmar = total;
    formPagos.establecerTotal(total);
    const tasaDia = tasaActual.get();
    document.getElementById('pos-confirmar-total-bs')!.textContent = tasaDia ? `≈ ${formatearBolivares(convertirABs(total, tasaDia))} (tasa ${formatearBolivares(tasaDia)})` : '';
    document.getElementById('pos-confirmar-lineas')!.innerHTML = carrito
      .map(
        ({ producto, cantidad }) => `
          <li class="flex items-center justify-between gap-3 px-3 py-2">
            <span class="min-w-0 flex-1 truncate text-slate-700 dark:text-slate-300">${cantidad} × ${escaparHtml(producto.nombre)}</span>
            <span class="shrink-0 font-medium text-slate-900 dark:text-white">${formatearMoneda(producto.precio_venta * cantidad)}</span>
          </li>`
      )
      .join('');

    errorConfirmar.classList.add('hidden');
    // Pasos: si falta escanear alguna unidad, primero eso; después los datos del cliente y, al final, el cobro
    pasos = pendientesDeEscanear().length > 0 ? ['escaneo', 'cliente', 'pago'] : ['cliente', 'pago'];
    pasoActual = 0;
    pintarPasos();
    dialogoConfirmar.showModal();
    enfocarPaso();
  }

  function pedirConfirmacionActualiza() {
    const tasaDia = tasaActual.get();
    document.getElementById('pos-confirmar-total-bs')!.textContent = tasaDia ? `≈ ${formatearBolivares(convertirABs(totalAConfirmar, tasaDia))} (tasa ${formatearBolivares(tasaDia)})` : '';
    formPagos.refrescar();
  }

  document.getElementById('pos-confirmar-no')!.addEventListener('click', () => {
    if (pasoActual > 0) retroceder();
    else dialogoConfirmar.close();
  });
  // Clic en el fondo oscuro = cancelar (los datos escritos se conservan si se reabre)
  dialogoConfirmar.addEventListener('click', (e) => {
    if (e.target === dialogoConfirmar) dialogoConfirmar.close();
  });
  formConfirmar.addEventListener('input', () => errorConfirmar.classList.add('hidden'));
  campoCedula.addEventListener('input', () => {
    campoCedula.value = campoCedula.value.replace(/\D/g, '');
    programarBusquedaCliente();
  });
  campoNac.addEventListener('change', programarBusquedaCliente);
  formConfirmar.addEventListener('submit', (e) => {
    e.preventDefault();
    const paso = pasos[pasoActual];
    if (paso === 'escaneo') {
      if (pendientesDeEscanear().length === 0) avanzar();
      return;
    }
    if (paso === 'cliente') {
      if (validarCliente()) avanzar();
      return;
    }
    const datos = leerDatosCliente();
    if (!datos) return;
    dialogoConfirmar.close();
    procesarVenta(datos);
  });

  async function procesarVenta(datos: { cliente: ClienteVenta; pagos: PagoVenta[]; vuelto: DineroEntregado | null }) {
    if (carrito.length === 0) return;
    limpiarError();
    const tasa = tasaActual.get();
    if (!tasa) {
      mostrarError('Falta la tasa del dólar del día. Regístrala para poder vender.');
      window.dispatchEvent(new Event('easystem:abrir-tasa'));
      return;
    }
    botonProcesar.disabled = true;
    botonProcesar.textContent = 'Procesando...';
    barraCobrar.disabled = true;

    try {
      const items: VentaItem[] = carrito.map((l) => ({
        producto_id: l.producto.id,
        nombre: l.producto.nombre,
        codigo_barras: l.producto.codigo_barras,
        cantidad: l.cantidad,
        precio_unitario: l.producto.precio_venta,
        unidades: l.unidades.length ? [...l.unidades] : undefined,
      }));
      const sesion = await obtenerSesionActual();
      const venta = await inventoryService.registrarVenta(items, { ...datos, tasa_cambio: tasa, vendedor_nombre: sesion?.nombre });
      mostrarTicket(venta);
      carrito = [];
      limpiarDatosCliente();
      await cargarProductos();
    } catch (err) {
      if (err instanceof inventoryService.VentaIncompletaError) {
        // Esas líneas ya salieron del inventario: se quitan del carrito para no cobrarlas dos veces.
        carrito = carrito.filter((l) => !err.productosRegistrados.includes(l.producto.id));
        if (carrito.length === 0) limpiarDatosCliente();
        else formPagos.reiniciar(); // el total cambió: hay que volver a repartir los pagos
        await cargarProductos();
        renderCarrito();
      }
      mostrarError(err instanceof Error ? err.message : 'No se pudo procesar la venta.');
      // Si el rechazo fue por una unidad que otro dispositivo ya vendió, se identifica y se quita del carrito
      if (!(err instanceof inventoryService.VentaIncompletaError)) await revalidarUnidadesCarrito();
    } finally {
      botonProcesar.textContent = 'Procesar venta';
      botonProcesar.disabled = carrito.length === 0;
      barraCobrar.disabled = carrito.length === 0;
    }
  }

  // La tasa cambió: recalcula todos los Bs. visibles (y el monto a cobrar si el diálogo está abierto)
  tasaActual.listen(() => {
    renderResultados(buscador.value);
    renderCarrito();
    if (dialogoConfirmar.open) {
      pedirConfirmacionActualiza();
    }
  });

  function iniciarNuevaVenta() {
    ticket.classList.add('hidden');
    posApp.classList.remove('hidden');
    barraMovil.classList.remove('hidden');
    barraMovil.classList.add('flex');
    renderCarrito();
    renderResultados(buscador.value);
    enfocarCodigo();
  }

  /** En el computador el cursor queda listo para el lector; en el teléfono no se abre el teclado solo. */
  function enfocarCodigo() {
    if (window.matchMedia('(pointer: fine)').matches) campoCodigo.focus();
  }

  let primeraCarga = true;

  async function cargarProductos() {
    productos = await inventoryService.listarProductos();
    cargando.classList.add('hidden');
    if (primeraCarga) {
      primeraCarga = false;
      animarLista(resultados);
    }
    ajustarCarritoAlStock();
    await revalidarUnidadesCarrito();
    renderResultados(buscador.value);
  }

  /**
   * Las unidades escaneadas siguen siendo suyas solo mientras estén DISPONIBLES: si otro dispositivo ya vendió alguna,
   * se quita del carrito con un aviso (así la venta no se rechaza al cobrar). Sin conexión no se puede comprobar.
   */
  async function revalidarUnidadesCarrito() {
    const codigos = carrito.flatMap((l) => l.unidades);
    if (codigos.length === 0) return;
    let disponibles: UnidadProducto[];
    try {
      disponibles = await inventoryService.listarUnidades({ estado: 'DISPONIBLE', codigos });
    } catch {
      return;
    }
    const vigentes = new Set(disponibles.map((u) => u.codigo));
    const perdidas = codigos.filter((c) => !vigentes.has(c));
    if (perdidas.length === 0) return;
    for (const linea of [...carrito]) {
      const sueltas = linea.unidades.filter((c) => perdidas.includes(c));
      if (sueltas.length === 0) continue;
      linea.unidades = linea.unidades.filter((c) => !perdidas.includes(c));
      linea.cantidad -= sueltas.length;
      if (linea.cantidad <= 0) carrito = carrito.filter((l) => l !== linea);
    }
    renderCarrito();
    mostrarError(`La unidad ${perdidas.join(', ')} ya no está disponible (otro dispositivo la vendió) y se quitó del carrito.`);
  }

  /**
   * Con el stock recién traído (p. ej. otro dispositivo vendió el mismo producto), cada línea del carrito pasa a
   * apuntar al producto actualizado y, si ya no alcanza, se baja la cantidad (o se quita) avisando al cajero.
   */
  function ajustarCarritoAlStock() {
    const avisos: string[] = [];
    for (const linea of [...carrito]) {
      const actual = productos.find((p) => p.id === linea.producto.id);
      if (!actual) {
        carrito = carrito.filter((l) => l !== linea);
        avisos.push(`"${linea.producto.nombre}" ya no está disponible y se quitó del carrito.`);
        continue;
      }
      linea.producto = actual;
      if (linea.cantidad > actual.stock_actual) {
        if (actual.stock_actual <= 0) {
          carrito = carrito.filter((l) => l !== linea);
          avisos.push(`Se agotó "${actual.nombre}" (otro dispositivo lo vendió) y se quitó del carrito.`);
        } else {
          linea.cantidad = actual.stock_actual;
          linea.unidades = linea.unidades.slice(0, linea.cantidad);
          avisos.push(`Solo quedan ${actual.stock_actual} de "${actual.nombre}": se ajustó la cantidad del carrito.`);
        }
      }
    }
    if (avisos.length > 0) {
      renderCarrito();
      mostrarError(avisos.join(' '));
    }
  }

  /** Actualización en vivo: no toca nada mientras haya una ventana abierta (confirmar venta, ticket...), para no cambiar un total a mitad del cobro. */
  async function refrescarEnVivo() {
    while (document.querySelector('dialog[open]')) await new Promise((r) => setTimeout(r, 1500));
    await cargarProductos();
  }

  // Delegación de eventos: los botones de resultados/carrito se regeneran en cada render
  resultados.addEventListener('click', (e) => {
    const boton = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-agregar]');
    if (boton?.dataset.agregar) agregarAlCarrito(boton.dataset.agregar);
  });

  listaCarrito.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;
    const quitar = objetivo.closest<HTMLButtonElement>('[data-quitar-unidad]');
    if (quitar?.dataset.quitarUnidad && quitar.dataset.codigo) return quitarUnidad(quitar.dataset.quitarUnidad, quitar.dataset.codigo);
    const sumar = objetivo.closest<HTMLButtonElement>('[data-sumar]');
    const restar = objetivo.closest<HTMLButtonElement>('[data-restar]');
    const eliminar = objetivo.closest<HTMLButtonElement>('[data-eliminar]');
    if (sumar?.dataset.sumar) cambiarCantidad(sumar.dataset.sumar, 1);
    else if (restar?.dataset.restar) cambiarCantidad(restar.dataset.restar, -1);
    else if (eliminar?.dataset.eliminar) eliminarDelCarrito(eliminar.dataset.eliminar);
  });

  buscador.addEventListener('input', () => renderResultados(buscador.value));

  /** Busca un código de barras exacto (tecleado + Enter, lector físico USB, o cámara) y lo agrega al carrito. */
  async function buscarYAgregarPorCodigo(codigo: string) {
    const coincidenciaLocal = productos.find((p) => p.codigo_barras === codigo);
    if (!coincidenciaLocal) {
      mostrarError(`No se encontró ningún producto con el código "${codigo}".`);
      return;
    }

    // Relee el producto por si su stock cambió desde otra sesión/pestaña
    const fresco = await inventoryService.obtenerProductoPorCodigoBarras(codigo);
    if (fresco) {
      productos = productos.map((p) => (p.id === fresco.id ? fresco : p));
      agregarAlCarrito(fresco.id);
      buscador.value = '';
      renderResultados('');
    }
  }

  buscador.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const codigo = buscador.value.trim();
    if (codigo) void agregarPorCodigo(codigo).then((agregado) => agregado && (buscador.value = ''));
  });

  /**
   * Agrega lo que identifica un código: el de UNA unidad (etiqueta propia: se agrega esa unidad exacta) o, como
   * respaldo, el código del producto (empaque de fábrica: se agrega una unidad cualquiera). Devuelve si se agregó.
   */
  async function agregarPorCodigo(codigoCrudo: string, aceptarNumeroCorto = false): Promise<boolean> {
    limpiarError();
    // En el campo del lector, escribir solo el número de la etiqueta ("N.º 7" → 7) equivale a escanearla
    const codigo = (aceptarNumeroCorto ? codigoDeNumeroCorto(codigoCrudo) : null) ?? codigoCrudo.trim();
    if (!codigo) return false;
    if (!esCodigoUnidad(codigo)) {
      const antes = carrito.reduce((suma, l) => suma + l.cantidad, 0);
      await buscarYAgregarPorCodigo(codigo);
      return carrito.reduce((suma, l) => suma + l.cantidad, 0) > antes;
    }

    let unidad: UnidadProducto | null;
    try {
      unidad = await inventoryService.obtenerUnidadPorCodigo(codigo);
    } catch {
      mostrarError('No se pudo consultar ese código (¿sin conexión?). Busca el producto por nombre o modelo.');
      return false;
    }
    if (!unidad) {
      mostrarError(`El código ${codigo} no corresponde a ninguna unidad registrada.`);
      return false;
    }
    if (localActivoId && unidad.local_id !== localActivoId) {
      mostrarError(`La unidad ${codigo} pertenece a otro local: no se puede vender desde este.`);
      return false;
    }
    if (unidad.estado === 'VENDIDA') {
      mostrarError(`La unidad ${codigo} ya fue vendida.`);
      return false;
    }
    const producto = productos.find((p) => p.id === unidad!.producto_id);
    if (!producto) {
      mostrarError('Esa unidad pertenece a un producto que este local no maneja.');
      return false;
    }
    return agregarUnidad(producto, codigo);
  }

  campoCodigo.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    const codigo = campoCodigo.value;
    if (!codigo.trim()) return;
    void agregarPorCodigo(codigo, true).then((agregado) => {
      if (agregado) campoCodigo.value = '';
      campoCodigo.select();
    });
  });

  // Escaneo con cámara (ver src/components/CamaraEscaner.astro): agrega directo al carrito.
  window.addEventListener('easystem:codigo-escaneado', ((e: CustomEvent<{ codigo: string }>) => {
    if (escaneoAbierto()) {
      void registrarEscaneo(e.detail.codigo);
      return;
    }
    void agregarPorCodigo(e.detail.codigo);
  }) as EventListener);

  // --- Seleccionar código: producto → unidades disponibles ------------------------------------------------
  const dialogoSelector = document.getElementById('pos-selector') as HTMLDialogElement;
  const selBuscar = document.getElementById('pos-selector-buscar') as HTMLInputElement;
  const selLista = document.getElementById('pos-selector-lista') as HTMLUListElement;
  const selAyuda = document.getElementById('pos-selector-ayuda') as HTMLParagraphElement;
  const selVolver = document.getElementById('pos-selector-volver') as HTMLButtonElement;
  let selProducto: ProductoConRelaciones | null = null;
  let selUnidades: UnidadProducto[] = [];

  function pintarSelectorProductos() {
    const lista = filtrarProductos(selBuscar.value).filter((p) => p.stock_actual > 0);
    selLista.innerHTML = lista.length
      ? lista
          .slice(0, 40)
          .map(
            (p) => `
          <li>
            <button type="button" data-sel-producto="${p.id}" class="flex w-full items-center gap-3 px-5 py-3 text-left hover:bg-slate-50 dark:hover:bg-slate-800">
              ${htmlMiniatura(p.imagen_url, p.nombre, 'h-10 w-10')}
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-medium text-slate-900 dark:text-white">${escaparHtml(p.nombre)}</span>
                <span class="block truncate text-xs text-slate-500 dark:text-slate-400">${escaparHtml(p.categoria)} · ${precioEnLinea(p.precio_venta)}</span>
              </span>
              <span class="shrink-0 text-xs text-slate-500 dark:text-slate-400">${p.stock_actual} u.</span>
            </button>
          </li>`
          )
          .join('')
      : '<li class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">No hay productos con stock que coincidan.</li>';
  }

  function pintarSelectorUnidades() {
    if (!selProducto) return;
    const q = selBuscar.value.trim();
    const enCarrito = new Set(carrito.flatMap((l) => l.unidades));
    const lista = selUnidades.filter((u) => !q || u.codigo.includes(q));
    selLista.innerHTML = lista.length
      ? lista
          .map((u) => {
            const tomada = enCarrito.has(u.codigo);
            return `
          <li class="flex items-center justify-between gap-3 px-5 py-2.5">
            <span class="min-w-0">
              <span class="block font-mono text-sm text-slate-900 dark:text-white">${escaparHtml(u.codigo)}</span>
              ${u.impresa_en ? '' : '<span class="block text-[11px] text-amber-600 dark:text-amber-400">Aún sin etiqueta impresa</span>'}
            </span>
            <button type="button" data-sel-unidad="${escaparHtml(u.codigo)}" ${tomada ? 'disabled' : ''} class="shrink-0 rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:dark:bg-slate-700">${tomada ? 'En el carrito' : '+ Agregar'}</button>
          </li>`;
          })
          .join('')
      : `<li class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">${selUnidades.length ? 'Ningún código coincide.' : 'Este producto no tiene unidades disponibles.'}</li>`;
  }

  async function elegirProductoDelSelector(id: string) {
    const producto = productos.find((p) => p.id === id);
    if (!producto) return;
    selProducto = producto;
    selBuscar.value = '';
    selBuscar.placeholder = 'Filtrar por código (ej. los últimos dígitos)...';
    selBuscar.inputMode = 'numeric';
    selVolver.classList.remove('hidden');
    selAyuda.textContent = `${producto.nombre}: elige la unidad que vas a vender.`;
    selLista.innerHTML = '<li class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">Cargando unidades...</li>';
    try {
      selUnidades = await inventoryService.listarUnidades({ productoId: id, estado: 'DISPONIBLE' });
    } catch {
      selUnidades = [];
      selLista.innerHTML = '<li class="px-5 py-6 text-sm text-red-600 dark:text-red-400">No se pudieron cargar las unidades (¿sin conexión?).</li>';
      return;
    }
    pintarSelectorUnidades();
  }

  function volverAProductos() {
    selProducto = null;
    selBuscar.value = '';
    selBuscar.placeholder = 'Nombre, categoría o modelo...';
    selBuscar.inputMode = 'text';
    selVolver.classList.add('hidden');
    selAyuda.textContent = 'Busca el producto y elige la unidad que vas a vender.';
    pintarSelectorProductos();
    selBuscar.focus();
  }

  document.getElementById('pos-seleccionar-codigo')!.addEventListener('click', () => {
    limpiarError();
    volverAProductos();
    dialogoSelector.showModal();
  });
  document.getElementById('pos-selector-cerrar')!.addEventListener('click', () => dialogoSelector.close());
  document.getElementById('pos-selector-listo')!.addEventListener('click', () => dialogoSelector.close());
  dialogoSelector.addEventListener('click', (e) => {
    if (e.target === dialogoSelector) dialogoSelector.close();
  });
  dialogoSelector.addEventListener('close', enfocarCodigo);
  selVolver.addEventListener('click', volverAProductos);
  selBuscar.addEventListener('input', () => (selProducto ? pintarSelectorUnidades() : pintarSelectorProductos()));
  selLista.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;
    const producto = objetivo.closest<HTMLElement>('[data-sel-producto]')?.dataset.selProducto;
    if (producto) return void elegirProductoDelSelector(producto);
    const codigo = objetivo.closest<HTMLElement>('[data-sel-unidad]')?.dataset.selUnidad;
    if (codigo && selProducto && agregarUnidad(selProducto, codigo)) pintarSelectorUnidades();
  });

  // --- Pasos de "Procesar venta": 1) escanear el QR de cada unidad, 2) datos del cliente, 3) cobro ---------------------------
  type Paso = 'escaneo' | 'cliente' | 'pago';
  const TITULO_PASO: Record<Paso, string> = { escaneo: 'Escanea lo que vas a vender', cliente: 'Datos del cliente', pago: 'Cobro' };
  let pasos: Paso[] = ['cliente', 'pago'];
  let pasoActual = 0;

  const listaEscaneo = document.getElementById('pos-escaneo-lista') as HTMLUListElement;
  const campoEscaneo = document.getElementById('pos-escaneo-codigo') as HTMLInputElement;
  const errorEscaneo = document.getElementById('pos-escaneo-error') as HTMLParagraphElement;
  const botonSinConexion = document.getElementById('pos-escaneo-sinconexion') as HTMLButtonElement;
  const botonSiguiente = document.getElementById('pos-confirmar-si') as HTMLButtonElement;
  const botonAtras = document.getElementById('pos-confirmar-no') as HTMLButtonElement;
  const escaneoAbierto = () => dialogoConfirmar.open && pasos[pasoActual] === 'escaneo';

  /** Líneas del carrito con unidades todavía sin escanear. */
  const pendientesDeEscanear = () => carrito.filter((l) => l.unidades.length < l.cantidad);

  function pintarEscaneo() {
    listaEscaneo.innerHTML = carrito
      .map((l) => {
        const hecho = l.unidades.length >= l.cantidad;
        const chips = l.unidades.map((c) => `<span class="rounded bg-emerald-50 px-1.5 py-0.5 font-mono text-[10px] text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300">${escaparHtml(c)}</span>`).join(' ');
        return `<li class="flex items-center justify-between gap-3 px-3 py-2">
          <div class="min-w-0"><p class="font-medium">${escaparHtml(l.producto.nombre)}</p><div class="mt-1 flex flex-wrap gap-1">${chips}</div></div>
          <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-semibold ${hecho ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-300' : 'bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300'}">${hecho ? 'Listo' : `${l.unidades.length} de ${l.cantidad}`}</span>
        </li>`;
      })
      .join('');
  }

  /** Muestra solo la sección del paso actual y ajusta el encabezado, la barra de avance y los botones. */
  function pintarPasos() {
    const paso = pasos[pasoActual];
    for (const seccion of dialogoConfirmar.querySelectorAll<HTMLElement>('[data-paso]')) seccion.classList.toggle('hidden', seccion.dataset.paso !== paso);
    document.getElementById('pos-confirmar-resumen')!.textContent = `Paso ${pasoActual + 1} de ${pasos.length} · ${TITULO_PASO[paso]}`;
    document.getElementById('pos-pasos')!.innerHTML = pasos
      .map((_, i) => `<li class="h-1.5 flex-1 rounded-full ${i <= pasoActual ? 'bg-brand-600' : 'bg-slate-200 dark:bg-slate-700'}"></li>`)
      .join('');
    // La lista de productos y el aviso de stock solo en el cobro; el total, siempre
    document.getElementById('pos-confirmar-lineas')!.classList.toggle('hidden', paso !== 'pago');
    document.getElementById('pos-confirmar-nota')!.classList.toggle('hidden', paso !== 'pago');
    errorConfirmar.classList.add('hidden');
    errorEscaneo.classList.add('hidden');
    botonSinConexion.classList.toggle('hidden', !(paso === 'escaneo' && navigator.onLine === false));

    const ultimo = pasoActual === pasos.length - 1;
    botonAtras.textContent = pasoActual === 0 ? 'Cancelar' : 'Atrás';
    botonSiguiente.textContent = ultimo ? 'Sí, procesar venta' : 'Siguiente';
    botonSiguiente.disabled = paso === 'escaneo' && pendientesDeEscanear().length > 0;
    if (paso === 'escaneo') pintarEscaneo();
  }

  function enfocarPaso() {
    const paso = pasos[pasoActual];
    // En el POS la pistola lectora escribe y manda Enter: el foco va siempre al campo del paso
    (paso === 'escaneo' ? campoEscaneo : paso === 'cliente' ? campoCedula : null)?.focus();
  }

  function irAlPaso(paso: Paso) {
    const i = pasos.indexOf(paso);
    if (i < 0 || i === pasoActual) return;
    pasoActual = i;
    pintarPasos();
    enfocarPaso();
  }
  function avanzar() {
    if (pasoActual >= pasos.length - 1) return;
    pasoActual += 1;
    pintarPasos();
    enfocarPaso();
  }
  function retroceder() {
    if (pasoActual <= 0) return;
    pasoActual -= 1;
    pintarPasos();
    enfocarPaso();
  }

  function errorDeEscaneo(mensaje: string, red = false) {
    errorEscaneo.textContent = mensaje;
    errorEscaneo.classList.remove('hidden');
    botonSinConexion.classList.toggle('hidden', !red && navigator.onLine !== false);
  }

  /** Procesar venta: abre el diálogo en su primer paso (escanear lo pendiente, o directamente los datos del cliente). */
  function iniciarCobro() {
    if (carrito.length === 0 || dialogoConfirmar.open) return;
    pedirConfirmacion();
  }

  function terminarEscaneoSiCompleto() {
    pintarEscaneo();
    botonSiguiente.disabled = pendientesDeEscanear().length > 0;
    if (pendientesDeEscanear().length > 0) return;
    renderCarrito();
    avanzar(); // todo escaneado: se pasa solo a los datos del cliente
  }

  /** Un código escaneado (o escrito) durante este paso: debe ser de una unidad de lo que se está vendiendo y que aún no se escaneó. */
  async function registrarEscaneo(codigoCrudo: string): Promise<boolean> {
    errorEscaneo.classList.add('hidden');
    const codigo = codigoDeNumeroCorto(codigoCrudo) ?? codigoCrudo.trim();
    if (!codigo) return false;
    if (!esCodigoUnidad(codigo)) {
      errorDeEscaneo('Escanea el QR de la etiqueta de la unidad (no el código del empaque de fábrica).');
      return false;
    }
    if (carrito.some((l) => l.unidades.includes(codigo))) {
      errorDeEscaneo(`La unidad ${codigo} ya está en esta venta.`);
      return false;
    }
    let unidad: UnidadProducto | null;
    try {
      unidad = await inventoryService.obtenerUnidadPorCodigo(codigo);
    } catch (err) {
      errorDeEscaneo('No se pudo consultar ese código (¿sin conexión?).', esErrorDeRed(err));
      return false;
    }
    if (!unidad) {
      errorDeEscaneo(`El código ${codigo} no corresponde a ninguna unidad registrada.`);
      return false;
    }
    if (localActivoId && unidad.local_id !== localActivoId) {
      errorDeEscaneo(`La unidad ${codigo} pertenece a otro local: no se puede vender desde este.`);
      return false;
    }
    if (unidad.estado === 'VENDIDA') {
      errorDeEscaneo(`La unidad ${codigo} ya fue vendida.`);
      return false;
    }
    const linea = carrito.find((l) => l.producto.id === unidad!.producto_id && l.unidades.length < l.cantidad);
    if (!linea) {
      const enCarrito = carrito.find((l) => l.producto.id === unidad!.producto_id);
      const nombre = enCarrito?.producto.nombre ?? productos.find((p) => p.id === unidad!.producto_id)?.nombre ?? 'otro producto';
      errorDeEscaneo(
        enCarrito
          ? `Ya escaneaste todas las unidades de «${nombre}» de esta venta.`
          : `Esa unidad es de «${nombre}», que no está en esta venta. Escanea solo lo que vas a vender.`
      );
      return false;
    }
    linea.unidades.push(codigo);
    terminarEscaneoSiCompleto();
    return true;
  }

  campoEscaneo.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    e.stopPropagation();
    void registrarEscaneo(campoEscaneo.value).then((ok) => {
      if (ok) campoEscaneo.value = '';
      else campoEscaneo.select();
    });
  });
  // Sin conexión no se puede reconocer cada unidad: se deja vender y el sistema asigna las unidades más antiguas (como antes)
  botonSinConexion.addEventListener('click', () => avanzar());

  // Móvil: el carrito queda debajo de los productos; estos botones llevan hasta él (para cambiar cantidades o quitar productos)
  const irAlCarrito = () => document.getElementById('pos-carrito-seccion')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  document.getElementById('pos-barra-ver')?.addEventListener('click', irAlCarrito);
  document.getElementById('pos-barra-carrito')?.addEventListener('click', irAlCarrito);

  botonProcesar.addEventListener('click', iniciarCobro);
  barraCobrar.addEventListener('click', iniciarCobro);
  document.getElementById('pos-imprimir')?.addEventListener('click', () => window.print());
  document.getElementById('pos-nueva-venta')?.addEventListener('click', iniciarNuevaVenta);

  // Manda el ticket como IMAGEN: abre el menú "Compartir" del teléfono (el cajero elige WhatsApp y el chat del cliente y toca "Enviar").
  // Una computadora no tiene ese menú: se descarga la imagen y se abre el chat del cliente para adjuntarla.
  document.getElementById('pos-whatsapp')?.addEventListener('click', async () => {
    if (!ultimaVenta) return;
    const boton = document.getElementById('pos-whatsapp') as HTMLButtonElement;
    boton.disabled = true;
    try {
      const archivo = await (imagenTicket ??= archivoDeTicket(ultimaVenta));
      if (puedeCompartirArchivos([archivo])) {
        await compartirArchivos([archivo], 'Ticket de venta · Edward Accesorios');
        avisoWhatsApp(`En WhatsApp elige el chat de ${ultimaVenta.cliente_nombre} (${ultimaVenta.cliente_telefono}).`);
      } else {
        descargarArchivos([archivo]);
        const chat = urlWhatsApp(ultimaVenta.cliente_telefono);
        if (chat) window.open(chat, '_blank', 'noopener');
        avisoWhatsApp(chat ? 'La imagen del ticket se descargó: adjúntala en el chat de WhatsApp del cliente.' : 'La imagen del ticket se descargó. El teléfono del cliente no parece válido para abrir su chat.');
      }
    } catch (err) {
      imagenTicket = null;
      avisoWhatsApp(err instanceof Error ? err.message : 'No se pudo preparar la imagen del ticket.', true);
    } finally {
      boton.disabled = false;
    }
  });

  // El POS vende desde UN local: en la vista "Todos los locales" del administrador se pide elegir uno
  inventoryService.obtenerContextoLocal().then((contexto) => {
    if (contexto?.local) {
      localActivoId = contexto.local.id;
      cargarProductos();
      enfocarCodigo();
      // Otro dispositivo vendió o ingresó mercancía: el stock se actualiza solo y el carrito se ajusta
      alCambiarDatos(['inventario_local', 'productos', 'compatibilidades', 'unidades_producto'], refrescarEnVivo);
      return;
    }
    cargando.classList.add('hidden');
    posApp.classList.add('hidden');
    barraMovil.classList.add('hidden');
    barraMovil.classList.remove('flex');
    const aviso = document.getElementById('pos-sin-local')!;
    aviso.classList.remove('hidden');
    if (contexto && contexto.alcance === null) {
      aviso.querySelector('p')!.textContent = 'Tu usuario no tiene un local asignado';
      aviso.querySelectorAll('p')[1].textContent = 'Pídele al administrador que te asigne uno para poder vender.';
    }
  });
</script>
