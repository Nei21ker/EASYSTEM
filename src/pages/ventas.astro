<script>
  import * as inventoryService from '../lib/inventoryService';
  import type { VentaRegistrada } from '../lib/inventoryService';
  import { esGerencia, obtenerSesionActual } from '../lib/auth';
  import { etiquetaMetodoPago, incluyePagoMovil, METODOS_PAGO, pagosDeVenta } from '../utils/pagos';
  import { FormularioPagos } from '../utils/formularioPagos';
  import { tasaActual } from '../stores/tasa';
  import { convertirABs, estadoStock, formatearBolivares, formatearMoneda, htmlPrecioDual } from '../utils/format';
  import { tienePrecioEnBs } from '../utils/precioBs';
  import { animarLista, reanimar } from '../utils/animaciones';
import { alCambiarDatos } from '../lib/realtime';
  import { htmlMiniatura } from '../utils/imagenes';
  import { codigoVisible, esCodigoUnidad, normalizarCodigoUnidad, normalizarReferencia, prefijoDelCodigo } from '../utils/codigos';
  import { esPorCantidad, UMBRAL_CLAVE_DANADOS } from '../utils/controlPorCantidad';
  import { MOTIVOS_MERMA, type MotivoMerma } from '../types/database.types';
  import { normalizarPromotor, separarNombreCompleto, unirNombre } from '../utils/promotor';
  import { montarSelectorPromotor, partirCedula } from '../utils/selectorPromotor';
  import { errorPrecioInstalacion, hayInstalacionDelPromotor, INSTALACION_PREDETERMINADA_USD, montoInstalacion, totalLinea, type QuienInstala } from '../utils/instalacion';
  import { esErrorDeRed } from '../utils/red';
  import { alertaUnidadNoVendible, type AlertaUnidad } from '../utils/unidadesVenta';
  import { urlWhatsApp } from '../utils/ticketWhatsApp';
  import { esClienteSinDatos } from '../utils/clienteSinDatos';
  import { archivoDeTicket, copiarImagenAlPortapapeles } from '../utils/ticketImagen';
  import { compartirArchivos, descargarArchivos, puedeCompartirArchivos } from '../utils/etiquetaImagen';
  import type { AutorizacionPrecio, ClienteVenta, DatosPromotor, DineroEntregado, MetodoPago, ModoPrecio, PagoVenta, Pendiente, ProductoConRelaciones, UnidadProducto, VentaItem } from '../types/database.types';

  interface LineaCarrito {
    producto: ProductoConRelaciones;
    cantidad: number;
    /** Unidades concretas escaneadas o elegidas (cada una con su código); el resto de la cantidad sale por orden de llegada */
    unidades: string[];
    /** Precio modificado y autorizado por un supervisor (mayor al del catálogo: promotor; menor: descuento); si no hay, se cobra el del catálogo */
    precioPromotor?: number;
    /** Precio de catálogo que tenía el producto cuando se autorizó (si el catálogo cambia después, la autorización ya no vale) */
    listaAutorizada?: number;
    /** Solo productos por cantidad: piezas defectuosas que se botan en esta venta y NO se cobran (aparte de `cantidad`, que sí se cobra) */
    danados?: number;
    /** Motivo opcional de esas piezas defectuosas */
    danadosMotivo?: MotivoMerma | null;
    /** Instalación del vidrio (Local Vidrios): quién la hace y su precio POR UNIDAD; se suma al total de la línea */
    instalacion?: { por: QuienInstala; usd: number };
  }

  /** Lo que sale del stock por esa línea: lo que se cobra más lo que se bota */
  const ocupadas = (l: LineaCarrito): number => l.cantidad + (l.danados ?? 0);
  const totalDanadosCarrito = (): number => carrito.reduce((suma, l) => suma + (l.danados ?? 0), 0);
  /** Solo el encargado, el gerente y el administrador marcan piezas defectuosas (el servidor lo vuelve a exigir) */
  let puedeMarcarDanados = false;
  /** La clave de un gerente o administrador para botar 3 o más piezas defectuosas; cubre hasta `cantidad` en total (dura 20 minutos) */
  let autorizacionDanados: { token: string; vence_en: number; autorizado_por: string; cantidad: number } | null = null;

  let productos: ProductoConRelaciones[] = [];
  let carrito: LineaCarrito[] = [];
  // Precio de promotor: UN promotor por venta y la autorización firmada que cubre los precios de las líneas modificadas
  let promotorVenta: { datos: DatosPromotor; nombre: string } | null = null;
  let autorizacionPrecio: AutorizacionPrecio | null = null;
  /** Lo que se cobra por unidad de esa línea (el del catálogo, o el de promotor si lo autorizó un supervisor) */
  const precioDe = (l: LineaCarrito): number => l.precioPromotor ?? l.producto.precio_venta;
  /** Lo que cuesta instalar toda la línea (precio por unidad × cantidad); 0 sin instalación */
  const instalacionDe = (l: LineaCarrito): number => (l.instalacion ? Math.round(l.instalacion.usd * l.cantidad * 100) / 100 : 0);
  /** Lo que paga el cliente por la línea: producto + instalación */
  const totalLineaCarrito = (l: LineaCarrito): number => Math.round((precioDe(l) * l.cantidad + instalacionDe(l)) * 100) / 100;
  const totalDelCarrito = (): number => Math.round(carrito.reduce((suma, l) => suma + totalLineaCarrito(l), 0) * 100) / 100;
  /** Precio fijo en Bs de un producto (null si su precio es en dólares) */
  const bsFijoDe = (p: ProductoConRelaciones): number | null => (tienePrecioEnBs(p) ? p.precio_bs! : null);
  /**
   * Bs EXACTOS de una línea con precio fijo en bolívares (sin precio de promotor): el total en dólares se redondea a centavos y, con una
   * tasa alta, cada centavo son varios bolívares (1100 Bs saldrían como 1.098). La instalación sigue en dólares y se convierte con la tasa.
   */
  const bsExactoDeLinea = (l: LineaCarrito, tasa: number | null): number | null => {
    if (!tasa || l.precioPromotor !== undefined || !tienePrecioEnBs(l.producto)) return null;
    return Math.round((l.producto.precio_bs! * l.cantidad + convertirABs(instalacionDe(l), tasa)) * 100) / 100;
  };
  /** Total del carrito en bolívares cuando alguna línea tiene precio fijo en Bs (null = el normal: total en $ × tasa) */
  const totalBsExactoDelCarrito = (): number | null => {
    const tasa = tasaActual.get();
    if (!tasa || !carrito.some((l) => bsExactoDeLinea(l, tasa) !== null)) return null;
    return Math.round(carrito.reduce((suma, l) => suma + (bsExactoDeLinea(l, tasa) ?? convertirABs(totalLineaCarrito(l), tasa)), 0) * 100) / 100;
  };
  /** El total en Bs que se muestra: el exacto si lo hay, o el del dólar × tasa */
  const totalEnBsParaMostrar = (usd: number): number | null => {
    const tasa = tasaActual.get();
    return totalBsExactoDelCarrito() ?? (tasa ? convertirABs(usd, tasa) : null);
  };
  /** El botón de instalación solo existe en el Local Vidrios */
  let instalacionDisponible = false;
  /** Cobro rápido (Local Vidrios): sin paso de datos del cliente, tipos de cobro de un toque y último tipo recordado */
  let cobroRapido = false;
  /** Datos del promotor que instala (cuando no hay un promotor del precio ya autorizado); viajan con la venta */
  let promotorInstalacion: DatosPromotor | null = null;
  let localActivoId = '';

  const campoCodigo = document.getElementById('pos-codigo') as HTMLInputElement;
  // Un solo campo para escanear, escribir un código o buscar por nombre: `buscador` es el mismo elemento
  const buscador = campoCodigo;
  const resultados = document.getElementById('pos-resultados') as HTMLUListElement;
  const cargando = document.getElementById('pos-cargando') as HTMLParagraphElement;
  const sinResultados = document.getElementById('pos-sin-resultados') as HTMLParagraphElement;
  const listaCarrito = document.getElementById('pos-carrito') as HTMLUListElement;
  const carritoVacio = document.getElementById('pos-carrito-vacio') as HTMLParagraphElement;
  const carritoContador = document.getElementById('pos-carrito-contador') as HTMLSpanElement;
  const totalEl = document.getElementById('pos-total') as HTMLSpanElement;
  const errorEl = document.getElementById('pos-error') as HTMLParagraphElement;
  const botonProcesar = document.getElementById('pos-procesar') as HTMLButtonElement;
  const posApp = document.getElementById('pos-app') as HTMLDivElement;
  const ticket = document.getElementById('pos-ticket') as HTMLDivElement;
  const barraMovil = document.getElementById('pos-barra-movil') as HTMLDivElement;
  const barraContador = document.getElementById('pos-barra-contador') as HTMLParagraphElement;
  const barraTotal = document.getElementById('pos-barra-total') as HTMLParagraphElement;
  const barraCobrar = document.getElementById('pos-barra-cobrar') as HTMLButtonElement;

  function escaparHtml(texto: string): string {
    const div = document.createElement('div');
    div.textContent = texto;
    return div.innerHTML;
  }

  /** "$5.00 · Bs. 182,50" (solo "$5.00" mientras no haya tasa). */
  function precioEnLinea(usd: number, bsFijo: number | null = null): string {
    const tasa = tasaActual.get();
    return tasa || bsFijo !== null ? `${formatearMoneda(usd)} · ${formatearBolivares(bsFijo ?? convertirABs(usd, tasa!))}` : formatearMoneda(usd);
  }

  function mostrarError(mensaje: string) {
    errorEl.textContent = mensaje;
    errorEl.classList.remove('hidden');
  }

  const dialogoAlerta = document.getElementById('pos-alerta') as HTMLDialogElement;
  /** Vibra el teléfono (el navegador solo lo permite después de que la persona tocó la pantalla; si no, no hace nada). */
  function vibrar() {
    try {
      if (navigator.userActivation?.hasBeenActive) navigator.vibrate?.([200, 100, 200]);
    } catch {
      // sin vibración: no pasa nada
    }
  }
  /**
   * Alerta grande y que no se puede pasar por alto (con vibración en el teléfono) para lo que sale mal al LEER un código: el aviso
   * pequeño junto al carrito quedaba fuera de la pantalla en el celular, así que una pieza ya vendida "no avisaba nada".
   */
  function alertarUnidad(alerta: AlertaUnidad) {
    document.getElementById('pos-alerta-titulo')!.textContent = alerta.titulo;
    document.getElementById('pos-alerta-detalle')!.textContent = alerta.detalle;
    vibrar();
    if (!dialogoAlerta.open) dialogoAlerta.showModal();
  }
  document.getElementById('pos-alerta-ok')!.addEventListener('click', () => dialogoAlerta.close());
  dialogoAlerta.addEventListener('close', () => campoCodigo.focus({ preventScroll: true }));

  function limpiarError() {
    errorEl.classList.add('hidden');
    errorEl.textContent = '';
  }

  function cantidadEnCarrito(productoId: string): number {
    const linea = carrito.find((l) => l.producto.id === productoId);
    return linea ? ocupadas(linea) : 0;
  }

  function filtrarProductos(texto: string): ProductoConRelaciones[] {
    const q = texto.trim().toLowerCase();
    const coincidencias = !q
      ? productos
      : productos.filter(
          (p) =>
            p.nombre.toLowerCase().includes(q) ||
            p.codigo_barras.toLowerCase().includes(q) ||
            (p.referencia ?? '').toLowerCase().includes(q) ||
            p.categoria.toLowerCase().includes(q) ||
            p.modelos_compatibles.some((m) => `${m.marca} ${m.modelo}`.toLowerCase().includes(q))
        );
    // Lo que se puede vender (stock > 0) va primero; el orden alfabético se conserva dentro de cada grupo.
    return [...coincidencias].sort((a, b) => Number(b.stock_actual > 0) - Number(a.stock_actual > 0));
  }

  // Con cientos de productos, pintarlos todos en cada tecla es lento en un teléfono.
  const LIMITE_RESULTADOS = 80;

  const estilosBadge: Record<string, string> = {
    ok: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400',
    bajo: 'bg-amber-100 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400',
    critico: 'bg-red-100 text-red-700 dark:bg-red-500/10 dark:text-red-400',
  };

  function renderResultados(texto: string) {
    const lista = filtrarProductos(texto);
    sinResultados.classList.toggle('hidden', lista.length > 0);

    const recortada = lista.length > LIMITE_RESULTADOS;
    resultados.innerHTML = lista
      .slice(0, LIMITE_RESULTADOS)
      .map((producto) => {
        const disponible = producto.stock_actual - cantidadEnCarrito(producto.id);
        const estado = estadoStock(producto.stock_actual, producto.stock_minimo);
        const compatibles = producto.modelos_compatibles.length
          ? producto.modelos_compatibles.map((m) => `${m.marca} ${m.modelo}`).join(', ')
          : 'Universal';

        return `
          <li class="flex items-center justify-between gap-3 px-5 py-3">
            ${htmlMiniatura(producto.imagen_url, producto.nombre, 'h-12 w-12')}
            <div class="min-w-0 flex-1">
              <p class="break-words text-sm font-medium text-slate-900 dark:text-white">${escaparHtml(producto.nombre)}</p>
              <p class="line-clamp-2 break-words text-xs text-slate-500 dark:text-slate-400">
                ${escaparHtml(codigoVisible(producto))} · ${escaparHtml(producto.categoria)} · ${escaparHtml(compatibles)}
              </p>
              <p class="mt-1 text-xs">
                <span class="rounded-full px-2 py-0.5 font-medium ${estilosBadge[estado]}">${disponible} disponible${disponible === 1 ? '' : 's'}</span>
                <span class="ml-1 text-slate-500 dark:text-slate-400">${precioEnLinea(producto.precio_venta, bsFijoDe(producto))}</span>
              </p>
            </div>
            <button
              type="button"
              data-agregar="${producto.id}"
              ${disponible <= 0 ? 'disabled' : ''}
              class="shrink-0 rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:dark:bg-slate-700"
            >
              + Agregar
            </button>
          </li>
        `;
      })
      .join('') +
      (recortada
        ? `<li class="px-5 py-3 text-xs text-slate-500 dark:text-slate-400">Mostrando ${LIMITE_RESULTADOS} de ${lista.length}. Escribe más del nombre, modelo o código para afinar.</li>`
        : '');
  }

  function renderCarrito() {
    // Sin ninguna línea con precio de promotor no queda promotor ni autorización (p. ej. tras cobrar o vaciar el carrito)
    if (!carrito.some((l) => l.precioPromotor !== undefined)) {
      promotorVenta = null;
      autorizacionPrecio = null;
    }
    if (totalDanadosCarrito() === 0) autorizacionDanados = null;
    if (!carrito.some((l) => l.instalacion?.por === 'PROMOTOR')) promotorInstalacion = null;
    carritoVacio.classList.toggle('hidden', carrito.length > 0);
    carritoContador.textContent = `${carrito.length} línea${carrito.length === 1 ? '' : 's'}`;
    botonProcesar.disabled = carrito.length === 0;

    listaCarrito.innerHTML = carrito
      .map((linea) => {
        const { producto, cantidad, unidades } = linea;
        const precio = precioDe(linea);
        const subtotal = totalLineaCarrito(linea);
        const alMaximo = ocupadas(linea) >= producto.stock_actual;
        const danados = linea.danados ?? 0;
        const conPromotor = linea.precioPromotor !== undefined;
        const esDescuento = conPromotor && precio < producto.precio_venta - 0.005;
        const esLocal = autorizacionPrecio?.modo === 'local';
        const detallePrecio = conPromotor
          ? esDescuento
            ? `<p class="text-xs font-medium text-emerald-700 dark:text-emerald-400">Precio con descuento</p>
             <p class="text-xs text-slate-500 dark:text-slate-400">Lista ${formatearMoneda(producto.precio_venta)} · descuento ${formatearMoneda((producto.precio_venta - precio) * cantidad)}</p>`
            : esLocal
              ? `<p class="text-xs font-medium text-sky-700 dark:text-sky-400">Precio del local</p>
             <p class="text-xs text-slate-500 dark:text-slate-400">Lista ${formatearMoneda(producto.precio_venta)} · ${formatearMoneda((precio - producto.precio_venta) * cantidad)} más que el catálogo</p>`
              : `<p class="text-xs font-medium text-amber-700 dark:text-amber-400">Precio de promotor${promotorVenta?.nombre ? ` · ${escaparHtml(promotorVenta.nombre)}` : ''}</p>
             <p class="text-xs text-slate-500 dark:text-slate-400">Lista ${formatearMoneda(producto.precio_venta)} · comisión ${formatearMoneda((precio - producto.precio_venta) * cantidad)}</p>`
          : '';
        // Las piezas defectuosas (no se cobran) se anotan en el paso de Cobro; aquí solo se recuerda lo anotado
        const bloqueDanados =
          danados > 0
            ? `<p class="mt-1 text-xs font-medium text-orange-700 dark:text-orange-400">${danados} defectuosa${danados === 1 ? '' : 's'} (no se cobra${danados === 1 ? '' : 'n'})</p>`
            : '';
        const detalleInstalacion = linea.instalacion
          ? `<p class="text-xs font-medium text-sky-700 dark:text-sky-400">Instalación ${formatearMoneda(instalacionDe(linea))} · ${linea.instalacion.por === 'LOCAL' ? 'la instala el local' : 'la instala el promotor'}</p>`
          : '';
        const codigos = unidades.length
          ? `<div class="mt-1 flex flex-wrap gap-1">${unidades
              .map(
                (c) =>
                  `<span class="inline-flex items-center gap-1 rounded bg-slate-100 px-1.5 py-0.5 font-mono text-[10px] text-slate-600 dark:bg-slate-800 dark:text-slate-300">${escaparHtml(c)}<button type="button" data-quitar-unidad="${producto.id}" data-codigo="${escaparHtml(c)}" aria-label="Quitar la unidad ${escaparHtml(c)}" class="text-slate-400 hover:text-red-600">✕</button></span>`
              )
              .join('')}</div>`
          : '';
        return `
          <li data-linea="${producto.id}" class="px-4 py-3 sm:px-5">
            <div class="flex items-start gap-3">
              ${htmlMiniatura(producto.imagen_url, producto.nombre, 'h-12 w-12')}
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium leading-snug text-slate-900 dark:text-white">${escaparHtml(producto.nombre)}</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">${precioEnLinea(precio, linea.precioPromotor === undefined ? bsFijoDe(producto) : null)} c/u</p>
                ${detallePrecio}
                ${detalleInstalacion}
                ${codigos}
                ${esPorCantidad(producto) ? '<p class="mt-0.5 text-[11px] text-sky-700 dark:text-sky-400">Por cantidad: no se escanea cada pieza</p>' : ''}
              </div>
              <span class="shrink-0 text-right text-sm font-semibold text-slate-900 dark:text-white">${htmlPrecioDual(subtotal, tasaActual.get(), '', bsExactoDeLinea(linea, tasaActual.get()))}</span>
            </div>
            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
              ${
                conPromotor
                  ? `<button type="button" data-quitar-precio="${producto.id}" class="text-xs font-medium text-red-600 hover:underline dark:text-red-400">Quitar precio modificado</button>`
                  : `<button type="button" data-precio-promotor="${producto.id}" class="text-xs font-medium text-brand-700 hover:underline dark:text-brand-300">Modificar precio</button>`
              }
              ${instalacionDisponible ? `<button type="button" data-instalacion="${producto.id}" class="text-xs font-medium text-sky-700 hover:underline dark:text-sky-400">${linea.instalacion ? 'Cambiar instalación' : '+ Instalación'}</button>` : ''}
            </div>
            ${bloqueDanados}
            <div class="mt-2 flex items-center justify-between gap-3">
              <div class="flex items-center gap-1">
                <button type="button" data-restar="${producto.id}" aria-label="Quitar una unidad" class="h-10 w-10 rounded-lg border border-slate-200 text-lg leading-none text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">−</button>
                <span class="w-10 text-center text-base font-semibold text-slate-900 dark:text-white">${cantidad}</span>
                <button type="button" data-sumar="${producto.id}" ${alMaximo ? 'disabled' : ''} aria-label="Agregar una unidad" class="h-10 w-10 rounded-lg border border-slate-200 text-lg leading-none text-slate-700 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">+</button>
              </div>
              <button type="button" data-eliminar="${producto.id}" aria-label="Quitar ${escaparHtml(producto.nombre)} del carrito" class="flex items-center gap-1.5 rounded-lg border border-red-200 px-3 py-2 text-sm font-semibold text-red-600 hover:bg-red-50 dark:border-red-500/40 dark:text-red-400 dark:hover:bg-red-500/10">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14M10 11v6m4-6v6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Quitar
              </button>
            </div>
          </li>
        `;
      })
      .join('');

    const total = totalDelCarrito();
    const totalBsNumero = carrito.length > 0 ? totalEnBsParaMostrar(total) : null;
    const totalBs = totalBsNumero !== null ? formatearBolivares(totalBsNumero) : '';
    totalEl.textContent = formatearMoneda(total);
    document.getElementById('pos-total-bs')!.textContent = totalBs;

    barraContador.textContent = `${carrito.length} línea${carrito.length === 1 ? '' : 's'}`;
    barraTotal.textContent = formatearMoneda(total);
    document.getElementById('pos-barra-total-bs')!.textContent = totalBs;
    barraCobrar.disabled = carrito.length === 0;
  }

  function agregarAlCarrito(productoId: string) {
    limpiarError();
    const producto = productos.find((p) => p.id === productoId);
    if (!producto) return;

    const linea = carrito.find((l) => l.producto.id === productoId);
    const cantidadActual = linea ? ocupadas(linea) : 0;

    if (cantidadActual + 1 > producto.stock_actual) {
      mostrarError(`No hay más stock disponible de "${producto.nombre}".`);
      return;
    }

    if (linea) linea.cantidad += 1;
    else carrito.push({ producto, cantidad: 1, unidades: [] });

    renderCarrito();
    renderResultados(buscador.value);
    destacarLinea(productoId);
  }

  /** Agrega al carrito ESA unidad (la del código escaneado o elegido en la lista). Devuelve false si no se pudo. */
  function agregarUnidad(producto: ProductoConRelaciones, codigo: string): boolean {
    limpiarError();
    if (carrito.some((l) => l.unidades.includes(codigo))) {
      mostrarError(`La unidad ${codigo} ya está en el carrito.`);
      return false;
    }
    const linea = carrito.find((l) => l.producto.id === producto.id);
    if ((linea ? ocupadas(linea) : 0) + 1 > producto.stock_actual) {
      mostrarError(`No hay más stock disponible de "${producto.nombre}".`);
      return false;
    }
    if (linea) {
      linea.cantidad += 1;
      linea.unidades.push(codigo);
    } else {
      carrito.push({ producto, cantidad: 1, unidades: [codigo] });
    }
    renderCarrito();
    renderResultados(buscador.value);
    destacarLinea(producto.id);
    return true;
  }

  /** Quita del carrito una unidad concreta (la ✕ junto a su código). */
  function quitarUnidad(productoId: string, codigo: string) {
    limpiarError();
    const linea = carrito.find((l) => l.producto.id === productoId);
    if (!linea || !linea.unidades.includes(codigo)) return;
    linea.unidades = linea.unidades.filter((c) => c !== codigo);
    linea.cantidad -= 1;
    if (linea.cantidad <= 0) carrito = carrito.filter((l) => l !== linea);
    renderCarrito();
    renderResultados(buscador.value);
  }

  // Feedback visual: la línea tocada destella y el total "late".
  function destacarLinea(productoId: string) {
    reanimar(listaCarrito.querySelector<HTMLElement>(`[data-linea="${productoId}"]`), 'anim-destello');
    reanimar(totalEl, 'anim-pulso-valor');
    reanimar(barraTotal, 'anim-pulso-valor');
  }

  function cambiarCantidad(productoId: string, delta: number) {
    limpiarError();
    const linea = carrito.find((l) => l.producto.id === productoId);
    if (!linea) return;

    const nuevaCantidad = linea.cantidad + delta;
    // Al restar, primero salen las unidades escaneadas (la última que se agregó)
    if (delta < 0 && linea.unidades.length >= linea.cantidad) linea.unidades.pop();
    if (nuevaCantidad <= 0) {
      carrito = carrito.filter((l) => l.producto.id !== productoId);
    } else if (nuevaCantidad + (linea.danados ?? 0) > linea.producto.stock_actual) {
      mostrarError(`No hay más stock disponible de "${linea.producto.nombre}".`);
      return;
    } else {
      linea.cantidad = nuevaCantidad;
    }

    renderCarrito();
    renderResultados(buscador.value);
    destacarLinea(productoId);
  }

  function eliminarDelCarrito(productoId: string) {
    limpiarError();
    carrito = carrito.filter((l) => l.producto.id !== productoId);
    renderCarrito();
    renderResultados(buscador.value);
  }

  // El ticket de la última venta, para enviarlo por WhatsApp como imagen (nota de entrega y garantía del cliente)
  let ultimaVenta: VentaRegistrada | null = null;
  // La imagen se dibuja apenas se muestra el ticket: el menú "Compartir" del teléfono exige que se abra justo al tocar el botón
  let imagenTicket: Promise<File> | null = null;

  function avisoWhatsApp(mensaje: string, error = false) {
    const aviso = document.getElementById('pos-whatsapp-aviso')!;
    aviso.textContent = mensaje;
    aviso.classList.toggle('hidden', !mensaje);
    aviso.classList.toggle('text-red-600', error);
    aviso.classList.toggle('dark:text-red-400', error);
    aviso.classList.toggle('text-slate-500', !error);
    aviso.classList.toggle('dark:text-slate-400', !error);
  }

  /** Los códigos de las unidades vendidas, debajo del nombre del producto en el ticket (identifican la pieza para la garantía). */
  function htmlCodigosUnidades(unidades: string[] | undefined): string {
    if (!unidades || unidades.length === 0) return '';
    return `<span class="mt-0.5 block font-mono text-xs leading-snug text-slate-500 dark:text-slate-400 print:text-black">${unidades.map((u) => escaparHtml(u)).join(' · ')}</span>`;
  }

  function mostrarTicket(venta: VentaRegistrada) {
    ultimaVenta = venta;
    avisoWhatsApp('');
    imagenTicket = archivoDeTicket(venta);
    imagenTicket.catch(() => {}); // si falla, se vuelve a intentar al tocar el botón y ahí sí se avisa
    document.getElementById('ticket-folio')!.textContent = venta.folio
      ? `Folio #${venta.folio.toString().padStart(4, '0')}`
      : 'Folio pendiente (se asigna al sincronizar)';
    document.getElementById('ticket-fecha')!.textContent = new Date(venta.fecha).toLocaleString('es-GT', {
      dateStyle: 'medium',
      timeStyle: 'short',
    });
    // Venta sin datos del cliente (cobro rápido): no se muestra la línea ni se ofrece abrir un chat de WhatsApp
    const sinCliente = esClienteSinDatos(venta);
    document.getElementById('ticket-cliente')!.textContent = sinCliente ? '' : `Cliente: ${venta.cliente_nombre} · ${venta.cliente_cedula}`;
    document.getElementById('pos-whatsapp')?.classList.toggle('hidden', sinCliente);

    document.getElementById('ticket-lineas')!.innerHTML = venta.items
      .map(
        (item) => `
          <li class="flex justify-between gap-2">
            <span>${escaparHtml(item.nombre)} <span class="text-slate-400 print:text-black">x${item.cantidad}</span>${montoInstalacion(item) > 0 ? `<span class="mt-0.5 block text-xs text-slate-500 print:text-black">+ Instalación ${formatearMoneda(montoInstalacion(item))}</span>` : ''}${htmlCodigosUnidades(item.unidades)}</span>
            <span>${formatearMoneda(totalLinea(item))}</span>
          </li>
        `
      )
      .join('');
    document.getElementById('ticket-total')!.textContent = formatearMoneda(venta.total);
    const filaBs = document.getElementById('ticket-bs')!;
    const cobraEnBs = venta.total_bs != null;
    filaBs.classList.toggle('hidden', !cobraEnBs);
    filaBs.classList.toggle('flex', cobraEnBs);
    document.getElementById('ticket-total-bs')!.textContent = cobraEnBs ? formatearBolivares(venta.total_bs!) : '';
    document.getElementById('ticket-pagos')!.innerHTML = pagosDeVenta(venta)
      .map(
        (p) => `
          <li class="flex justify-between gap-2">
            <span>${escaparHtml(etiquetaMetodoPago(p.metodo))}</span>
            <span>${p.monto_bs != null ? `${formatearBolivares(p.monto_bs)} <span class="text-slate-400 print:text-black">(${formatearMoneda(p.monto_usd)})</span>` : formatearMoneda(p.monto_usd)}</span>
          </li>`
      )
      .join('');
    if (venta.vuelto) {
      const v = venta.vuelto;
      document.getElementById('ticket-pagos')!.insertAdjacentHTML(
        'beforeend',
        `<li class="flex justify-between gap-2 font-medium">
          <span>Vuelto (${escaparHtml(etiquetaMetodoPago(v.metodo))})</span>
          <span>−${v.monto_bs != null ? `${formatearBolivares(v.monto_bs)} <span class="text-slate-400 print:text-black">(${formatearMoneda(v.monto_usd)})</span>` : formatearMoneda(v.monto_usd)}</span>
        </li>`
      );
    }
    document.getElementById('ticket-tasa')!.textContent = venta.tasa_cambio ? `Tasa del día: ${formatearBolivares(venta.tasa_cambio)} por $1` : '';

    posApp.classList.add('hidden');
    barraMovil.classList.add('hidden');
    barraMovil.classList.remove('flex');
    ticket.classList.remove('hidden');
    reanimar(ticket, 'anim-subir');
    ticket.scrollIntoView({ behavior: 'smooth' });
  }

  const dialogoConfirmar = document.getElementById('pos-confirmar') as HTMLDialogElement;
  const formConfirmar = document.getElementById('pos-confirmar-form') as HTMLFormElement;
  const errorConfirmar = document.getElementById('pos-confirmar-error') as HTMLParagraphElement;
  const campo = (id: string) => document.getElementById(id) as HTMLInputElement & HTMLSelectElement;
  const campoNac = campo('pos-cli-nac');
  const campoCedula = campo('pos-cli-cedula');
  const campoNombre = campo('pos-cli-nombre');
  const campoTelefono = campo('pos-cli-telefono');
  const avisoCliente = document.getElementById('pos-cli-aviso') as HTMLParagraphElement;

  // --- Cliente que ya compró: al escribir su cédula se rellenan sus datos de la compra anterior -------------------------------
  let autollenado: { cedula: string; nombre: string; telefono: string } | null = null;
  let consultaCliente = 0;
  let temporizadorCliente: number | undefined;

  function limpiarAutollenado() {
    // Si los datos siguen siendo los rellenados (nadie los editó), se vacían para no dejar los de OTRO cliente
    if (autollenado && campoNombre.value === autollenado.nombre && campoTelefono.value === autollenado.telefono) {
      campoNombre.value = '';
      campoTelefono.value = '';
    }
    autollenado = null;
    avisoCliente.classList.add('hidden');
  }

  async function buscarClienteConocido() {
    const digitos = campoCedula.value.replace(/\D/g, '');
    const cedulaCompleta = `${campoNac.value}-${digitos}`;
    if (autollenado && autollenado.cedula !== cedulaCompleta) limpiarAutollenado();
    if (!/^\d{5,9}$/.test(digitos)) return;
    const turno = ++consultaCliente;
    const cliente = await inventoryService.buscarCliente(cedulaCompleta);
    if (turno !== consultaCliente || !cliente) return; // llegó una consulta más nueva, o es un cliente nuevo
    // Solo se rellena lo que está vacío: lo que el cajero ya escribió no se pisa
    if (!campoNombre.value.trim()) campoNombre.value = unirNombre(cliente.nombre, cliente.apellido);
    if (!campoTelefono.value.trim()) campoTelefono.value = cliente.telefono;
    autollenado = { cedula: cedulaCompleta, nombre: campoNombre.value, telefono: campoTelefono.value };
    avisoCliente.textContent = 'Cliente registrado: se cargaron los datos de su compra anterior. Revísalos y corrígelos si cambiaron.';
    avisoCliente.classList.remove('hidden');
  }

  function programarBusquedaCliente() {
    window.clearTimeout(temporizadorCliente);
    temporizadorCliente = window.setTimeout(() => void buscarClienteConocido(), 300);
  }

  // Formas de pago (una o varias) y vuelto: lo maneja utils/formularioPagos.ts
  const contenedorPagos = document.getElementById('pos-formulario-pagos')!;
  const formPagos = new FormularioPagos(contenedorPagos);
  let totalAConfirmar = 0;

  // --- Referencia del pago móvil (4 dígitos; ya no se pide foto) ---------------------------------------
  const bloqueComprobante = document.getElementById('pos-comprobante')!;
  const errorComprobante = document.getElementById('pos-comprobante-error')!;
  const campoReferencia = document.getElementById('pos-comprobante-ref') as HTMLInputElement;

  function pintarComprobante() {
    bloqueComprobante.classList.toggle('hidden', !formPagos.metodosElegidos().includes('BS_PAGO_MOVIL'));
  }
  function soltarComprobante() {
    campoReferencia.value = '';
    errorComprobante.classList.add('hidden');
    pintarComprobante();
  }
  campoReferencia.addEventListener('input', () => {
    campoReferencia.value = campoReferencia.value.replace(/\D/g, '').slice(0, 4); // solo dígitos, máximo 4
    errorComprobante.classList.add('hidden');
    errorConfirmar.classList.add('hidden');
  });
  contenedorPagos.addEventListener('easystem:pagos-cambiaron', pintarComprobante);
  pintarComprobante();

  // --- Cobro rápido (Local Vidrios): los datos del cliente son opcionales y viven dentro del cobro ---------------------
  const bloqueClienteOpcional = document.getElementById('pos-cli-opcional-bloque')!;
  const contenedorClienteOpcional = document.getElementById('pos-cli-opcional')!;
  const botonClienteOpcional = document.getElementById('pos-cli-toggle') as HTMLButtonElement;
  const clienteSinEscribir = () => ![campoCedula, campoNombre, campoTelefono].some((c) => c.value.trim() !== '');
  function mostrarClienteOpcional(abierto: boolean) {
    contenedorClienteOpcional.classList.toggle('hidden', !abierto);
    botonClienteOpcional.setAttribute('aria-expanded', String(abierto));
    botonClienteOpcional.textContent = abierto ? '− Quitar los datos del cliente' : '+ Datos del cliente (opcional)';
  }
  /** Convierte el paso «Datos del cliente» en un bloque plegable dentro del cobro (solo en el Local Vidrios). */
  function activarCobroRapido(ultimoMetodo: MetodoPago | null) {
    if (cobroRapido) return;
    cobroRapido = true;
    const fieldset = dialogoConfirmar.querySelector<HTMLElement>('fieldset[data-paso="cliente"]');
    if (fieldset) {
      fieldset.removeAttribute('data-paso');
      fieldset.classList.remove('hidden');
      contenedorClienteOpcional.appendChild(fieldset);
    }
    bloqueClienteOpcional.classList.remove('hidden');
    mostrarClienteOpcional(false);
    formPagos.activarCobroRapido(ultimoMetodo);
    // En el Local Vidrios también hay ventas en espera
    document.getElementById('pos-espera-abrir')!.classList.remove('hidden');
    document.getElementById('pos-confirmar-espera')!.classList.remove('hidden');
  }
  botonClienteOpcional.addEventListener('click', () => {
    const abrir = contenedorClienteOpcional.classList.contains('hidden');
    if (!abrir) {
      // Quitar los datos: se vacían para que la venta salga sin cliente
      for (const c of [campoCedula, campoNombre, campoTelefono]) c.value = '';
      autollenado = null;
      avisoCliente.classList.add('hidden');
    }
    mostrarClienteOpcional(abrir);
    if (abrir) campoCedula.focus();
  });

  // Último tipo de cobro usado en cada local (se propone ya elegido en el siguiente cobro)
  const claveUltimoMetodo = () => `easystem:ultimo-metodo:${localActivoId}`;
  function leerUltimoMetodo(): MetodoPago | null {
    try {
      const guardado = localStorage.getItem(claveUltimoMetodo());
      return METODOS_PAGO.some((m) => m.valor === guardado) ? (guardado as MetodoPago) : null;
    } catch {
      return null;
    }
  }
  function recordarUltimoMetodo(pagos: PagoVenta[]) {
    if (!cobroRapido || pagos.length !== 1) return;
    try {
      localStorage.setItem(claveUltimoMetodo(), pagos[0].metodo);
    } catch {
      /* sin almacenamiento: simplemente no se recuerda */
    }
    formPagos.activarCobroRapido(pagos[0].metodo);
  }

  // Los datos del cliente solo viven mientras dura la venta (se borran al cobrar).
  function limpiarDatosCliente() {
    if (cobroRapido) mostrarClienteOpcional(false);
    for (const c of [campoCedula, campoNombre, campoTelefono]) c.value = '';
    campoNac.value = 'V';
    autollenado = null;
    avisoCliente.classList.add('hidden');
    errorConfirmar.classList.add('hidden');
    formPagos.reiniciar();
    soltarComprobante();
  }

  const fallar = (mensaje: string, el: HTMLElement | null | undefined) => {
    errorConfirmar.textContent = mensaje;
    errorConfirmar.classList.remove('hidden');
    el?.focus();
    return null;
  };

  /** Los datos del cliente ya validados, o muestra el primer error y devuelve null. */
  function validarCliente(): ClienteVenta | null {
    const cedula = campoCedula.value.replace(/\D/g, '');
    // Un solo campo «Nombre y apellido» escrito corrido: se parte en las dos piezas que guarda el sistema
    const { nombre, apellido } = separarNombreCompleto(campoNombre.value);
    const telefono = campoTelefono.value.trim();
    const patronNombre = /^[\p{L}][\p{L} '.-]*$/u;

    if (!/^\d{5,9}$/.test(cedula)) return fallar('La cédula debe tener entre 5 y 9 dígitos (solo números).', campoCedula);
    if (nombre.length < 2 || !patronNombre.test(nombre)) return fallar('Escribe el nombre y el apellido del cliente.', campoNombre);
    if (apellido.length < 2 || !patronNombre.test(apellido)) return fallar('Escribe también el apellido del cliente (nombre y apellido).', campoNombre);
    const digitos = telefono.replace(/\D/g, '');
    if (!/^[\d\s+()-]+$/.test(telefono) || digitos.length < 10 || digitos.length > 13) {
      return fallar('El teléfono debe tener entre 10 y 13 dígitos (ej. 0414-1234567).', campoTelefono);
    }

    errorConfirmar.classList.add('hidden');
    return { cedula: `${campoNac.value}-${cedula}`, nombre: `${nombre} ${apellido}`, apellido, telefono };
  }

  /** Devuelve los datos del cliente y los pagos ya validados, o muestra el primer error y devuelve null. */
  function leerDatosCliente(): { cliente: ClienteVenta | null; pagos: PagoVenta[]; vuelto: DineroEntregado | null } | null {
    // Cobro rápido: sin nada escrito la venta sale sin datos del cliente; si se escribió algo, se valida completo
    const sinCliente = cobroRapido && clienteSinEscribir();
    const cliente = sinCliente ? null : validarCliente();
    if (!sinCliente && !cliente) {
      if (cobroRapido) mostrarClienteOpcional(true);
      else irAlPaso('cliente'); // el error estaba en los datos del cliente: se vuelve a ese paso
      validarCliente();
      return null;
    }
    const lectura = formPagos.leer();
    if (!lectura.ok) return fallar(lectura.mensaje, lectura.foco);
    errorConfirmar.classList.add('hidden');
    return { cliente, pagos: lectura.pagos, vuelto: lectura.vuelto };
  }

  /** Paso previo: muestra el resumen y pide los datos del cliente; la venta solo se registra al confirmar. */
  function pedirConfirmacion() {
    if (carrito.length === 0 || dialogoConfirmar.open) return;
    if (autorizacionVencida() || autorizacionDanadosVencida()) return;
    const unidades = carrito.reduce((suma, l) => suma + l.cantidad, 0);

    document.getElementById('pos-confirmar-resumen')!.textContent =
      `${carrito.length} línea${carrito.length === 1 ? '' : 's'} · ${unidades} unidad${unidades === 1 ? '' : 'es'}`;
    pintarResumenConfirmar();

    errorConfirmar.classList.add('hidden');
    // Pasos: si falta escanear alguna unidad, primero eso; después los datos del cliente y, al final, el cobro
    const restantes: Paso[] = cobroRapido ? ['pago'] : ['cliente', 'pago'];
    pasos = pendientesDeEscanear().length > 0 ? ['escaneo', ...restantes] : restantes;
    pasoActual = 0;
    if (cobroRapido) mostrarClienteOpcional(!clienteSinEscribir()); // si ya había datos escritos, el bloque queda abierto
    pintarPasos();
    dialogoConfirmar.showModal();
    enfocarPaso();
  }

  function pedirConfirmacionActualiza() {
    const tasaDia = tasaActual.get();
    document.getElementById('pos-confirmar-total-bs')!.textContent = tasaDia ? `≈ ${formatearBolivares(totalEnBsParaMostrar(totalAConfirmar)!)} (tasa ${formatearBolivares(tasaDia)})` : '';
    formPagos.refrescar();
  }

  document.getElementById('pos-confirmar-no')!.addEventListener('click', () => {
    if (pasoActual > 0) retroceder();
    else dialogoConfirmar.close();
  });
  // Clic en el fondo oscuro = cancelar (los datos escritos se conservan si se reabre)
  dialogoConfirmar.addEventListener('click', (e) => {
    if (e.target === dialogoConfirmar) dialogoConfirmar.close();
  });
  formConfirmar.addEventListener('input', () => errorConfirmar.classList.add('hidden'));
  campoCedula.addEventListener('input', () => {
    campoCedula.value = campoCedula.value.replace(/\D/g, '');
    programarBusquedaCliente();
  });
  campoNac.addEventListener('change', programarBusquedaCliente);
  formConfirmar.addEventListener('submit', (e) => {
    e.preventDefault();
    const paso = pasos[pasoActual];
    if (paso === 'escaneo') {
      if (pendientesDeEscanear().length === 0) avanzar();
      return;
    }
    if (paso === 'cliente') {
      if (validarCliente()) avanzar();
      return;
    }
    const datos = leerDatosCliente();
    if (!datos) return;
    // Pago móvil: sin los 4 dígitos de la referencia no se procesa (el diálogo sigue abierto para escribirlos)
    if (incluyePagoMovil(datos.pagos) && !/^\d{4}$/.test(campoReferencia.value)) {
      errorComprobante.textContent = 'Escribe los 4 dígitos de la referencia del pago móvil (solo números).';
      errorComprobante.classList.remove('hidden');
      bloqueComprobante.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return fallar('Falta la referencia del pago móvil (4 dígitos).', campoReferencia);
    }
    dialogoConfirmar.close();
    procesarVenta(datos);
  });

  async function procesarVenta(datos: { cliente: ClienteVenta | null; pagos: PagoVenta[]; vuelto: DineroEntregado | null }) {
    if (carrito.length === 0) return;
    limpiarError();
    if (autorizacionVencida() || autorizacionesManualesVencidas() || autorizacionDanadosVencida()) return;
    const tasa = tasaActual.get();
    if (!tasa) {
      mostrarError('Falta la tasa del dólar del día. Regístrala para poder vender.');
      window.dispatchEvent(new Event('easystem:abrir-tasa'));
      return;
    }
    botonProcesar.disabled = true;
    botonProcesar.textContent = 'Procesando...';
    barraCobrar.disabled = true;

    try {
      const items: VentaItem[] = carrito.map((l) => ({
        producto_id: l.producto.id,
        nombre: l.producto.nombre,
        codigo_barras: l.producto.codigo_barras,
        cantidad: l.cantidad,
        precio_unitario: precioDe(l),
        // El precio de catálogo solo se anota en las líneas con precio modificado (el servidor lo vuelve a leer del catálogo)
        precio_lista: l.precioPromotor !== undefined ? l.producto.precio_venta : undefined,
        ...(l.instalacion ? { instalacion_por: l.instalacion.por, instalacion_usd: l.instalacion.usd } : {}),
        unidades: l.unidades.length ? [...l.unidades] : undefined,
        // Piezas defectuosas (productos por cantidad): no se cobran, salen del stock como baja junto con la venta
        ...((l.danados ?? 0) > 0 ? { danados: l.danados, danados_motivo: l.danadosMotivo ?? null } : {}),
        // Las unidades elegidas a mano (la etiqueta no se leía) viajan con la autorización del supervisor que las permitió
        ...(() => {
          const a = manualPorProducto.get(l.producto.id);
          const codigos = a ? [...a.codigos].filter((c) => l.unidades.includes(c)) : [];
          return codigos.length && a ? { codigos_manuales: codigos, autorizacion_codigo: a.token } : {};
        })(),
      }));
      const sesion = await obtenerSesionActual();
      const venta = await inventoryService.registrarVenta(items, {
        ...datos,
        tasa_cambio: tasa,
        vendedor_nombre: sesion?.nombre,
        referenciaPagoMovil: incluyePagoMovil(datos.pagos) ? campoReferencia.value : null,
        esperaId: esperaActiva?.id ?? null,
        precioPromotor: autorizacionPrecio ? { promotor: promotorVenta?.datos ?? null, autorizacion: autorizacionPrecio } : null,
        promotorInstalacion: hayInstalacionDelPromotor(items) ? promotorInstalacion : null,
        autorizacionDanados: totalDanadosCarrito() >= UMBRAL_CLAVE_DANADOS && autorizacionDanados ? { token: autorizacionDanados.token, vence_en: autorizacionDanados.vence_en, autorizado_por: autorizacionDanados.autorizado_por } : null,
      });
      mostrarTicket(venta);
      carrito = [];
      manualPorProducto.clear();
      esperaActiva = null; // la venta en espera que se cobró ya quedó cerrada junto con la venta
      pintarBannerEspera();
      limpiarDatosCliente();
      recordarUltimoMetodo(datos.pagos);
      await cargarProductos();
    } catch (err) {
      if (err instanceof inventoryService.VentaIncompletaError) {
        // Esas líneas ya salieron del inventario: se quitan del carrito para no cobrarlas dos veces.
        carrito = carrito.filter((l) => !err.productosRegistrados.includes(l.producto.id));
        if (carrito.length === 0) limpiarDatosCliente();
        else formPagos.reiniciar(); // el total cambió: hay que volver a repartir los pagos
        await cargarProductos();
        renderCarrito();
      }
      mostrarError(err instanceof Error ? err.message : 'No se pudo procesar la venta.');
      // Si el rechazo fue por una unidad que otro dispositivo ya vendió, se identifica y se quita del carrito
      if (!(err instanceof inventoryService.VentaIncompletaError)) await revalidarUnidadesCarrito();
    } finally {
      botonProcesar.textContent = 'Procesar venta';
      botonProcesar.disabled = carrito.length === 0;
      barraCobrar.disabled = carrito.length === 0;
    }
  }

  // La tasa cambió: recalcula todos los Bs. visibles (y el monto a cobrar si el diálogo está abierto)
  tasaActual.listen(() => {
    renderResultados(buscador.value);
    renderCarrito();
    if (dialogoConfirmar.open) {
      pedirConfirmacionActualiza();
    }
  });

  function iniciarNuevaVenta() {
    ticket.classList.add('hidden');
    posApp.classList.remove('hidden');
    barraMovil.classList.remove('hidden');
    barraMovil.classList.add('flex');
    renderCarrito();
    renderResultados(buscador.value);
    enfocarCodigo();
  }

  /** En el computador el cursor queda listo para el lector; en el teléfono no se abre el teclado solo. */
  function enfocarCodigo() {
    if (window.matchMedia('(pointer: fine)').matches) campoCodigo.focus();
  }

  let primeraCarga = true;

  async function cargarProductos() {
    const lista = await inventoryService.listarProductos();
    await cargarEsperas();
    // Lo que está reservado por ventas en espera (menos la que se está retomando) no se ofrece: así otro vendedor no vende esa pieza
    productos = esperas.length
      ? lista.map((p) => {
          const reservado = reservadoDe(p.id);
          return reservado > 0 ? { ...p, stock_actual: Math.max(0, p.stock_actual - reservado) } : p;
        })
      : lista;
    cargando.classList.add('hidden');
    if (primeraCarga) {
      primeraCarga = false;
      animarLista(resultados);
    }
    ajustarCarritoAlStock();
    await revalidarUnidadesCarrito();
    renderResultados(buscador.value);
  }

  /**
   * Las unidades escaneadas siguen siendo suyas solo mientras estén DISPONIBLES: si otro dispositivo ya vendió alguna,
   * se quita del carrito con un aviso (así la venta no se rechaza al cobrar). Sin conexión no se puede comprobar.
   */
  async function revalidarUnidadesCarrito() {
    const codigos = carrito.flatMap((l) => l.unidades);
    if (codigos.length === 0) return;
    let disponibles: UnidadProducto[];
    try {
      disponibles = await inventoryService.listarUnidades({ estado: 'DISPONIBLE', codigos });
    } catch {
      return;
    }
    const vigentes = new Set(disponibles.map((u) => u.codigo));
    const perdidas = codigos.filter((c) => !vigentes.has(c));
    if (perdidas.length === 0) return;
    for (const linea of [...carrito]) {
      const sueltas = linea.unidades.filter((c) => perdidas.includes(c));
      if (sueltas.length === 0) continue;
      linea.unidades = linea.unidades.filter((c) => !perdidas.includes(c));
      linea.cantidad -= sueltas.length;
      if (linea.cantidad <= 0) carrito = carrito.filter((l) => l !== linea);
    }
    renderCarrito();
    mostrarError(`La unidad ${perdidas.join(', ')} ya no está disponible (otro dispositivo la vendió) y se quitó del carrito.`);
  }

  /**
   * Con el stock recién traído (p. ej. otro dispositivo vendió el mismo producto), cada línea del carrito pasa a
   * apuntar al producto actualizado y, si ya no alcanza, se baja la cantidad (o se quita) avisando al cajero.
   */
  function ajustarCarritoAlStock() {
    const avisos: string[] = [];
    for (const linea of [...carrito]) {
      const actual = productos.find((p) => p.id === linea.producto.id);
      if (!actual) {
        carrito = carrito.filter((l) => l !== linea);
        avisos.push(`"${linea.producto.nombre}" ya no está disponible y se quitó del carrito.`);
        continue;
      }
      linea.producto = actual;
      // Si el precio de catálogo cambió desde que se autorizó el precio modificado, esa autorización ya no vale
      if (linea.precioPromotor !== undefined && Math.abs(actual.precio_venta - (linea.listaAutorizada ?? actual.precio_venta)) > 0.005) {
        delete linea.precioPromotor;
        delete linea.listaAutorizada;
        avisos.push(`El precio de "${actual.nombre}" cambió en el catálogo: se quitó el precio modificado de esa línea.`);
      }
      if (ocupadas(linea) > actual.stock_actual) {
        if (actual.stock_actual <= 0) {
          carrito = carrito.filter((l) => l !== linea);
          avisos.push(`Se agotó "${actual.nombre}" (otro dispositivo lo vendió) y se quitó del carrito.`);
        } else {
          // Primero se sueltan las piezas defectuosas marcadas; luego se baja lo que se cobra
          delete linea.danados;
          delete linea.danadosMotivo;
          linea.cantidad = Math.min(linea.cantidad, actual.stock_actual);
          linea.unidades = linea.unidades.slice(0, linea.cantidad);
          avisos.push(`Solo quedan ${actual.stock_actual} de "${actual.nombre}": se ajustó la cantidad del carrito.`);
        }
      }
    }
    if (avisos.length > 0) {
      renderCarrito();
      mostrarError(avisos.join(' '));
    }
  }

  /** Actualización en vivo: no toca nada mientras haya una ventana abierta (confirmar venta, ticket...), para no cambiar un total a mitad del cobro. */
  async function refrescarEnVivo() {
    while (document.querySelector('dialog[open]')) await new Promise((r) => setTimeout(r, 1500));
    await cargarProductos();
  }

  // Delegación de eventos: los botones de resultados/carrito se regeneran en cada render
  resultados.addEventListener('click', (e) => {
    const boton = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-agregar]');
    if (boton?.dataset.agregar) agregarAlCarrito(boton.dataset.agregar);
  });

  listaCarrito.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;
    const quitar = objetivo.closest<HTMLButtonElement>('[data-quitar-unidad]');
    if (quitar?.dataset.quitarUnidad && quitar.dataset.codigo) return quitarUnidad(quitar.dataset.quitarUnidad, quitar.dataset.codigo);
    const sumar = objetivo.closest<HTMLButtonElement>('[data-sumar]');
    const restar = objetivo.closest<HTMLButtonElement>('[data-restar]');
    const eliminar = objetivo.closest<HTMLButtonElement>('[data-eliminar]');
    const instalacion = objetivo.closest<HTMLButtonElement>('[data-instalacion]');
    if (instalacion?.dataset.instalacion) return abrirInstalacion(instalacion.dataset.instalacion);
    const precioPromotor = objetivo.closest<HTMLButtonElement>('[data-precio-promotor]');
    const quitarPrecio = objetivo.closest<HTMLButtonElement>('[data-quitar-precio]');
    if (sumar?.dataset.sumar) cambiarCantidad(sumar.dataset.sumar, 1);
    else if (restar?.dataset.restar) cambiarCantidad(restar.dataset.restar, -1);
    else if (eliminar?.dataset.eliminar) eliminarDelCarrito(eliminar.dataset.eliminar);
    else if (precioPromotor?.dataset.precioPromotor) elegirModoPrecio(precioPromotor.dataset.precioPromotor);
    else if (quitarPrecio?.dataset.quitarPrecio) quitarPrecioPromotor(quitarPrecio.dataset.quitarPrecio);
  });

  const listaCobro = document.getElementById('pos-confirmar-lineas') as HTMLUListElement;
  listaCobro.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;
    const sumar = objetivo.closest<HTMLButtonElement>('[data-danados-sumar]');
    const restar = objetivo.closest<HTMLButtonElement>('[data-danados-restar]');
    if (sumar?.dataset.danadosSumar) cambiarDanados(sumar.dataset.danadosSumar, 1);
    else if (restar?.dataset.danadosRestar) cambiarDanados(restar.dataset.danadosRestar, -1);
  });

  listaCobro.addEventListener('change', (e) => {
    const motivo = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-danados-motivo]');
    if (!motivo?.dataset.danadosMotivo) return;
    const linea = carrito.find((l) => l.producto.id === motivo.dataset.danadosMotivo);
    if (linea) linea.danadosMotivo = (MOTIVOS_MERMA.find((m) => m.id === motivo.value)?.id as MotivoMerma | undefined) ?? null;
  });

  // --- Piezas defectuosas (productos por cantidad) ----------------------------------------------------------------
  // Una pieza que viene defectuosa o se daña al colocarla no se le cobra al cliente: se anota aquí y sale del stock como baja, junto con
  // la venta. Solo encargado, gerente y administrador. Con 3 o más piezas defectuosas en la misma venta hace falta la contraseña de un
  // gerente o administrador (ventana #pos-danados); el servidor lo vuelve a comprobar.
  const dialogoDanados = document.getElementById('pos-danados') as HTMLDialogElement;
  const formDanados = document.getElementById('pos-danados-form') as HTMLFormElement;
  const claveDanados = document.getElementById('pos-danados-clave') as HTMLInputElement;
  const errorDanados = document.getElementById('pos-danados-error') as HTMLParagraphElement;
  const botonDanados = document.getElementById('pos-danados-ok') as HTMLButtonElement;
  let pendienteDanados: { productoId: string; total: number } | null = null;

  const autorizacionDanadosVigente = (cantidad: number) =>
    !!autorizacionDanados && autorizacionDanados.vence_en > Date.now() + 15_000 && autorizacionDanados.cantidad >= cantidad;

  function cambiarDanados(productoId: string, delta: number) {
    limpiarError();
    const linea = carrito.find((l) => l.producto.id === productoId);
    if (!linea || !esPorCantidad(linea.producto) || !puedeMarcarDanados) return;
    const actual = linea.danados ?? 0;
    if (actual + delta < 0) return;
    if (delta > 0) {
      if (ocupadas(linea) + 1 > linea.producto.stock_actual) {
        mostrarError(`No hay más stock disponible de "${linea.producto.nombre}".`);
        return;
      }
      const total = totalDanadosCarrito() + 1;
      if (total >= UMBRAL_CLAVE_DANADOS && !autorizacionDanadosVigente(total)) {
        pedirClaveDanados(productoId, total);
        return;
      }
    }
    aplicarDanados(linea, actual + delta);
  }

  function aplicarDanados(linea: LineaCarrito, cantidad: number) {
    if (cantidad > 0) linea.danados = cantidad;
    else {
      delete linea.danados;
      delete linea.danadosMotivo;
    }
    renderCarrito();
    destacarLinea(linea.producto.id);
    if (dialogoConfirmar.open) pintarResumenConfirmar();
  }

  function pedirClaveDanados(productoId: string, total: number) {
    pendienteDanados = { productoId, total };
    document.getElementById('pos-danados-texto')!.textContent = `Botar ${total} piezas defectuosas en una misma venta lo autoriza un gerente o un administrador con su contraseña (vale 20 minutos).`;
    claveDanados.value = '';
    errorDanados.classList.add('hidden');
    dialogoDanados.showModal();
    claveDanados.focus();
  }

  document.getElementById('pos-danados-cancelar')!.addEventListener('click', () => {
    pendienteDanados = null;
    dialogoDanados.close();
  });
  formDanados.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!pendienteDanados) return;
    const { productoId, total } = pendienteDanados;
    if (!claveDanados.value) {
      errorDanados.textContent = 'Escribe la contraseña de un gerente o administrador.';
      errorDanados.classList.remove('hidden');
      return;
    }
    botonDanados.disabled = true;
    try {
      const r = await inventoryService.autorizarDanados({ clave: claveDanados.value, cantidad: total });
      autorizacionDanados = { token: r.token, vence_en: r.vence_en, autorizado_por: r.autorizado_por, cantidad: total };
      claveDanados.value = '';
      pendienteDanados = null;
      dialogoDanados.close();
      const linea = carrito.find((l) => l.producto.id === productoId);
      if (linea) aplicarDanados(linea, (linea.danados ?? 0) + 1);
    } catch (err) {
      errorDanados.textContent = err instanceof Error ? err.message : 'No se pudo autorizar.';
      errorDanados.classList.remove('hidden');
      claveDanados.select();
    } finally {
      botonDanados.disabled = false;
    }
  });

  /** Si la autorización de las piezas defectuosas venció (o no hay) y ya son 3 o más, se quitan las defectuosas y se avisa; devuelve si pasó. */
  function autorizacionDanadosVencida(): boolean {
    const total = totalDanadosCarrito();
    if (total < UMBRAL_CLAVE_DANADOS || autorizacionDanadosVigente(total)) return false;
    for (const l of carrito) {
      delete l.danados;
      delete l.danadosMotivo;
    }
    autorizacionDanados = null;
    renderCarrito();
    mostrarError('La autorización de las piezas defectuosas venció: se quitaron del carrito. Márcalas de nuevo (pedirá la clave).');
    return true;
  }

  // --- Precio de promotor ---------------------------------------------------------------------------------------
  // El cliente paga más que el catálogo (p. ej. $15 por un control de $12) y la diferencia es la comisión del promotor, que la tienda
  // le paga aparte. Se abre tocando el total del cobro; un encargado de este local, un gerente o un administrador lo autoriza con SU
  // contraseña (sin correo: el servidor la reconoce entre quienes pueden autorizar aquí) y el servidor lo vuelve a comprobar.
  const dialogoPrecio = document.getElementById('pos-precio') as HTMLDialogElement;
  const formPrecio = document.getElementById('pos-precio-form') as HTMLFormElement;
  const listaPrecio = document.getElementById('pos-precio-lineas') as HTMLUListElement;
  const promotorNac = document.getElementById('pos-promotor-nac') as HTMLSelectElement;
  const promotorCedula = document.getElementById('pos-promotor-cedula') as HTMLInputElement;
  const promotorNombre = document.getElementById('pos-promotor-nombre') as HTMLInputElement;
  const promotorTelefono = document.getElementById('pos-promotor-telefono') as HTMLInputElement;
  const promotorBanco = document.getElementById('pos-promotor-banco') as HTMLInputElement;
  const promotorRegistrado = document.getElementById('pos-promotor-registrado') as HTMLParagraphElement;
  const campoClaveSupervisor = document.getElementById('pos-precio-clave') as HTMLInputElement;
  const errorPrecio = document.getElementById('pos-precio-error') as HTMLParagraphElement;
  const botonAutorizar = document.getElementById('pos-precio-guardar') as HTMLButtonElement;

  const dialogoModo = document.getElementById('pos-precio-modo') as HTMLDialogElement;
  /** Modo con el que está abierta la ventana de precios: "promotor" (más caro, con comisión) o "local" (la tienda cambia el precio) */
  let modoPrecio: ModoPrecio = 'promotor';
  let productoDestacadoPrecio: string | undefined;

  /** Primero se elige qué precio se modifica (promotor o local); después se abre la ventana de precios con ese modo. */
  function elegirModoPrecio(productoDestacado?: string) {
    if (carrito.length === 0) return;
    productoDestacadoPrecio = productoDestacado;
    dialogoModo.showModal();
  }
  dialogoModo.addEventListener('click', (e) => {
    const boton = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-modo-precio]');
    if (!boton) return;
    dialogoModo.close();
    void abrirPrecioPromotor(boton.dataset.modoPrecio === 'local' ? 'local' : 'promotor', productoDestacadoPrecio);
  });
  document.getElementById('pos-precio-modo-cancelar')!.addEventListener('click', () => dialogoModo.close());

  const numeroEscrito = (texto: string): number => Number(texto.trim().replace(',', '.'));
  const camposPrecio = () => [...listaPrecio.querySelectorAll<HTMLInputElement>('input[data-precio-de]')];

  /** Precios escritos distintos al del catálogo (más caros o más baratos): [línea, precio]. Los campos vacíos o iguales al catálogo no cuentan. */
  function preciosEscritos(): { linea: LineaCarrito; precio: number }[] {
    const resultado: { linea: LineaCarrito; precio: number }[] = [];
    for (const campo of camposPrecio()) {
      const linea = carrito.find((l) => l.producto.id === campo.dataset.precioDe);
      const precio = Math.round(numeroEscrito(campo.value) * 100) / 100;
      if (linea && campo.value.trim() !== '' && Number.isFinite(precio) && precio > 0 && Math.abs(precio - linea.producto.precio_venta) > 0.005) resultado.push({ linea, precio });
    }
    return resultado;
  }

  /**
   * Según lo escrito: la comisión del promotor (precios mayores), el descuento (precios menores) y quién puede autorizar.
   * Un precio menor al del catálogo solo lo autoriza un gerente o un administrador; uno mayor, también el encargado.
   */
  function textoComision() {
    const cambios = preciosEscritos();
    const comision = cambios.reduce((suma, { linea, precio }) => suma + Math.max(0, precio - linea.producto.precio_venta) * linea.cantidad, 0);
    const descuento = cambios.reduce((suma, { linea, precio }) => suma + Math.max(0, linea.producto.precio_venta - precio) * linea.cantidad, 0);
    const partes: string[] = [];
    if (modoPrecio === 'local') {
      if (comision > 0) partes.push(`El precio sube ${formatearMoneda(comision)} para la tienda (sin comisión de promotor).`);
      if (descuento > 0) partes.push(`Descuento de ${formatearMoneda(descuento)}: solo lo autoriza un gerente o un administrador.`);
    } else {
      if (comision > 0) partes.push(`La tienda le paga ${formatearMoneda(comision)} de comisión al promotor.`);
      if (descuento > 0) partes.push('En el precio de promotor el precio no puede ser menor al del catálogo: para un descuento elige «Precio del local».');
    }
    document.getElementById('pos-precio-comision')!.textContent = partes.length > 0 ? partes.join(' ') : 'Escribe un precio distinto al del catálogo en alguno de los productos.';
    // El promotor solo existe en el precio de promotor (el precio del local no lleva promotor ni comisión)
    document.getElementById('pos-promotor-bloque')!.classList.toggle('hidden', modoPrecio === 'local');
    // El precio de promotor (siempre más caro que el catálogo) no pide contraseña; el precio del local, sí
    document.getElementById('pos-precio-clave-bloque')!.classList.toggle('hidden', modoPrecio === 'promotor');
    document.getElementById('pos-precio-clave-titulo')!.textContent =
      descuento > 0 ? 'Contraseña de un gerente o administrador' : 'Contraseña de un encargado, gerente o administrador';
  }

  function errorDePrecio(mensaje: string) {
    errorPrecio.textContent = mensaje;
    errorPrecio.classList.remove('hidden');
  }

  /** Vuelve a pintar el resumen del cobro (líneas, total, equivalente en Bs. y pagos) cuando cambia algún precio. */
  /** Control de piezas defectuosas de una línea por cantidad (solo encargado, gerente y administrador), dentro del paso de Cobro. */
  function htmlDanadosCobro(linea: LineaCarrito): string {
    if (!puedeMarcarDanados || !esPorCantidad(linea.producto)) return '';
    const id = escaparHtml(linea.producto.id);
    const danados = linea.danados ?? 0;
    const alMaximo = ocupadas(linea) >= linea.producto.stock_actual;
    const boton = 'h-9 w-9 rounded-lg border border-orange-200 text-lg leading-none text-orange-800 hover:bg-orange-100 disabled:cursor-not-allowed disabled:opacity-40 dark:border-orange-500/40 dark:text-orange-300 dark:hover:bg-orange-500/20';
    return `<div class="mt-2 rounded-lg border border-orange-200 bg-orange-50/60 px-3 py-2 dark:border-orange-500/30 dark:bg-orange-500/10">
        <div class="flex items-center justify-between gap-3">
          <p class="text-xs font-semibold text-orange-800 dark:text-orange-300">Pieza defectuosa (no se cobra)</p>
          <div class="flex items-center gap-1">
            <button type="button" data-danados-restar="${id}" ${danados === 0 ? 'disabled' : ''} aria-label="Quitar una pieza defectuosa" class="${boton}">−</button>
            <span class="w-8 text-center text-base font-semibold text-slate-900 dark:text-white">${danados}</span>
            <button type="button" data-danados-sumar="${id}" ${alMaximo ? 'disabled' : ''} aria-label="Agregar una pieza defectuosa" class="${boton}">+</button>
          </div>
        </div>
        ${
          danados > 0
            ? `<select data-danados-motivo="${id}" aria-label="Motivo de la pieza defectuosa (opcional)" class="mt-2 w-full rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white">
                <option value="">Motivo (opcional)</option>
                ${MOTIVOS_MERMA.map((m) => `<option value="${m.id}" ${linea.danadosMotivo === m.id ? 'selected' : ''}>${escaparHtml(m.nombre)}</option>`).join('')}
              </select>`
            : ''
        }
      </div>`;
  }

  function pintarResumenConfirmar() {
    const total = totalDelCarrito();
    document.getElementById('pos-confirmar-total')!.textContent = formatearMoneda(total);
    totalAConfirmar = total;
    formPagos.establecerTotal(total, totalBsExactoDelCarrito());
    const tasaDia = tasaActual.get();
    document.getElementById('pos-confirmar-total-bs')!.textContent = tasaDia ? `≈ ${formatearBolivares(totalEnBsParaMostrar(total)!)} (tasa ${formatearBolivares(tasaDia)})` : '';
    document.getElementById('pos-confirmar-lineas')!.innerHTML = carrito
      .map(
        (linea) => `
          <li class="px-3 py-2"><div class="flex items-center justify-between gap-3">
            <span class="min-w-0 flex-1 break-words text-slate-700 dark:text-slate-300">${linea.cantidad} × ${escaparHtml(linea.producto.nombre)}${linea.precioPromotor !== undefined ? (linea.precioPromotor < linea.producto.precio_venta ? '<span class="ml-1 text-[11px] font-medium text-emerald-700 dark:text-emerald-400">(con descuento)</span>' : autorizacionPrecio?.modo === 'local' ? '<span class="ml-1 text-[11px] font-medium text-sky-700 dark:text-sky-400">(precio del local)</span>' : '<span class="ml-1 text-[11px] font-medium text-amber-700 dark:text-amber-400">(precio de promotor)</span>') : ''}${linea.instalacion ? '<span class="ml-1 text-[11px] font-medium text-sky-700 dark:text-sky-400">(con instalación)</span>' : ''}</span>
            <span class="shrink-0 font-medium text-slate-900 dark:text-white">${formatearMoneda(totalLineaCarrito(linea))}</span>
          </div>${htmlDanadosCobro(linea)}</li>`
      )
      .join('');
  }

  async function abrirPrecioPromotor(modo: ModoPrecio, productoDestacado?: string) {
    if (carrito.length === 0) return;
    limpiarError();
    modoPrecio = modo;
    document.getElementById('pos-precio-titulo')!.textContent = modo === 'local' ? 'Precio del local' : 'Precio de promotor';
    document.getElementById('pos-precio-descripcion')!.textContent =
      modo === 'local'
        ? 'Escribe el precio al que la tienda vende. Más caro o con descuento, sin promotor ni comisión.'
        : 'Escribe el precio al que paga el cliente. La diferencia sobre el catálogo es la comisión del promotor. No pide contraseña.';
    // Los precios y el promotor ya autorizados solo se muestran si se vuelve a abrir el MISMO modo
    const mismoModo = !autorizacionPrecio || autorizacionPrecio.modo === modo;
    listaPrecio.innerHTML = carrito
      .map(
        (l) => `<li>
          <label class="block">
            <span class="block break-words text-sm font-medium text-slate-800 dark:text-slate-100">${l.cantidad} × ${escaparHtml(l.producto.nombre)}</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Catálogo: ${formatearMoneda(l.producto.precio_venta)} c/u</span>
            <input data-precio-de="${escaparHtml(l.producto.id)}" type="text" inputmode="decimal" placeholder="${l.producto.precio_venta.toFixed(2)}" value="${mismoModo && l.precioPromotor !== undefined ? l.precioPromotor.toFixed(2) : ''}" aria-label="Precio al que paga el cliente por cada uno, en dólares" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base tabular-nums text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          </label>
        </li>`
      )
      .join('');
    campoClaveSupervisor.value = '';
    errorPrecio.classList.add('hidden');
    // Un solo promotor por venta: si ya se anotó, sus datos quedan para corregirlos
    const previo = mismoModo ? (promotorVenta?.datos ?? promotorInstalacion ?? undefined) : undefined;
    const cedulaPrevia = (previo?.cedula ?? '').toUpperCase().match(/^([VE])-?(\d+)$/);
    promotorNac.value = cedulaPrevia?.[1] ?? 'V';
    promotorCedula.value = cedulaPrevia?.[2] ?? '';
    promotorNombre.value = unirNombre(previo?.nombre, previo?.apellido);
    promotorTelefono.value = previo?.telefono ?? '';
    promotorBanco.value = previo?.banco ?? '';
    promotorRegistrado.classList.add('hidden');
    selectorPromotor.cerrar();
    botonAutorizar.disabled = false;
    textoComision();
    dialogoPrecio.showModal();
    const destacado = productoDestacado ? camposPrecio().find((c) => c.dataset.precioDe === productoDestacado) : undefined;
    (destacado ?? camposPrecio()[0])?.focus();
  }

  /** Datos que se anotaron del promotor (todo opcional); null y un mensaje si algo está mal escrito. */
  function leerPromotor(): { datos: DatosPromotor } | { error: string } {
    const datos: DatosPromotor = {
      cedula: promotorCedula.value.trim() ? `${promotorNac.value}-${promotorCedula.value.trim()}` : null,
      ...separarNombreCompleto(promotorNombre.value),
      telefono: promotorTelefono.value,
      banco: promotorBanco.value,
    };
    const r = normalizarPromotor(datos);
    return r.ok ? { datos } : { error: r.mensaje };
  }

  function cerrarPrecioPromotor() {
    campoClaveSupervisor.value = ''; // la contraseña de quien autoriza nunca queda en pantalla ni en memoria de la página
    dialogoPrecio.close();
  }

  // Al escribir la cédula de un promotor ya registrado se completan sus datos (solo lo que está vacío: nada de lo escrito se pisa)
  let esperaPromotor: number | undefined;
  let consultaPromotor = 0;
  async function completarPromotorRegistrado() {
    const numero = promotorCedula.value.trim();
    promotorRegistrado.classList.add('hidden');
    if (numero.length < 5) return;
    const actual = ++consultaPromotor;
    try {
      const encontrado = await inventoryService.buscarPromotorPorCedula(`${promotorNac.value}-${numero}`);
      if (!encontrado || actual !== consultaPromotor) return;
      if (!promotorNombre.value.trim()) promotorNombre.value = unirNombre(encontrado.nombre, encontrado.apellido);
      if (!promotorTelefono.value.trim() && encontrado.telefono) promotorTelefono.value = encontrado.telefono;
      if (!promotorBanco.value.trim() && encontrado.banco) promotorBanco.value = encontrado.banco;
      promotorRegistrado.textContent = `Promotor registrado: ${`${encontrado.nombre} ${encontrado.apellido}`.trim()}. Se completaron sus datos.`;
      promotorRegistrado.classList.remove('hidden');
    } catch {
      /* sin conexión o sin permiso: se escriben a mano */
    }
  }
  const programarBusquedaPromotor = () => {
    window.clearTimeout(esperaPromotor);
    esperaPromotor = window.setTimeout(() => void completarPromotorRegistrado(), 350);
  };
  // Lista de promotores registrados en este local: al elegir uno se llenan sus datos
  const selectorPromotor = montarSelectorPromotor({
    boton: document.getElementById('pos-promotor-lista-abrir')!,
    panel: document.getElementById('pos-promotor-lista')!,
    buscador: document.getElementById('pos-promotor-lista-buscar') as HTMLInputElement,
    lista: document.getElementById('pos-promotor-lista-items')!,
    vacio: document.getElementById('pos-promotor-lista-vacio')!,
    cargar: () => inventoryService.listarPromotoresDelLocal(),
    alElegir: (p) => {
      const c = partirCedula(p.cedula);
      promotorNac.value = c.nac;
      promotorCedula.value = c.numero;
      promotorNombre.value = unirNombre(p.nombre, p.apellido);
      promotorTelefono.value = p.telefono ?? '';
      promotorBanco.value = p.banco ?? '';
      promotorRegistrado.textContent = `Promotor registrado: ${`${p.nombre} ${p.apellido}`.trim()}. Se completaron sus datos.`;
      promotorRegistrado.classList.remove('hidden');
    },
  });
  promotorNac.addEventListener('change', programarBusquedaPromotor);
  promotorCedula.addEventListener('input', () => {
    promotorCedula.value = promotorCedula.value.replace(/\D/g, '');
    programarBusquedaPromotor();
  });
  listaPrecio.addEventListener('input', textoComision);
  document.getElementById('pos-precio-cancelar')!.addEventListener('click', cerrarPrecioPromotor);
  dialogoPrecio.addEventListener('close', () => (campoClaveSupervisor.value = ''));
  document.getElementById('pos-confirmar-total-btn')!.addEventListener('click', () => elegirModoPrecio());

  formPrecio.addEventListener('submit', async (e) => {
    e.preventDefault();
    for (const campo of camposPrecio()) {
      const linea = carrito.find((l) => l.producto.id === campo.dataset.precioDe);
      if (!linea || campo.value.trim() === '') continue;
      const valor = numeroEscrito(campo.value);
      if (!Number.isFinite(valor) || valor <= 0) return errorDePrecio(`El precio de «${linea.producto.nombre}» no es válido.`);
    }
    const cambios = preciosEscritos();
    const hayDescuento = cambios.some(({ linea, precio }) => precio < linea.producto.precio_venta);
    const hayAumento = cambios.some(({ linea, precio }) => precio > linea.producto.precio_venta);

    // Todos los precios iguales al catálogo: todo vuelve al precio normal (no hace falta contraseña para volver al precio de lista)
    if (cambios.length === 0) {
      if (!carrito.some((l) => l.precioPromotor !== undefined)) return errorDePrecio('Escribe un precio distinto al del catálogo en alguno de los productos.');
      for (const l of carrito) {
        delete l.precioPromotor;
        delete l.listaAutorizada;
      }
      promotorVenta = null;
      autorizacionPrecio = null;
      cerrarPrecioPromotor();
      renderCarrito();
      pintarResumenConfirmar();
      return;
    }

    if (modoPrecio === 'promotor' && hayDescuento) return errorDePrecio('En el precio de promotor el precio no puede ser menor al del catálogo. Para un descuento elige «Precio del local».');
    // El promotor solo existe en el precio de promotor (con un precio mayor); el precio del local no lleva promotor
    const promotor: { datos: DatosPromotor } | { error: string } = modoPrecio === 'promotor' && hayAumento ? leerPromotor() : { datos: { cedula: null, nombre: '', apellido: '', telefono: '' } };
    if ('error' in promotor) return errorDePrecio(promotor.error);
    // Solo el precio del local pide contraseña (el de promotor, siempre más caro que el catálogo, no)
    if (modoPrecio === 'local' && !campoClaveSupervisor.value) return errorDePrecio(hayDescuento ? 'Escribe la contraseña de un gerente o administrador.' : 'Escribe la contraseña de un encargado, gerente o administrador.');

    errorPrecio.classList.add('hidden');
    botonAutorizar.disabled = true;
    botonAutorizar.textContent = 'Verificando...';
    try {
      const aut = await inventoryService.autorizarPrecioVenta({
        clave: modoPrecio === 'local' ? campoClaveSupervisor.value : undefined,
        promotor: promotor.datos,
        modo: modoPrecio,
        lineas: cambios.map(({ linea, precio }) => ({ producto_id: linea.producto.id, precio })),
      });
      for (const l of carrito) {
        delete l.precioPromotor;
        delete l.listaAutorizada;
      }
      for (const { linea, precio } of cambios) {
        linea.precioPromotor = precio;
        linea.listaAutorizada = linea.producto.precio_venta;
      }
      promotorVenta = { datos: promotor.datos, nombre: aut.promotor };
      autorizacionPrecio = aut;
      // Si el mismo promotor instala, sus datos se conservan aunque después se quite el precio de promotor
      if (carrito.some((l) => l.instalacion?.por === 'PROMOTOR') && (promotor.datos.cedula || promotor.datos.nombre)) promotorInstalacion = promotor.datos;
      cerrarPrecioPromotor();
      renderCarrito();
      pintarResumenConfirmar();
    } catch (err) {
      campoClaveSupervisor.value = '';
      errorDePrecio(err instanceof Error ? err.message : 'No se pudo autorizar el precio.');
      campoClaveSupervisor.focus();
    } finally {
      botonAutorizar.disabled = false;
      botonAutorizar.textContent = 'Autorizar';
    }
  });

  function quitarPrecioPromotor(productoId: string) {
    const linea = carrito.find((l) => l.producto.id === productoId);
    if (!linea) return;
    delete linea.precioPromotor;
    delete linea.listaAutorizada;
    if (!carrito.some((l) => l.precioPromotor !== undefined)) {
      promotorVenta = null;
      autorizacionPrecio = null;
    }
    limpiarError();
    renderCarrito();
    if (dialogoConfirmar.open) pintarResumenConfirmar();
  }

  /** Si la autorización venció (dura 20 minutos), las líneas vuelven al precio de catálogo y se avisa; devuelve si venció. */
  function autorizacionVencida(): boolean {
    if (!autorizacionPrecio || autorizacionPrecio.vence_en > Date.now() + 15_000) return false;
    for (const l of carrito) {
      delete l.precioPromotor;
      delete l.listaAutorizada;
    }
    renderCarrito();
    mostrarError('La autorización del precio venció: las líneas volvieron al precio de catálogo. Vuelve a pedir la autorización.');
    return true;
  }

  let pausaBusqueda: ReturnType<typeof setTimeout> | undefined;
  buscador.addEventListener('input', () => {
    clearTimeout(pausaBusqueda);
    pausaBusqueda = setTimeout(() => renderResultados(buscador.value), 120);
  });

  /** Busca un código de barras exacto (tecleado + Enter, lector físico USB, o cámara) y lo agrega al carrito. */
  async function buscarYAgregarPorCodigo(codigo: string) {
    const coincidenciaLocal = productos.find((p) => p.codigo_barras === codigo || (p.referencia ?? '') === normalizarReferencia(codigo));
    if (!coincidenciaLocal) {
      mostrarError(`No se encontró ningún producto con el código "${codigo}".`);
      return;
    }

    // Relee el producto por si su stock cambió desde otra sesión/pestaña
    const fresco = await inventoryService.obtenerProductoPorCodigoBarras(codigo);
    if (fresco) {
      productos = productos.map((p) => (p.id === fresco.id ? fresco : p));
      agregarAlCarrito(fresco.id);
      buscador.value = '';
      renderResultados('');
    }
  }

  /**
   * Agrega lo que identifica un código: el de UNA unidad (etiqueta propia: se agrega esa unidad exacta) o, como
   * respaldo, el código del producto (empaque de fábrica: se agrega una unidad cualquiera). Devuelve si se agregó.
   */
  async function agregarPorCodigo(codigoCrudo: string, aceptarNumeroCorto = false): Promise<boolean> {
    limpiarError();
    // En el campo del lector, escribir el código abreviado de la etiqueta ("inf14" → INF000014) equivale a escanearla
    const codigo = (aceptarNumeroCorto ? normalizarCodigoUnidad(codigoCrudo) : null) ?? codigoCrudo.trim();
    if (!codigo) return false;
    if (!esCodigoUnidad(codigo)) {
      const antes = carrito.reduce((suma, l) => suma + l.cantidad, 0);
      await buscarYAgregarPorCodigo(codigo);
      return carrito.reduce((suma, l) => suma + l.cantidad, 0) > antes;
    }

    let unidad: UnidadProducto | null;
    try {
      unidad = await inventoryService.obtenerUnidadPorCodigo(codigo);
    } catch {
      mostrarError('No se pudo consultar ese código (¿sin conexión?). Busca el producto por nombre o modelo.');
      alertarUnidad({ titulo: 'No se pudo consultar el código', detalle: 'Revisa la conexión o busca el producto por nombre o modelo.' });
      return false;
    }
    if (!unidad) {
      // Un código de fábrica puede parecerse al de una unidad (letras y números): si es de un producto, se agrega por el producto
      const crudo = codigoCrudo.trim();
      if (productos.some((p) => p.codigo_barras === crudo || (p.referencia ?? '') === normalizarReferencia(crudo))) {
        const antes = carrito.reduce((suma, l) => suma + l.cantidad, 0);
        await buscarYAgregarPorCodigo(crudo);
        return carrito.reduce((suma, l) => suma + l.cantidad, 0) > antes;
      }
      const alerta = alertaUnidadNoVendible(null, codigo, localActivoId)!;
      mostrarError(alerta.detalle);
      alertarUnidad(alerta);
      return false;
    }
    const noVendible = alertaUnidadNoVendible(unidad, codigo, localActivoId);
    if (noVendible) {
      mostrarError(noVendible.detalle);
      alertarUnidad(noVendible);
      return false;
    }
    const producto = productos.find((p) => p.id === unidad!.producto_id);
    if (!producto) {
      mostrarError('Esa unidad pertenece a un producto que este local no maneja.');
      alertarUnidad({ titulo: 'Producto no disponible aquí', detalle: 'Esa unidad pertenece a un producto que este local no maneja.' });
      return false;
    }
    if (carrito.some((l) => l.unidades.includes(codigo))) {
      alertarUnidad({ titulo: 'Esa pieza ya está en el carrito', detalle: `La pieza ${codigo} ya la agregaste a esta venta.` });
      return false;
    }
    return agregarUnidad(producto, codigo);
  }

  /**
   * ¿Lo escrito es un código (de una etiqueta o de fábrica) y no una búsqueda por nombre? El código completo de una etiqueta
   * (INF000026), un código de barras largo o la referencia/código exacto de un producto lo son siempre. El abreviado ("inf14") solo
   * si no coincide con ningún nombre, categoría o modelo (para que "note13" no se confunda con una pieza).
   */
  function pareceCodigo(texto: string): boolean {
    const t = texto.trim();
    if (!t) return false;
    if (esCodigoUnidad(t.toUpperCase()) || /^\d{6,}$/.test(t)) return true;
    if (productos.some((p) => p.codigo_barras === t || (p.referencia ?? '') === normalizarReferencia(t))) return true;
    const abreviado = normalizarCodigoUnidad(t);
    if (abreviado === null || filtrarProductos(t).length > 0) return false;
    // Solo si ese prefijo existe en algún producto ("note13" no es una pieza: es una búsqueda mal escrita)
    const prefijo = prefijoDelCodigo(abreviado);
    return productos.some((p) => p.prefijo_codigo === prefijo || (p.referencia ?? '').startsWith(prefijo + '-'));
  }

  campoCodigo.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    const texto = campoCodigo.value;
    if (!pareceCodigo(texto)) return; // es una búsqueda por nombre: la lista ya está filtrada
    void agregarPorCodigo(texto, true).then((agregado) => {
      if (agregado) {
        campoCodigo.value = '';
        clearTimeout(pausaBusqueda);
        renderResultados('');
      }
      campoCodigo.select();
    });
  });

  // Escaneo con cámara (ver src/components/CamaraEscaner.astro): agrega directo al carrito.
  window.addEventListener('easystem:codigo-escaneado', ((e: CustomEvent<{ codigo: string }>) => {
    if (escaneoAbierto()) {
      void registrarEscaneo(e.detail.codigo);
      return;
    }
    void agregarPorCodigo(e.detail.codigo);
  }) as EventListener);

  // --- Seleccionar código: producto → unidades disponibles ------------------------------------------------
  const dialogoSelector = document.getElementById('pos-selector') as HTMLDialogElement;
  const selBuscar = document.getElementById('pos-selector-buscar') as HTMLInputElement;
  const selLista = document.getElementById('pos-selector-lista') as HTMLUListElement;
  const selAyuda = document.getElementById('pos-selector-ayuda') as HTMLParagraphElement;
  const selVolver = document.getElementById('pos-selector-volver') as HTMLButtonElement;
  const selClaveBloque = document.getElementById('pos-selector-clave-bloque') as HTMLDivElement;
  const selClave = document.getElementById('pos-selector-clave') as HTMLInputElement;
  const selAutorizado = document.getElementById('pos-selector-autorizado') as HTMLParagraphElement;
  const selError = document.getElementById('pos-selector-error') as HTMLParagraphElement;
  let selProducto: ProductoConRelaciones | null = null;
  let selUnidades: UnidadProducto[] = [];

  function errorSelector(mensaje: string) {
    selError.textContent = mensaje;
    selError.classList.remove('hidden');
  }

  /** Elegir a mano la unidad pide la contraseña de un supervisor (una vez por producto, vale 20 minutos); sin producto elegido no se muestra nada. */
  function pintarSelectorAutorizacion() {
    const aut = selProducto ? autorizacionManualVigente(selProducto.id) : null;
    selClaveBloque.classList.toggle('hidden', !selProducto || !!aut);
    selAutorizado.classList.toggle('hidden', !aut);
    if (aut) selAutorizado.textContent = `Autorizado por ${aut.nombre}`;
    selError.classList.add('hidden');
  }

  async function elegirUnidadDelSelector(codigo: string, boton: HTMLButtonElement) {
    if (!selProducto) return;
    selError.classList.add('hidden');
    let aut = autorizacionManualVigente(selProducto.id);
    if (!aut) {
      if (!selClave.value) return errorSelector('Escribe la contraseña de un encargado, gerente o administrador.');
      boton.disabled = true;
      try {
        const r = await inventoryService.autorizarCodigoManual({ clave: selClave.value, producto_id: selProducto.id });
        aut = { token: r.token, nombre: r.autorizado_por, vence_en: r.vence_en, codigos: manualPorProducto.get(selProducto.id)?.codigos ?? new Set<string>() };
        manualPorProducto.set(selProducto.id, aut);
      } catch (err) {
        selClave.value = ''; // la contraseña de quien autoriza no se queda escrita
        boton.disabled = false;
        return errorSelector(err instanceof Error ? err.message : 'No se pudo verificar la autorización.');
      }
      selClave.value = '';
      pintarSelectorAutorizacion();
    }
    // La unidad entra al carrito y queda marcada como elegida a mano (la venta guarda quién lo autorizó)
    if (agregarUnidad(selProducto, codigo)) aut.codigos.add(codigo);
    pintarSelectorUnidades();
  }

  function pintarSelectorProductos() {
    const lista = filtrarProductos(selBuscar.value).filter((p) => p.stock_actual > 0 && !esPorCantidad(p));
    selLista.innerHTML = lista.length
      ? lista
          .slice(0, 40)
          .map(
            (p) => `
          <li>
            <button type="button" data-sel-producto="${p.id}" class="flex w-full items-center gap-3 px-5 py-3 text-left hover:bg-slate-50 dark:hover:bg-slate-800">
              ${htmlMiniatura(p.imagen_url, p.nombre, 'h-10 w-10')}
              <span class="min-w-0 flex-1">
                <span class="block break-words text-sm font-medium text-slate-900 dark:text-white">${escaparHtml(p.nombre)}</span>
                <span class="block break-words text-xs text-slate-500 dark:text-slate-400">${escaparHtml(p.categoria)} · ${precioEnLinea(p.precio_venta, bsFijoDe(p))}</span>
              </span>
              <span class="shrink-0 text-xs text-slate-500 dark:text-slate-400">${p.stock_actual} u.</span>
            </button>
          </li>`
          )
          .join('')
      : '<li class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">No hay productos con stock que coincidan.</li>';
  }

  function pintarSelectorUnidades() {
    if (!selProducto) return;
    const q = selBuscar.value.trim();
    const enCarrito = new Set(carrito.flatMap((l) => l.unidades));
    const lista = selUnidades.filter((u) => !q || u.codigo.includes(q));
    selLista.innerHTML = lista.length
      ? lista
          .map((u) => {
            const tomada = enCarrito.has(u.codigo);
            return `
          <li class="flex items-center justify-between gap-3 px-5 py-2.5">
            <span class="min-w-0">
              <span class="block font-mono text-sm text-slate-900 dark:text-white">${escaparHtml(u.codigo)}</span>
              ${u.impresa_en ? '' : '<span class="block text-[11px] text-amber-600 dark:text-amber-400">Aún sin etiqueta impresa</span>'}
            </span>
            <button type="button" data-sel-unidad="${escaparHtml(u.codigo)}" ${tomada ? 'disabled' : ''} class="shrink-0 rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:dark:bg-slate-700">${tomada ? 'En el carrito' : '+ Agregar'}</button>
          </li>`;
          })
          .join('')
      : `<li class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">${selUnidades.length ? 'Ningún código coincide.' : 'Este producto no tiene unidades disponibles.'}</li>`;
  }

  async function elegirProductoDelSelector(id: string) {
    const producto = productos.find((p) => p.id === id);
    if (!producto) return;
    selProducto = producto;
    selBuscar.value = '';
    selBuscar.placeholder = 'Filtrar por código (ej. los últimos dígitos)...';
    selBuscar.inputMode = 'numeric';
    selVolver.classList.remove('hidden');
    pintarSelectorAutorizacion();
    selAyuda.textContent = `${producto.nombre}: elige la unidad que vas a vender.`;
    selLista.innerHTML = '<li class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">Cargando unidades...</li>';
    try {
      selUnidades = await inventoryService.listarUnidades({ productoId: id, estado: 'DISPONIBLE' });
    } catch {
      selUnidades = [];
      selLista.innerHTML = '<li class="px-5 py-6 text-sm text-red-600 dark:text-red-400">No se pudieron cargar las unidades (¿sin conexión?).</li>';
      return;
    }
    pintarSelectorUnidades();
  }

  function volverAProductos() {
    selProducto = null;
    selBuscar.value = '';
    selBuscar.placeholder = 'Nombre, categoría o modelo...';
    selBuscar.inputMode = 'text';
    selVolver.classList.add('hidden');
    pintarSelectorAutorizacion();
    selAyuda.textContent = 'Busca el producto y elige la unidad que vas a vender.';
    pintarSelectorProductos();
    selBuscar.focus();
  }

  document.getElementById('pos-seleccionar-codigo')!.addEventListener('click', () => {
    limpiarError();
    volverAProductos();
    dialogoSelector.showModal();
  });
  document.getElementById('pos-selector-cerrar')!.addEventListener('click', () => dialogoSelector.close());
  document.getElementById('pos-selector-listo')!.addEventListener('click', () => dialogoSelector.close());
  dialogoSelector.addEventListener('click', (e) => {
    if (e.target === dialogoSelector) dialogoSelector.close();
  });
  dialogoSelector.addEventListener('close', () => {
    selClave.value = '';
    enfocarCodigo();
  });
  selVolver.addEventListener('click', volverAProductos);
  selBuscar.addEventListener('input', () => (selProducto ? pintarSelectorUnidades() : pintarSelectorProductos()));
  selLista.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;
    const producto = objetivo.closest<HTMLElement>('[data-sel-producto]')?.dataset.selProducto;
    if (producto) return void elegirProductoDelSelector(producto);
    const codigo = objetivo.closest<HTMLElement>('[data-sel-unidad]')?.dataset.selUnidad;
    const botonUnidad = objetivo.closest<HTMLButtonElement>('[data-sel-unidad]');
    if (codigo && botonUnidad && selProducto) void elegirUnidadDelSelector(codigo, botonUnidad);
  });

  // --- Pasos de "Procesar venta": 1) escanear el QR de cada unidad, 2) datos del cliente, 3) cobro ---------------------------
  type Paso = 'escaneo' | 'cliente' | 'pago';
  const TITULO_PASO: Record<Paso, string> = { escaneo: 'Escanea lo que vas a vender', cliente: 'Datos del cliente', pago: 'Cobro' };
  let pasos: Paso[] = ['cliente', 'pago'];
  let pasoActual = 0;

  const listaEscaneo = document.getElementById('pos-escaneo-lista') as HTMLUListElement;
  const campoEscaneo = document.getElementById('pos-escaneo-codigo') as HTMLInputElement;
  const errorEscaneo = document.getElementById('pos-escaneo-error') as HTMLParagraphElement;
  const botonSinConexion = document.getElementById('pos-escaneo-sinconexion') as HTMLButtonElement;
  const botonSiguiente = document.getElementById('pos-confirmar-si') as HTMLButtonElement;
  const botonAtras = document.getElementById('pos-confirmar-no') as HTMLButtonElement;
  const escaneoAbierto = () => dialogoConfirmar.open && pasos[pasoActual] === 'escaneo';

  /** Líneas del carrito con unidades todavía sin escanear. */
  const pendientesDeEscanear = () => carrito.filter((l) => !esPorCantidad(l.producto) && l.unidades.length < l.cantidad);

  function pintarEscaneo() {
    listaEscaneo.innerHTML = carrito
      .map((l) => {
        const porCantidad = esPorCantidad(l.producto);
        const hecho = porCantidad || l.unidades.length >= l.cantidad;
        const chips = l.unidades.map((c) => `<span class="rounded bg-emerald-50 px-1.5 py-0.5 font-mono text-[10px] text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300">${escaparHtml(c)}</span>`).join(' ');
        return `<li class="flex items-center justify-between gap-3 px-3 py-2">
          <div class="min-w-0"><p class="font-medium">${escaparHtml(l.producto.nombre)}</p><div class="mt-1 flex flex-wrap gap-1">${chips}</div>${hecho ? '' : `<button type="button" data-manual="${l.producto.id}" class="mt-1.5 text-xs font-medium text-brand-700 hover:underline dark:text-brand-300">No lee el código</button>`}</div>
          <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-semibold ${hecho ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-300' : 'bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300'}">${porCantidad ? 'Por cantidad' : hecho ? 'Listo' : `${l.unidades.length} de ${l.cantidad}`}</span>
        </li>`;
      })
      .join('');
  }

  /** Muestra solo la sección del paso actual y ajusta el encabezado, la barra de avance y los botones. */
  function pintarPasos() {
    const paso = pasos[pasoActual];
    for (const seccion of dialogoConfirmar.querySelectorAll<HTMLElement>('[data-paso]')) seccion.classList.toggle('hidden', seccion.dataset.paso !== paso);
    // Con un solo paso (cobro rápido) no hace falta «Paso 1 de 1»
    document.getElementById('pos-confirmar-resumen')!.textContent = pasos.length === 1 ? TITULO_PASO[paso] : `Paso ${pasoActual + 1} de ${pasos.length} · ${TITULO_PASO[paso]}`;
    document.getElementById('pos-pasos')!.classList.toggle('hidden', pasos.length === 1);
    document.getElementById('pos-pasos')!.innerHTML = pasos
      .map((_, i) => `<li class="h-1.5 flex-1 rounded-full ${i <= pasoActual ? 'bg-brand-600' : 'bg-slate-200 dark:bg-slate-700'}"></li>`)
      .join('');
    // La lista de productos y el aviso de stock solo en el cobro; el total, siempre
    document.getElementById('pos-confirmar-lineas')!.classList.toggle('hidden', paso !== 'pago');
    document.getElementById('pos-confirmar-nota')!.classList.toggle('hidden', paso !== 'pago');
    errorConfirmar.classList.add('hidden');
    errorEscaneo.classList.add('hidden');
    botonSinConexion.classList.toggle('hidden', !(paso === 'escaneo' && navigator.onLine === false));

    const ultimo = pasoActual === pasos.length - 1;
    botonAtras.textContent = pasoActual === 0 ? 'Cancelar' : 'Atrás';
    botonSiguiente.textContent = ultimo ? 'Sí, procesar venta' : 'Siguiente';
    botonSiguiente.disabled = paso === 'escaneo' && pendientesDeEscanear().length > 0;
    if (paso === 'escaneo') pintarEscaneo();
  }

  function enfocarPaso() {
    const paso = pasos[pasoActual];
    // En el POS la pistola lectora escribe y manda Enter: el foco va siempre al campo del paso
    (paso === 'escaneo' ? campoEscaneo : paso === 'cliente' ? campoCedula : null)?.focus();
  }

  function irAlPaso(paso: Paso) {
    const i = pasos.indexOf(paso);
    if (i < 0 || i === pasoActual) return;
    pasoActual = i;
    pintarPasos();
    enfocarPaso();
  }
  function avanzar() {
    if (pasoActual >= pasos.length - 1) return;
    pasoActual += 1;
    pintarPasos();
    enfocarPaso();
  }
  function retroceder() {
    if (pasoActual <= 0) return;
    pasoActual -= 1;
    pintarPasos();
    enfocarPaso();
  }

  function errorDeEscaneo(mensaje: string, red = false) {
    errorEscaneo.textContent = mensaje;
    errorEscaneo.classList.remove('hidden');
    botonSinConexion.classList.toggle('hidden', !red && navigator.onLine !== false);
  }

  /** Procesar venta: abre el diálogo en su primer paso (escanear lo pendiente, o directamente los datos del cliente). */
  function iniciarCobro() {
    if (carrito.length === 0 || dialogoConfirmar.open) return;
    pedirConfirmacion();
  }

  function terminarEscaneoSiCompleto() {
    pintarEscaneo();
    botonSiguiente.disabled = pendientesDeEscanear().length > 0;
    if (pendientesDeEscanear().length > 0) return;
    renderCarrito();
    avanzar(); // todo escaneado: se pasa solo a los datos del cliente
  }

  /** Un código escaneado (o escrito) durante este paso: debe ser de una unidad de lo que se está vendiendo y que aún no se escaneó. */
  async function registrarEscaneo(codigoCrudo: string): Promise<boolean> {
    errorEscaneo.classList.add('hidden');
    const codigo = normalizarCodigoUnidad(codigoCrudo) ?? codigoCrudo.trim();
    if (!codigo) return false;
    if (!esCodigoUnidad(codigo)) {
      errorDeEscaneo('Escanea el QR de la etiqueta de la unidad (no el código del empaque de fábrica).');
      return false;
    }
    if (carrito.some((l) => l.unidades.includes(codigo))) {
      errorDeEscaneo(`La unidad ${codigo} ya está en esta venta.`);
      return false;
    }
    let unidad: UnidadProducto | null;
    try {
      unidad = await inventoryService.obtenerUnidadPorCodigo(codigo);
    } catch (err) {
      errorDeEscaneo('No se pudo consultar ese código (¿sin conexión?).', esErrorDeRed(err));
      return false;
    }
    const noVendible = alertaUnidadNoVendible(unidad, codigo, localActivoId);
    if (noVendible) {
      errorDeEscaneo(`${noVendible.titulo}. ${noVendible.detalle}`);
      vibrar();
      return false;
    }
    if (!unidad) return false;
    const linea = carrito.find((l) => l.producto.id === unidad!.producto_id && !esPorCantidad(l.producto) && l.unidades.length < l.cantidad);
    if (!linea) {
      const enCarrito = carrito.find((l) => l.producto.id === unidad!.producto_id);
      const nombre = enCarrito?.producto.nombre ?? productos.find((p) => p.id === unidad!.producto_id)?.nombre ?? 'otro producto';
      errorDeEscaneo(
        enCarrito
          ? `Ya escaneaste todas las unidades de «${nombre}» de esta venta.`
          : `Esa unidad es de «${nombre}», que no está en esta venta. Escanea solo lo que vas a vender.`
      );
      return false;
    }
    linea.unidades.push(codigo);
    terminarEscaneoSiCompleto();
    return true;
  }

  campoEscaneo.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    e.stopPropagation();
    void registrarEscaneo(campoEscaneo.value).then((ok) => {
      if (ok) campoEscaneo.value = '';
      else campoEscaneo.select();
    });
  });
  // Sin conexión no se puede reconocer cada unidad: se deja vender y el sistema asigna las unidades más antiguas (como antes)
  botonSinConexion.addEventListener('click', () => avanzar());

  // --- "No lee el código": elegir a mano la unidad, con la contraseña de un supervisor ------------------------------
  // La etiqueta está dañada o el lector no la reconoce: se ve la lista de códigos disponibles del producto y se elige el que corresponde.
  // Un encargado/gerente/administrador lo autoriza con su contraseña (vale 20 minutos para ese producto); la venta guarda
  // cuáles códigos se eligieron a mano y quién lo autorizó.
  const dialogoManual = document.getElementById('pos-manual') as HTMLDialogElement;
  const manualBuscar = document.getElementById('pos-manual-buscar') as HTMLInputElement;
  const manualLista = document.getElementById('pos-manual-lista') as HTMLUListElement;
  const manualError = document.getElementById('pos-manual-error') as HTMLParagraphElement;
  const manualClave = document.getElementById('pos-manual-clave') as HTMLInputElement;
  const manualBloqueClave = document.getElementById('pos-manual-clave-bloque') as HTMLDivElement;
  const manualAutorizado = document.getElementById('pos-manual-autorizado') as HTMLParagraphElement;
  let manualProducto: ProductoConRelaciones | null = null;
  let manualUnidades: UnidadProducto[] = [];
  /** Por producto: la autorización vigente y los códigos que se eligieron a mano en esta venta */
  const manualPorProducto = new Map<string, { token: string; nombre: string; vence_en: number; codigos: Set<string> }>();

  const autorizacionManualVigente = (productoId: string) => {
    const a = manualPorProducto.get(productoId);
    return a && a.vence_en > Date.now() + 15_000 ? a : null;
  };

  function errorManual(mensaje: string) {
    manualError.textContent = mensaje;
    manualError.classList.remove('hidden');
  }

  function pintarManual() {
    if (!manualProducto) return;
    const linea = carrito.find((l) => l.producto.id === manualProducto!.id);
    const faltan = linea ? linea.cantidad - linea.unidades.length : 0;
    document.getElementById('pos-manual-producto')!.textContent = `${manualProducto.nombre} · faltan ${faltan} por elegir`;
    const aut = autorizacionManualVigente(manualProducto.id);
    manualBloqueClave.classList.toggle('hidden', !!aut);
    manualAutorizado.classList.toggle('hidden', !aut);
    if (aut) manualAutorizado.textContent = `Autorizado por ${aut.nombre}`;
    const q = manualBuscar.value.trim();
    const enCarrito = new Set(carrito.flatMap((l) => l.unidades));
    const lista = manualUnidades.filter((u) => !q || u.codigo.includes(q));
    manualLista.innerHTML = lista.length
      ? lista
          .map((u) => {
            const tomada = enCarrito.has(u.codigo);
            return `<li class="flex items-center justify-between gap-3 px-5 py-2.5">
              <span class="font-mono text-sm text-slate-900 dark:text-white">${escaparHtml(u.codigo)}</span>
              <button type="button" data-manual-unidad="${escaparHtml(u.codigo)}" ${tomada ? 'disabled' : ''} class="shrink-0 rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:dark:bg-slate-700">${tomada ? 'En la venta' : 'Elegir'}</button>
            </li>`;
          })
          .join('')
      : `<li class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">${manualUnidades.length ? 'Ningún código coincide.' : 'Este producto no tiene unidades disponibles.'}</li>`;
  }

  async function abrirManual(productoId: string) {
    const linea = carrito.find((l) => l.producto.id === productoId);
    if (!linea) return;
    manualProducto = linea.producto;
    manualUnidades = [];
    manualBuscar.value = '';
    manualClave.value = '';
    manualError.classList.add('hidden');
    manualLista.innerHTML = '<li class="px-5 py-6 text-sm text-slate-500 dark:text-slate-400">Cargando códigos...</li>';
    pintarManual();
    dialogoManual.showModal();
    try {
      manualUnidades = await inventoryService.listarUnidades({ productoId, estado: 'DISPONIBLE' });
    } catch {
      manualLista.innerHTML = '<li class="px-5 py-6 text-sm text-red-600 dark:text-red-400">No se pudieron cargar los códigos (¿sin conexión?).</li>';
      return;
    }
    pintarManual();
  }

  async function elegirManual(codigo: string, boton: HTMLButtonElement) {
    const linea = carrito.find((l) => l.producto.id === manualProducto?.id);
    if (!linea || !manualProducto) return;
    manualError.classList.add('hidden');
    let aut = autorizacionManualVigente(manualProducto.id);
    if (!aut) {
      if (!manualClave.value) return errorManual('Escribe la contraseña de un encargado, gerente o administrador.');
      boton.disabled = true;
      try {
        const r = await inventoryService.autorizarCodigoManual({ clave: manualClave.value, producto_id: manualProducto.id });
        aut = { token: r.token, nombre: r.autorizado_por, vence_en: r.vence_en, codigos: manualPorProducto.get(manualProducto.id)?.codigos ?? new Set<string>() };
        manualPorProducto.set(manualProducto.id, aut);
      } catch (err) {
        manualClave.value = ''; // la contraseña de quien autoriza no se queda escrita
        boton.disabled = false;
        return errorManual(err instanceof Error ? err.message : 'No se pudo verificar la autorización.');
      }
      manualClave.value = '';
    }
    if (linea.unidades.length >= linea.cantidad || carrito.some((l) => l.unidades.includes(codigo))) return pintarManual();
    linea.unidades.push(codigo);
    aut.codigos.add(codigo);
    const completo = linea.unidades.length >= linea.cantidad;
    if (completo) dialogoManual.close();
    else pintarManual();
    terminarEscaneoSiCompleto(); // refresca la lista del paso y, si ya está todo escaneado, pasa a los datos del cliente
  }

  /** Si la autorización de algún producto venció antes de cobrar, esas unidades elegidas a mano se sueltan (hay que volver a elegirlas). */
  function autorizacionesManualesVencidas(): boolean {
    let huboVencidas = false;
    for (const [productoId, a] of [...manualPorProducto]) {
      if (a.vence_en > Date.now() + 15_000) continue;
      const linea = carrito.find((l) => l.producto.id === productoId);
      if (linea) linea.unidades = linea.unidades.filter((c) => !a.codigos.has(c));
      manualPorProducto.delete(productoId);
      huboVencidas = true;
    }
    if (huboVencidas) {
      renderCarrito();
      mostrarError('Venció la autorización de los códigos elegidos a mano (dura 20 minutos). Toca Procesar venta y elígelos de nuevo.');
    }
    return huboVencidas;
  }

  listaEscaneo.addEventListener('click', (e) => {
    const productoId = (e.target as HTMLElement).closest<HTMLElement>('[data-manual]')?.dataset.manual;
    if (productoId) void abrirManual(productoId);
  });
  manualLista.addEventListener('click', (e) => {
    const boton = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-manual-unidad]');
    if (boton?.dataset.manualUnidad) void elegirManual(boton.dataset.manualUnidad, boton);
  });
  manualBuscar.addEventListener('input', pintarManual);
  document.getElementById('pos-manual-cerrar')!.addEventListener('click', () => dialogoManual.close());
  dialogoManual.addEventListener('click', (e) => {
    if (e.target === dialogoManual) dialogoManual.close();
  });
  dialogoManual.addEventListener('close', () => {
    manualClave.value = '';
    if (escaneoAbierto()) campoEscaneo.focus();
  });

  // Móvil: el carrito queda debajo de los productos; estos botones llevan hasta él (para cambiar cantidades o quitar productos)
  const irAlCarrito = () => document.getElementById('pos-carrito-seccion')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  document.getElementById('pos-barra-ver')?.addEventListener('click', irAlCarrito);
  document.getElementById('pos-barra-carrito')?.addEventListener('click', irAlCarrito);

  botonProcesar.addEventListener('click', iniciarCobro);
  barraCobrar.addEventListener('click', iniciarCobro);
  document.getElementById('pos-imprimir')?.addEventListener('click', () => window.print());
  document.getElementById('pos-nueva-venta')?.addEventListener('click', iniciarNuevaVenta);

  // Manda el ticket como IMAGEN al WhatsApp del cliente. Una página no puede elegir el chat desde el menú Compartir ni adjuntar una imagen
  // en un enlace wa.me (solo lleva texto), así que: se COPIA la imagen y se abre el chat de ESE número; el cajero mantiene pulsado el
  // cuadro de mensaje, toca "Pegar" y "Enviar". Sin portapapeles (o sin teléfono válido) se descarga la imagen.
  const botonWhatsApp = document.getElementById('pos-whatsapp') as HTMLButtonElement;
  const botonCompartir = document.getElementById('pos-compartir') as HTMLButtonElement;

  botonWhatsApp.addEventListener('click', async () => {
    if (!ultimaVenta) return;
    const venta = ultimaVenta;
    // Sin ningún "await" antes: el iPhone solo deja copiar al portapapeles dentro del toque del cajero (la imagen ya se está preparando)
    const copiada = copiarImagenAlPortapapeles((imagenTicket ??= archivoDeTicket(venta)));
    botonWhatsApp.disabled = true;
    try {
      const copiadaOk = await copiada;
      const chat = urlWhatsApp(venta.cliente_telefono);
      if (!copiadaOk) {
        descargarArchivos([await imagenTicket!]);
        if (chat) window.open(chat, '_blank', 'noopener');
        avisoWhatsApp(
          chat
            ? 'No se pudo copiar la imagen: se descargó. Adjúntala en el chat de WhatsApp del cliente (clip → Fotos/Archivos).'
            : 'La imagen del ticket se descargó. El teléfono del cliente no parece válido para abrir su chat.'
        );
        return;
      }
      if (!chat) {
        avisoWhatsApp(`Imagen copiada, pero el teléfono ${venta.cliente_telefono} no parece válido para WhatsApp. Pégala en el chat del cliente.`, true);
        return;
      }
      avisoWhatsApp(`Imagen copiada. En el chat de ${venta.cliente_nombre}: mantén pulsado el cuadro de mensaje, toca Pegar y Enviar.`);
      window.location.assign(chat);
    } catch (err) {
      imagenTicket = null;
      avisoWhatsApp(err instanceof Error ? err.message : 'No se pudo preparar la imagen del ticket.', true);
    } finally {
      botonWhatsApp.disabled = false;
    }
  });

  // Alternativa: el menú Compartir del teléfono (el cajero elige el chat); en una computadora no existe y se descarga la imagen
  botonCompartir.addEventListener('click', async () => {
    if (!ultimaVenta) return;
    botonCompartir.disabled = true;
    try {
      const archivo = await (imagenTicket ??= archivoDeTicket(ultimaVenta));
      if (puedeCompartirArchivos([archivo])) {
        await compartirArchivos([archivo], 'Ticket de venta · Edward Accesorios');
        avisoWhatsApp(`En WhatsApp elige el chat de ${ultimaVenta.cliente_nombre} (${ultimaVenta.cliente_telefono}).`);
      } else {
        descargarArchivos([archivo]);
        avisoWhatsApp('Este equipo no tiene el menú Compartir: la imagen del ticket se descargó.');
      }
    } catch (err) {
      imagenTicket = null;
      avisoWhatsApp(err instanceof Error ? err.message : 'No se pudo preparar la imagen del ticket.', true);
    } finally {
      botonCompartir.disabled = false;
    }
  });

  // --- Instalación de vidrios (Local Vidrios) ---------------------------------------------------------------------
  // Cada línea puede llevar instalación (precio por unidad, normalmente $3): «la instala el local» es ingreso de la tienda; «la instala el
  // promotor» se le entrega después al promotor (queda como pendiente junto con su comisión). Suma al total de la venta.
  const dialogoInst = document.getElementById('pos-instalacion') as HTMLDialogElement;
  const formInst = document.getElementById('pos-inst-form') as HTMLFormElement;
  const instPrecio = document.getElementById('pos-inst-precio') as HTMLInputElement;
  const instError = document.getElementById('pos-inst-error') as HTMLParagraphElement;
  const instNac = document.getElementById('pos-inst-nac') as HTMLSelectElement;
  const instCedula = document.getElementById('pos-inst-cedula') as HTMLInputElement;
  const instNombre = document.getElementById('pos-inst-nombre') as HTMLInputElement;
  const instTelefono = document.getElementById('pos-inst-telefono') as HTMLInputElement;
  const instBanco = document.getElementById('pos-inst-banco') as HTMLInputElement;
  const instRegistrado = document.getElementById('pos-inst-registrado') as HTMLParagraphElement;
  let instProductoId: string | null = null;

  const quienInstala = (): string => formInst.querySelector<HTMLInputElement>('input[name="pos-inst-quien"]:checked')?.value ?? 'NINGUNA';
  /** El promotor del precio (ya autorizado con su contraseña): si lo hay, la instalación del promotor es de ese mismo promotor */
  const promotorYaAutorizado = (): DatosPromotor | null => {
    const d = promotorVenta?.datos;
    return d && (d.cedula || d.nombre) ? d : null;
  };

  function actualizarInstalacion() {
    const por = quienInstala();
    const linea = carrito.find((l) => l.producto.id === instProductoId);
    const usd = numeroEscrito(instPrecio.value);
    document.getElementById('pos-inst-precio-caja')!.classList.toggle('hidden', por === 'NINGUNA');
    document.getElementById('pos-inst-promotor-caja')!.classList.toggle('hidden', por !== 'PROMOTOR');
    const autorizado = promotorYaAutorizado();
    const aviso = document.getElementById('pos-inst-promotor-actual')!;
    aviso.classList.toggle('hidden', !autorizado);
    if (autorizado) aviso.textContent = `Promotor de esta venta: ${promotorVenta?.nombre || autorizado.nombre || autorizado.cedula}. Esta instalación se le entrega a él.`;
    document.getElementById('pos-inst-promotor-campos')!.classList.toggle('hidden', !!autorizado);
    document.getElementById('pos-inst-resumen')!.textContent =
      linea && por !== 'NINGUNA' && usd > 0
        ? `${linea.cantidad} × ${formatearMoneda(usd)} = ${formatearMoneda(linea.cantidad * usd)}. Se suma al total de la venta.`
        : '';
  }

  function abrirInstalacion(productoId: string) {
    const linea = carrito.find((l) => l.producto.id === productoId);
    if (!linea) return;
    limpiarError();
    instProductoId = productoId;
    document.getElementById('pos-inst-producto')!.textContent = `${linea.cantidad} × ${linea.producto.nombre}`;
    const actual = linea.instalacion;
    formInst.querySelector<HTMLInputElement>(`input[name="pos-inst-quien"][value="${actual?.por ?? 'NINGUNA'}"]`)!.checked = true;
    instPrecio.value = (actual?.usd ?? INSTALACION_PREDETERMINADA_USD).toFixed(2);
    const previo = promotorInstalacion;
    const cedulaPrevia = (previo?.cedula ?? '').toUpperCase().match(/^([VE])-?(\d+)$/);
    instNac.value = cedulaPrevia?.[1] ?? 'V';
    instCedula.value = cedulaPrevia?.[2] ?? '';
    instNombre.value = unirNombre(previo?.nombre, previo?.apellido);
    instTelefono.value = previo?.telefono ?? '';
    instBanco.value = previo?.banco ?? '';
    selectorInst.cerrar();
    instRegistrado.classList.add('hidden');
    instError.classList.add('hidden');
    actualizarInstalacion();
    dialogoInst.showModal();
  }

  formInst.addEventListener('change', actualizarInstalacion);
  instPrecio.addEventListener('input', actualizarInstalacion);
  document.getElementById('pos-inst-cancelar')!.addEventListener('click', () => dialogoInst.close());

  // Al escribir la cédula de un promotor registrado se completan sus datos (solo lo que está vacío)
  let esperaInst: number | undefined;
  let consultaInst = 0;
  async function completarPromotorInstalacion() {
    const numero = instCedula.value.trim();
    instRegistrado.classList.add('hidden');
    if (numero.length < 5) return;
    const actual = ++consultaInst;
    try {
      const encontrado = await inventoryService.buscarPromotorPorCedula(`${instNac.value}-${numero}`);
      if (!encontrado || actual !== consultaInst) return;
      if (!instNombre.value.trim()) instNombre.value = unirNombre(encontrado.nombre, encontrado.apellido);
      if (!instTelefono.value.trim() && encontrado.telefono) instTelefono.value = encontrado.telefono;
      if (!instBanco.value.trim() && encontrado.banco) instBanco.value = encontrado.banco;
      instRegistrado.textContent = `Promotor registrado: ${`${encontrado.nombre} ${encontrado.apellido}`.trim()}. Se completaron sus datos.`;
      instRegistrado.classList.remove('hidden');
    } catch {
      /* sin conexión o sin permiso: se escriben a mano */
    }
  }
  const programarBusquedaInst = () => {
    window.clearTimeout(esperaInst);
    esperaInst = window.setTimeout(() => void completarPromotorInstalacion(), 350);
  };
  // Lista de promotores registrados en este local
  const selectorInst = montarSelectorPromotor({
    boton: document.getElementById('pos-inst-lista-abrir')!,
    panel: document.getElementById('pos-inst-lista')!,
    buscador: document.getElementById('pos-inst-lista-buscar') as HTMLInputElement,
    lista: document.getElementById('pos-inst-lista-items')!,
    vacio: document.getElementById('pos-inst-lista-vacio')!,
    cargar: () => inventoryService.listarPromotoresDelLocal(),
    alElegir: (p) => {
      const c = partirCedula(p.cedula);
      instNac.value = c.nac;
      instCedula.value = c.numero;
      instNombre.value = unirNombre(p.nombre, p.apellido);
      instTelefono.value = p.telefono ?? '';
      instBanco.value = p.banco ?? '';
      instRegistrado.textContent = `Promotor registrado: ${`${p.nombre} ${p.apellido}`.trim()}. Se completaron sus datos.`;
      instRegistrado.classList.remove('hidden');
    },
  });
  instNac.addEventListener('change', programarBusquedaInst);
  instCedula.addEventListener('input', () => {
    instCedula.value = instCedula.value.replace(/\D/g, '');
    programarBusquedaInst();
  });

  function errorDeInstalacion(mensaje: string) {
    instError.textContent = mensaje;
    instError.classList.remove('hidden');
  }

  formInst.addEventListener('submit', (e) => {
    e.preventDefault();
    const linea = carrito.find((l) => l.producto.id === instProductoId);
    if (!linea) return dialogoInst.close();
    const por = quienInstala();
    if (por === 'NINGUNA') {
      delete linea.instalacion;
      dialogoInst.close();
      renderCarrito();
      return;
    }
    const usd = Math.round(numeroEscrito(instPrecio.value) * 100) / 100;
    const problema = errorPrecioInstalacion(usd);
    if (problema) return errorDeInstalacion(problema);
    if (por === 'PROMOTOR' && !promotorYaAutorizado()) {
      const datos: DatosPromotor = {
        cedula: instCedula.value.trim() ? `${instNac.value}-${instCedula.value.trim()}` : null,
        ...separarNombreCompleto(instNombre.value),
        telefono: instTelefono.value,
        banco: instBanco.value,
      };
      const r = normalizarPromotor(datos);
      if (!r.ok) return errorDeInstalacion(r.mensaje);
      if (!r.promotor.cedula || !r.promotor.nombrePropio || !r.promotor.apellido) return errorDeInstalacion('Para pagarle al promotor anota su cédula, nombre y apellido (en el mismo campo).');
      promotorInstalacion = datos;
    }
    linea.instalacion = { por: por as QuienInstala, usd };
    dialogoInst.close();
    renderCarrito();
  });

  // --- Ventas en espera (Local Vidrios) ------------------------------------------------------------------------------------
  // El promotor apurado se lleva el vidrio y vuelve a pagar: el carrito queda guardado (y su mercancía reservada) y se retoma después.
  let esperas: Pendiente[] = [];
  /** La venta en espera que se está retomando en el carrito: al cobrar se cierra con la venta y no cuenta como reservada */
  let esperaActiva: { id: string; nombre: string } | null = null;
  const reservadoDe = (productoId: string): number =>
    esperas.filter((e) => e.id !== esperaActiva?.id).reduce((suma, e) => suma + (e.items ?? []).filter((i) => i.producto_id === productoId).reduce((s, i) => s + i.cantidad, 0), 0);

  const botonEsperaAbrir = document.getElementById('pos-espera-abrir') as HTMLButtonElement;
  const dialogoEspera = document.getElementById('pos-espera') as HTMLDialogElement;
  const formEspera = document.getElementById('pos-espera-form') as HTMLFormElement;
  const campoEsperaNombre = document.getElementById('pos-espera-nombre') as HTMLInputElement;
  const campoEsperaNota = document.getElementById('pos-espera-nota') as HTMLInputElement;
  const errorEspera = document.getElementById('pos-espera-error') as HTMLParagraphElement;
  const dialogoEsperaLista = document.getElementById('pos-espera-lista') as HTMLDialogElement;
  const listaEspera = document.getElementById('pos-espera-items') as HTMLUListElement;
  const errorEsperaLista = document.getElementById('pos-espera-lista-error') as HTMLParagraphElement;
  const bannerEspera = document.getElementById('pos-espera-banner') as HTMLElement;

  async function cargarEsperas() {
    if (!cobroRapido) return;
    try {
      esperas = await inventoryService.listarEspera();
    } catch {
      /* sin conexión o sin permiso: se conserva la última lista */
    }
    document.getElementById('pos-espera-n')!.textContent = String(esperas.length);
    if (dialogoEsperaLista.open) pintarListaEspera();
  }

  function pintarBannerEspera() {
    bannerEspera.classList.toggle('hidden', !esperaActiva);
    bannerEspera.classList.toggle('flex', !!esperaActiva);
    if (esperaActiva) document.getElementById('pos-espera-banner-texto')!.textContent = `Retomaste la venta en espera${esperaActiva.nombre ? ` de ${esperaActiva.nombre}` : ''}: al cobrarla queda cerrada.`;
  }

  const haceCuanto = (iso: string): string => {
    const min = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60_000));
    if (min < 1) return 'hace un momento';
    if (min < 60) return `hace ${min} min`;
    const h = Math.round(min / 60);
    return h < 24 ? `hace ${h} h` : `hace ${Math.round(h / 24)} d`;
  };

  function pintarListaEspera() {
    document.getElementById('pos-espera-vacia')!.classList.toggle('hidden', esperas.length > 0);
    listaEspera.innerHTML = esperas
      .map((e) => {
        const productosTexto = (e.items ?? []).map((i) => `${i.cantidad} × ${escaparHtml(i.nombre)}`).join(', ');
        const activa = e.id === esperaActiva?.id;
        return `<li class="space-y-2 px-5 py-3 text-sm">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-semibold">${e.promotor_nombre ? escaparHtml(e.promotor_nombre) : 'Sin nombre'}</p>
              <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">${escaparHtml(haceCuanto(e.fecha))} · ${escaparHtml(e.creado_por_nombre)}</p>
            </div>
            <span class="shrink-0 font-semibold tabular-nums">${formatearMoneda(e.monto_usd)}</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300">${productosTexto}</p>
          <div class="flex gap-2">
            ${
              activa
                ? '<span class="flex-1 rounded-lg bg-amber-50 px-3 py-2 text-center text-xs font-semibold text-amber-800 dark:bg-amber-500/10 dark:text-amber-300">En el carrito ahora</span>'
                : `<button type="button" data-retomar="${e.id}" class="bg-marca flex-1 rounded-lg px-3 py-2 text-sm font-semibold text-white shadow-sm hover:brightness-110">Retomar</button>`
            }
            <button type="button" data-liberar="${e.id}" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">Liberar</button>
          </div>
        </li>`;
      })
      .join('');
  }

  function errorDeLista(mensaje: string) {
    errorEsperaLista.textContent = mensaje;
    errorEsperaLista.classList.toggle('hidden', !mensaje);
  }

  async function abrirListaEspera() {
    errorDeLista('');
    await cargarEsperas();
    pintarListaEspera();
    if (!dialogoEsperaLista.open) dialogoEsperaLista.showModal();
  }

  /** Pone en el carrito los productos de una venta en espera (con sus precios de catálogo de hoy) para cobrarla. */
  async function retomarEspera(id: string): Promise<boolean> {
    if (carrito.length > 0) {
      errorDeLista('Termina o vacía la venta actual antes de retomar una en espera.');
      mostrarError('Termina o vacía la venta actual antes de retomar una en espera.');
      return false;
    }
    await cargarEsperas();
    const espera = esperas.find((e) => e.id === id);
    if (!espera) {
      errorDeLista('Esa venta en espera ya no existe: se cobró o se liberó.');
      mostrarError('Esa venta en espera ya no existe: se cobró o se liberó.');
      return false;
    }
    esperaActiva = { id: espera.id, nombre: espera.promotor_nombre ?? '' };
    await cargarProductos(); // ahora lo reservado por esta venta vuelve a estar disponible para su carrito
    const avisos: string[] = [];
    for (const item of espera.items ?? []) {
      const producto = productos.find((p) => p.id === item.producto_id);
      if (!producto) {
        avisos.push(`«${item.nombre}» ya no existe en el catálogo.`);
        continue;
      }
      const cantidad = Math.min(item.cantidad, producto.stock_actual);
      if (cantidad < item.cantidad) avisos.push(`De «${item.nombre}» solo hay ${producto.stock_actual} (se dejó ${item.cantidad}).`);
      if (cantidad > 0) carrito.push({ producto, cantidad, unidades: [] });
    }
    if (carrito.length === 0) {
      esperaActiva = null;
      await cargarProductos();
    }
    pintarBannerEspera();
    renderCarrito();
    renderResultados(buscador.value);
    if (dialogoEsperaLista.open) dialogoEsperaLista.close();
    if (avisos.length) mostrarError(avisos.join(' '));
    return carrito.length > 0;
  }

  botonEsperaAbrir.addEventListener('click', () => void abrirListaEspera());
  document.getElementById('pos-espera-lista-cerrar')!.addEventListener('click', () => dialogoEsperaLista.close());
  dialogoEsperaLista.addEventListener('click', (e) => {
    if (e.target === dialogoEsperaLista) dialogoEsperaLista.close();
  });
  listaEspera.addEventListener('click', async (e) => {
    const objetivo = e.target as HTMLElement;
    const retomar = objetivo.closest<HTMLButtonElement>('[data-retomar]')?.dataset.retomar;
    const liberar = objetivo.closest<HTMLButtonElement>('[data-liberar]')?.dataset.liberar;
    if (retomar) return void (await retomarEspera(retomar));
    if (!liberar) return;
    const espera = esperas.find((x) => x.id === liberar);
    if (!window.confirm(`¿Liberar la venta en espera${espera?.promotor_nombre ? ` de ${espera.promotor_nombre}` : ''}? La mercancía vuelve a estar disponible para vender.`)) return;
    try {
      await inventoryService.liberarEspera(liberar);
      if (esperaActiva?.id === liberar) {
        carrito = [];
        esperaActiva = null;
        pintarBannerEspera();
        renderCarrito();
      }
      errorDeLista('');
      await cargarProductos();
      pintarListaEspera();
    } catch (err) {
      errorDeLista(err instanceof Error ? err.message : 'No se pudo liberar la venta en espera.');
    }
  });

  document.getElementById('pos-espera-banner-cancelar')!.addEventListener('click', async () => {
    // Vaciar el carrito de la venta retomada: sigue en espera (reservada) y se puede retomar de nuevo
    carrito = [];
    manualPorProducto.clear();
    esperaActiva = null;
    pintarBannerEspera();
    renderCarrito();
    await cargarProductos();
  });

  // Desde el cobro: «Dejar en espera» guarda el carrito y lo vacía
  document.getElementById('pos-confirmar-espera')!.addEventListener('click', () => {
    if (carrito.length === 0) return;
    dialogoConfirmar.close();
    errorEspera.classList.add('hidden');
    campoEsperaNombre.value = esperaActiva?.nombre ?? '';
    campoEsperaNota.value = '';
    dialogoEspera.showModal();
    campoEsperaNombre.focus();
  });
  document.getElementById('pos-espera-cancelar')!.addEventListener('click', () => dialogoEspera.close());
  dialogoEspera.addEventListener('click', (e) => {
    if (e.target === dialogoEspera) dialogoEspera.close();
  });
  formEspera.addEventListener('submit', async (e) => {
    e.preventDefault();
    const boton = document.getElementById('pos-espera-guardar') as HTMLButtonElement;
    boton.disabled = true;
    boton.textContent = 'Guardando...';
    errorEspera.classList.add('hidden');
    try {
      // Si se estaba retomando una venta en espera y se vuelve a dejar, la anterior se libera para no reservar dos veces lo mismo
      if (esperaActiva) {
        await inventoryService.liberarEspera(esperaActiva.id);
        esperaActiva = null;
        pintarBannerEspera();
        await cargarEsperas();
      }
      await inventoryService.ponerEnEspera({
        items: carrito.map((l) => ({ producto_id: l.producto.id, cantidad: l.cantidad })),
        promotor_nombre: campoEsperaNombre.value,
        nota: campoEsperaNota.value,
      });
      dialogoEspera.close();
      carrito = [];
      manualPorProducto.clear();
      limpiarDatosCliente();
      renderCarrito();
      await cargarProductos();
      avisarEspera('Venta dejada en espera. Su mercancía quedó reservada.');
    } catch (err) {
      errorEspera.textContent = err instanceof Error ? err.message : 'No se pudo dejar la venta en espera.';
      errorEspera.classList.remove('hidden');
    } finally {
      boton.disabled = false;
      boton.textContent = 'Dejar en espera';
    }
  });

  /** Aviso corto de éxito en el carrito (se quita solo). */
  function avisarEspera(texto: string) {
    const aviso = document.getElementById('pos-espera-aviso')!;
    aviso.textContent = texto;
    aviso.classList.remove('hidden');
    window.setTimeout(() => aviso.classList.add('hidden'), 6000);
  }

  // El POS vende desde UN local: en la vista "Todos los locales" del administrador se pide elegir uno
  inventoryService.obtenerContextoLocal().then((contexto) => {
    puedeMarcarDanados = esGerencia(contexto?.sesion.rol);
    instalacionDisponible = contexto?.local?.tipo === 'vidrios';
    if (contexto?.local) {
      localActivoId = contexto.local.id;
      if (contexto.local.tipo === 'vidrios') activarCobroRapido(leerUltimoMetodo());
      // Desde Pendientes → «Cobrar ahora» se llega con ?espera=<id>: se retoma esa venta en cuanto carga el catálogo
      void cargarProductos().then(() => {
        const espera = new URLSearchParams(window.location.search).get('espera');
        if (espera && cobroRapido) {
          window.history.replaceState(null, '', window.location.pathname);
          void retomarEspera(espera);
        }
      });
      enfocarCodigo();
      // Otro dispositivo vendió o ingresó mercancía: el stock se actualiza solo y el carrito se ajusta
      alCambiarDatos(['inventario_local', 'productos', 'compatibilidades', 'unidades_producto', 'pendientes'], refrescarEnVivo);
      return;
    }
    cargando.classList.add('hidden');
    posApp.classList.add('hidden');
    barraMovil.classList.add('hidden');
    barraMovil.classList.remove('flex');
    const aviso = document.getElementById('pos-sin-local')!;
    aviso.classList.remove('hidden');
    if (contexto && contexto.alcance === null) {
      aviso.querySelector('p')!.textContent = 'Tu usuario no tiene un local asignado';
      aviso.querySelectorAll('p')[1].textContent = 'Pídele al administrador que te asigne uno para poder vender.';
    }
  });
</script>
