---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import StatCard from '../components/dashboard/StatCard.astro';
import QuickSearch from '../components/dashboard/QuickSearch.astro';
import LowStockTable from '../components/dashboard/LowStockTable.astro';
import RecentMovements from '../components/dashboard/RecentMovements.astro';
---

<DashboardLayout
  titulo="Dashboard"
  tituloPestana="EASYSTEM"
  subtitulo="Resumen general del inventario de Edward Accesorios"
>
  <section class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <StatCard id="stat-total-productos" etiqueta="Total de productos" valor="—" icono="productos" />
    <StatCard id="stat-valor-inventario" etiqueta="Valor del inventario" valor="—" tendencia=" " icono="valor" />
    <StatCard
      id="stat-stock-bajo"
      etiqueta="Alertas de stock bajo"
      valor="—"
      tendencia="Calculando..."
      icono="stock-bajo"
    />
  </section>

  <QuickSearch />

  <section class="grid grid-cols-1 gap-6 xl:grid-cols-5">
    <div class="xl:col-span-3">
      <LowStockTable />
    </div>
    <div class="xl:col-span-2">
      <RecentMovements />
    </div>
  </section>
</DashboardLayout>

<script>
  import * as inventoryService from '../lib/inventoryService';
  import { convertirABs, formatearBolivares, formatearMoneda } from '../utils/format';
  import { tasaActual } from '../stores/tasa';
  import { contarHasta } from '../utils/animaciones';

  // Valor del inventario en bolívares (a la tasa del día), debajo del monto en dólares
  let valorInventarioUsd = 0;
  function pintarValorEnBs() {
    const el = document.getElementById('stat-valor-inventario-tendencia');
    if (!el) return;
    const tasa = tasaActual.get();
    el.textContent = tasa ? `≈ ${formatearBolivares(convertirABs(valorInventarioUsd, tasa))}` : '';
    el.classList.remove('text-emerald-600', 'dark:text-emerald-400');
    el.classList.add('text-slate-500', 'dark:text-slate-400');
  }
  tasaActual.listen(pintarValorEnBs);

  // Todo viene ya filtrado por el local activo (o por todos los locales, en la vista del administrador).
  // Las alertas se cuentan por local: un producto bajo en dos locales son dos alertas.
  Promise.all([inventoryService.listarProductos(), inventoryService.listarProductosStockBajo()]).then(([productos, stockBajo]) => {
    const valorInventario = productos.reduce((total, p) => total + p.precio_venta * p.stock_actual, 0);
    valorInventarioUsd = valorInventario;
    pintarValorEnBs();

    contarHasta(document.getElementById('stat-total-productos'), productos.length);
    contarHasta(document.getElementById('stat-valor-inventario'), valorInventario, formatearMoneda, 1100);
    contarHasta(document.getElementById('stat-stock-bajo'), stockBajo.length);

    const tendencia = document.getElementById('stat-stock-bajo-tendencia');
    if (tendencia) {
      const requiereAtencion = stockBajo.length > 0;
      tendencia.textContent = requiereAtencion ? 'Requiere reabastecimiento' : 'Todo en orden';
      tendencia.classList.toggle('text-emerald-600', !requiereAtencion);
      tendencia.classList.toggle('dark:text-emerald-400', !requiereAtencion);
      tendencia.classList.toggle('text-red-600', requiereAtencion);
      tendencia.classList.toggle('dark:text-red-400', requiereAtencion);
    }
  });
</script>
