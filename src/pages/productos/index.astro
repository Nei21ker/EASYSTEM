---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import CamaraEscaner from '../../components/CamaraEscaner.astro';
import FormularioProducto from '../../components/productos/FormularioProducto.astro';
import ImportadorCsv from '../../components/productos/ImportadorCsv.astro';

const claseBotonSecundario =
  'rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800';
const claseBotonAdmin =
  'hidden rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-brand-700 transition hover:bg-brand-50 dark:border-slate-700 dark:text-brand-300 dark:hover:bg-slate-800';
const claseSelect =
  'rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-medium text-slate-700 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200';
---

<DashboardLayout titulo="Productos" subtitulo="Catálogo de forros, cargadores, vidrios y más">
  <div class="space-y-4">
    <!-- Barra de herramientas -->
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center">
        <div class="relative flex-1">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
            <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" stroke-linecap="round" />
          </svg>
          <input
            id="pr-buscador"
            type="search"
            autocomplete="off"
            placeholder="Buscar por nombre, código, categoría o modelo de teléfono..."
            class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-9 pr-10 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
          />
          <button
            type="button"
            data-abrir-escaner
            aria-label="Escanear código de barras con la cámara"
            title="Escanear con la cámara"
            class="absolute right-1.5 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-brand-600 dark:hover:bg-slate-700 dark:hover:text-brand-400"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
              <path d="M3 9V7a2 2 0 0 1 2-2h2M3 15v2a2 2 0 0 0 2 2h2M21 9V7a2 2 0 0 0-2-2h-2M21 15v2a2 2 0 0 1-2 2h-2" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="12" cy="12" r="3" stroke-linecap="round" />
            </svg>
          </button>
        </div>

        <div class="flex flex-wrap gap-2">
          <button id="pr-exportar" type="button" class={claseBotonSecundario}>Exportar CSV</button>
          <!-- Herramientas de administrador: ocultas hasta confirmar el rol -->
          <button id="pr-importar" type="button" class={claseBotonAdmin}>Importar CSV</button>
          <button id="pr-cambiar-precios" type="button" class={claseBotonAdmin} title="Poner el mismo precio (en $ o fijo en Bs) a muchos productos de una vez">Cambiar precios</button>
          <button id="pr-seleccionar" type="button" class={claseBotonAdmin} title="Elegir productos para eliminarlos (por ejemplo, los de un ingreso equivocado)">Seleccionar</button>
          <!-- Ingreso de mercancía (producto nuevo, entradas de stock y etiquetas): módulo propio -->
          <a
            id="pr-ingreso"
            href="/ingreso"
            class="bg-marca hidden rounded-lg px-3 py-2 text-xs font-semibold text-white shadow-sm transition hover:brightness-110"
          >
            Ingresar mercancía
          </a>
        </div>
      </div>

      <!-- Categorías -->
      <div id="pr-categorias" class="-mx-1 mt-3 flex gap-2 overflow-x-auto px-1 pb-1" role="group" aria-label="Filtrar por categoría"></div>

      <!-- Opciones -->
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-slate-100 pt-3 dark:border-slate-800">
        <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
          <input id="pr-solo-stock" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
          Solo con stock
        </label>
        <label class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
          Ordenar por
          <select id="pr-orden" class={claseSelect}>
            <option value="nombre">Nombre (A–Z)</option>
            <option value="categoria">Categoría</option>
            <option value="precio_asc">Precio: menor a mayor</option>
            <option value="precio_desc">Precio: mayor a menor</option>
            <option value="stock_desc">Más stock primero</option>
            <option value="stock_asc">Menos stock primero</option>
          </select>
        </label>
        <p id="pr-resumen" class="ml-auto text-xs text-slate-500 dark:text-slate-400">Cargando...</p>
      </div>
    </div>

    <!-- Selección para eliminar (administrador y gerente): aparece al pulsar "Seleccionar" -->
    <div id="pr-barra-seleccion" class="hidden flex-col gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm sm:flex-row sm:items-center dark:border-red-500/30 dark:bg-red-500/10">
      <p id="pr-seleccionados" class="font-semibold text-red-800 dark:text-red-300"></p>
      <div class="flex flex-wrap gap-2 sm:ml-auto">
        <button id="pr-sel-filtrados" type="button" class={claseBotonSecundario}></button>
        <button id="pr-sel-ninguno" type="button" class={claseBotonSecundario}>Quitar selección</button>
        <button id="pr-eliminar" type="button" class="rounded-lg bg-red-600 px-3 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-40">Eliminar seleccionados</button>
        <button id="pr-sel-cancelar" type="button" class={claseBotonSecundario}>Cancelar</button>
      </div>
    </div>
    <p id="pr-mensaje" role="status" class="hidden rounded-lg px-3 py-2 text-xs"></p>

    <!-- Tabla -->
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="overflow-x-auto">
        <table class="tabla-tarjetas w-full md:min-w-[56rem] md:table-fixed text-left text-sm">
          <colgroup>
            <col />
            <col class="w-28" />
            <col class="w-[22%]" />
            <col id="pr-col-costo" class="hidden w-24" />
            <col class="w-32" />
            <col class="w-32" />
            <col id="pr-col-acciones" class="hidden w-40" />
          </colgroup>
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50/70 text-[11px] uppercase tracking-wider text-slate-500 dark:border-slate-800 dark:bg-slate-800/40 dark:text-slate-400">
              <th class="px-4 py-3 font-semibold">Producto</th>
              <th class="px-4 py-3 font-semibold">Categoría</th>
              <th class="px-4 py-3 font-semibold">Compatible con</th>
              <th id="pr-th-costo" class="hidden px-4 py-3 text-right font-semibold">Compra</th>
              <th class="px-4 py-3 text-right font-semibold">Venta</th>
              <th class="px-4 py-3 font-semibold">Stock</th>
              <th id="pr-th-acciones" class="hidden px-4 py-3 text-right font-semibold">Acciones</th>
            </tr>
          </thead>
          <tbody id="pr-filas" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
        </table>
      </div>

      <div id="pr-sin-resultados" class="hidden px-5 py-12 text-center">
        <p class="text-sm font-medium text-slate-700 dark:text-slate-200">No hay productos con esos filtros</p>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Prueba con otra búsqueda o quita algún filtro.</p>
        <button id="pr-limpiar" type="button" class="mt-3 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-brand-700 hover:bg-brand-50 dark:border-slate-700 dark:text-brand-300 dark:hover:bg-slate-800">
          Limpiar filtros
        </button>
      </div>

      <!-- Paginación -->
      <div id="pr-paginacion" class="flex flex-col gap-3 border-t border-slate-100 px-4 py-3 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800 dark:text-slate-400">
        <p id="pr-rango"></p>
        <div class="flex items-center gap-3">
          <label class="flex items-center gap-2">
            Por página
            <select id="pr-por-pagina" class={claseSelect}>
              <option value="25">25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </label>
          <div class="flex items-center gap-1">
            <button id="pr-anterior" type="button" class={`${claseBotonSecundario} disabled:cursor-not-allowed disabled:opacity-40`}>← Anterior</button>
            <span id="pr-pagina" class="min-w-20 text-center font-medium text-slate-700 dark:text-slate-200"></span>
            <button id="pr-siguiente" type="button" class={`${claseBotonSecundario} disabled:cursor-not-allowed disabled:opacity-40`}>Siguiente →</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <CamaraEscaner />
  <FormularioProducto />
  <ImportadorCsv />

  <!-- Cambiar el precio de muchos productos a la vez (administrador y gerente) -->
  <dialog
    id="pr-precios-dialogo"
    class="anim-escalar m-auto w-[min(30rem,calc(100vw-1.5rem))] max-h-[92dvh] overflow-y-auto rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
  >
    <form id="pr-precios-form" class="space-y-4 p-5" novalidate>
      <div>
        <h2 class="text-base font-semibold">Cambiar precios en lote</h2>
        <p id="pr-precios-alcance" class="mt-1 text-sm text-slate-600 dark:text-slate-300"></p>
      </div>

      <fieldset id="pr-precios-opciones" class="hidden space-y-1 rounded-lg border border-slate-200 p-3 text-sm dark:border-slate-700">
        <label class="flex items-center gap-2"><input type="radio" name="pr-precios-alcance" value="seleccion" checked /> <span id="pr-precios-txt-seleccion"></span></label>
        <label class="flex items-center gap-2"><input type="radio" name="pr-precios-alcance" value="lista" /> <span id="pr-precios-txt-lista"></span></label>
      </fieldset>

      <div>
        <div class="flex items-center justify-between gap-2">
          <label for="pr-precios-valor" id="pr-precios-etiqueta" class="block text-xs font-medium text-slate-600 dark:text-slate-400">Nuevo precio de venta (Bs, fijo)</label>
          <div role="group" aria-label="Moneda del precio" class="inline-flex overflow-hidden rounded-md border border-slate-200 text-xs font-semibold dark:border-slate-700">
            <button type="button" id="pr-precios-usd" aria-pressed="false" class="px-2.5 py-1">$</button>
            <button type="button" id="pr-precios-bs" aria-pressed="true" class="border-l border-slate-200 px-2.5 py-1 dark:border-slate-700">Bs</button>
          </div>
        </div>
        <input id="pr-precios-valor" type="text" inputmode="decimal" autocomplete="off" placeholder="1100" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-base tabular-nums text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white sm:py-2.5 sm:text-sm" />
        <p id="pr-precios-vista" class="mt-1 text-xs text-slate-500 dark:text-slate-400"></p>
      </div>

      <p class="rounded-lg bg-sky-50 px-3 py-2 text-xs text-sky-800 dark:bg-sky-500/10 dark:text-sky-300">
        En bolívares el precio queda <strong>fijo</strong>: no sube ni baja con el dólar y se cambia solo cuando haces esto de nuevo. Lo que ya está vendido no cambia.
      </p>

      <p id="pr-precios-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>

      <div class="flex justify-end gap-2">
        <button type="button" id="pr-precios-cancelar" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Cancelar</button>
        <button type="submit" id="pr-precios-aplicar" class="bg-marca rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:brightness-110 disabled:opacity-50">Cambiar precios</button>
      </div>
    </form>
  </dialog>
</DashboardLayout>

<script>
  import * as inventoryService from '../../lib/inventoryService';
  import { esGerencia, esGlobal } from '../../lib/auth';
  import { formatearBolivares, formatearMoneda, htmlPrecioDual } from '../../utils/format';
  import { errorPrecioBs, leerPrecioEscrito, PRECIO_BS_MAXIMO, tienePrecioEnBs, usdDesdeBs, type MonedaPrecio } from '../../utils/precioBs';
  import { tasaActual } from '../../stores/tasa';
  import { descargarCSV } from '../../utils/csv';
  import { animarLista } from '../../utils/animaciones';
  import { alCambiarDatos } from '../../lib/realtime';
  import { htmlMiniatura } from '../../utils/imagenes';
  import { codigoVisible } from '../../utils/codigos';
  import { esPorCantidad } from '../../utils/controlPorCantidad';
  import {
    alternarCompatibles,
    compararNatural as natural,
    escaparHtml as escapar,
    htmlCompatibles,
    htmlPildoraStock as pildoraStock,
    normalizarTexto as normalizar,
  } from '../../utils/productosUI';
  import type { ProductoConRelaciones } from '../../types/database.types';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const filas = $<HTMLTableSectionElement>('pr-filas');
  const buscador = $<HTMLInputElement>('pr-buscador');
  const soloStock = $<HTMLInputElement>('pr-solo-stock');
  const selectOrden = $<HTMLSelectElement>('pr-orden');
  const selectPorPagina = $<HTMLSelectElement>('pr-por-pagina');
  const contenedorCategorias = $('pr-categorias');
  const sinResultados = $('pr-sin-resultados');
  const paginacion = $('pr-paginacion');

  // Precio de compra e importar CSV: administrador y gerente. Editar productos e ir al ingreso de mercancía: también el encargado.
  const COLUMNAS_COSTO = ['pr-th-costo', 'pr-col-costo'];
  const COLUMNAS_ACCIONES = ['pr-th-acciones', 'pr-col-acciones'];
  const BOTONES_ADMIN = ['pr-importar', 'pr-seleccionar'];
  const ORDEN_CATEGORIAS = ['forros', 'vidrios templados', 'cargadores', 'popsockets', 'audífonos'];

  let productos: ProductoConRelaciones[] = [];
  let esAdministrador = false;
  let puedeEntradas = false;
  let nombresLocales = new Map<string, string>();
  let categoriaActiva = '';
  let pagina = 1;
  /** Modo "Seleccionar": casillas en cada fila para eliminar productos ingresados por error */
  let modoSeleccion = false;
  const seleccion = new Set<string>();
  /** id -> texto normalizado (nombre + código + categoría + modelos) para buscar rápido */
  const indice = new Map<string, string>();

  // --- Filtrado, orden y paginación -----------------------------------------------
  function filtrar(): ProductoConRelaciones[] {
    const q = normalizar(buscador.value.trim());
    const tokens = q ? q.split(/\s+/) : [];
    let lista = productos.filter((p) => {
      if (categoriaActiva && p.categoria !== categoriaActiva) return false;
      if (soloStock.checked && p.stock_actual <= 0) return false;
      if (tokens.length === 0) return true;
      const texto = indice.get(p.id) ?? '';
      return tokens.every((t) => texto.includes(t)); // todas las palabras deben aparecer
    });

    const orden = selectOrden.value;
    lista = [...lista].sort((a, b) => {
      switch (orden) {
        case 'categoria':
          return natural(a.categoria, b.categoria) || natural(a.nombre, b.nombre);
        case 'precio_asc':
          return a.precio_venta - b.precio_venta || natural(a.nombre, b.nombre);
        case 'precio_desc':
          return b.precio_venta - a.precio_venta || natural(a.nombre, b.nombre);
        case 'stock_desc':
          return b.stock_actual - a.stock_actual || natural(a.nombre, b.nombre);
        case 'stock_asc':
          return a.stock_actual - b.stock_actual || natural(a.nombre, b.nombre);
        default:
          return natural(a.nombre, b.nombre);
      }
    });
    return lista;
  }

  function pintarCategorias() {
    const conteo = new Map<string, number>();
    for (const p of productos) conteo.set(p.categoria, (conteo.get(p.categoria) ?? 0) + 1);
    const ordenadas = [...conteo.keys()].sort((a, b) => {
      const ia = ORDEN_CATEGORIAS.indexOf(a.toLowerCase());
      const ib = ORDEN_CATEGORIAS.indexOf(b.toLowerCase());
      return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || natural(a, b);
    });

    const base = 'shrink-0 whitespace-nowrap rounded-full border px-3 py-1.5 text-xs font-semibold transition';
    const activo = 'border-brand-600 bg-brand-600 text-white shadow-sm';
    const inactivo =
      'border-slate-200 text-slate-600 hover:border-brand-300 hover:text-brand-700 dark:border-slate-700 dark:text-slate-300 dark:hover:border-brand-500 dark:hover:text-brand-300';
    const chip = (valor: string, texto: string, n: number) =>
      `<button type="button" data-categoria="${escapar(valor)}" aria-pressed="${categoriaActiva === valor}" class="${base} ${categoriaActiva === valor ? activo : inactivo}">${escapar(texto)} <span class="ml-0.5 opacity-70">${n}</span></button>`;

    contenedorCategorias.innerHTML =
      chip('', 'Todas', productos.length) + ordenadas.map((c) => chip(c, c, conteo.get(c)!)).join('');
  }

  /** En la vista "Todos los locales": stock de cada local debajo del total. */
  function desgloseStock(p: ProductoConRelaciones): string {
    if (!p.stock_por_local) return '';
    const partes = Object.entries(p.stock_por_local)
      .filter(([, n]) => n > 0)
      .map(([id, n]) => `${escapar((nombresLocales.get(id) ?? 'Local').replace(/^Local /, ''))} ${n}`);
    return partes.length ? `<span class="mt-1 block text-[11px] text-slate-500 dark:text-slate-400">${partes.join(' · ')}</span>` : '';
  }

  function filaHtml(p: ProductoConRelaciones): string {
    return `
      <tr class="align-middle text-slate-700 transition-colors hover:bg-slate-50/80 dark:text-slate-300 dark:hover:bg-slate-800/40">
        <td class="px-4 py-3">
          <div class="grid ${modoSeleccion ? 'grid-cols-[auto_auto_1fr]' : 'grid-cols-[auto_1fr]'} items-center gap-3">
            ${modoSeleccion ? `<input type="checkbox" data-sel="${escapar(p.id)}" ${seleccion.has(p.id) ? 'checked' : ''} aria-label="Seleccionar ${escapar(p.nombre)}" class="h-5 w-5 rounded border-slate-300 text-red-600 focus:ring-red-500" />` : ''}
            ${htmlMiniatura(p.imagen_url, p.nombre, 'h-12 w-12')}
            <div class="min-w-0">
              <p class="line-clamp-2 break-words font-medium leading-snug text-slate-900 dark:text-white">${escapar(p.nombre)}</p>
              <p class="mt-0.5 font-mono text-[11px] text-slate-500 dark:text-slate-400">${escapar(codigoVisible(p))}${esPorCantidad(p) ? ' <span title="Sin etiqueta por pieza: se vende sin escanear y el stock se corrige contando" class="ml-1 rounded bg-sky-100 px-1.5 py-0.5 font-sans text-[10px] font-semibold uppercase text-sky-800 dark:bg-sky-500/20 dark:text-sky-300">Por cantidad</span>' : ''}</p>
            </div>
          </div>
        </td>
        <td data-label="Categoría" class="px-4 py-3">
          <span class="inline-flex whitespace-nowrap rounded-md border border-slate-200 px-2 py-0.5 text-xs font-medium text-slate-600 dark:border-slate-700 dark:text-slate-300">${escapar(p.categoria)}</span>
        </td>
        <td data-label="Compatible con" class="px-4 py-3">${htmlCompatibles(p)}</td>
        ${
          esAdministrador
            ? `<td data-label="Precio compra" class="px-4 py-3 text-right tabular-nums text-slate-500 dark:text-slate-400">${formatearMoneda(p.precio_compra)}</td>`
            : ''
        }
        <td data-label="Precio venta" class="px-4 py-3 text-right font-semibold tabular-nums text-slate-900 dark:text-white">${htmlPrecioDual(p.precio_venta, tasaActual.get(), '', tienePrecioEnBs(p) ? p.precio_bs! : null, tienePrecioEnBs(p) ? 'Fijo ' : '')}</td>
        <td data-label="Stock" class="px-4 py-3"><div class="text-left">${pildoraStock(p)}${desgloseStock(p)}</div></td>
        ${
          puedeEntradas
            ? `<td class="px-4 py-3">
                <div class="acciones flex justify-end gap-1.5">
                  <a href="/ingreso?producto=${p.id}" class="whitespace-nowrap rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-semibold text-brand-700 hover:bg-brand-50 dark:border-slate-700 dark:text-brand-300 dark:hover:bg-slate-800">+ Stock</a>
                  <a href="/ingreso?reimprimir=${p.id}" title="Volver a imprimir la etiqueta de una unidad de este producto" class="whitespace-nowrap rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Etiquetas</a>
                  ${puedeEntradas ? `<button type="button" data-editar="${p.id}" class="whitespace-nowrap rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Editar</button>` : ''}
                </div>
              </td>`
            : ''
        }
      </tr>`;
  }

  function pintarBarraSeleccion(lista: ProductoConRelaciones[]) {
    const barra = $('pr-barra-seleccion');
    barra.classList.toggle('hidden', !modoSeleccion);
    barra.classList.toggle('flex', modoSeleccion);
    if (!modoSeleccion) return;
    $('pr-seleccionados').textContent = seleccion.size === 0 ? 'Marca los productos que quieres eliminar' : `${seleccion.size} seleccionado${seleccion.size === 1 ? '' : 's'}`;
    $('pr-sel-filtrados').textContent = `Marcar los ${lista.length} de la lista`;
    ($('pr-eliminar') as HTMLButtonElement).disabled = seleccion.size === 0;
  }

  function mostrarMensaje(texto: string, ok: boolean) {
    const el = $('pr-mensaje');
    el.textContent = texto;
    el.className = `rounded-lg px-3 py-2 text-xs ${ok ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400' : 'bg-red-50 text-red-700 dark:bg-red-500/10 dark:text-red-400'}`;
  }

  function pintar() {
    const lista = filtrar();
    const porPagina = Number(selectPorPagina.value);
    const totalPaginas = Math.max(1, Math.ceil(lista.length / porPagina));
    pagina = Math.min(Math.max(1, pagina), totalPaginas);

    const inicio = (pagina - 1) * porPagina;
    filas.innerHTML = lista.slice(inicio, inicio + porPagina).map(filaHtml).join('');

    const hayFiltro = buscador.value.trim() !== '' || categoriaActiva !== '' || soloStock.checked;
    $('pr-resumen').textContent = hayFiltro
      ? `${lista.length} de ${productos.length} productos`
      : `${productos.length} productos · ${productos.filter((p) => p.stock_actual > 0).length} con stock`;

    pintarBarraSeleccion(lista);
    sinResultados.classList.toggle('hidden', lista.length > 0);
    paginacion.classList.toggle('hidden', lista.length === 0);
    $('pr-rango').textContent = lista.length
      ? `Mostrando ${inicio + 1}–${Math.min(inicio + porPagina, lista.length)} de ${lista.length}`
      : '';
    $('pr-pagina').textContent = `Página ${pagina} de ${totalPaginas}`;
    ($('pr-anterior') as HTMLButtonElement).disabled = pagina <= 1;
    ($('pr-siguiente') as HTMLButtonElement).disabled = pagina >= totalPaginas;
  }

  /** Cambio deliberado (categoría, orden, página): vuelve a animar la lista. */
  function pintarAnimado() {
    animarLista(filas);
    pintar();
  }

  function reconstruirIndice() {
    indice.clear();
    for (const p of productos) {
      indice.set(
        p.id,
        normalizar(
          [p.nombre, p.referencia ?? '', p.codigo_barras, p.categoria, ...p.modelos_compatibles.map((m) => `${m.marca} ${m.modelo}`)].join(' ')
        )
      );
    }
  }

  // --- Eventos ---------------------------------------------------------------------
  buscador.addEventListener('input', () => {
    pagina = 1;
    pintar(); // sin animación: se reescribe en cada tecla
  });
  soloStock.addEventListener('change', () => {
    pagina = 1;
    pintarAnimado();
  });
  selectOrden.addEventListener('change', () => {
    pagina = 1;
    pintarAnimado();
  });
  selectPorPagina.addEventListener('change', () => {
    pagina = 1;
    pintarAnimado();
  });
  $('pr-anterior').addEventListener('click', () => {
    pagina--;
    pintarAnimado();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  $('pr-siguiente').addEventListener('click', () => {
    pagina++;
    pintarAnimado();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  contenedorCategorias.addEventListener('click', (e) => {
    const boton = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-categoria]');
    if (!boton) return;
    categoriaActiva = boton.dataset.categoria ?? '';
    pagina = 1;
    pintarCategorias();
    pintarAnimado();
  });
  $('pr-limpiar').addEventListener('click', () => {
    buscador.value = '';
    soloStock.checked = false;
    categoriaActiva = '';
    pagina = 1;
    pintarCategorias();
    pintarAnimado();
  });

  // La tasa cambió (se registró la del día o se corrigió): recalcula los Bs.
  tasaActual.listen(() => pintar());

  // Escaneo con cámara (ver src/components/CamaraEscaner.astro): autocompleta el buscador.
  window.addEventListener('easystem:codigo-escaneado', ((e: CustomEvent<{ codigo: string }>) => {
    buscador.value = e.detail.codigo;
    pagina = 1;
    pintar();
  }) as EventListener);

  // Herramientas de administrador (formularios en src/components/productos/, que
  // escuchan estos eventos; esta página no depende de sus detalles internos).
  const abrir = (evento: string, detalle?: object) => window.dispatchEvent(new CustomEvent(evento, { detail: detalle }));
  $('pr-importar').addEventListener('click', () => abrir('easystem:abrir-importador'));

  function alternarSeleccion(activo: boolean) {
    modoSeleccion = activo;
    seleccion.clear();
    ($('pr-seleccionar') as HTMLButtonElement).textContent = activo ? 'Salir de selección' : 'Seleccionar';
    pintar();
  }
  $('pr-seleccionar').addEventListener('click', () => alternarSeleccion(!modoSeleccion));
  $('pr-sel-cancelar').addEventListener('click', () => alternarSeleccion(false));
  $('pr-sel-ninguno').addEventListener('click', () => {
    seleccion.clear();
    pintar();
  });
  $('pr-sel-filtrados').addEventListener('click', () => {
    for (const p of filtrar()) seleccion.add(p.id);
    pintar();
  });
  filas.addEventListener('change', (e) => {
    const casilla = (e.target as HTMLElement).closest<HTMLInputElement>('[data-sel]');
    if (!casilla) return;
    if (casilla.checked) seleccion.add(casilla.dataset.sel!);
    else seleccion.delete(casilla.dataset.sel!);
    pintarBarraSeleccion(filtrar());
  });

  // --- Cambiar precios en lote (administrador y gerente) ---------------------------------
  const dlgPrecios = $<HTMLDialogElement>('pr-precios-dialogo');
  const campoPrecioLote = $<HTMLInputElement>('pr-precios-valor');
  const errorPrecioLote = $('pr-precios-error');
  const botonAplicarPrecios = $<HTMLButtonElement>('pr-precios-aplicar');
  let monedaLote: MonedaPrecio = 'BS';
  let aplicandoPrecios = false;

  /** A qué productos se aplica: los marcados (si hay) o todos los de la lista que se ve (categoría + búsqueda). */
  function destinoPrecios(): { ids: string[]; texto: string } {
    const lista = filtrar();
    const elegirSeleccion = modoSeleccion && seleccion.size > 0 && (document.querySelector<HTMLInputElement>('input[name="pr-precios-alcance"]:checked')?.value ?? 'seleccion') === 'seleccion';
    if (elegirSeleccion) return { ids: [...seleccion], texto: `${seleccion.size} producto${seleccion.size === 1 ? '' : 's'} marcado${seleccion.size === 1 ? '' : 's'}` };
    const filtros = [categoriaActiva ? `categoría «${categoriaActiva}»` : '', buscador.value.trim() ? `búsqueda «${buscador.value.trim()}»` : ''].filter(Boolean);
    return { ids: lista.map((p) => p.id), texto: `${lista.length} producto${lista.length === 1 ? '' : 's'} de la lista${filtros.length ? ` (${filtros.join(' · ')})` : ' (todo el catálogo)'}` };
  }

  function pintarPreciosLote() {
    for (const [id, activo] of [['pr-precios-usd', monedaLote === 'USD'], ['pr-precios-bs', monedaLote === 'BS']] as const) {
      const boton = $(id);
      boton.setAttribute('aria-pressed', String(activo));
      boton.className = `${id === 'pr-precios-bs' ? 'border-l border-slate-200 dark:border-slate-700 ' : ''}px-2.5 py-1 ${activo ? 'bg-brand-600 text-white' : 'bg-white text-slate-600 hover:bg-slate-50 dark:bg-slate-800 dark:text-slate-300'}`;
    }
    $('pr-precios-etiqueta').textContent = monedaLote === 'BS' ? 'Nuevo precio de venta (Bs, fijo)' : 'Nuevo precio de venta ($)';
    campoPrecioLote.placeholder = monedaLote === 'BS' ? '1100' : '0,00';

    const destino = destinoPrecios();
    $('pr-precios-alcance').textContent = destino.ids.length === 0 ? 'No hay productos en la lista: ajusta la categoría o la búsqueda.' : `Se cambiará el precio de ${destino.texto}.`;
    const hayMarcados = modoSeleccion && seleccion.size > 0;
    $('pr-precios-opciones').classList.toggle('hidden', !hayMarcados);
    $('pr-precios-txt-seleccion').textContent = `Solo los ${seleccion.size} marcados`;
    $('pr-precios-txt-lista').textContent = `Todos los ${filtrar().length} de la lista`;

    const valor = leerPrecioEscrito(campoPrecioLote.value, monedaLote);
    const tasa = tasaActual.get();
    const vista = $('pr-precios-vista');
    if (valor === null || !(valor >= 0)) vista.textContent = '';
    else if (monedaLote === 'BS') vista.textContent = tasa ? `Hoy equivale a ${formatearMoneda(usdDesdeBs(valor, tasa))} (tasa ${formatearBolivares(tasa)}). Si la tasa cambia, el precio en Bs no.` : 'Falta registrar la tasa del día para fijar precios en Bs.';
    else vista.textContent = tasa ? `Equivale a ${formatearBolivares(Math.round(valor * tasa * 100) / 100)} con la tasa de hoy.` : '';
  }

  function abrirPreciosLote() {
    errorPrecioLote.classList.add('hidden');
    campoPrecioLote.value = '';
    pintarPreciosLote();
    dlgPrecios.showModal();
    campoPrecioLote.focus();
  }
  $('pr-cambiar-precios').addEventListener('click', abrirPreciosLote);
  $('pr-precios-cancelar').addEventListener('click', () => {
    if (!aplicandoPrecios) dlgPrecios.close();
  });
  dlgPrecios.addEventListener('cancel', (e) => {
    if (aplicandoPrecios) e.preventDefault();
  });
  campoPrecioLote.addEventListener('input', pintarPreciosLote);
  for (const radio of document.querySelectorAll('input[name="pr-precios-alcance"]')) radio.addEventListener('change', pintarPreciosLote);
  for (const [id, valor] of [['pr-precios-usd', 'USD'], ['pr-precios-bs', 'BS']] as const) {
    $(id).addEventListener('click', () => {
      monedaLote = valor;
      pintarPreciosLote();
    });
  }

  $('pr-precios-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (aplicandoPrecios) return;
    const falla = (texto: string) => {
      errorPrecioLote.textContent = texto;
      errorPrecioLote.classList.remove('hidden');
    };
    errorPrecioLote.classList.add('hidden');
    const destino = destinoPrecios();
    if (destino.ids.length === 0) return falla('No hay productos a los que aplicar el precio.');
    const valor = leerPrecioEscrito(campoPrecioLote.value, monedaLote);
    if (valor === null) return falla('Escribe el precio (por ejemplo 1100 o 1,22).');
    if (monedaLote === 'BS') {
      const mensaje = errorPrecioBs(valor);
      if (mensaje) return falla(mensaje);
      if (valor > PRECIO_BS_MAXIMO) return falla('El precio en bolívares es demasiado grande.');
    } else if (!(valor >= 0)) return falla('El precio no es válido.');

    const textoPrecio = monedaLote === 'BS' ? formatearBolivares(valor) : formatearMoneda(valor);
    if (!confirm(`Vas a poner ${textoPrecio}${monedaLote === 'BS' ? ' (precio fijo en bolívares)' : ''} a ${destino.texto}.\n\nEl precio anterior de cada uno se pierde. ¿Continuar?`)) return;

    aplicandoPrecios = true;
    botonAplicarPrecios.disabled = true;
    botonAplicarPrecios.textContent = 'Cambiando...';
    try {
      const r = await inventoryService.cambiarPreciosLote(destino.ids, monedaLote, valor);
      dlgPrecios.close();
      mostrarMensaje(`Listo: ${r.actualizados} producto${r.actualizados === 1 ? '' : 's'} con precio ${textoPrecio}${monedaLote === 'BS' ? ' fijo' : ''}.`, true);
      await recargarProductos();
    } catch (err) {
      falla(err instanceof Error ? err.message : 'No se pudieron cambiar los precios.');
    } finally {
      aplicandoPrecios = false;
      botonAplicarPrecios.disabled = false;
      botonAplicarPrecios.textContent = 'Cambiar precios';
    }
  });

  $('pr-eliminar').addEventListener('click', async () => {
    const elegidos = productos.filter((p) => seleccion.has(p.id));
    if (elegidos.length === 0) return;
    const stock = elegidos.reduce((suma, p) => suma + p.stock_actual, 0);
    const nombres = elegidos.slice(0, 8).map((p) => `  · ${p.nombre}`).join('\n') + (elegidos.length > 8 ? `\n  … y ${elegidos.length - 8} más` : '');
    const respuesta = prompt(
      `Vas a ELIMINAR ${elegidos.length} producto${elegidos.length === 1 ? '' : 's'} con sus ${stock} unidad${stock === 1 ? '' : 'es'} en stock, de TODOS los locales:\n\n${nombres}\n\nNo se puede deshacer. Los que ya tengan ventas, traslados o bajas NO se borrarán.\n\nEscribe ELIMINAR para confirmar:`
    );
    if (respuesta === null) return;
    if (respuesta.trim().toUpperCase() !== 'ELIMINAR') return mostrarMensaje('No se eliminó nada: la palabra de confirmación no coincidía.', false);
    const boton = $('pr-eliminar') as HTMLButtonElement;
    boton.disabled = true;
    try {
      const r = await inventoryService.eliminarProductos(elegidos.map((p) => p.id));
      const aviso = r.bloqueados.length
        ? ` No se borraron ${r.bloqueados.length} porque ya tienen historial (ventas, traslados o bajas): ${r.bloqueados.map((b) => b.nombre).join(', ')}. Para retirar su stock usa una baja en Mercancía → Descargo.`
        : '';
      mostrarMensaje(`Se eliminaron ${r.eliminados.length} producto${r.eliminados.length === 1 ? '' : 's'}.${aviso}`, r.bloqueados.length === 0);
      seleccion.clear();
      for (const b of r.bloqueados) seleccion.add(b.id); // los que no se pudieron borrar quedan marcados
      await recargarProductos();
    } catch (err) {
      mostrarMensaje(err instanceof Error ? err.message : 'No se pudo eliminar.', false);
    } finally {
      boton.disabled = false;
    }
  });

  filas.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;

    if (alternarCompatibles(objetivo)) return;

    const editar = objetivo.closest<HTMLElement>('[data-editar]')?.dataset.editar;
    if (editar) abrir('easystem:abrir-producto', { productoId: editar });
  });

  $('pr-exportar').addEventListener('click', () => {
    // Exporta TODO el inventario (no solo la página visible).
    descargarCSV(
      `easystem-inventario-${new Date().toISOString().slice(0, 10)}.csv`,
      productos.map((p) => ({
        codigo_barras: p.codigo_barras,
        nombre: p.nombre,
        categoria: p.categoria,
        ...(esAdministrador ? { precio_compra: p.precio_compra.toFixed(2) } : {}),
        precio_venta: p.precio_venta.toFixed(2),
        stock_actual: p.stock_actual,
        stock_minimo: p.stock_minimo,
        ...(p.stock_por_local
          ? { stock_por_local: Object.entries(p.stock_por_local).map(([id, n]) => `${nombresLocales.get(id) ?? id}: ${n}`).join('; ') }
          : {}),
        compatible_con: p.modelos_compatibles.map((m) => `${m.marca} ${m.modelo}`).join('; ') || 'Universal',
      }))
    );
  });

  // Tras guardar/importar/registrar entrada, las ventanas avisan con este evento.
  async function recargarProductos() {
    productos = await inventoryService.listarProductos();
    reconstruirIndice();
    pintarCategorias();
    pintar();
  }
  window.addEventListener('easystem:productos-cambiaron', recargarProductos);
  // Otro dispositivo vendió, ingresó mercancía o editó productos: la lista se actualiza sola (conserva filtros y página)
  alCambiarDatos(['productos', 'inventario_local', 'compatibilidades', 'modelos_telefono'], recargarProductos);

  Promise.all([inventoryService.listarProductos(), inventoryService.obtenerContextoLocal()]).then(([lista, contexto]) => {
    productos = lista;
    const rol = contexto?.sesion.rol;
    esAdministrador = esGlobal(rol);
    puedeEntradas = esGerencia(rol);
    nombresLocales = new Map((contexto?.locales ?? []).map((l) => [l.id, l.nombre]));
    for (const id of COLUMNAS_COSTO) $(id).classList.toggle('hidden', !esAdministrador);
    for (const id of COLUMNAS_ACCIONES) $(id).classList.toggle('hidden', !puedeEntradas);
    for (const id of BOTONES_ADMIN) $(id).classList.toggle('hidden', !esAdministrador);
    $('pr-ingreso').classList.toggle('hidden', !puedeEntradas);
    // Cambiar precios en lote: también el encargado (el catálogo es compartido, como al editar un producto)
    $('pr-cambiar-precios').classList.toggle('hidden', !puedeEntradas);
    reconstruirIndice();
    pintarCategorias();
    animarLista(filas);
    pintar();
  });
</script>
