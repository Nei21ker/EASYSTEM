---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout titulo="Usuarios" subtitulo="Empleados con acceso a EASYSTEM y sus permisos" roles={['administrador', 'gerente']}>
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2 rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="border-b border-slate-200 px-5 py-4 dark:border-slate-800">
        <h2 id="us-contador" class="text-sm font-semibold text-slate-900 dark:text-white">Cargando...</h2>
        <p id="us-subtitulo" class="mt-0.5 text-xs text-slate-500 dark:text-slate-400"></p>
      </div>
      <div class="overflow-x-auto">
        <table class="tabla-tarjetas w-full text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500 dark:border-slate-800 dark:text-slate-400">
              <th class="px-5 py-3 font-medium">Nombre</th>
              <th class="px-5 py-3 font-medium">Correo</th>
              <th class="px-5 py-3 font-medium">Rol</th>
              <th class="px-5 py-3 font-medium">Local</th>
              <th class="px-5 py-3 font-medium">Estado</th>
              <th class="px-5 py-3 font-medium"><span class="sr-only">Acciones</span></th>
            </tr>
          </thead>
          <tbody id="us-filas" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
        </table>
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Nuevo empleado</h2>
      <form id="us-form" class="mt-4 space-y-3">
        <div>
          <label for="us-nombre" class="block text-xs font-medium text-slate-600 dark:text-slate-400">Nombre completo</label>
          <input id="us-nombre" type="text" required class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 sm:py-2 sm:text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
        </div>
        <div>
          <label for="us-email" class="block text-xs font-medium text-slate-600 dark:text-slate-400">Correo electrónico</label>
          <input id="us-email" type="email" required class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 sm:py-2 sm:text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
        </div>
        <div>
          <label for="us-password" class="block text-xs font-medium text-slate-600 dark:text-slate-400">Contraseña temporal</label>
          <input id="us-password" type="text" required minlength="6" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 sm:py-2 sm:text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
        </div>
        <div>
          <label for="us-rol" class="block text-xs font-medium text-slate-600 dark:text-slate-400">Rol</label>
          <select id="us-rol" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 sm:py-2 sm:text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white">
          </select>
          <p id="us-rol-ayuda" class="mt-1 text-xs text-slate-400"></p>
        </div>
        <div id="us-local-bloque">
          <label for="us-local" class="block text-xs font-medium text-slate-600 dark:text-slate-400">Local asignado</label>
          <select id="us-local" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 sm:py-2 sm:text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white"></select>
        </div>
        <button type="submit" class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">
          Crear usuario
        </button>
        <p id="us-error" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
        <p id="us-exito" class="hidden rounded-lg bg-emerald-50 px-3 py-2 text-xs text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"></p>
      </form>
    </div>
  </div>

  <dialog
    id="ed-dialogo"
    aria-labelledby="ed-titulo"
    class="anim-escalar m-auto w-[min(26rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/70 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
  >
    <form id="ed-form" novalidate>
      <div class="space-y-4 px-5 pb-4 pt-5">
        <div class="min-w-0">
          <h2 id="ed-titulo" class="text-base font-semibold">Editar usuario</h2>
          <p id="ed-nombre" class="mt-0.5 truncate text-sm font-medium"></p>
          <p id="ed-correo" class="truncate text-xs text-slate-500 dark:text-slate-400"></p>
        </div>

        <div id="ed-bloque-rol">
          <label for="ed-rol" class="block text-xs font-medium text-slate-600 dark:text-slate-400">Rol</label>
          <select id="ed-rol" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 sm:py-2 sm:text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white"></select>
        </div>
        <div id="ed-bloque-local">
          <label for="ed-local" class="block text-xs font-medium text-slate-600 dark:text-slate-400">Local asignado</label>
          <select id="ed-local" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 sm:py-2 sm:text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white"></select>
        </div>

        <div>
          <label for="ed-clave" class="block text-xs font-medium text-slate-600 dark:text-slate-400">Nueva contraseña (opcional)</label>
          <div class="mt-1 flex gap-2">
            <input id="ed-clave" type="password" autocomplete="new-password" minlength="6" placeholder="Déjala vacía para no cambiarla" class="min-w-0 flex-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 sm:py-2 sm:text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            <button id="ed-ojo" type="button" class="shrink-0 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Ver</button>
            <button id="ed-generar" type="button" class="shrink-0 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Generar</button>
          </div>
          <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">
            La contraseña actual queda cifrada y no se puede consultar; aquí defines una nueva y puedes verla mientras la escribes. Al
            cambiarla, el usuario debe iniciar sesión otra vez.
          </p>
        </div>

        <div id="ed-resultado" class="hidden rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2.5 dark:border-emerald-500/30 dark:bg-emerald-500/10">
          <p class="text-xs font-medium text-emerald-800 dark:text-emerald-300">Contraseña guardada. Pásasela al usuario; esta es la única vez que se muestra:</p>
          <div class="mt-1.5 flex items-center justify-between gap-2">
            <code id="ed-resultado-clave" class="min-w-0 break-all text-base font-bold text-emerald-900 dark:text-emerald-200"></code>
            <button id="ed-copiar" type="button" class="shrink-0 rounded-lg border border-emerald-300 px-2.5 py-1 text-xs font-semibold text-emerald-800 hover:bg-emerald-100 dark:border-emerald-500/40 dark:text-emerald-300 dark:hover:bg-emerald-500/10">Copiar</button>
          </div>
        </div>

        <p id="ed-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
      </div>

      <div class="flex gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-800/40">
        <button id="ed-cancelar" type="button" class="flex-1 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
          Cancelar
        </button>
        <button id="ed-guardar" type="submit" class="bg-marca flex-1 rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60">
          Guardar cambios
        </button>
      </div>
    </form>
  </dialog>
</DashboardLayout>

<script>
  import {
    listarUsuarios,
    registrarUsuario,
    actualizarAccesoUsuario,
    eliminarUsuario,
    cambiarClaveUsuario,
    obtenerSesionActual,
    ETIQUETAS_ROL,
    esGlobal,
    puedeGestionarUsuario,
    rolesAsignables,
    type Rol,
  } from '../lib/auth';
  import { listarLocales } from '../lib/inventoryService';
  import type { Local } from '../types/database.types';
  import { animarLista, reanimar } from '../utils/animaciones';

  const contador = document.getElementById('us-contador') as HTMLHeadingElement;
  const filas = document.getElementById('us-filas') as HTMLTableSectionElement;
  const form = document.getElementById('us-form') as HTMLFormElement;
  const error = document.getElementById('us-error') as HTMLParagraphElement;
  const exito = document.getElementById('us-exito') as HTMLParagraphElement;

  let miId = '';
  let miRol: Rol | null = null;
  let locales: Local[] = [];

  const AYUDA_ROL: Record<Rol, string> = {
    administrador: 'Dueño del servicio: acceso total, suscripciones, sesiones y gestión de cualquier usuario.',
    gerente: 'Dueño del negocio: acceso a TODOS los locales, catálogo y reportes. Crea y elimina encargados, vendedores y técnicos.',
    encargado: 'Gerente de su local: entradas de stock, devoluciones y reportes de ese local.',
    vendedor: 'Cajero de su local: ventas y consulta de productos.',
    tecnico: 'Servicio técnico de su local: órdenes de servicio y repuestos.',
  };

  const opcionesRol = (seleccionado?: Rol) =>
    rolesAsignables(miRol)
      .map((r) => `<option value="${r}" ${r === seleccionado ? 'selected' : ''}>${ETIQUETAS_ROL[r]}</option>`)
      .join('');
  const opcionesLocal = (seleccionado?: string | null) =>
    '<option value="">Sin local</option>' +
    locales.map((l) => `<option value="${l.id}" ${l.id === seleccionado ? 'selected' : ''}>${l.nombre}</option>`).join('');

  const selectRolNuevo = document.getElementById('us-rol') as HTMLSelectElement;
  const selectLocalNuevo = document.getElementById('us-local') as HTMLSelectElement;
  const bloqueLocalNuevo = document.getElementById('us-local-bloque') as HTMLDivElement;

  function actualizarFormularioNuevo() {
    const rol = selectRolNuevo.value as Rol;
    (document.getElementById('us-rol-ayuda') as HTMLParagraphElement).textContent = AYUDA_ROL[rol] ?? '';
    bloqueLocalNuevo.classList.toggle('hidden', esGlobal(rol));
  }
  selectRolNuevo.addEventListener('change', actualizarFormularioNuevo);

  function escaparHtml(texto: string): string {
    const div = document.createElement('div');
    div.textContent = texto;
    return div.innerHTML;
  }

  // La lista se agrupa por jerarquía. Los administradores solo llegan aquí si quien mira es administrador
  // (la base de datos y listarUsuarios() se los ocultan a los demás).
  const ORDEN_JERARQUIA: Rol[] = ['administrador', 'gerente', 'encargado', 'tecnico', 'vendedor'];
  const TITULO_GRUPO: Record<Rol, string> = {
    administrador: 'Administradores',
    gerente: 'Gerentes',
    encargado: 'Encargados',
    tecnico: 'Técnicos',
    vendedor: 'Vendedores',
  };

  async function cargarUsuarios() {
    const usuarios = await listarUsuarios();
    contador.textContent = `${usuarios.length} usuario${usuarios.length === 1 ? '' : 's'}`;
    animarLista(filas);

    const ordenados = [...usuarios].sort(
      (a, b) => ORDEN_JERARQUIA.indexOf(a.rol) - ORDEN_JERARQUIA.indexOf(b.rol) || a.nombre.localeCompare(b.nombre)
    );

    filas.innerHTML = ordenados
      .map((u, indice) => {
        const yo = u.id === miId;
        // Se puede gestionar a quien está por debajo en la jerarquía (el gerente solo encargados, vendedores y técnicos); nunca a uno mismo
        const gestionable = !yo && puedeGestionarUsuario(miRol, u.rol);
        const inactivo = u.status === 'inactive';
        const nombreLocal = locales.find((l) => l.id === u.local_id)?.nombre;

        const celdaRol = `<span class="text-sm">${escaparHtml(ETIQUETAS_ROL[u.rol] ?? u.rol)}</span>`;

        const celdaLocal = esGlobal(u.rol)
          ? '<span class="text-xs text-slate-500 dark:text-slate-400">Todos los locales</span>'
          : `<span class="text-xs ${u.local_id ? 'text-slate-500 dark:text-slate-400' : 'font-semibold text-amber-600 dark:text-amber-400'}">${escaparHtml(nombreLocal ?? 'Sin local')}</span>`;

        const claseActivo = 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-400';
        const claseInactivo = 'border-red-200 bg-red-50 text-red-700 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-400';
        const celdaEstado = gestionable
          ? `<button type="button" data-usuario="${u.id}" data-nuevo="${inactivo ? 'active' : 'inactive'}" class="us-estado rounded-lg border px-2.5 py-1 text-xs font-semibold ${inactivo ? claseInactivo : claseActivo}" title="${inactivo ? 'Inactivo: no puede operar. Clic para reactivarlo' : 'Activo. Clic para desactivarlo (no podrá operar)'}">${inactivo ? 'Inactivo' : 'Activo'}</button>`
          : `<span class="rounded-full border px-2.5 py-1 text-xs font-semibold ${inactivo ? claseInactivo : claseActivo}">${inactivo ? 'Inactivo' : 'Activo'}</span>`;

        // Editar: rol, local y contraseña. Uno mismo solo puede cambiar su contraseña (la base de datos lo exige)
        const botonEditar = `<button type="button" data-usuario="${u.id}" class="us-editar rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Editar</button>`;
        const botonEliminar = `<button type="button" data-usuario="${u.id}" data-nombre="${escaparHtml(u.nombre)}" class="us-eliminar rounded-lg border border-red-200 px-2.5 py-1 text-xs font-semibold text-red-700 transition hover:bg-red-50 dark:border-red-500/30 dark:text-red-400 dark:hover:bg-red-500/10">Eliminar</button>`;
        const celdaAcciones = gestionable ? `<div class="flex flex-wrap gap-2 sm:justify-end">${botonEditar}${botonEliminar}</div>` : yo && esGlobal(miRol) ? botonEditar : '';

        const cantidadGrupo = ordenados.filter((x) => x.rol === u.rol).length;
        const cabeceraGrupo =
          indice === 0 || ordenados[indice - 1].rol !== u.rol
            ? `<tr class="bg-slate-50 dark:bg-slate-800/50"><td colspan="6" class="px-5 py-2 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">${TITULO_GRUPO[u.rol] ?? escaparHtml(u.rol)} <span class="font-normal normal-case">(${cantidadGrupo})</span></td></tr>`
            : '';

        return `${cabeceraGrupo}
          <tr class="text-slate-700 dark:text-slate-300">
            <td class="px-5 py-3 font-medium text-slate-900 dark:text-white">${escaparHtml(u.nombre)}${yo ? ' <span class="text-xs text-slate-400">(tú)</span>' : ''}</td>
            <td data-label="Correo" class="break-all px-5 py-3 text-slate-500 dark:text-slate-400">${escaparHtml(u.email || '—')}</td>
            <td data-label="Rol" class="px-5 py-3">${celdaRol}</td>
            <td data-label="Local" class="px-5 py-3">${celdaLocal}</td>
            <td data-label="Estado" class="px-5 py-3">${celdaEstado}</td>
            <td class="px-5 py-3 sm:text-right">${celdaAcciones}</td>
          </tr>
        `;
      })
      .join('');

    for (const boton of document.querySelectorAll<HTMLButtonElement>('.us-estado')) {
      boton.addEventListener('click', async () => {
        const nuevo = boton.dataset.nuevo as 'active' | 'inactive';
        if (nuevo === 'inactive' && !confirm('¿Desactivar este usuario? No podrá ver ni registrar nada hasta que lo reactives.')) return;
        try {
          await actualizarAccesoUsuario(boton.dataset.usuario!, { status: nuevo });
        } catch (err) {
          alert(err instanceof Error ? err.message : 'No se pudo cambiar el estado.');
        }
        cargarUsuarios();
      });
    }

    for (const boton of document.querySelectorAll<HTMLButtonElement>('.us-eliminar')) {
      boton.addEventListener('click', async () => {
        const nombre = boton.dataset.nombre ?? 'este usuario';
        if (!confirm(`¿Eliminar a ${nombre}? Se borra su cuenta y ya no podrá entrar. Las ventas que registró se conservan. Esto no se puede deshacer.`)) return;
        boton.disabled = true;
        try {
          await eliminarUsuario(boton.dataset.usuario!);
        } catch (err) {
          alert(err instanceof Error ? err.message : 'No se pudo eliminar el usuario.');
        }
        cargarUsuarios();
      });
    }

    for (const boton of document.querySelectorAll<HTMLButtonElement>('.us-editar')) {
      boton.addEventListener('click', () => abrirEdicion(usuarios.find((u) => u.id === boton.dataset.usuario)));
    }
  }

  // ---------------------------------------------------------------------------
  // Diálogo "Editar usuario": rol, local y contraseña
  // ---------------------------------------------------------------------------
  const dialogo = document.getElementById('ed-dialogo') as HTMLDialogElement;
  const edForm = document.getElementById('ed-form') as HTMLFormElement;
  const edNombre = document.getElementById('ed-nombre') as HTMLParagraphElement;
  const edCorreo = document.getElementById('ed-correo') as HTMLParagraphElement;
  const edRol = document.getElementById('ed-rol') as HTMLSelectElement;
  const edLocal = document.getElementById('ed-local') as HTMLSelectElement;
  const edBloqueRol = document.getElementById('ed-bloque-rol') as HTMLDivElement;
  const edBloqueLocal = document.getElementById('ed-bloque-local') as HTMLDivElement;
  const edClave = document.getElementById('ed-clave') as HTMLInputElement;
  const edOjo = document.getElementById('ed-ojo') as HTMLButtonElement;
  const edGenerar = document.getElementById('ed-generar') as HTMLButtonElement;
  const edError = document.getElementById('ed-error') as HTMLParagraphElement;
  const edResultado = document.getElementById('ed-resultado') as HTMLDivElement;
  const edResultadoClave = document.getElementById('ed-resultado-clave') as HTMLElement;
  const edGuardar = document.getElementById('ed-guardar') as HTMLButtonElement;
  const edCancelar = document.getElementById('ed-cancelar') as HTMLButtonElement;
  let editando: Awaited<ReturnType<typeof listarUsuarios>>[number] | null = null;

  function abrirEdicion(usuario?: typeof editando) {
    if (!usuario) return;
    editando = usuario;
    const yo = usuario.id === miId;
    edNombre.textContent = usuario.nombre;
    edCorreo.textContent = usuario.email || '';
    // Rol y local: solo de quienes están por debajo (uno mismo solo cambia su contraseña)
    edBloqueRol.classList.toggle('hidden', yo);
    edRol.innerHTML = opcionesRol(usuario.rol);
    edLocal.innerHTML = opcionesLocal(usuario.local_id);
    edClave.value = '';
    edClave.type = 'password';
    edOjo.textContent = 'Ver';
    edError.classList.add('hidden');
    edResultado.classList.add('hidden');
    edGuardar.classList.remove('hidden');
    edCancelar.textContent = 'Cancelar';
    actualizarBloqueLocalEdicion();
    dialogo.showModal();
  }

  function actualizarBloqueLocalEdicion() {
    const rol = (edBloqueRol.classList.contains('hidden') ? editando?.rol : (edRol.value as Rol)) ?? 'vendedor';
    edBloqueLocal.classList.toggle('hidden', esGlobal(rol));
  }
  edRol.addEventListener('change', actualizarBloqueLocalEdicion);

  // Ver / ocultar lo que se está escribiendo. La contraseña actual NO se puede consultar: queda cifrada.
  edOjo.addEventListener('click', () => {
    const visible = edClave.type === 'text';
    edClave.type = visible ? 'password' : 'text';
    edOjo.textContent = visible ? 'Ver' : 'Ocultar';
  });

  edGenerar.addEventListener('click', () => {
    const letras = 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    const azar = crypto.getRandomValues(new Uint32Array(10));
    edClave.value = Array.from(azar, (n) => letras[n % letras.length]).join('');
    edClave.type = 'text';
    edOjo.textContent = 'Ocultar';
  });

  document.getElementById('ed-copiar')!.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(edResultadoClave.textContent ?? '');
      (document.getElementById('ed-copiar') as HTMLButtonElement).textContent = 'Copiada';
    } catch {
      /* sin portapapeles: se puede copiar a mano */
    }
  });

  edCancelar.addEventListener('click', () => dialogo.close());

  edForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!editando) return;
    edError.classList.add('hidden');
    edGuardar.disabled = true;
    edGuardar.textContent = 'Guardando...';

    const yo = editando.id === miId;
    const clave = edClave.value;
    try {
      if (!yo) {
        const rol = edRol.value as Rol;
        const local_id = esGlobal(rol) ? null : edLocal.value || null;
        if (rol !== editando.rol || (local_id ?? null) !== (editando.local_id ?? null)) {
          await actualizarAccesoUsuario(editando.id, { rol, local_id });
        }
      }
      if (clave) await cambiarClaveUsuario(editando.id, clave);

      await cargarUsuarios();
      if (clave) {
        // Se muestra una sola vez: después ya no se puede volver a ver
        edResultadoClave.textContent = clave;
        (document.getElementById('ed-copiar') as HTMLButtonElement).textContent = 'Copiar';
        edResultado.classList.remove('hidden');
        edGuardar.classList.add('hidden');
        edCancelar.textContent = 'Cerrar';
      } else {
        dialogo.close();
      }
    } catch (err) {
      edError.textContent = err instanceof Error ? err.message : 'No se pudo guardar.';
      edError.classList.remove('hidden');
    } finally {
      edGuardar.disabled = false;
      edGuardar.textContent = 'Guardar cambios';
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.classList.add('hidden');
    exito.classList.add('hidden');

    const nombre = (document.getElementById('us-nombre') as HTMLInputElement).value.trim();
    const email = (document.getElementById('us-email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('us-password') as HTMLInputElement).value;
    const rol = selectRolNuevo.value as Rol;
    const local_id = esGlobal(rol) ? null : selectLocalNuevo.value || null;

    try {
      const { requiereConfirmacion } = await registrarUsuario({ nombre, email, password, rol, local_id });
      exito.textContent = requiereConfirmacion
        ? `Cuenta creada para ${nombre}. Debe confirmar su correo (enlace enviado a ${email}) antes de poder iniciar sesión.`
        : `Cuenta creada para ${nombre}.`;
      exito.classList.remove('hidden');
      reanimar(exito, 'anim-subir');
      form.reset();
      selectRolNuevo.value = rolesAsignables(miRol).includes('vendedor') ? 'vendedor' : (rolesAsignables(miRol)[0] ?? '');
      actualizarFormularioNuevo();
      await cargarUsuarios();
    } catch (err) {
      error.textContent = err instanceof Error ? err.message : 'No se pudo crear el usuario.';
      error.classList.remove('hidden');
      reanimar(error, 'anim-sacudir');
    }
  });

  Promise.all([obtenerSesionActual(), listarLocales()]).then(([sesion, lista]) => {
    miId = sesion?.id ?? '';
    miRol = sesion?.rol ?? null;
    locales = lista;
    selectRolNuevo.innerHTML = opcionesRol('vendedor');
    selectLocalNuevo.innerHTML = lista.map((l) => `<option value="${l.id}">${l.nombre}</option>`).join('');
    if (miRol === 'gerente') {
      (document.getElementById('us-subtitulo') as HTMLParagraphElement).textContent = 'Como gerente puedes crear, editar y eliminar encargados, vendedores y técnicos.';
    }
    actualizarFormularioNuevo();
    cargarUsuarios();
  });
</script>
