---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import StatCard from '../components/dashboard/StatCard.astro';
import CuadreCaja from '../components/reportes/CuadreCaja.astro';
---

<DashboardLayout
  titulo="Reportes y cuadre"
  subtitulo="Ventas, categorías y modelos más solicitados, y el cuadre de caja del día"
  roles={['administrador', 'gerente', 'encargado']}
>
  <div id="rp-pantalla" class="space-y-6 print:hidden">
    <!-- Filtro de rango de fechas -->
    <div class="flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-center gap-2">
        <button data-rango="hoy" class="rp-rango rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 transition dark:border-slate-700 dark:text-slate-300">Hoy</button>
        <button data-rango="semana" class="rp-rango rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 transition dark:border-slate-700 dark:text-slate-300">Esta semana</button>
        <button data-rango="mes" class="rp-rango rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 transition dark:border-slate-700 dark:text-slate-300">Este mes</button>
        <button data-rango="personalizado" class="rp-rango rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 transition dark:border-slate-700 dark:text-slate-300">Personalizado</button>
        <div id="rp-personalizado" class="hidden items-center gap-2">
          <input id="rp-desde" type="date" class="rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          <span class="text-xs text-slate-400">a</span>
          <input id="rp-hasta" type="date" class="rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button id="rp-cuadre" type="button" class="bg-marca rounded-lg px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:brightness-110">
          Cuadre de caja del día
        </button>
        <button id="rp-imprimir" type="button" class="rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-brand-700">
          Generar reporte (PDF / Imprimir)
        </button>
      </div>
    </div>

    <p id="rp-rango-etiqueta" class="text-xs text-slate-500 dark:text-slate-400"></p>

    <!-- Resumen financiero -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <StatCard id="stat-ingresos" etiqueta="Ingresos" valor="—" icono="valor" />
      <StatCard id="stat-costos" etiqueta="Costos" valor="—" icono="valor" />
      <StatCard id="stat-ganancia" etiqueta="Ganancia neta" valor="—" icono="valor" />
    </section>

    <!-- Ventas por día -->
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Ventas por día — ingresos vs. costos y ganancia neta</h2>
      <p id="rp-sin-ventas" class="hidden mt-4 text-sm text-slate-500 dark:text-slate-400">No hay ventas registradas en este periodo.</p>
      <div class="mt-4 h-72">
        <canvas id="chart-ventas"></canvas>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Top 5 categorías más vendidas</h2>
        <div class="mt-4 h-64">
          <canvas id="chart-categorias"></canvas>
        </div>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Top 5 modelos de teléfono más solicitados</h2>
        <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
          Unidades vendidas de productos compatibles con cada modelo (excluye accesorios universales).
        </p>
        <div class="mt-4 h-64">
          <canvas id="chart-modelos"></canvas>
        </div>
      </div>
    </div>

    <!-- Ventas por tipo de cobro -->
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Ventas por tipo de cobro</h2>
      <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
        Dólares netos cobrados con cada tipo de cobro (si un cliente paga con varios, cada parte suma en el suyo; el vuelto y los reembolsos de devoluciones restan). Incluye solo ventas registradas con datos de cliente (desde que se activó ese registro).
      </p>
      <p id="rp-metodos-error" class="mt-3 hidden text-xs text-red-600 dark:text-red-400"></p>
      <div class="mt-4 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="h-56">
          <canvas id="chart-metodos"></canvas>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[26rem] text-left text-sm">
            <thead>
              <tr class="text-[11px] uppercase tracking-wider text-slate-500 dark:text-slate-400">
                <th class="py-2 pr-3 font-semibold">Tipo de cobro</th>
                <th class="px-3 py-2 text-right font-semibold">Ventas</th>
                <th class="px-3 py-2 text-right font-semibold">Total ($)</th>
                <th class="py-2 pl-3 text-right font-semibold">En Bs.</th>
              </tr>
            </thead>
            <tbody id="rp-metodos-filas" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Reporte imprimible: oculto en pantalla, es lo único visible al imprimir -->
  <div id="rp-imprimible" class="hidden print:block"></div>

  <CuadreCaja />
</DashboardLayout>

<script>
  import Chart from 'chart.js/auto';
  import * as inventoryService from '../lib/inventoryService';
  import { formatearBolivares, formatearMoneda } from '../utils/format';
import { alCambiarDatos } from '../lib/realtime';
  import { esMetodoBolivares } from '../utils/pagos';
  import { resumirPorMetodo, type ResumenMetodo } from '../utils/ventasResumen';
  import { $tema } from '../stores/theme';
  import { contarHasta } from '../utils/animaciones';
  import {
    calcularRango,
    formatearClaveDia,
    formatearEtiquetaDia,
    listarDiasEnRango,
    type RangoPreestablecido,
  } from '../utils/dateRange';
  import type { ProductoConRelaciones } from '../types/database.types';
  import type { MovimientoConProducto } from '../lib/db/movimientos';
  import type { Devolucion } from '../types/database.types';
  import type { VentaRegistrada } from '../lib/inventoryService';

  let productos: ProductoConRelaciones[] = [];
  let movimientos: MovimientoConProducto[] = [];
  let ventasRegistradas: VentaRegistrada[] = [];
  let devoluciones: Devolucion[] = [];
  let rangoActual: RangoPreestablecido = 'semana';

  const botonesRango = Array.from(document.querySelectorAll<HTMLButtonElement>('.rp-rango'));
  const contenedorPersonalizado = document.getElementById('rp-personalizado') as HTMLDivElement;
  const inputDesde = document.getElementById('rp-desde') as HTMLInputElement;
  const inputHasta = document.getElementById('rp-hasta') as HTMLInputElement;
  const elIngresos = document.getElementById('stat-ingresos') as HTMLParagraphElement;
  const elCostos = document.getElementById('stat-costos') as HTMLParagraphElement;
  const elGanancia = document.getElementById('stat-ganancia') as HTMLParagraphElement;
  const elRangoEtiqueta = document.getElementById('rp-rango-etiqueta') as HTMLParagraphElement;
  const elSinVentas = document.getElementById('rp-sin-ventas') as HTMLParagraphElement;
  const elImprimible = document.getElementById('rp-imprimible') as HTMLDivElement;

  function escaparHtml(texto: string): string {
    const div = document.createElement('div');
    div.textContent = texto;
    return div.innerHTML;
  }

  function coloresChart() {
    const oscuro = document.documentElement.classList.contains('dark');
    return {
      texto: oscuro ? '#cbd5e1' : '#475569',
      grid: oscuro ? 'rgba(148,163,184,0.15)' : 'rgba(100,116,139,0.15)',
    };
  }

  function opcionesBase() {
    const { texto, grid } = coloresChart();
    return {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 900, easing: 'easeOutQuart' as const },
      plugins: { legend: { labels: { color: texto } } },
      scales: {
        x: { ticks: { color: texto }, grid: { color: grid } },
        y: { ticks: { color: texto }, grid: { color: grid }, beginAtZero: true },
      },
    };
  }

  const sinDatosTexto: string[] = [];
  const sinDatosNum: number[] = [];

  const chartVentas = new Chart(document.getElementById('chart-ventas') as HTMLCanvasElement, {
    type: 'bar',
    data: {
      labels: sinDatosTexto,
      datasets: [
        { label: 'Ingresos', data: sinDatosNum, backgroundColor: '#1871d3', borderRadius: 6 },
        { label: 'Costos', data: sinDatosNum.slice(), backgroundColor: '#f59e0b', borderRadius: 6 },
        { label: 'Ganancia neta', data: sinDatosNum.slice(), backgroundColor: '#18c8d8', borderRadius: 6 },
      ],
    },
    options: opcionesBase(),
  });

  const chartCategorias = new Chart(document.getElementById('chart-categorias') as HTMLCanvasElement, {
    type: 'bar',
    data: { labels: sinDatosTexto.slice(), datasets: [{ label: 'Unidades vendidas', data: sinDatosNum.slice(), backgroundColor: '#1871d3', borderRadius: 6 }] },
    options: { ...opcionesBase(), indexAxis: 'y' as const, plugins: { legend: { display: false } } },
  });

  const chartModelos = new Chart(document.getElementById('chart-modelos') as HTMLCanvasElement, {
    type: 'bar',
    data: { labels: sinDatosTexto.slice(), datasets: [{ label: 'Unidades vendidas', data: sinDatosNum.slice(), backgroundColor: '#18a8d8', borderRadius: 6 }] },
    options: { ...opcionesBase(), indexAxis: 'y' as const, plugins: { legend: { display: false } } },
  });

  const chartMetodos = new Chart(document.getElementById('chart-metodos') as HTMLCanvasElement, {
    type: 'bar',
    data: { labels: sinDatosTexto.slice(), datasets: [{ label: 'Total vendido ($)', data: sinDatosNum.slice(), backgroundColor: '#18c8d8', borderRadius: 6 }] },
    options: { ...opcionesBase(), indexAxis: 'y' as const, plugins: { legend: { display: false } } },
  });

  function repintarCharts() {
    const { texto, grid } = coloresChart();
    for (const chart of [chartVentas, chartCategorias, chartModelos, chartMetodos]) {
      if (chart.options.plugins?.legend?.labels) chart.options.plugins.legend.labels.color = texto;
      if (chart.options.scales?.x) {
        (chart.options.scales.x as any).ticks.color = texto;
        (chart.options.scales.x as any).grid.color = grid;
      }
      if (chart.options.scales?.y) {
        (chart.options.scales.y as any).ticks.color = texto;
        (chart.options.scales.y as any).grid.color = grid;
      }
      chart.update();
    }
  }

  function marcarBotonActivo() {
    for (const boton of botonesRango) {
      const activo = boton.dataset.rango === rangoActual;
      boton.classList.toggle('bg-brand-600', activo);
      boton.classList.toggle('text-white', activo);
      boton.classList.toggle('border-brand-600', activo);
      boton.classList.toggle('hover:bg-slate-50', !activo);
      boton.classList.toggle('dark:hover:bg-slate-800', !activo);
    }
  }

  function actualizarReportePrintable(
    rango: { desde: Date; hasta: Date },
    ingresos: number,
    costos: number,
    ganancia: number,
    topCategorias: [string, number][],
    topModelos: [string, number][],
    lineasVenta: number,
    porMetodo: ResumenMetodo[],
    devolucionesPeriodo: Devolucion[]
  ) {
    const periodo = `${rango.desde.toLocaleDateString('es-GT', { dateStyle: 'medium' })} – ${rango.hasta.toLocaleDateString('es-GT', { dateStyle: 'medium' })}`;

    elImprimible.innerHTML = `
      <div class="mx-auto max-w-2xl p-8 text-black">
        <img src="/logo.png" alt="Edward Accesorios" class="mb-3 h-14 w-auto" />
        <h1 class="text-xl font-bold">Edward Accesorios — Reporte de ventas</h1>
        <p class="text-sm text-slate-600">Periodo: ${escaparHtml(periodo)}</p>
        <p class="text-xs text-slate-400">Generado el ${new Date().toLocaleString('es-GT')}</p>

        <div class="mt-6 grid grid-cols-3 gap-4 border-y border-slate-300 py-4 text-center">
          <div><p class="text-xs uppercase text-slate-500">Ingresos</p><p class="text-lg font-semibold">${formatearMoneda(ingresos)}</p></div>
          <div><p class="text-xs uppercase text-slate-500">Costos</p><p class="text-lg font-semibold">${formatearMoneda(costos)}</p></div>
          <div><p class="text-xs uppercase text-slate-500">Ganancia neta</p><p class="text-lg font-semibold">${formatearMoneda(ganancia)}</p></div>
        </div>

        <h2 class="mt-6 text-sm font-semibold">Top categorías más vendidas</h2>
        <ol class="mt-2 list-decimal pl-5 text-sm">
          ${topCategorias.length ? topCategorias.map(([nombre, cant]) => `<li>${escaparHtml(nombre)} — ${cant} u.</li>`).join('') : '<li class="list-none text-slate-400">Sin datos en este periodo.</li>'}
        </ol>

        <h2 class="mt-4 text-sm font-semibold">Top modelos de teléfono más solicitados</h2>
        <ol class="mt-2 list-decimal pl-5 text-sm">
          ${topModelos.length ? topModelos.map(([nombre, cant]) => `<li>${escaparHtml(nombre)} — ${cant} u.</li>`).join('') : '<li class="list-none text-slate-400">Sin datos en este periodo.</li>'}
        </ol>

        <h2 class="mt-4 text-sm font-semibold">Ventas por tipo de cobro</h2>
        <table class="mt-2 w-full text-left text-sm">
          <thead><tr class="text-xs text-slate-500"><th class="py-1 font-medium">Tipo de cobro</th><th class="py-1 text-right font-medium">Ventas</th><th class="py-1 text-right font-medium">Total ($)</th><th class="py-1 text-right font-medium">En Bs.</th></tr></thead>
          <tbody>
            ${porMetodo
              .filter((r) => r.cantidad > 0)
              .map((r) => `<tr><td class="py-0.5">${escaparHtml(r.etiqueta)}</td><td class="py-0.5 text-right">${r.cantidad}</td><td class="py-0.5 text-right">${formatearMoneda(r.totalUsd)}</td><td class="py-0.5 text-right">${esMetodoBolivares(r.metodo) ? formatearBolivares(r.totalBs) : '—'}</td></tr>`)
              .join('') || '<tr><td colspan="4" class="py-1 text-slate-400">Sin ventas con datos de cliente en este periodo.</td></tr>'}
          </tbody>
        </table>

        <p class="mt-6 text-xs text-slate-400">Total de líneas de venta en el periodo: ${lineasVenta}</p>
        ${devolucionesPeriodo.length ? `<p class="text-xs text-slate-400">Las cifras ya descuentan ${devolucionesPeriodo.length} devolución(es) o cambio(s) del periodo.</p>` : ''}
      </div>
    `;
  }

  function actualizarReporte() {
    marcarBotonActivo();
    const rango =
      rangoActual === 'personalizado'
        ? calcularRango('personalizado', { desde: inputDesde.value, hasta: inputHasta.value })
        : calcularRango(rangoActual);

    elRangoEtiqueta.textContent = `Mostrando del ${rango.desde.toLocaleDateString('es-GT', { dateStyle: 'medium' })} al ${rango.hasta.toLocaleDateString('es-GT', { dateStyle: 'medium' })}`;

    const productosPorId = Object.fromEntries(productos.map((p) => [p.id, p]));
    const ventas = movimientos.filter((m) => {
      if (m.tipo !== 'SALIDA') return false;
      const fecha = new Date(m.fecha);
      return fecha >= rango.desde && fecha <= rango.hasta;
    });

    elSinVentas.classList.toggle('hidden', ventas.length > 0);

    const dias = listarDiasEnRango(rango.desde, rango.hasta);
    const porDia: Record<string, { ingresos: number; costos: number }> = Object.fromEntries(
      dias.map((d) => [d, { ingresos: 0, costos: 0 }])
    );
    const porCategoria: Record<string, number> = {};
    const porModelo: Record<string, number> = {};

    let ingresosTotal = 0;
    let costosTotal = 0;

    for (const mov of ventas) {
      const producto = productosPorId[mov.producto_id];
      if (!producto) continue;

      const ingreso = producto.precio_venta * mov.cantidad;
      const costo = producto.precio_compra * mov.cantidad;
      ingresosTotal += ingreso;
      costosTotal += costo;

      const clave = formatearClaveDia(new Date(mov.fecha));
      if (porDia[clave]) {
        porDia[clave].ingresos += ingreso;
        porDia[clave].costos += costo;
      }

      porCategoria[producto.categoria] = (porCategoria[producto.categoria] ?? 0) + mov.cantidad;

      for (const modelo of producto.modelos_compatibles) {
        const claveModelo = `${modelo.marca} ${modelo.modelo}`;
        porModelo[claveModelo] = (porModelo[claveModelo] ?? 0) + mov.cantidad;
      }
    }

    // Devoluciones y cambios del periodo: lo devuelto resta ingreso, costo y unidades (lo entregado a
    // cambio ya está en las ventas, porque sale del inventario como una SALIDA).
    const devolucionesPeriodo = devoluciones.filter((d) => {
      const fecha = new Date(d.fecha);
      return fecha >= rango.desde && fecha <= rango.hasta;
    });
    for (const dev of devolucionesPeriodo) {
      const clave = formatearClaveDia(new Date(dev.fecha));
      for (const item of dev.items_devueltos) {
        const producto = productosPorId[item.producto_id];
        const ingreso = item.precio_unitario * item.cantidad;
        const costo = (producto?.precio_compra ?? 0) * item.cantidad;
        ingresosTotal -= ingreso;
        costosTotal -= costo;
        if (porDia[clave]) {
          porDia[clave].ingresos -= ingreso;
          porDia[clave].costos -= costo;
        }
        if (!producto) continue;
        porCategoria[producto.categoria] = (porCategoria[producto.categoria] ?? 0) - item.cantidad;
        for (const modelo of producto.modelos_compatibles) {
          const claveModelo = `${modelo.marca} ${modelo.modelo}`;
          porModelo[claveModelo] = (porModelo[claveModelo] ?? 0) - item.cantidad;
        }
      }
    }

    const gananciaTotal = ingresosTotal - costosTotal;
    contarHasta(elIngresos, ingresosTotal, formatearMoneda, 800);
    contarHasta(elCostos, costosTotal, formatearMoneda, 800);
    contarHasta(elGanancia, gananciaTotal, formatearMoneda, 800);

    chartVentas.data.labels = dias.map(formatearEtiquetaDia);
    chartVentas.data.datasets[0].data = dias.map((d) => Number(porDia[d].ingresos.toFixed(2)));
    chartVentas.data.datasets[1].data = dias.map((d) => Number(porDia[d].costos.toFixed(2)));
    chartVentas.data.datasets[2].data = dias.map((d) => Number((porDia[d].ingresos - porDia[d].costos).toFixed(2)));
    chartVentas.update();

    const topCategorias = Object.entries(porCategoria)
      .filter(([, cantidad]) => cantidad > 0)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 5);
    chartCategorias.data.labels = topCategorias.map(([nombre]) => nombre);
    chartCategorias.data.datasets[0].data = topCategorias.map(([, cantidad]) => cantidad);
    chartCategorias.update();

    const topModelos = Object.entries(porModelo)
      .filter(([, cantidad]) => cantidad > 0)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 5);
    chartModelos.data.labels = topModelos.map(([nombre]) => nombre);
    chartModelos.data.datasets[0].data = topModelos.map(([, cantidad]) => cantidad);
    chartModelos.update();

    // Ventas por tipo de cobro (de la tabla de ventas con cliente)
    const ventasDelPeriodo = ventasRegistradas.filter((v) => {
      const fecha = new Date(v.fecha);
      return fecha >= rango.desde && fecha <= rango.hasta;
    });
    const porMetodo = resumirPorMetodo(ventasDelPeriodo, devolucionesPeriodo);
    chartMetodos.data.labels = porMetodo.map((r) => r.etiqueta);
    chartMetodos.data.datasets[0].data = porMetodo.map((r) => Number(r.totalUsd.toFixed(2)));
    chartMetodos.update();
    document.getElementById('rp-metodos-filas')!.innerHTML = porMetodo
      .map(
        (r) => `
          <tr class="${r.cantidad === 0 ? 'text-slate-400 dark:text-slate-600' : 'text-slate-700 dark:text-slate-300'}">
            <td class="py-2 pr-3 font-medium">${escaparHtml(r.etiqueta)}</td>
            <td class="px-3 py-2 text-right tabular-nums">${r.cantidad}</td>
            <td class="px-3 py-2 text-right tabular-nums">${formatearMoneda(r.totalUsd)}</td>
            <td class="py-2 pl-3 text-right tabular-nums">${esMetodoBolivares(r.metodo) ? formatearBolivares(r.totalBs) : '—'}</td>
          </tr>`
      )
      .join('');

    actualizarReportePrintable(rango, ingresosTotal, costosTotal, gananciaTotal, topCategorias, topModelos, ventas.length, porMetodo, devolucionesPeriodo);
  }

  for (const boton of botonesRango) {
    boton.addEventListener('click', () => {
      rangoActual = boton.dataset.rango as RangoPreestablecido;
      contenedorPersonalizado.classList.toggle('flex', rangoActual === 'personalizado');
      contenedorPersonalizado.classList.toggle('hidden', rangoActual !== 'personalizado');
      actualizarReporte();
    });
  }

  inputDesde.addEventListener('change', () => rangoActual === 'personalizado' && actualizarReporte());
  inputHasta.addEventListener('change', () => rangoActual === 'personalizado' && actualizarReporte());
  document.getElementById('rp-imprimir')?.addEventListener('click', () => window.print());
  document.getElementById('rp-cuadre')?.addEventListener('click', () => window.dispatchEvent(new Event('easystem:abrir-cuadre')));

  $tema.subscribe(() => repintarCharts());

  // Si la tabla de ventas no existe todavía (migración 0011 sin aplicar), el resto del reporte sigue funcionando.
  const pedirVentas = () => inventoryService.listarVentas({ limite: 2000 }).catch((err) => {
    const aviso = document.getElementById('rp-metodos-error')!;
    aviso.textContent = `No se pudieron cargar las ventas por tipo de cobro: ${err instanceof Error ? err.message : err}`;
    aviso.classList.remove('hidden');
    return [] as VentaRegistrada[];
  });

  const pedirDevoluciones = () => inventoryService.listarDevoluciones().catch((err) => {
    console.error('[EASYSTEM] No se pudieron cargar las devoluciones.', err);
    return [] as Devolucion[];
  });

  async function cargarReporte() {
    const [listaProductos, listaMovimientos, listaVentas, listaDevoluciones] = await Promise.all([
      inventoryService.listarProductos({ catalogoCompleto: true }),
      inventoryService.listarMovimientos(2000),
      pedirVentas(),
      pedirDevoluciones(),
    ]);
    productos = listaProductos;
    movimientos = listaMovimientos;
    ventasRegistradas = listaVentas;
    devoluciones = listaDevoluciones;
    actualizarReporte();
  }

  cargarReporte();
  // Otro dispositivo registró una venta, una devolución o un ingreso: el reporte se actualiza solo (con más espera: es pesado)
  alCambiarDatos(['ventas', 'devoluciones', 'movimientos_inventario', 'productos'], cargarReporte, 2000);
</script>
