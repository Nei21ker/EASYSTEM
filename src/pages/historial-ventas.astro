---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import StatCard from '../components/dashboard/StatCard.astro';
import DevolucionVenta from '../components/ventas/DevolucionVenta.astro';
import PestanasHistorial from '../components/layout/PestanasHistorial.astro';
import { METODOS_PAGO } from '../utils/pagos';

const claseSelect =
  'rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-xs font-medium text-slate-700 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200';
const claseRango =
  'hv-rango rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 transition dark:border-slate-700 dark:text-slate-300';
const claseBotonSecundario =
  'rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800';
---

<DashboardLayout titulo="Ventas realizadas" subtitulo="Historial de ventas con cliente y tipo de cobro" roles={["administrador", "gerente", "encargado"]}>
  <PestanasHistorial activa="ventas" />
  <div class="space-y-4">
    <p id="hv-aviso-exito" role="status" class="hidden rounded-lg bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"></p>

    <!-- Filtros -->
    <div class="space-y-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-wrap items-center gap-2">
          <button data-rango="hoy" class={claseRango}>Hoy</button>
          <button data-rango="semana" class={claseRango}>Esta semana</button>
          <button data-rango="mes" class={claseRango}>Este mes</button>
          <button data-rango="personalizado" class={claseRango}>Personalizado</button>
          <div id="hv-personalizado" class="hidden items-center gap-2">
            <input id="hv-desde" type="date" class="rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            <span class="text-xs text-slate-400">a</span>
            <input id="hv-hasta" type="date" class="rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <button id="hv-exportar" type="button" class={`${claseBotonSecundario} hidden`}>Exportar CSV</button>
          <!-- Administrador y gerente: elegir ventas y eliminarlas (sus piezas vuelven al stock) -->
          <button id="hv-seleccionar" type="button" class={`${claseBotonSecundario} hidden`}>Seleccionar</button>
          <!-- Solo el administrador: borra todas las ventas y devuelve las piezas al stock -->
          <button id="hv-resetear" type="button" class="hidden rounded-lg border border-red-200 px-3 py-2 text-xs font-semibold text-red-600 transition hover:bg-red-50 dark:border-red-500/40 dark:text-red-400 dark:hover:bg-red-500/10">Resetear ventas</button>
        </div>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <div class="relative flex-1">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
            <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" stroke-linecap="round" />
          </svg>
          <input
            id="hv-buscador"
            type="search"
            autocomplete="off"
            placeholder="Buscar por folio, nombre, cédula o teléfono..."
            class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-9 pr-3 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white"
          />
        </div>
        <select id="hv-metodo" class={claseSelect} aria-label="Filtrar por tipo de cobro">
          <option value="">Todos los tipos de cobro</option>
          {METODOS_PAGO.map((m) => <option value={m.valor}>{m.etiqueta}</option>)}
          <option value="MIXTO">Pago mixto (varios tipos de cobro)</option>
        </select>
      </div>

      <p id="hv-aviso-vendedor" class="hidden rounded-lg bg-slate-50 px-3 py-2 text-xs text-slate-500 dark:bg-slate-800/50 dark:text-slate-400">
        Estás viendo solo las ventas que registraste tú. El encargado y el administrador ven todas las de su local.
      </p>
    </div>

    <!-- Resumen -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <StatCard id="hv-stat-ventas" etiqueta="Ventas" valor="—" icono="movimientos" />
      <StatCard id="hv-stat-total" etiqueta="Total vendido" valor="—" tendencia=" " icono="valor" />
      <StatCard id="hv-stat-bs" etiqueta="Cobrado en bolívares" valor="—" icono="valor" />
    </section>

    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="border-b border-slate-200 px-5 py-3 dark:border-slate-800">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Por tipo de cobro</h2>
        <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Si un cliente pagó con varios tipos de cobro, cada parte suma en su tipo; "Ventas" cuenta en cuántas ventas se usó.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[30rem] text-left text-sm">
          <thead>
            <tr class="text-[11px] uppercase tracking-wider text-slate-500 dark:text-slate-400">
              <th class="px-5 py-2 font-semibold">Tipo de cobro</th>
              <th class="px-4 py-2 text-right font-semibold">Ventas</th>
              <th class="px-4 py-2 text-right font-semibold">Total ($)</th>
              <th class="px-5 py-2 text-right font-semibold">Cobrado en Bs.</th>
            </tr>
          </thead>
          <tbody id="hv-resumen-metodos" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
        </table>
      </div>
    </div>

    <!-- Listado -->
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="overflow-x-auto">
        <table class="tabla-tarjetas w-full text-left text-sm md:table-fixed">
          <colgroup>
            <col class="w-24" />
            <col class="w-[20%]" />
            <col class="w-40" />
            <col />
            <col class="w-24" />
            <col id="hv-col-vendedor" class="hidden w-24" />
            <col id="hv-col-acciones" class="hidden w-44" />
          </colgroup>
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50/70 text-[11px] uppercase tracking-wider text-slate-500 dark:border-slate-800 dark:bg-slate-800/40 dark:text-slate-400">
              <th class="px-5 py-3 font-semibold">Folio</th>
              <th class="px-4 py-3 font-semibold">Cliente</th>
              <th class="px-4 py-3 font-semibold">Tipo de cobro</th>
              <th class="px-4 py-3 font-semibold">Productos</th>
              <th class="px-4 py-3 text-right font-semibold">Total</th>
              <th id="hv-th-vendedor" class="hidden px-5 py-3 font-semibold">Vendedor</th>
              <th id="hv-th-acciones" class="hidden px-4 py-3 text-right font-semibold">Acciones</th>
            </tr>
          </thead>
          <tbody id="hv-filas" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
        </table>
      </div>

      <p id="hv-cargando" class="px-5 py-8 text-sm text-slate-500 dark:text-slate-400">Cargando ventas...</p>
      <div id="hv-sin-resultados" class="hidden px-5 py-12 text-center">
        <p class="text-sm font-medium text-slate-700 dark:text-slate-200">No hay ventas con esos filtros</p>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Cambia el rango de fechas, el tipo de cobro o la búsqueda.</p>
      </div>
      <p id="hv-error" class="hidden px-5 py-8 text-sm text-red-600 dark:text-red-400"></p>

      <div id="hv-paginacion" class="hidden flex-col gap-3 border-t border-slate-100 px-4 py-3 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800 dark:text-slate-400">
        <p id="hv-rango-texto"></p>
        <div class="flex items-center gap-1">
          <button id="hv-anterior" type="button" class={`${claseBotonSecundario} disabled:cursor-not-allowed disabled:opacity-40`}>← Anterior</button>
          <span id="hv-pagina" class="min-w-20 text-center font-medium text-slate-700 dark:text-slate-200"></span>
          <button id="hv-siguiente" type="button" class={`${claseBotonSecundario} disabled:cursor-not-allowed disabled:opacity-40`}>Siguiente →</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra de la selección: fuera del contenedor con separación vertical para que quede pegada al borde de la pantalla -->
  <div id="hv-barra-seleccion" class="fixed inset-x-0 bottom-0 z-30 mb-0 hidden border-t border-slate-200 bg-white/95 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 shadow-[0_-4px_16px_rgba(0,0,0,0.12)] backdrop-blur lg:left-64 print:hidden dark:border-slate-700 dark:bg-slate-900/95">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <p id="hv-sel-conteo" class="text-sm font-semibold text-slate-900 dark:text-white">Ninguna seleccionada</p>
      <div class="flex flex-wrap items-center gap-2">
        <button id="hv-sel-pagina" type="button" class={claseBotonSecundario}>Elegir las de esta página</button>
        <button id="hv-sel-salir" type="button" class={claseBotonSecundario}>Cancelar</button>
        <button id="hv-sel-eliminar" type="button" disabled class="rounded-lg bg-red-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-40">Eliminar seleccionadas</button>
      </div>
    </div>
  </div>

  <DevolucionVenta />

  <dialog id="hv-del-dialogo" class="m-auto w-[min(94vw,30rem)] rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
    <div class="space-y-4 px-5 py-5 text-sm">
      <h2 class="text-base font-semibold text-red-600 dark:text-red-400">Eliminar ventas</h2>
      <p id="hv-del-resumen" class="rounded-lg bg-slate-50 px-3 py-3 text-slate-700 dark:bg-slate-800 dark:text-slate-200">Calculando…</p>
      <ul class="list-disc space-y-1 pl-5 text-xs text-slate-600 dark:text-slate-300">
        <li>Se borran esas ventas con sus devoluciones y <strong>dejan de contar en los reportes</strong>.</li>
        <li>Las piezas que dejaron vendidas <strong>vuelven al stock</strong> de su local, con los mismos códigos.</li>
        <li>En Movimientos queda una entrada "Eliminación de venta" como rastro.</li>
        <li><strong>No se puede deshacer.</strong></li>
      </ul>
      <p id="hv-del-aviso" class="hidden rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:bg-amber-500/10 dark:text-amber-300"></p>
      <div>
        <label for="hv-del-confirmar" class="block text-xs font-medium text-slate-600 dark:text-slate-300">Para confirmar, escribe <strong>ELIMINAR</strong></label>
        <input id="hv-del-confirmar" type="text" autocomplete="off" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 focus:border-red-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
      </div>
      <p id="hv-del-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-300"></p>
      <div class="flex justify-end gap-2">
        <button id="hv-del-cancelar" type="button" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Cancelar</button>
        <button id="hv-del-ejecutar" type="button" disabled class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50">Eliminar</button>
      </div>
    </div>
  </dialog>

  <dialog id="hv-reset-dialogo" class="m-auto w-[min(94vw,30rem)] rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
    <div class="space-y-4 px-5 py-5 text-sm">
      <h2 class="text-base font-semibold text-red-600 dark:text-red-400">Resetear las ventas</h2>
      <p id="hv-reset-resumen" class="rounded-lg bg-slate-50 px-3 py-3 text-slate-700 dark:bg-slate-800 dark:text-slate-200">Calculando…</p>
      <ul class="list-disc space-y-1 pl-5 text-xs text-slate-600 dark:text-slate-300">
        <li>Se borran <strong>todas</strong> las ventas y devoluciones de <strong>todos los locales y fechas</strong> (no solo las que ves ahora).</li>
        <li>Las piezas que esas ventas dejaron vendidas vuelven al stock de su local.</li>
        <li>Los movimientos de stock siguen en Movimientos, con una entrada "Reseteo de ventas".</li>
        <li><strong>No se puede deshacer.</strong></li>
      </ul>
      <div>
        <label for="hv-reset-confirmar" class="block text-xs font-medium text-slate-600 dark:text-slate-300">Para confirmar, escribe <strong>RESETEAR</strong></label>
        <input id="hv-reset-confirmar" type="text" autocomplete="off" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 focus:border-red-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
      </div>
      <p id="hv-reset-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-300"></p>
      <div class="flex justify-end gap-2">
        <button id="hv-reset-cancelar" type="button" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Cancelar</button>
        <button id="hv-reset-ejecutar" type="button" disabled class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50">Resetear ventas</button>
      </div>
    </div>
  </dialog>
</DashboardLayout>

<script>
  import * as inventoryService from '../lib/inventoryService';
  import { esGerencia, esGlobal, obtenerSesionActual } from '../lib/auth';
  import { formatearBolivares, formatearFecha, formatearMoneda } from '../utils/format';
  import { descargarCSV } from '../utils/csv';
  import { animarLista, contarHasta } from '../utils/animaciones';
import { alCambiarDatos } from '../lib/realtime';
  import { calcularRango, type RangoPreestablecido } from '../utils/dateRange';
  import { esMetodoBolivares, etiquetaMetodoPago, pagosDeVenta } from '../utils/pagos';
  import { resumirPorMetodo } from '../utils/ventasResumen';
  import { escaparHtml, normalizarTexto } from '../utils/productosUI';
  import type { Devolucion } from '../types/database.types';
  import type { VentaRegistrada } from '../lib/inventoryService';

  const POR_PAGINA = 25;

  let ventas: VentaRegistrada[] = []; // ya filtradas por rango de fechas
  let devolucionesPorVenta = new Map<string, Devolucion[]>();
  let rangoActual: RangoPreestablecido = 'mes';
  // Gerencia (administrador y encargado): ven las ventas de todo su alcance, devuelven productos y exportan.
  // Vendedor y técnico: solo las ventas que registraron ellos.
  let esAdministrador = false;
  let verLocal = false; // vista "Todos los locales": se indica el local de cada venta
  let nombresLocales = new Map<string, string>();
  let nombreSesion = '';
  let pagina = 1;
  // Selección de ventas para eliminar (administrador y gerente); se guarda por id, así sobrevive a filtros, páginas y refrescos
  let puedeEliminar = false;
  let modoSeleccion = false;
  const seleccion = new Set<string>();
  let primeraVez = true;
  let cargaId = 0; // descarta respuestas viejas si se cambia de rango rápido

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const filas = $<HTMLTableSectionElement>('hv-filas');
  const buscador = $<HTMLInputElement>('hv-buscador');
  const selectMetodo = $<HTMLSelectElement>('hv-metodo');
  const botonesRango = Array.from(document.querySelectorAll<HTMLButtonElement>('.hv-rango'));
  const contenedorPersonalizado = $('hv-personalizado');
  const inputDesde = $<HTMLInputElement>('hv-desde');
  const inputHasta = $<HTMLInputElement>('hv-hasta');

  function marcarBotonActivo() {
    for (const boton of botonesRango) {
      const activo = boton.dataset.rango === rangoActual;
      boton.classList.toggle('bg-brand-600', activo);
      boton.classList.toggle('text-white', activo);
      boton.classList.toggle('border-brand-600', activo);
      boton.classList.toggle('hover:bg-slate-50', !activo);
      boton.classList.toggle('dark:hover:bg-slate-800', !activo);
    }
  }

  // --- Filtros en pantalla ------------------------------------------------------
  function filtrar(): VentaRegistrada[] {
    const q = normalizarTexto(buscador.value.trim());
    const tokens = q ? q.split(/\s+/) : [];
    const metodo = selectMetodo.value;
    return ventas.filter((v) => {
      if (metodo === 'MIXTO' ? v.metodo_pago !== 'MIXTO' : metodo && !pagosDeVenta(v).some((p) => p.metodo === metodo)) return false;
      if (tokens.length === 0) return true;
      const texto = normalizarTexto(
        `${v.folio} ${String(v.folio).padStart(4, "0")} ${v.cliente_nombre} ${v.cliente_cedula} ${v.cliente_cedula.replace(/\D/g, '')} ${v.cliente_telefono} ${v.cliente_telefono.replace(/\D/g, '')}`
      );
      return tokens.every((t) => texto.includes(t));
    });
  }

  const estiloMetodo = (metodo: string) =>
    metodo === 'MIXTO'
      ? 'bg-violet-100 text-violet-700 dark:bg-violet-500/10 dark:text-violet-300'
      : esMetodoBolivares(metodo)
      ? 'bg-brand-100 text-brand-700 dark:bg-brand-500/15 dark:text-brand-300'
      : metodo === 'BINANCE_USDT'
        ? 'bg-amber-100 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400'
        : 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400';

  /** ¿Queda algo por devolver de esta venta? */
  function quedaPorDevolver(v: VentaRegistrada): boolean {
    const ya = new Map<string, number>();
    for (const d of devolucionesDe(v)) for (const i of d.items_devueltos) ya.set(i.producto_id, (ya.get(i.producto_id) ?? 0) + i.cantidad);
    return v.items.some((i) => i.cantidad - (ya.get(i.producto_id) ?? 0) > 0);
  }

  function botonDevolver(v: VentaRegistrada): string {
    if (!v.folio) return '<span class="text-[11px] text-slate-400">Sincronizando…</span>';
    if (!quedaPorDevolver(v)) return '<span class="text-[11px] text-slate-400">Totalmente devuelta</span>';
    return `<button type="button" data-devolver-venta="${v.id}" class="whitespace-nowrap rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-semibold text-orange-700 hover:bg-orange-50 dark:border-slate-700 dark:text-orange-300 dark:hover:bg-slate-800">Devolución / cambio</button>`;
  }

  function htmlDevolucion(d: Devolucion): string {
    const lineas = (items: { cantidad: number; nombre: string }[]) => items.map((i) => `${i.cantidad} × ${escaparHtml(i.nombre)}`).join(', ');
    const dinero =
      d.reembolso
        ? `Reembolso: ${d.reembolso.monto_bs != null ? formatearBolivares(d.reembolso.monto_bs) : formatearMoneda(d.reembolso.monto_usd)} (${escaparHtml(etiquetaMetodoPago(d.reembolso.metodo))})`
        : d.diferencia > 0.01
          ? `Cliente pagó ${formatearMoneda(d.diferencia)} de diferencia`
          : 'Sin diferencia de precio';
    return `
      <div class="mt-2 rounded-lg border border-orange-200 bg-orange-50/60 px-2.5 py-2 text-left text-[11px] text-slate-700 dark:border-orange-500/30 dark:bg-orange-500/5 dark:text-slate-300">
        <p class="font-semibold text-orange-700 dark:text-orange-300">Devolución #${String(d.folio).padStart(4, '0')} · ${escaparHtml(formatearFecha(d.fecha))}</p>
        <p>Devolvió: ${lineas(d.items_devueltos)}</p>
        ${d.items_nuevos.length ? `<p>A cambio: ${lineas(d.items_nuevos)}</p>` : ''}
        <p>${dinero} · Motivo: ${escaparHtml(d.motivo)}</p>
      </div>`;
  }

  /** Dirección de la captura: en el servidor es un archivo privado (se entrega con la sesión); en la demo es una imagen guardada en el navegador. */
  const hrefComprobante = (ruta: string) => (ruta.startsWith('data:') ? '#' : `/api/archivos/privado/${encodeURI(ruta)}`);

  /** Una imagen data: no se abre en una pestaña nueva: se pasa a un enlace de objeto. */
  function abrirImagenLocal(dataUrl: string) {
    const [cabecera, datos] = dataUrl.split(',');
    const tipo = /data:([^;]+)/.exec(cabecera)?.[1] ?? 'image/jpeg';
    const binario = atob(datos);
    const bytes = new Uint8Array(binario.length);
    for (let i = 0; i < binario.length; i++) bytes[i] = binario.charCodeAt(i);
    window.open(URL.createObjectURL(new Blob([bytes], { type: tipo })), '_blank', 'noopener');
  }

  function filaHtml(v: VentaRegistrada): string {
    const unidades = v.items.reduce((suma, i) => suma + i.cantidad, 0);
    const pagos = pagosDeVenta(v);
    const devs = devolucionesDe(v);
    const detalle = v.items
      .map(
        (i) => `<li class="flex justify-between gap-3"><span class="min-w-0 break-words">${i.cantidad} × ${escaparHtml(i.nombre)}${i.seleccion_manual ? `<span class="mt-0.5 block text-[10px] text-amber-700 dark:text-amber-400">Código a mano: ${escaparHtml(i.seleccion_manual.codigos.join(', '))} · autorizó ${escaparHtml(i.seleccion_manual.autorizado_nombre)}</span>` : ''}</span><span class="shrink-0 tabular-nums">${formatearMoneda(i.precio_unitario * i.cantidad)}${i.precio_lista !== undefined ? ` <span class="text-[10px] text-amber-700 dark:text-amber-400">(lista ${formatearMoneda(i.precio_lista)})</span>` : ''}</span></li>`
      )
      .join('');
    const folio = v.folio
      ? `#${String(v.folio).padStart(4, '0')}${devs.length ? ' <span class="ml-1 rounded-full bg-orange-100 px-2 py-0.5 align-middle text-[10px] font-semibold text-orange-700 dark:bg-orange-500/10 dark:text-orange-300">Devolución</span>' : ''}`
      : '<span class="rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-700 dark:bg-amber-500/10 dark:text-amber-400">Pendiente de sincronizar</span>';

    return `
      <tr class="align-top text-slate-700 transition-colors hover:bg-slate-50/80 dark:text-slate-300 dark:hover:bg-slate-800/40 ${modoSeleccion && seleccion.has(v.id) ? 'bg-red-50/70 dark:bg-red-500/10' : ''}">
        <td class="px-5 py-3">
          ${
            modoSeleccion && v.folio
              ? `<label class="mb-1.5 flex cursor-pointer items-center gap-2 text-xs font-medium text-slate-600 dark:text-slate-300"><input type="checkbox" data-sel-venta="${escaparHtml(v.id)}" ${seleccion.has(v.id) ? 'checked' : ''} class="h-5 w-5 rounded border-slate-300 text-red-600 focus:ring-red-500" aria-label="Elegir la venta ${escaparHtml(String(v.folio))}" /> Elegir</label>`
              : ''
          }
          <p class="font-semibold text-slate-900 dark:text-white">${folio}</p>
          <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">${escaparHtml(formatearFecha(v.fecha))}</p>
          ${verLocal ? `<p class="mt-0.5 text-[11px] font-medium text-brand-700 dark:text-brand-300">${escaparHtml(nombresLocales.get(v.local_id) ?? 'Local')}</p>` : ''}
        </td>
        <td data-label="Cliente" class="px-4 py-3">
          <div class="min-w-0 text-right md:text-left">
            <p class="font-medium text-slate-900 dark:text-white">${escaparHtml(v.cliente_nombre)}</p>
            <p class="mt-0.5 font-mono text-[11px] text-slate-500 dark:text-slate-400">${escaparHtml(v.cliente_cedula)} · ${escaparHtml(v.cliente_telefono)}</p>
          </div>
        </td>
        <td data-label="Tipo de cobro" class="px-4 py-3">
          <span class="inline-flex whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold ${estiloMetodo(v.metodo_pago)}">${escaparHtml(etiquetaMetodoPago(v.metodo_pago))}</span>
          ${v.vuelto ? `<p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">Vuelto: ${v.vuelto.monto_bs != null ? formatearBolivares(v.vuelto.monto_bs) : formatearMoneda(v.vuelto.monto_usd)} (${escaparHtml(etiquetaMetodoPago(v.vuelto.metodo))})</p>` : ''}
          ${esAdministrador && v.comprobante_path ? `<a href="${hrefComprobante(v.comprobante_path)}" target="_blank" rel="noopener" data-comprobante="${escaparHtml(v.comprobante_path.startsWith('data:') ? 'local' : 'servidor')}" data-ruta-comprobante="${escaparHtml(v.id)}" class="mt-1.5 inline-block text-[11px] font-semibold text-brand-700 hover:underline dark:text-brand-300">Ver comprobante</a>` : ''}
          ${v.referencia_pago_movil ? `<p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">Ref. pago móvil: <span class="font-mono font-semibold text-slate-700 dark:text-slate-200">${escaparHtml(v.referencia_pago_movil)}</span></p>` : ''}
          ${pagos.length > 1 ? `<ul class="mt-1.5 space-y-0.5 text-[11px] text-slate-500 dark:text-slate-400">${pagos.map((p) => `<li class="flex justify-between gap-3"><span>${escaparHtml(etiquetaMetodoPago(p.metodo))}</span><span class="shrink-0 tabular-nums">${p.monto_bs != null ? formatearBolivares(p.monto_bs) : formatearMoneda(p.monto_usd)}</span></li>`).join('')}</ul>` : ''}
        </td>
        <td data-label="Productos" class="px-4 py-3">
          <details class="group text-left">
            <summary class="cursor-pointer list-none text-xs font-semibold text-brand-700 hover:underline dark:text-brand-300">
              ${v.items.length} producto${v.items.length === 1 ? '' : 's'} · ${unidades} u. <span class="text-slate-400 group-open:hidden">(ver)</span><span class="hidden text-slate-400 group-open:inline">(ocultar)</span>
            </summary>
            <ul class="mt-2 space-y-1 text-xs text-slate-600 dark:text-slate-400">${detalle}</ul>
          </details>
          ${devs.map(htmlDevolucion).join('')}
        </td>
        <td data-label="Total" class="px-4 py-3 text-right">
          <span class="inline-block text-right">
            <span class="block font-semibold tabular-nums text-slate-900 dark:text-white">${formatearMoneda(v.total)}</span>
            ${v.total_bs != null ? `<span class="block whitespace-nowrap text-[11px] font-medium tabular-nums text-slate-500 dark:text-slate-400">${formatearBolivares(v.total_bs)}</span>` : ''}
            ${v.tasa_cambio ? `<span class="block whitespace-nowrap text-[11px] text-slate-400 dark:text-slate-500">Tasa ${formatearBolivares(v.tasa_cambio)}</span>` : ''}
            ${
              v.promotor_nombre || (v.comision ?? 0) > 0
                ? `<span class="mt-1 block text-[11px] font-medium text-amber-700 dark:text-amber-400">Promotor: ${escaparHtml(v.promotor_nombre || 'sin datos')} · comisión ${formatearMoneda(v.comision ?? 0)}</span>${v.promotor_cedula || v.promotor_telefono ? `<span class="block text-[11px] text-slate-500 dark:text-slate-400">${escaparHtml([v.promotor_cedula, v.promotor_telefono].filter(Boolean).join(' · '))}</span>` : ''}${v.precio_autorizado_nombre ? `<span class="block text-[11px] text-slate-400 dark:text-slate-500">Precio autorizado por ${escaparHtml(v.precio_autorizado_nombre)}</span>` : ''}`
                : v.precio_autorizado_nombre
                  ? `<span class="mt-1 block text-[11px] font-medium text-emerald-700 dark:text-emerald-400">Precio con descuento · autorizó ${escaparHtml(v.precio_autorizado_nombre)}</span>`
                  : ''
            }
          </span>
        </td>
        ${esAdministrador ? `<td data-label="Vendedor" class="px-5 py-3 text-xs text-slate-500 dark:text-slate-400">${escaparHtml(v.vendedor_nombre ?? '—')}</td>` : ''}
        ${esAdministrador ? `<td class="px-4 py-3 text-right">${botonDevolver(v)}</td>` : ''}
      </tr>`;
  }

  const devolucionesDe = (v: VentaRegistrada): Devolucion[] => devolucionesPorVenta.get(v.id) ?? [];

  function pintarResumen(lista: VentaRegistrada[]) {
    const devoluciones = lista.flatMap(devolucionesDe);
    // Neto: lo vendido, menos lo devuelto, más lo entregado a cambio
    const ajuste = devoluciones.reduce((suma, d) => suma + d.diferencia, 0);
    const totalUsd = lista.reduce((suma, v) => suma + v.total, 0) + ajuste;
    const nota = $('hv-stat-total-tendencia');
    nota.textContent = devoluciones.length ? `Neto: incluye ${devoluciones.length} devolución(es)/cambio(s) (${ajuste >= 0 ? '+' : ''}${formatearMoneda(ajuste)})` : '';
    nota.classList.remove('text-emerald-600', 'dark:text-emerald-400');
    nota.classList.add('text-slate-500', 'dark:text-slate-400');
    nota.classList.toggle('hidden', devoluciones.length === 0);
    const totalBs = resumirPorMetodo(lista, devoluciones).reduce((suma, r) => suma + r.totalBs, 0);
    contarHasta($('hv-stat-ventas'), lista.length, undefined, 600);
    contarHasta($('hv-stat-total'), totalUsd, formatearMoneda, 700);
    contarHasta($('hv-stat-bs'), totalBs, formatearBolivares, 700);

    $('hv-resumen-metodos').innerHTML = resumirPorMetodo(lista, devoluciones)
      .map(
        (r) => `
          <tr class="${r.cantidad === 0 ? 'text-slate-400 dark:text-slate-600' : 'text-slate-700 dark:text-slate-300'}">
            <td class="px-5 py-2.5 font-medium">${escaparHtml(r.etiqueta)}</td>
            <td class="px-4 py-2.5 text-right tabular-nums">${r.cantidad}</td>
            <td class="px-4 py-2.5 text-right tabular-nums">${formatearMoneda(r.totalUsd)}</td>
            <td class="px-5 py-2.5 text-right tabular-nums">${esMetodoBolivares(r.metodo) ? formatearBolivares(r.totalBs) : '—'}</td>
          </tr>`
      )
      .join('');
  }

  function pintar() {
    const lista = filtrar();
    const totalPaginas = Math.max(1, Math.ceil(lista.length / POR_PAGINA));
    pagina = Math.min(Math.max(1, pagina), totalPaginas);
    const inicio = (pagina - 1) * POR_PAGINA;

    filas.innerHTML = lista.slice(inicio, inicio + POR_PAGINA).map(filaHtml).join('');
    $('hv-sin-resultados').classList.toggle('hidden', lista.length > 0);

    const hayPaginas = lista.length > POR_PAGINA;
    const paginacion = $('hv-paginacion');
    paginacion.classList.toggle('hidden', !hayPaginas);
    paginacion.classList.toggle('flex', hayPaginas);
    $('hv-rango-texto').textContent = `Mostrando ${inicio + 1}–${Math.min(inicio + POR_PAGINA, lista.length)} de ${lista.length}`;
    $('hv-pagina').textContent = `Página ${pagina} de ${totalPaginas}`;
    $<HTMLButtonElement>('hv-anterior').disabled = pagina <= 1;
    $<HTMLButtonElement>('hv-siguiente').disabled = pagina >= totalPaginas;

    pintarResumen(lista);
    pintarBarraSeleccion();
  }

  // --- Selección para eliminar ------------------------------------------------------
  const ventasDeLaPagina = (): VentaRegistrada[] => {
    const lista = filtrar();
    const inicio = (Math.min(Math.max(1, pagina), Math.max(1, Math.ceil(lista.length / POR_PAGINA))) - 1) * POR_PAGINA;
    return lista.slice(inicio, inicio + POR_PAGINA).filter((v) => v.folio); // las pendientes de sincronizar no se pueden elegir
  };

  function pintarBarraSeleccion() {
    $('hv-barra-seleccion').classList.toggle('hidden', !modoSeleccion);
    $('hv-seleccionar').textContent = modoSeleccion ? 'Salir de la selección' : 'Seleccionar';
    // Espacio al final para que la barra no tape las últimas filas
    document.body.classList.toggle('pb-24', modoSeleccion);
    const n = seleccion.size;
    $('hv-sel-conteo').textContent = n === 0 ? 'Ninguna seleccionada' : n === 1 ? '1 seleccionada' : `${n} seleccionadas`;
    $<HTMLButtonElement>('hv-sel-eliminar').disabled = n === 0;
    const pag = ventasDeLaPagina();
    $('hv-sel-pagina').textContent = pag.length > 0 && pag.every((v) => seleccion.has(v.id)) ? 'Quitar las de esta página' : 'Elegir las de esta página';
  }

  function alternarModoSeleccion(activo: boolean) {
    modoSeleccion = activo && puedeEliminar;
    if (!modoSeleccion) seleccion.clear();
    pintar();
  }

  // --- Carga por rango de fechas -----------------------------------------------------
  async function cargar(enVivo = false) {
    marcarBotonActivo();
    const rango =
      rangoActual === 'personalizado'
        ? calcularRango('personalizado', { desde: inputDesde.value, hasta: inputHasta.value })
        : calcularRango(rangoActual);

    const miCarga = ++cargaId;
    $('hv-error').classList.add('hidden');
    try {
      const [lista, devoluciones] = await Promise.all([
        inventoryService.listarVentas({ desde: rango.desde, hasta: rango.hasta }),
        // Si falta la tabla de devoluciones (migración 0014 sin aplicar) el historial sigue funcionando
        inventoryService.listarDevoluciones().catch((err) => {
          console.error('[EASYSTEM] No se pudieron cargar las devoluciones.', err);
          return [] as Devolucion[];
        }),
      ]);
      if (miCarga !== cargaId) return;
      devolucionesPorVenta = new Map();
      for (const d of devoluciones) devolucionesPorVenta.set(d.venta_id, [...(devolucionesPorVenta.get(d.venta_id) ?? []), d]);
      // Con el servidor, la API ya entrega solo las ventas del vendedor (permisos por rol); en el modo demo
      // local se replica esa regla aquí para que el comportamiento sea el mismo.
      const filtrarPropias = !esAdministrador && !inventoryService.obtenerEstadoConexion().usaServidor;
      // (en modo demo local no hay RLS: el encargado ve todo su local y el resto solo lo propio)
      ventas = filtrarPropias ? lista.filter((v) => v.vendedor_nombre === nombreSesion) : lista;
    } catch (err) {
      if (miCarga !== cargaId) return;
      ventas = [];
      devolucionesPorVenta = new Map();
      const mensaje = err instanceof Error ? err.message : 'No se pudieron cargar las ventas.';
      $('hv-error').textContent = `No se pudieron cargar las ventas: ${mensaje}`;
      $('hv-error').classList.remove('hidden');
    }
    $('hv-cargando').classList.add('hidden');
    for (const id of [...seleccion]) if (!ventas.some((v) => v.id === id)) seleccion.delete(id); // otra persona la eliminó o salió del rango
    // Una actualización en vivo no devuelve a la página 1 a quien esté revisando la lista
    if (!enVivo) pagina = 1;
    if (primeraVez) {
      primeraVez = false;
      animarLista(filas);
    }
    pintar();
  }

  for (const boton of botonesRango) {
    boton.addEventListener('click', () => {
      rangoActual = boton.dataset.rango as RangoPreestablecido;
      contenedorPersonalizado.classList.toggle('flex', rangoActual === 'personalizado');
      contenedorPersonalizado.classList.toggle('hidden', rangoActual !== 'personalizado');
      cargar();
    });
  }
  inputDesde.addEventListener('change', () => rangoActual === 'personalizado' && cargar());
  inputHasta.addEventListener('change', () => rangoActual === 'personalizado' && cargar());

  buscador.addEventListener('input', () => {
    pagina = 1;
    pintar();
  });
  selectMetodo.addEventListener('change', () => {
    pagina = 1;
    pintar();
  });
  $('hv-anterior').addEventListener('click', () => {
    pagina--;
    pintar();
  });
  $('hv-siguiente').addEventListener('click', () => {
    pagina++;
    pintar();
  });

  filas.addEventListener('click', (e) => {
    const enlace = (e.target as HTMLElement).closest<HTMLElement>('[data-comprobante="local"]');
    if (enlace) {
      e.preventDefault();
      const captura = ventas.find((v) => v.id === enlace.dataset.rutaComprobante)?.comprobante_path;
      if (captura) abrirImagenLocal(captura);
      return;
    }
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-devolver-venta]')?.dataset.devolverVenta;
    const venta = ventas.find((v) => v.id === id);
    if (venta) window.dispatchEvent(new CustomEvent('easystem:abrir-devolucion', { detail: { venta } }));
  });

  filas.addEventListener('change', (e) => {
    const casilla = (e.target as HTMLElement).closest<HTMLInputElement>('[data-sel-venta]');
    if (!casilla?.dataset.selVenta) return;
    if (casilla.checked) seleccion.add(casilla.dataset.selVenta);
    else seleccion.delete(casilla.dataset.selVenta);
    casilla.closest('tr')?.classList.toggle('bg-red-50/70', casilla.checked);
    casilla.closest('tr')?.classList.toggle('dark:bg-red-500/10', casilla.checked);
    pintarBarraSeleccion();
  });
  $('hv-seleccionar').addEventListener('click', () => alternarModoSeleccion(!modoSeleccion));
  $('hv-sel-salir').addEventListener('click', () => alternarModoSeleccion(false));
  $('hv-sel-pagina').addEventListener('click', () => {
    const pag = ventasDeLaPagina();
    const todas = pag.length > 0 && pag.every((v) => seleccion.has(v.id));
    for (const v of pag) {
      if (todas) seleccion.delete(v.id);
      else seleccion.add(v.id);
    }
    pintar();
  });

  const dialogoEliminar = $<HTMLDialogElement>('hv-del-dialogo');
  const confirmarEliminar = $<HTMLInputElement>('hv-del-confirmar');
  const ejecutarEliminar = $<HTMLButtonElement>('hv-del-ejecutar');
  const errorEliminar = $('hv-del-error');
  const avisoEliminar = $('hv-del-aviso');
  const pluralDe = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;
  const textoFolios = (folios: number[]) => {
    const f = folios.slice(0, 8).map((n) => `#${String(n).padStart(4, '0')}`).join(', ');
    return folios.length > 8 ? `${f} y ${folios.length - 8} más` : f;
  };

  $('hv-sel-eliminar').addEventListener('click', async () => {
    if (seleccion.size === 0) return;
    confirmarEliminar.value = '';
    ejecutarEliminar.disabled = true;
    errorEliminar.classList.add('hidden');
    avisoEliminar.classList.add('hidden');
    $('hv-del-resumen').textContent = 'Calculando…';
    dialogoEliminar.showModal();
    try {
      const r = await inventoryService.eliminarVentas([...seleccion], { simular: true });
      $('hv-del-resumen').textContent =
        r.ventas === 0
          ? 'Esas ventas ya no existen.'
          : `Se eliminarán ${pluralDe(r.ventas, 'venta', 'ventas')} (${textoFolios(r.folios)})${r.devoluciones ? ` y ${pluralDe(r.devoluciones, 'devolución', 'devoluciones')}` : ''}, y volverán al stock ${pluralDe(r.piezas, 'pieza', 'piezas')}.`;
      if (r.ventasSinPiezas > 0) {
        avisoEliminar.textContent = `${pluralDe(r.ventasSinPiezas, 'venta es anterior', 'ventas son anteriores')} a los códigos por pieza: se borra${r.ventasSinPiezas === 1 ? '' : 'n'}, pero su stock no se repone (hay que ajustarlo con un ingreso).`;
        avisoEliminar.classList.remove('hidden');
      }
    } catch (err) {
      $('hv-del-resumen').textContent = '';
      errorEliminar.textContent = err instanceof Error ? err.message : 'No se pudo calcular la eliminación.';
      errorEliminar.classList.remove('hidden');
    }
  });
  confirmarEliminar.addEventListener('input', () => {
    ejecutarEliminar.disabled = confirmarEliminar.value.trim().toUpperCase() !== 'ELIMINAR';
  });
  $('hv-del-cancelar').addEventListener('click', () => dialogoEliminar.close());
  ejecutarEliminar.addEventListener('click', async () => {
    if (confirmarEliminar.value.trim().toUpperCase() !== 'ELIMINAR' || seleccion.size === 0) return;
    ejecutarEliminar.disabled = true;
    ejecutarEliminar.textContent = 'Eliminando…';
    errorEliminar.classList.add('hidden');
    try {
      const r = await inventoryService.eliminarVentas([...seleccion]);
      dialogoEliminar.close();
      alternarModoSeleccion(false);
      const aviso = $('hv-aviso-exito');
      aviso.textContent = `Listo: se eliminaron ${pluralDe(r.ventas, 'venta', 'ventas')} (${textoFolios(r.folios)}); volvieron al stock ${pluralDe(r.piezas, 'pieza', 'piezas')}.`;
      aviso.classList.remove('hidden');
      setTimeout(() => aviso.classList.add('hidden'), 10000);
      void cargar();
    } catch (err) {
      errorEliminar.textContent = `${err instanceof Error ? err.message : 'No se pudo eliminar.'} Puedes volver a intentarlo: solo repone lo que falte.`;
      errorEliminar.classList.remove('hidden');
      ejecutarEliminar.disabled = false;
    } finally {
      ejecutarEliminar.textContent = 'Eliminar';
    }
  });

  // Se registró una devolución o cambio: recarga y avisa
  window.addEventListener('easystem:ventas-cambiaron', ((e: CustomEvent<{ folio: number; ventaFolio: number }>) => {
    const aviso = $('hv-aviso-exito');
    aviso.textContent = `✓ Devolución #${String(e.detail.folio).padStart(4, '0')} registrada sobre la venta #${String(e.detail.ventaFolio).padStart(4, '0')}. El inventario ya se actualizó.`;
    aviso.classList.remove('hidden');
    setTimeout(() => aviso.classList.add('hidden'), 8000);
    void cargar();
  }) as EventListener);

  // Exporta todo lo filtrado (no solo la página visible). Solo administrador: son datos personales de clientes.
  $('hv-exportar').addEventListener('click', () => {
    descargarCSV(
      `easystem-ventas-${new Date().toISOString().slice(0, 10)}.csv`,
      filtrar().map((v) => ({
        ...(verLocal ? { local: nombresLocales.get(v.local_id) ?? '' } : {}),
        folio: v.folio || 'pendiente',
        fecha: new Date(v.fecha).toLocaleString('es-GT'),
        cedula: v.cliente_cedula,
        cliente: v.cliente_nombre,
        telefono: v.cliente_telefono,
        tipo_de_cobro: etiquetaMetodoPago(v.metodo_pago),
        detalle_pagos: pagosDeVenta(v)
          .map((p) => `${etiquetaMetodoPago(p.metodo)}: ${p.monto_bs != null ? `Bs. ${p.monto_bs.toFixed(2)} ($${p.monto_usd.toFixed(2)})` : `$${p.monto_usd.toFixed(2)}`}`)
          .join('; '),
        total_usd: v.total.toFixed(2),
        tasa_bs_por_usd: v.tasa_cambio ?? '',
        total_bs: v.total_bs != null ? v.total_bs.toFixed(2) : '',
        vuelto: v.vuelto ? (v.vuelto.monto_bs != null ? `Bs. ${v.vuelto.monto_bs.toFixed(2)}` : `$${v.vuelto.monto_usd.toFixed(2)}`) : '',
        devoluciones: devolucionesDe(v)
          .map((d) => `#${d.folio} (${d.motivo}): devolvió ${d.items_devueltos.map((i) => `${i.cantidad} x ${i.nombre}`).join(', ')}${d.items_nuevos.length ? `; a cambio ${d.items_nuevos.map((i) => `${i.cantidad} x ${i.nombre}`).join(', ')}` : ''}; diferencia $${d.diferencia.toFixed(2)}`)
          .join(' | '),
        vendedor: v.vendedor_nombre ?? '',
        productos: v.items.map((i) => `${i.cantidad} x ${i.nombre}`).join('; '),
      }))
    );
  });

  // --- Resetear las ventas (solo el administrador) ---
  const dialogoReset = $<HTMLDialogElement>('hv-reset-dialogo');
  const confirmarReset = $<HTMLInputElement>('hv-reset-confirmar');
  const ejecutarReset = $<HTMLButtonElement>('hv-reset-ejecutar');
  const errorReset = $('hv-reset-error');
  const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;

  $('hv-resetear').addEventListener('click', async () => {
    confirmarReset.value = '';
    ejecutarReset.disabled = true;
    errorReset.classList.add('hidden');
    $('hv-reset-resumen').textContent = 'Calculando…';
    dialogoReset.showModal();
    try {
      const r = await inventoryService.resetearVentas({ simular: true });
      $('hv-reset-resumen').textContent =
        r.ventas === 0 && r.devoluciones === 0
          ? 'No hay ventas que resetear.'
          : `Se borrarán ${plural(r.ventas, 'venta', 'ventas')} y ${plural(r.devoluciones, 'devolución', 'devoluciones')}, y volverán al stock ${plural(r.piezas, 'pieza', 'piezas')}.`;
    } catch (err) {
      $('hv-reset-resumen').textContent = '';
      errorReset.textContent = err instanceof Error ? err.message : 'No se pudo calcular el reseteo.';
      errorReset.classList.remove('hidden');
    }
  });
  confirmarReset.addEventListener('input', () => {
    ejecutarReset.disabled = confirmarReset.value.trim().toUpperCase() !== 'RESETEAR';
  });
  $('hv-reset-cancelar').addEventListener('click', () => dialogoReset.close());
  ejecutarReset.addEventListener('click', async () => {
    if (confirmarReset.value.trim().toUpperCase() !== 'RESETEAR') return;
    ejecutarReset.disabled = true;
    ejecutarReset.textContent = 'Reseteando…';
    errorReset.classList.add('hidden');
    try {
      const r = await inventoryService.resetearVentas();
      dialogoReset.close();
      const aviso = $('hv-aviso-exito');
      aviso.textContent = `Listo: se borraron ${plural(r.ventas, 'venta', 'ventas')} y ${plural(r.devoluciones, 'devolución', 'devoluciones')}; volvieron al stock ${plural(r.piezas, 'pieza', 'piezas')}.`;
      aviso.classList.remove('hidden');
      setTimeout(() => aviso.classList.add('hidden'), 10000);
      void cargar();
    } catch (err) {
      errorReset.textContent = `${err instanceof Error ? err.message : 'No se pudo resetear.'} Puedes volver a intentarlo: solo repone lo que falte.`;
      errorReset.classList.remove('hidden');
      ejecutarReset.disabled = false;
    } finally {
      ejecutarReset.textContent = 'Resetear ventas';
    }
  });

  obtenerSesionActual().then((sesion) => {
    esAdministrador = esGerencia(sesion?.rol);
    $('hv-resetear').classList.toggle('hidden', sesion?.rol !== 'administrador');
    puedeEliminar = esGlobal(sesion?.rol);
    $('hv-seleccionar').classList.toggle('hidden', !puedeEliminar);
    nombreSesion = sesion?.nombre ?? '';
    void inventoryService.obtenerContextoLocal().then((contexto) => {
      verLocal = contexto?.alcance === 'todos';
      nombresLocales = new Map((contexto?.locales ?? []).map((l) => [l.id, l.nombre]));
    });
    for (const id of ['hv-th-vendedor', 'hv-col-vendedor', 'hv-th-acciones', 'hv-col-acciones']) $(id).classList.toggle('hidden', !esAdministrador);
    $('hv-exportar').classList.toggle('hidden', !esAdministrador);
    $('hv-aviso-vendedor').classList.toggle('hidden', esAdministrador);
    cargar();
    // Otro dispositivo registró una venta o una devolución: la lista y el resumen se actualizan solos
    alCambiarDatos(['ventas', 'devoluciones'], () => cargar(true));
  });
</script>
