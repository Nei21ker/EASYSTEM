---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import CamaraEscaner from '../components/CamaraEscaner.astro';
import FormularioProducto from '../components/productos/FormularioProducto.astro';
import Descargo from '../components/mercancia/Descargo.astro';
import Inventario from '../components/mercancia/Inventario.astro';
import { FORMATOS_ETIQUETA, FORMATO_PERSONALIZADO_ID, LIMITES_FORMATO_PERSONALIZADO, TIPOS_CODIGO_ETIQUETA, estilosEtiqueta } from '../utils/etiquetas';

const claseCampo =
  'w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 sm:py-2 sm:text-sm placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white';
const claseEtiqueta = 'block text-xs font-medium text-slate-600 dark:text-slate-400';
---

<style is:global set:html={estilosEtiqueta()}></style>

<DashboardLayout
  titulo="Mercancía"
  subtitulo="Ingreso: lo que llega y sus etiquetas. Descargo: traslados y bajas. Inventario: hoja para contar lo que hay en el local"
  roles={['administrador', 'gerente', 'encargado']}
>
  <div class="grid grid-cols-3 gap-2 sm:flex sm:flex-wrap" role="tablist" aria-label="Mercancía">
    <button id="mc-tab-ingreso" type="button" role="tab" aria-selected="true" class="rounded-lg border px-2 py-2 text-center text-sm font-semibold transition sm:px-4">Ingreso</button>
    <button id="mc-tab-descargo" type="button" role="tab" aria-selected="false" class="rounded-lg border px-2 py-2 text-center text-sm font-semibold transition sm:px-4">Descargo</button>
    <button id="mc-tab-inventario" type="button" role="tab" aria-selected="false" class="rounded-lg border px-2 py-2 text-center text-sm font-semibold transition sm:px-4">Inventario</button>
  </div>

  <div id="mc-panel-ingreso" class="mt-4">
  <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
    <div class="space-y-4 xl:col-span-2">
      <!-- 1. Agregar productos al lote -->
      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
          <div class="relative min-w-0 flex-1">
            <label for="ig-buscar" class={claseEtiqueta}>Agregar producto (nombre, categoría, modelo o código de barras)</label>
            <div class="relative mt-1">
              <input id="ig-buscar" type="search" autocomplete="off" placeholder="Escribe o escanea el código..." class={`${claseCampo} pr-11`} />
              <button
                type="button"
                data-abrir-escaner
                aria-label="Escanear código de barras con la cámara"
                title="Escanear con la cámara"
                class="absolute right-1.5 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-brand-600 dark:hover:bg-slate-700 dark:hover:text-brand-400"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                  <path d="M3 9V7a2 2 0 0 1 2-2h2M3 15v2a2 2 0 0 0 2 2h2M21 9V7a2 2 0 0 0-2-2h-2M21 15v2a2 2 0 0 1-2 2h-2" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="12" cy="12" r="3" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <ul id="ig-resultados" class="absolute z-10 mt-1 hidden max-h-64 w-full divide-y divide-slate-100 overflow-y-auto rounded-lg border border-slate-200 bg-white shadow-lg dark:divide-slate-800 dark:border-slate-700 dark:bg-slate-900"></ul>
          </div>
          <button id="ig-nuevo" type="button" class="bg-marca w-full shrink-0 rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:brightness-110 sm:mt-5 sm:w-auto sm:py-2">
            + Nuevo producto
          </button>
        </div>
        <div class="mt-3 flex flex-col gap-2 rounded-lg border border-dashed border-slate-300 px-3 py-2.5 text-xs text-slate-600 dark:border-slate-700 dark:text-slate-300 sm:flex-row sm:items-center sm:justify-between">
          <p>¿Ya tienes mercancía en el sistema y solo faltan las etiquetas? No hace falta ingresar nada.</p>
          <button id="ig-pendientes" type="button" class="shrink-0 rounded-lg border border-brand-300 px-3 py-2 text-xs font-semibold text-brand-700 transition hover:bg-brand-50 dark:border-brand-700 dark:text-brand-300 dark:hover:bg-slate-800">
            Agregar todo lo que está sin etiqueta
          </button>
        </div>
        <div class="mt-2 flex flex-col gap-2 rounded-lg border border-dashed border-slate-300 px-3 py-2.5 text-xs text-slate-600 dark:border-slate-700 dark:text-slate-300 sm:flex-row sm:items-center sm:justify-between">
          <p>¿Una etiqueta se despegó, se perdió o salió mal? Se vuelve a imprimir con el mismo código.</p>
          <button id="ig-reimprimir-abrir" type="button" class="shrink-0 rounded-lg border border-brand-300 px-3 py-2 text-xs font-semibold text-brand-700 transition hover:bg-brand-50 dark:border-brand-700 dark:text-brand-300 dark:hover:bg-slate-800">
            Reimprimir etiquetas
          </button>
        </div>
        <p id="ig-aviso" role="status" class="mt-2 hidden rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:bg-amber-500/10 dark:text-amber-300"></p>
        <p id="ig-local" class="mt-2 text-xs font-medium text-brand-700 dark:text-brand-300"></p>
      </section>

      <!-- 2. Lote -->
      <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <h2 id="ig-titulo-lote" class="text-sm font-semibold text-slate-900 dark:text-white">Lote de ingreso</h2>
          <button id="ig-vaciar" type="button" class="hidden text-xs font-medium text-slate-500 hover:text-red-600 dark:text-slate-400 dark:hover:text-red-400">Vaciar lote</button>
        </div>

        <div id="ig-vacio" class="px-5 py-10 text-center">
          <p class="text-sm font-medium text-slate-700 dark:text-slate-200">Todavía no hay productos en el lote</p>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
            Busca o escanea un producto para sumarle stock, o crea uno nuevo. Cada unidad que ingresa recibe su propio código. Con cantidad 0 solo imprimes etiquetas de unidades que aún no tienen.
          </p>
        </div>

        <div id="ig-tabla" class="hidden overflow-x-auto">
          <table class="tabla-tarjetas w-full text-left text-sm">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50/70 text-[11px] uppercase tracking-wider text-slate-500 dark:border-slate-800 dark:bg-slate-800/40 dark:text-slate-400">
                <th class="px-4 py-3 font-semibold">Producto</th>
                <th class="px-4 py-3 text-right font-semibold">Stock</th>
                <th class="w-28 px-4 py-3 font-semibold">Ingresan</th>
                <th class="w-28 px-4 py-3 font-semibold">Etiquetas</th>
                <th class="w-20 px-4 py-3"><span class="sr-only">Quitar</span></th>
              </tr>
            </thead>
            <tbody id="ig-filas" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
          </table>
        </div>

        <div class="space-y-3 border-t border-slate-200 px-5 py-4 dark:border-slate-800">
          <div>
            <label for="ig-motivo" class={claseEtiqueta}>Motivo del ingreso</label>
            <input id="ig-motivo" type="text" list="ig-motivos" value="Compra a proveedor" class={`mt-1 ${claseCampo}`} />
            <datalist id="ig-motivos">
              <option value="Compra a proveedor"></option>
              <option value="Reabastecimiento"></option>
              <option value="Devolución de cliente"></option>
              <option value="Ajuste de inventario"></option>
            </datalist>
          </div>
          <p id="ig-resumen" class="text-xs text-slate-500 dark:text-slate-400"></p>
          <p id="ig-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
          <p id="ig-exito" role="status" class="hidden rounded-lg bg-emerald-50 px-3 py-2 text-xs text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"></p>
          <div id="ig-reimprimir-ultimas" class="hidden flex-col gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2.5 text-xs text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300 sm:flex-row sm:items-center sm:justify-between">
            <p>¿Alguna etiqueta salió mal o se dañó? Puedes volver a imprimir estas mismas.</p>
            <button id="ig-reimprimir-estas" type="button" class="shrink-0 rounded-lg border border-amber-400 px-3 py-2 font-semibold hover:bg-amber-100 dark:border-amber-500/50 dark:hover:bg-amber-500/20">Reimprimir estas</button>
          </div>
          <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
            <button id="ig-compartir" type="button" title="Prepara las etiquetas como imágenes y las entrega a la app de tu impresora Bluetooth (WePrint)" class="rounded-lg border border-accent-300 px-4 py-2.5 text-sm font-semibold text-accent-700 transition hover:bg-accent-50 dark:border-accent-700 dark:text-accent-300 dark:hover:bg-slate-800">
              Imprimir etiquetas
            </button>
            <button id="ig-registrar" type="button" class="bg-marca rounded-lg px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60">
              Registrar ingreso
            </button>
          </div>
        </div>
      </section>
    </div>

    <!-- 3. Etiquetas -->
    <aside class="space-y-4">
      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Etiquetas</h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Cada etiqueta lleva el código ÚNICO de una unidad y el nombre del producto: al venderla, el sistema sabe cuál unidad salió y no se puede vender dos veces. Elige el tipo de código y el tamaño de tu papel de etiquetas.
        </p>
        <label for="ig-tipo" class={`mt-4 ${claseEtiqueta}`}>Tipo de código</label>
        <select id="ig-tipo" class={`mt-1 ${claseCampo}`}>
          {TIPOS_CODIGO_ETIQUETA.map((t) => <option value={t.id}>{t.nombre}</option>)}
        </select>
        <p id="ig-tipo-nota" class="mt-1.5 text-xs text-slate-500 dark:text-slate-400"></p>
        <label for="ig-formato" class={`mt-4 ${claseEtiqueta}`}>Tamaño</label>
        <select id="ig-formato" class={`mt-1 ${claseCampo}`}>
          {FORMATOS_ETIQUETA.map((f) => <option value={f.id}>{f.nombre}</option>)}
          <option value={FORMATO_PERSONALIZADO_ID}>Tamaño personalizado…</option>
        </select>
        <div id="ig-personalizado" class="mt-2 hidden rounded-lg border border-slate-200 p-3 dark:border-slate-700">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="ig-ancho" class={claseEtiqueta}>Ancho (mm)</label>
              <input id="ig-ancho" type="number" inputmode="decimal" step="0.5" min={LIMITES_FORMATO_PERSONALIZADO.anchoMin} max={LIMITES_FORMATO_PERSONALIZADO.anchoMax} value="50" class={`mt-1 ${claseCampo}`} />
            </div>
            <div>
              <label for="ig-alto" class={claseEtiqueta}>Alto (mm)</label>
              <input id="ig-alto" type="number" inputmode="decimal" step="0.5" min={LIMITES_FORMATO_PERSONALIZADO.altoMin} max={LIMITES_FORMATO_PERSONALIZADO.altoMax} value="30" class={`mt-1 ${claseCampo}`} />
            </div>
          </div>
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
            Escribe lo que mide tu etiqueta (ancho {LIMITES_FORMATO_PERSONALIZADO.anchoMin}–{LIMITES_FORMATO_PERSONALIZADO.anchoMax} mm, alto {LIMITES_FORMATO_PERSONALIZADO.altoMin}–{LIMITES_FORMATO_PERSONALIZADO.altoMax} mm). El código y el nombre se ajustan solos al tamaño. Se recuerda en este equipo.
          </p>
        </div>
        <p id="ig-formato-nota" class="mt-1.5 text-xs text-slate-500 dark:text-slate-400"></p>

        <p class="mt-4 text-xs font-medium text-slate-600 dark:text-slate-400">Vista previa</p>
        <div class="mt-1 overflow-x-auto rounded-lg bg-slate-100 p-3 dark:bg-slate-800/60">
          <div id="ig-previa" class="inline-block border border-slate-300 bg-white shadow-sm"></div>
        </div>
        <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
          Al pulsar "Imprimir etiquetas" se preparan las etiquetas como imágenes de este tamaño y se entregan a la app de tu impresora (WePrint). En la app, deja el tamaño de papel de la etiqueta y sin escala.
        </p>
      </section>
    </aside>
  </div>
  </div>

  <div id="mc-panel-descargo" class="mt-4 hidden">
    <Descargo />
  </div>

  <div id="mc-panel-inventario" class="mt-4 hidden">
    <Inventario />
  </div>

  <!-- Etiquetas listas para la impresora del celular (WePrint): UN archivo con todas (tira o PDF) o imágenes sueltas -->
  <dialog id="ig-galeria" class="m-auto w-[min(94vw,36rem)] rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
    <div class="flex max-h-[90vh] flex-col">
      <div class="border-b border-slate-200 px-5 py-4 dark:border-slate-800">
        <h2 id="ig-galeria-titulo" class="text-base font-semibold">Imprimir etiquetas</h2>
        <p id="ig-galeria-cuenta" class="mt-0.5 text-xs text-slate-500 dark:text-slate-400"></p>
      </div>
      <div class="space-y-3 overflow-y-auto px-5 py-4 text-sm">
        <div class="rounded-lg border border-slate-200 p-3 dark:border-slate-700">
          <label for="ig-galeria-formato" class="block text-xs font-medium text-slate-600 dark:text-slate-300">Tamaño de la etiqueta</label>
          <select id="ig-galeria-formato" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 focus:border-brand-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white">
            {FORMATOS_ETIQUETA.map((f) => <option value={f.id}>{f.nombre}</option>)}
            <option value={FORMATO_PERSONALIZADO_ID}>Otra medida (escribirla)…</option>
          </select>
          <div id="ig-galeria-personalizado" class="mt-2 hidden">
            <div class="flex items-end gap-2">
              <div>
                <label for="ig-galeria-ancho" class="block text-xs font-medium text-slate-600 dark:text-slate-300">Ancho (mm)</label>
                <input id="ig-galeria-ancho" type="number" inputmode="decimal" step="0.5" min={LIMITES_FORMATO_PERSONALIZADO.anchoMin} max={LIMITES_FORMATO_PERSONALIZADO.anchoMax} class="mt-1 w-28 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 focus:border-brand-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
              </div>
              <span class="pb-3 text-slate-400">×</span>
              <div>
                <label for="ig-galeria-alto" class="block text-xs font-medium text-slate-600 dark:text-slate-300">Alto (mm)</label>
                <input id="ig-galeria-alto" type="number" inputmode="decimal" step="0.5" min={LIMITES_FORMATO_PERSONALIZADO.altoMin} max={LIMITES_FORMATO_PERSONALIZADO.altoMax} class="mt-1 w-28 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 focus:border-brand-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
              </div>
            </div>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Ancho {LIMITES_FORMATO_PERSONALIZADO.anchoMin}–{LIMITES_FORMATO_PERSONALIZADO.anchoMax} mm, alto {LIMITES_FORMATO_PERSONALIZADO.altoMin}–{LIMITES_FORMATO_PERSONALIZADO.altoMax} mm. Se recuerda en este equipo.</p>
          </div>
          <p id="ig-galeria-medida" class="mt-1.5 text-xs text-slate-500 dark:text-slate-400"></p>
        </div>
        <div>
          <label for="ig-galeria-modo" class="block text-xs font-medium text-slate-600 dark:text-slate-300">Cómo mandarlas a WePrint</label>
          <select id="ig-galeria-modo" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 focus:border-brand-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white">
            <option value="pdf">Un PDF con una etiqueta por página (recomendado)</option>
            <option value="tira">Una sola imagen con todas las etiquetas (tira)</option>
            <option value="sueltas">Una imagen por etiqueta</option>
          </select>
          <p id="ig-galeria-ayuda" class="mt-1 text-xs text-slate-500 dark:text-slate-400"></p>
        </div>
        <div id="ig-galeria-separacion-caja">
          <label for="ig-galeria-separacion" class="block text-xs font-medium text-slate-600 dark:text-slate-300">Separación entre etiquetas (mm)</label>
          <input id="ig-galeria-separacion" type="number" inputmode="decimal" min="0" max="10" step="0.5" value="0" class="mt-1 w-28 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 focus:border-brand-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          <span class="ml-2 text-xs text-slate-500 dark:text-slate-400">Déjala en 0; si al imprimir la tira las etiquetas se van corriendo, pon el espacio que hay entre etiquetas en tu rollo (por ejemplo 2 o 3).</span>
        </div>
        <ol class="list-decimal space-y-1 pl-5 text-xs text-slate-600 dark:text-slate-300">
          <li>Pulsa <strong>Compartir con WePrint</strong> y elige WePrint en el menú. En WePrint deja el papel en el tamaño de la etiqueta.</li>
          <li>Si WePrint no aparece en el menú, pulsa <strong>Descargar</strong> (queda en la app Archivos) o mantén el dedo sobre una etiqueta y elige <strong>Guardar en Fotos</strong>, y ábrela desde WePrint.</li>
          <li>Cuando las hayas impreso, pulsa <strong>Ya las imprimí</strong>.</li>
        </ol>
        <div id="ig-galeria-imagenes" class="grid grid-cols-2 gap-2"></div>
        <p id="ig-galeria-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
      </div>
      <div class="flex flex-col gap-2 border-t border-slate-200 px-5 py-4 dark:border-slate-800 sm:flex-row sm:justify-end">
        <button id="ig-galeria-cerrar" type="button" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Cerrar</button>
        <button id="ig-galeria-descargar" type="button" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Descargar</button>
        <button id="ig-galeria-compartir" type="button" class="rounded-lg border border-accent-300 px-4 py-2.5 text-sm font-semibold text-accent-700 hover:bg-accent-50 dark:border-accent-700 dark:text-accent-300 dark:hover:bg-slate-800">Compartir con WePrint</button>
        <button id="ig-galeria-listo" type="button" class="bg-marca rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:brightness-110">Ya las imprimí</button>
      </div>
    </div>
  </dialog>

  <!-- Reimprimir etiquetas: se eligen unidades que ya están en el local (disponibles); el código de cada una no cambia -->
  <dialog id="ig-reimp" aria-labelledby="ig-reimp-titulo" class="m-auto w-[min(94vw,36rem)] rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
    <div class="flex max-h-[90vh] flex-col">
      <div class="border-b border-slate-200 px-5 py-4 dark:border-slate-800">
        <h2 id="ig-reimp-titulo" class="text-base font-semibold">Reimprimir etiquetas</h2>
        <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
          Marca las unidades cuya etiqueta quieres volver a imprimir. El código no cambia: la etiqueta nueva reemplaza a la perdida. Solo aparecen unidades que están disponibles en el local (las vendidas no se reimprimen).
        </p>
        <input id="ig-reimp-buscar" type="search" placeholder="Buscar por nombre, código de barras o código de la unidad..." autocomplete="off" class="mt-3 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 focus:border-brand-500 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
      </div>
      <div class="overflow-y-auto px-5 py-3 text-sm">
        <p id="ig-reimp-estado" class="py-6 text-center text-xs text-slate-500 dark:text-slate-400"></p>
        <div id="ig-reimp-lista" class="space-y-3"></div>
      </div>
      <div class="flex flex-col gap-2 border-t border-slate-200 px-5 py-4 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between">
        <p id="ig-reimp-cuenta" class="text-xs text-slate-500 dark:text-slate-400"></p>
        <div class="flex flex-col gap-2 sm:flex-row">
          <button id="ig-reimp-cerrar" type="button" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Cancelar</button>
          <button id="ig-reimp-imprimir" type="button" disabled class="bg-marca rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-50">Reimprimir</button>
        </div>
      </div>
    </div>
  </dialog>

  <CamaraEscaner />
  <FormularioProducto />
</DashboardLayout>

<script>
  import * as inventoryService from '../lib/inventoryService';
  import { esGerencia } from '../lib/auth';
  import { codigoVisible, esCodigoUnidad, normalizarCodigoUnidad, normalizarReferencia } from '../utils/codigos';
  import {
    buscarFormatoEtiqueta,
    buscarTipoCodigo,
    FORMATO_ETIQUETA_POR_DEFECTO,
    FORMATO_PERSONALIZADO_ID,
    htmlEtiqueta,
    paginasNecesarias,
    TIPO_CODIGO_POR_DEFECTO,
    TIPOS_CODIGO_ETIQUETA,
    totalEtiquetas,
  } from '../utils/etiquetas';
  import {
    compartirArchivos,
    descargarArchivos,
    etiquetasComoPdf,
    MAX_ETIQUETAS_POR_TIRA,
    prepararArchivosEtiquetas,
    puedeCompartirArchivos,
    tiraComoPng,
  } from '../utils/etiquetaImagen';
  import { animarLista, reanimar } from '../utils/animaciones';
  import { alCambiarDatos } from '../lib/realtime';
  import { agruparUnidadesParaReimprimir, resumenReimpresion } from '../utils/reimpresion';
  import type { ProductoConRelaciones, UnidadProducto } from '../types/database.types';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const buscar = $<HTMLInputElement>('ig-buscar');
  const resultados = $<HTMLUListElement>('ig-resultados');
  const filas = $<HTMLTableSectionElement>('ig-filas');
  const aviso = $('ig-aviso');
  const error = $('ig-error');
  const exito = $('ig-exito');
  const resumen = $('ig-resumen');
  const motivo = $<HTMLInputElement>('ig-motivo');
  const botonRegistrar = $<HTMLButtonElement>('ig-registrar');
  const selectFormato = $<HTMLSelectElement>('ig-formato');
  const campoAncho = $<HTMLInputElement>('ig-ancho');
  const campoAlto = $<HTMLInputElement>('ig-alto');

  /** El formato elegido; con "Tamaño personalizado" usa el ancho y el alto escritos (corregidos a los límites). */
  function formatoElegido() {
    return buscarFormatoEtiqueta(selectFormato.value, { anchoMm: Number(campoAncho.value), altoMm: Number(campoAlto.value) });
  }
  const selectTipo = $<HTMLSelectElement>('ig-tipo');

  interface Linea {
    id: string;
    /** Unidades que ingresan (0 = solo imprimir etiquetas) */
    cantidad: number;
    copias: number;
    /** La cantidad de etiquetas se cambió a mano: ya no sigue a las unidades */
    manual: boolean;
    /** Códigos de las unidades que se crearon al registrar el ingreso de esta línea (para imprimir o reimprimir sus etiquetas) */
    unidades?: string[];
  }

  // El lote se recuerda por usuario (varias personas pueden compartir el mismo equipo)
  let LS_LOTE = 'easystem:ingreso-lote';
  const LS_FORMATO = 'easystem:formato-etiqueta';
  const LS_TAMANO_PERSONALIZADO = 'easystem:formato-personalizado';
  const LS_TIPO_CODIGO = 'easystem:etiqueta-tipo-codigo';

  let productos: ProductoConRelaciones[] = [];
  let lote: Linea[] = [];
  let hayLocal = false;
  let primeraVez = true;
  /** Unidades disponibles del local que todavía no tienen etiqueta impresa, por producto (las más antiguas primero) */
  let sinEtiqueta = new Map<string, string[]>();

  const normalizar = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const escapar = (t: string) => {
    const d = document.createElement('div');
    d.textContent = t;
    return d.innerHTML;
  };
  const producto = (id: string) => productos.find((p) => p.id === id);
  const entero = (valor: string) => {
    const n = Math.floor(Number(valor));
    return Number.isFinite(n) && n > 0 ? n : 0;
  };

  function guardarLote() {
    try {
      localStorage.setItem(LS_LOTE, JSON.stringify(lote));
    } catch {
      /* sin almacenamiento: el lote solo vive en esta pestaña */
    }
  }

  function leerLote(): Linea[] {
    try {
      const guardado = JSON.parse(localStorage.getItem(LS_LOTE) ?? '[]') as Linea[];
      return Array.isArray(guardado) ? guardado.filter((l) => l && typeof l.id === 'string') : [];
    } catch {
      return [];
    }
  }

  function avisar(texto: string) {
    aviso.textContent = texto;
    aviso.classList.remove('hidden');
  }
  function mostrarError(texto: string) {
    $('ig-reimprimir-ultimas').classList.add('hidden');
    exito.classList.add('hidden');
    error.textContent = texto;
    error.classList.remove('hidden');
    reanimar(error, 'anim-sacudir');
  }
  function mostrarExito(texto: string) {
    $('ig-reimprimir-ultimas').classList.add('hidden');
    error.classList.add('hidden');
    exito.textContent = texto;
    exito.classList.remove('hidden');
    reanimar(exito, 'anim-subir');
  }

  // --- Búsqueda -------------------------------------------------------------------
  function pintarResultados() {
    const q = normalizar(buscar.value.trim());
    if (!q) {
      resultados.classList.add('hidden');
      resultados.innerHTML = '';
      return;
    }
    const lista = productos
      .filter(
        (p) =>
          normalizar(p.nombre).includes(q) ||
          p.codigo_barras.includes(q) ||
          normalizar(p.referencia ?? '').includes(q) ||
          normalizar(p.categoria).includes(q) ||
          p.modelos_compatibles.some((m) => normalizar(`${m.marca} ${m.modelo}`).includes(q))
      )
      .slice(0, 8);

    resultados.classList.remove('hidden');
    resultados.innerHTML = lista.length
      ? lista
          .map(
            (p) => `
          <li>
            <button type="button" data-agregar="${p.id}" class="flex w-full items-center justify-between gap-3 px-3 py-2 text-left hover:bg-slate-50 dark:hover:bg-slate-800">
              <span class="min-w-0">
                <span class="block truncate text-sm font-medium text-slate-900 dark:text-white">${escapar(p.nombre)}</span>
                <span class="block font-mono text-xs text-slate-500">${escapar(codigoVisible(p))}</span>
              </span>
              <span class="shrink-0 text-xs text-slate-500">${p.stock_actual} u.</span>
            </button>
          </li>`
          )
          .join('')
      : '<li class="px-3 py-3 text-sm text-slate-500">Sin coincidencias. Puedes crearlo con "+ Nuevo producto".</li>';
  }

  buscar.addEventListener('input', () => {
    aviso.classList.add('hidden');
    pintarResultados();
    // Un lector de código de barras escribe el código completo y pulsa Enter
    const exacto = productos.find((p) => p.codigo_barras === buscar.value.trim() || (p.referencia ?? '') === normalizarReferencia(buscar.value));
    if (exacto) agregar(exacto.id);
  });
  buscar.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    const q = buscar.value.trim();
    if (!q) return;
    const exacto = productos.find((p) => p.codigo_barras === q || (p.referencia ?? '') === normalizarReferencia(q));
    if (exacto) return agregar(exacto.id);
    const unidad = normalizarCodigoUnidad(q);
    if (unidad) return void localizarPorUnidad(unidad);
    if (/^\d{6,}$/.test(q)) avisarCodigoNuevo(q);
  });
  resultados.addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-agregar]')?.dataset.agregar;
    if (id) agregar(id);
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#ig-buscar, #ig-resultados')) resultados.classList.add('hidden');
  });

  function avisarCodigoNuevo(codigo: string) {
    avisar(`No existe un producto con el código ${codigo}. Si es nuevo, créalo con "+ Nuevo producto".`);
    ultimoCodigoDesconocido = codigo;
  }
  let ultimoCodigoDesconocido = '';

  window.addEventListener('easystem:codigo-escaneado', ((e: CustomEvent<{ codigo: string }>) => {
    // Con la pestaña Descargo a la vista, el escaneo es de ella
    if (document.getElementById('mc-panel-ingreso')?.classList.contains('hidden')) return;
    const codigo = e.detail.codigo.trim();
    const encontrado = productos.find((p) => p.codigo_barras === codigo);
    if (encontrado) agregar(encontrado.id);
    else if (esCodigoUnidad(codigo)) void localizarPorUnidad(codigo);
    else avisarCodigoNuevo(codigo);
  }) as EventListener);

  /** Se escaneó la etiqueta de una unidad: se muestra su producto en el lote (sin sumar unidades, esa unidad ya existe). */
  async function localizarPorUnidad(codigo: string) {
    buscar.value = '';
    pintarResultados();
    const unidad = await inventoryService.obtenerUnidadPorCodigo(codigo).catch(() => null);
    if (!unidad || !producto(unidad.producto_id)) {
      avisar(`El código ${codigo} no corresponde a ninguna unidad registrada.`);
      return;
    }
    aviso.classList.add('hidden');
    if (!lote.some((l) => l.id === unidad.producto_id)) {
      lote.push({ id: unidad.producto_id, cantidad: 0, copias: 0, manual: false });
      guardarLote();
      pintarLote();
    }
    const fila = filas.querySelector<HTMLElement>(`[data-fila="${unidad.producto_id}"]`);
    reanimar(fila, 'anim-destello');
    fila?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // --- Lote -------------------------------------------------------------------------
  function agregar(id: string) {
    if (!producto(id)) return;
    buscar.value = '';
    pintarResultados();
    aviso.classList.add('hidden');
    const existente = lote.find((l) => l.id === id);
    if (existente) {
      // Escanear otra vez el mismo producto = una unidad más
      existente.cantidad += 1;
      if (!existente.manual) existente.copias = (existente.unidades?.length ?? 0) + existente.cantidad;
    } else {
      lote.push({ id, cantidad: 1, copias: 1, manual: false });
    }
    guardarLote();
    pintarLote();
    filas.querySelector<HTMLInputElement>(`[data-cantidad="${id}"]`)?.select();
  }

  /** Qué se puede imprimir de esta línea: las unidades que acaba de ingresar y las que siguen sin etiqueta. */
  function textoPista(l: Linea): string {
    const nuevas = l.unidades?.length ?? 0;
    const pendientes = (sinEtiqueta.get(l.id) ?? []).filter((c) => !l.unidades?.includes(c)).length;
    const partes = [];
    if (nuevas) partes.push(`${nuevas} unidad${nuevas === 1 ? '' : 'es'} nueva${nuevas === 1 ? '' : 's'} con código`);
    partes.push(pendientes ? `${pendientes} sin etiqueta` : 'todas con etiqueta');
    return escapar(partes.join(' · '));
  }

  async function cargarSinEtiqueta() {
    try {
      const unidades = await inventoryService.listarUnidades({ estado: 'DISPONIBLE', sinImprimir: true });
      const mapa = new Map<string, string[]>();
      for (const u of unidades) (mapa.get(u.producto_id) ?? mapa.set(u.producto_id, []).get(u.producto_id)!).push(u.codigo);
      sinEtiqueta = mapa;
    } catch {
      /* sin conexión: se conserva lo último que se supo */
    }
    for (const l of lote) {
      const pista = filas.querySelector<HTMLElement>(`[data-pista="${l.id}"]`);
      if (pista) pista.innerHTML = textoPista(l);
    }
  }

  function pintarLote() {
    const visibles = lote.filter((l) => producto(l.id));
    $('ig-vacio').classList.toggle('hidden', visibles.length > 0);
    $('ig-tabla').classList.toggle('hidden', visibles.length === 0);
    $('ig-vaciar').classList.toggle('hidden', visibles.length === 0);
    $('ig-titulo-lote').textContent = visibles.length ? `Lote de ingreso (${visibles.length} producto${visibles.length === 1 ? '' : 's'})` : 'Lote de ingreso';

    const campo =
      'w-full rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-right text-base tabular-nums text-slate-900 sm:text-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white';

    filas.innerHTML = visibles
      .map((l) => {
        const p = producto(l.id)!;
        return `
          <tr class="text-slate-700 dark:text-slate-300" data-fila="${l.id}">
            <td class="px-4 py-3">
              <p class="font-medium text-slate-900 dark:text-white">${escapar(p.nombre)}</p>
              <p class="font-mono text-[11px] text-slate-500 dark:text-slate-400">${escapar(codigoVisible(p))}</p>
              <p data-pista="${l.id}" class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">${textoPista(l)}</p>
            </td>
            <td data-label="Stock" class="px-4 py-3 text-right tabular-nums" data-stock="${l.id}">${p.stock_actual}${l.cantidad > 0 ? ` <span class="text-emerald-600 dark:text-emerald-400">→ ${p.stock_actual + l.cantidad}</span>` : ''}</td>
            <td data-label="Ingresan" class="px-4 py-3"><input type="number" inputmode="numeric" min="0" step="1" value="${l.cantidad}" data-cantidad="${l.id}" aria-label="Unidades que ingresan de ${escapar(p.nombre)}" class="${campo}" /></td>
            <td data-label="Etiquetas" class="px-4 py-3"><input type="number" inputmode="numeric" min="0" step="1" value="${l.copias}" data-copias="${l.id}" aria-label="Etiquetas a imprimir de ${escapar(p.nombre)}" class="${campo}" /></td>
            <td class="px-4 py-3 sm:text-right"><button type="button" data-quitar="${l.id}" class="text-xs font-medium text-red-600 hover:underline dark:text-red-400">Quitar</button></td>
          </tr>`;
      })
      .join('');

    if (primeraVez && visibles.length) {
      animarLista(filas);
      primeraVez = false;
    }
    actualizarResumen();
    pintarPrevia();
  }

  filas.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    const idCantidad = input.dataset.cantidad;
    const idCopias = input.dataset.copias;
    const id = idCantidad ?? idCopias;
    const linea = lote.find((l) => l.id === id);
    if (!linea) return;

    if (idCantidad) {
      linea.cantidad = entero(input.value);
      if (!linea.manual) {
        linea.copias = (linea.unidades?.length ?? 0) + linea.cantidad;
        const copias = filas.querySelector<HTMLInputElement>(`[data-copias="${linea.id}"]`);
        if (copias) copias.value = String(linea.copias);
      }
      const p = producto(linea.id);
      const celda = filas.querySelector<HTMLElement>(`[data-stock="${linea.id}"]`);
      if (p && celda) celda.innerHTML = `${p.stock_actual}${linea.cantidad > 0 ? ` <span class="text-emerald-600 dark:text-emerald-400">→ ${p.stock_actual + linea.cantidad}</span>` : ''}`;
    } else {
      linea.copias = entero(input.value);
      linea.manual = true;
    }
    guardarLote();
    actualizarResumen();
  });

  filas.addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-quitar]')?.dataset.quitar;
    if (!id) return;
    lote = lote.filter((l) => l.id !== id);
    guardarLote();
    pintarLote();
  });

  $('ig-vaciar').addEventListener('click', () => {
    lote = [];
    guardarLote();
    error.classList.add('hidden');
    exito.classList.add('hidden');
    pintarLote();
  });

  function pedidas() {
    return lote
      .map((l) => ({ l, p: producto(l.id) }))
      .filter((x): x is { l: Linea; p: ProductoConRelaciones } => !!x.p)
      .map(({ l, p }) => ({ codigo: p.codigo_barras, nombre: p.nombre, copias: l.copias }));
  }

  function actualizarResumen() {
    const unidades = lote.reduce((s, l) => s + l.cantidad, 0);
    const lineasConIngreso = lote.filter((l) => l.cantidad > 0).length;
    const formato = formatoElegido();
    const etiquetas = totalEtiquetas(pedidas());
    const paginas = paginasNecesarias(pedidas(), formato);
    resumen.textContent = lote.length
      ? `Ingreso: ${unidades} unidad${unidades === 1 ? '' : 'es'} en ${lineasConIngreso} producto${lineasConIngreso === 1 ? '' : 's'}. Etiquetas: ${etiquetas}${formato.hoja ? ` (${paginas} hoja${paginas === 1 ? '' : 's'} A4)` : ''}.`
      : '';
  }

  // --- Registrar ingreso --------------------------------------------------------------
  botonRegistrar.addEventListener('click', async () => {
    error.classList.add('hidden');
    exito.classList.add('hidden');

    const aRegistrar = lote.filter((l) => l.cantidad > 0 && producto(l.id));
    if (aRegistrar.length === 0) return mostrarError('Pon al menos un producto con cantidad mayor a 0 para registrar el ingreso.');
    if (!hayLocal) return mostrarError('Elige un local en el selector del encabezado: el ingreso se registra en un local concreto.');

    botonRegistrar.disabled = true;
    botonRegistrar.textContent = 'Registrando...';
    const texto = motivo.value.trim() || 'Reabastecimiento';
    let unidades = 0;
    const fallos: string[] = [];

    // Una entrada por producto, en orden. Si una falla, las demás siguen y esa se queda en el lote.
    for (const linea of aRegistrar) {
      const p = producto(linea.id)!;
      try {
        const movimiento = await inventoryService.registrarMovimiento({ producto_id: p.id, tipo: 'ENTRADA', cantidad: linea.cantidad, motivo: texto });
        unidades += linea.cantidad;
        linea.cantidad = 0; // ya está en el stock
        // Cada unidad nueva tiene su código: las etiquetas a imprimir son exactamente esas
        linea.unidades = [...(linea.unidades ?? []), ...(movimiento.unidad_codigos ?? [])];
        linea.copias = linea.unidades.length;
        linea.manual = false;
      } catch (err) {
        fallos.push(`${p.nombre}: ${err instanceof Error ? err.message : 'no se pudo registrar'}`);
      }
    }

    guardarLote();
    productos = await inventoryService.listarProductos({ catalogoCompleto: true });
    await cargarSinEtiqueta();
    pintarLote();
    botonRegistrar.disabled = false;
    botonRegistrar.textContent = 'Registrar ingreso';

    const registrados = aRegistrar.length - fallos.length;
    if (registrados > 0) {
      mostrarExito(`Ingreso registrado: ${unidades} unidad${unidades === 1 ? '' : 'es'} en ${registrados} producto${registrados === 1 ? '' : 's'}, cada una con su código. Ya puedes imprimir las etiquetas.`);
    }
    if (fallos.length) {
      mostrarError(`No se pudo registrar (siguen en el lote): ${fallos.join(' · ')}`);
      if (registrados > 0) exito.classList.remove('hidden');
    }
    window.dispatchEvent(new Event('easystem:productos-cambiaron'));
  });

  // --- Etiquetas -------------------------------------------------------------------------
  /** Las etiquetas a sacar (una por unidad: primero las de este ingreso y después las más antiguas sin etiqueta), o null si falta algo. */
  function reunirEtiquetas(): { codigo: string; nombre: string; copias: number }[] | null {
    error.classList.add('hidden');
    if (totalEtiquetas(pedidas()) === 0) {
      mostrarError('No hay etiquetas por imprimir: pon una cantidad de etiquetas mayor a 0 en algún producto.');
      return null;
    }
    if (lote.some((l) => l.cantidad > 0 && producto(l.id))) {
      mostrarError('Primero registra el ingreso: cada unidad recibe su código al registrarse y la etiqueta lleva ese código.');
      return null;
    }

    // Una etiqueta por unidad: primero las del ingreso de esta pantalla, después las más antiguas que siguen sin etiqueta
    const etiquetas: { codigo: string; nombre: string; copias: number }[] = [];
    const faltas: string[] = [];
    for (const l of lote) {
      const p = producto(l.id);
      if (!p || l.copias <= 0) continue;
      const codigos = (l.unidades ?? []).slice(0, l.copias);
      if (codigos.length < l.copias) {
        const extra = (sinEtiqueta.get(l.id) ?? []).filter((c) => !codigos.includes(c)).slice(0, l.copias - codigos.length);
        codigos.push(...extra);
      }
      if (codigos.length < l.copias) faltas.push(`${p.nombre}: pides ${l.copias} y solo hay ${codigos.length} unidad${codigos.length === 1 ? '' : 'es'} sin etiqueta`);
      for (const codigo of codigos) etiquetas.push({ codigo, nombre: p.nombre, copias: 1 });
    }
    if (etiquetas.length === 0) {
      mostrarError(faltas.length ? `No hay unidades para etiquetar. ${faltas.join(' · ')}` : 'No hay etiquetas por imprimir.');
      return null;
    }
    if (faltas.length) avisar(`Se imprimen solo las que existen. ${faltas.join(' · ')}`);
    return etiquetas;
  }

  // Impresora Bluetooth desde el celular (p. ej. NETUM G5 con la app WePrint): el iPhone no deja que una página hable con la
  // impresora, así que se preparan las etiquetas como archivos y se entregan a WePrint con "Compartir" (o se guardan en Fotos /
  // Archivos para abrirlas desde WePrint). WePrint imprime un archivo a la vez: por eso lo recomendado es UNA imagen (tira) con todas
  // las etiquetas una debajo de otra, o un PDF con una etiqueta por página (el que mejor funciona: una página = una etiqueta).
  const galeria = $('ig-galeria') as HTMLDialogElement;
  const galeriaImagenes = $('ig-galeria-imagenes');
  const galeriaError = $('ig-galeria-error');
  const galeriaModo = $('ig-galeria-modo') as HTMLSelectElement;
  const galeriaSeparacion = $('ig-galeria-separacion') as HTMLInputElement;
  const AYUDA_MODO: Record<string, string> = {
    tira: 'Una sola imagen larga con todas las etiquetas. Algunas impresoras la comprimen en UNA etiqueta: si pasa, usa el PDF.',
    pdf: 'Un solo archivo de varias páginas, una etiqueta por página, cada una del tamaño exacto del papel: la impresora avanza una etiqueta por página con su sensor de separación.',
    sueltas: 'Una imagen por etiqueta: WePrint solo deja imprimir una a la vez.',
  };
  let galeriaTira: File | null = null;
  let galeriaPdf: File | null = null;
  let galeriaSueltas: File[] = [];
  let galeriaCodigos: string[] = [];
  /** La galería abierta es una reimpresión: al terminar se anota como reimpresión y no cambia la fecha de la primera impresión */
  let galeriaEsReimpresion = false;
  /** Las últimas etiquetas que se dieron por impresas (para ofrecer reimprimirlas si alguna salió mal) */
  let ultimasImpresas: { codigo: string; nombre: string }[] = [];
  let galeriaEtiquetas: { codigo: string; nombre: string }[] = [];
  let galeriaUrls: string[] = [];
  let galeriaVersion = 0;

  function archivosDelModo(): File[] {
    if (galeriaModo.value === 'tira') return galeriaTira ? [galeriaTira] : [];
    if (galeriaModo.value === 'pdf') return galeriaPdf ? [galeriaPdf] : [];
    return galeriaSueltas;
  }

  function actualizarBotonesGaleria() {
    const archivos = archivosDelModo();
    $('ig-galeria-ayuda').textContent = AYUDA_MODO[galeriaModo.value] ?? '';
    $('ig-galeria-separacion-caja').classList.toggle('hidden', galeriaModo.value !== 'tira');
    ($('ig-galeria-compartir') as HTMLButtonElement).disabled = archivos.length === 0;
    ($('ig-galeria-descargar') as HTMLButtonElement).disabled = archivos.length === 0;
    $('ig-galeria-compartir').classList.toggle('hidden', archivos.length > 0 && !puedeCompartirArchivos(archivos));
  }

  /** Genera la tira y el PDF (y las imágenes sueltas la primera vez); se vuelve a llamar si cambia la separación. */
  async function prepararGaleria(incluirSueltas: boolean) {
    const version = ++galeriaVersion;
    const formato = formatoElegido();
    const tipo = buscarTipoCodigo(selectTipo.value);
    const separacion = Math.max(0, Math.min(10, Number(galeriaSeparacion.value) || 0));
    galeriaTira = null;
    galeriaPdf = null;
    actualizarBotonesGaleria();
    try {
      const [tira, pdf, sueltas] = await Promise.all([
        tiraComoPng(galeriaEtiquetas, formato, tipo, separacion),
        etiquetasComoPdf(galeriaEtiquetas, formato, tipo),
        incluirSueltas ? prepararArchivosEtiquetas(galeriaEtiquetas, formato, tipo) : Promise.resolve(galeriaSueltas),
      ]);
      if (version !== galeriaVersion) return; // llegó otra petición más nueva
      const medida = `${formato.anchoMm}x${formato.altoMm}mm`;
      galeriaTira = new File([tira], `etiquetas-tira-${medida}.png`, { type: 'image/png' });
      galeriaPdf = new File([pdf], `etiquetas-${medida}.pdf`, { type: 'application/pdf' });
      galeriaSueltas = sueltas;
      if (incluirSueltas) {
        galeriaUrls.forEach((u) => URL.revokeObjectURL(u));
        galeriaUrls = sueltas.map((a) => URL.createObjectURL(a));
        galeriaImagenes.innerHTML = sueltas
          .map((a, i) => `<img src="${galeriaUrls[i]}" alt="Etiqueta ${escapar(a.name)}" class="w-full rounded border border-slate-300 bg-white" />`)
          .join('');
      }
      galeriaError.classList.add('hidden');
    } catch (err) {
      galeriaError.textContent = err instanceof Error ? err.message : 'No se pudieron preparar las etiquetas.';
      galeriaError.classList.remove('hidden');
    }
    actualizarBotonesGaleria();
  }

  function cerrarGaleria() {
    galeriaVersion += 1;
    galeria.close();
    galeriaUrls.forEach((u) => URL.revokeObjectURL(u));
    galeriaUrls = [];
    galeriaImagenes.innerHTML = '';
  }

  /** Abre la galería con esas etiquetas (hasta MAX_ETIQUETAS_POR_TIRA por vez) lista para mandarla a la impresora. */
  async function abrirGaleria(etiquetas: { codigo: string; nombre: string }[], esReimpresion: boolean) {
    const envio = etiquetas.slice(0, MAX_ETIQUETAS_POR_TIRA);
    galeriaEsReimpresion = esReimpresion;
    galeriaEtiquetas = envio.map((e) => ({ codigo: e.codigo, nombre: e.nombre }));
    galeriaCodigos = envio.map((e) => e.codigo);
    const restantes = etiquetas.length - envio.length;
    const boton = esReimpresion ? 'Reimprimir etiquetas' : 'Imprimir etiquetas';
    $('ig-galeria-titulo').textContent = boton;
    $('ig-galeria-cuenta').textContent =
      `${envio.length} etiqueta${envio.length === 1 ? '' : 's'}${esReimpresion ? ' (mismo código que la anterior)' : ''}${restantes > 0 ? ` (faltan ${restantes} más: al terminar, vuelve a pulsar "${boton}" para las siguientes)` : ''}`;
    galeriaModo.value = 'pdf';
    galeriaImagenes.innerHTML = '';
    copiarMedidaAGaleria();
    galeria.showModal();
    await prepararGaleria(true);
  }

  $('ig-compartir').addEventListener('click', async () => {
    const etiquetas = reunirEtiquetas();
    if (!etiquetas) return;
    await abrirGaleria(etiquetas, false);
  });

  galeriaModo.addEventListener('change', actualizarBotonesGaleria);
  galeriaSeparacion.addEventListener('change', () => void prepararGaleria(false));

  // --- Medida de la etiqueta, dentro del mismo diálogo de impresión ---
  // Es la MISMA medida del panel "Etiquetas" (se copia en ambos sentidos): se cambia justo al imprimir o reimprimir y los archivos
  // (PDF, tira e imágenes) se vuelven a generar con el tamaño nuevo. Se recuerda para la próxima vez.
  const galeriaFormato = $<HTMLSelectElement>('ig-galeria-formato');
  const galeriaAncho = $<HTMLInputElement>('ig-galeria-ancho');
  const galeriaAlto = $<HTMLInputElement>('ig-galeria-alto');

  function mostrarMedidaGaleria() {
    $('ig-galeria-personalizado').classList.toggle('hidden', galeriaFormato.value !== FORMATO_PERSONALIZADO_ID);
    const f = buscarFormatoEtiqueta(galeriaFormato.value, { anchoMm: Number(galeriaAncho.value), altoMm: Number(galeriaAlto.value) });
    $('ig-galeria-medida').textContent = f.hoja
      ? `Hoja A4 con ${f.hoja.columnas * f.hoja.filas} etiquetas de ${f.anchoMm} × ${f.altoMm} mm.`
      : `Cada página del PDF mide ${f.anchoMm} × ${f.altoMm} mm: en WePrint deja ese mismo tamaño de papel.`;
  }

  function copiarMedidaAGaleria() {
    const f = formatoElegido();
    galeriaFormato.value = selectFormato.value;
    galeriaAncho.value = String(campoAncho.value || f.anchoMm);
    galeriaAlto.value = String(campoAlto.value || f.altoMm);
    mostrarMedidaGaleria();
  }

  galeriaFormato.addEventListener('change', () => {
    selectFormato.value = galeriaFormato.value;
    if (galeriaFormato.value === FORMATO_PERSONALIZADO_ID && !galeriaAncho.value) copiarMedidaAGaleria();
    selectFormato.dispatchEvent(new Event('change')); // guarda, redibuja la vista previa y el resumen
    mostrarMedidaGaleria();
    void prepararGaleria(true);
  });
  for (const campo of [galeriaAncho, galeriaAlto]) {
    campo.addEventListener('change', () => {
      campoAncho.value = galeriaAncho.value;
      campoAlto.value = galeriaAlto.value;
      campoAncho.dispatchEvent(new Event('change')); // corrige a los límites y guarda
      galeriaAncho.value = campoAncho.value;
      galeriaAlto.value = campoAlto.value;
      mostrarMedidaGaleria();
      void prepararGaleria(true);
    });
  }

  // El menú "Compartir" exige que se abra con un toque del usuario: los archivos ya están listos antes de pulsar el botón
  $('ig-galeria-compartir').addEventListener('click', async () => {
    galeriaError.classList.add('hidden');
    try {
      await compartirArchivos(archivosDelModo());
    } catch (err) {
      galeriaError.textContent = err instanceof Error ? `No se pudo abrir el menú Compartir (${err.message}). Usa "Descargar" o guarda las etiquetas en Fotos.` : 'No se pudo abrir el menú Compartir.';
      galeriaError.classList.remove('hidden');
    }
  });
  $('ig-galeria-descargar').addEventListener('click', () => descargarArchivos(archivosDelModo()));
  $('ig-galeria-cerrar').addEventListener('click', cerrarGaleria);
  $('ig-galeria-listo').addEventListener('click', async () => {
    const codigos = galeriaCodigos;
    const etiquetas = galeriaEtiquetas;
    const esReimpresion = galeriaEsReimpresion;
    cerrarGaleria();
    mostrarExito(
      esReimpresion
        ? `Reimpresión anotada en ${codigos.length} etiqueta${codigos.length === 1 ? '' : 's'}.`
        : `Marcadas ${codigos.length} etiqueta${codigos.length === 1 ? '' : 's'} como impresas.`
    );
    // Justo cuando se ve el resultado es cuando se nota que alguna salió mal: se ofrece reimprimir estas mismas
    ultimasImpresas = etiquetas;
    $('ig-reimprimir-ultimas').classList.remove('hidden');
    $('ig-reimprimir-ultimas').classList.add('flex');
    // Las unidades impresas ya no se vuelven a ofrecer como "sin etiqueta"
    try {
      await inventoryService.marcarEtiquetasImpresas(codigos, { reimpresion: esReimpresion });
      await cargarSinEtiqueta();
    } catch {
      /* si no se pudo anotar, esas unidades se vuelven a ofrecer como "sin etiqueta" */
    }
  });

  // --- Reimprimir etiquetas ---------------------------------------------------------------
  // Se elige entre las unidades DISPONIBLES del local (una vendida ya no está aquí). El código no cambia; al terminar se anota la
  // reimpresión (cuántas veces y cuándo) sin tocar la fecha de la primera impresión.
  const reimp = $('ig-reimp') as HTMLDialogElement;
  const reimpBuscar = $<HTMLInputElement>('ig-reimp-buscar');
  const reimpLista = $('ig-reimp-lista');
  const reimpEstado = $('ig-reimp-estado');
  const reimpImprimir = $<HTMLButtonElement>('ig-reimp-imprimir');
  const MAX_FILAS_REIMPRESION = 300;
  let reimpUnidades: UnidadProducto[] = [];
  let reimpSeleccion = new Set<string>();
  let reimpSoloProducto: string | undefined;

  function actualizarCuentaReimp() {
    const n = reimpSeleccion.size;
    const aImprimir = Math.min(n, MAX_ETIQUETAS_POR_TIRA);
    $('ig-reimp-cuenta').textContent = n
      ? `${n} seleccionada${n === 1 ? '' : 's'}${n > MAX_ETIQUETAS_POR_TIRA ? ` · se preparan ${MAX_ETIQUETAS_POR_TIRA} por vez` : ''}`
      : 'Ninguna seleccionada';
    reimpImprimir.disabled = n === 0;
    reimpImprimir.textContent = n ? `Reimprimir ${aImprimir} etiqueta${aImprimir === 1 ? '' : 's'}` : 'Reimprimir';
  }

  function pintarReimp() {
    const grupos = agruparUnidadesParaReimprimir(reimpUnidades, productos, reimpBuscar.value, reimpSoloProducto);
    reimpEstado.classList.toggle('hidden', grupos.length > 0);
    if (grupos.length === 0) reimpEstado.textContent = reimpUnidades.length ? 'No hay unidades que coincidan con la búsqueda.' : 'No hay unidades disponibles en este local.';
    let dibujadas = 0;
    reimpLista.innerHTML = grupos
      .map((g) => {
        const visibles = g.unidades.slice(0, Math.max(0, MAX_FILAS_REIMPRESION - dibujadas));
        dibujadas += visibles.length;
        const todas = visibles.length > 0 && visibles.every((u) => reimpSeleccion.has(u.codigo));
        return `
          <section class="rounded-lg border border-slate-200 dark:border-slate-700">
            <label class="flex cursor-pointer items-center gap-2 bg-slate-50 px-3 py-2 dark:bg-slate-800/60">
              <input type="checkbox" data-reimp-grupo="${escapar(g.producto.id)}" ${todas ? 'checked' : ''} class="h-4 w-4 rounded border-slate-300 text-brand-600" />
              <span class="min-w-0 flex-1 text-sm font-semibold">${escapar(g.producto.nombre)}</span>
              <span class="shrink-0 text-xs text-slate-500 dark:text-slate-400">${g.unidades.length} disponible${g.unidades.length === 1 ? '' : 's'}</span>
            </label>
            <ul class="divide-y divide-slate-100 dark:divide-slate-800">
              ${visibles
                .map(
                  (u) => `
                <li>
                  <label class="flex cursor-pointer items-center gap-2 px-3 py-2">
                    <input type="checkbox" data-reimp-unidad="${escapar(u.codigo)}" data-producto="${escapar(g.producto.id)}" ${reimpSeleccion.has(u.codigo) ? 'checked' : ''} class="h-4 w-4 rounded border-slate-300 text-brand-600" />
                    <span class="font-mono text-xs">${escapar(u.codigo)}</span>
                    <span class="ml-auto text-xs ${(u.reimpresiones ?? 0) > 0 ? 'text-amber-700 dark:text-amber-300' : 'text-slate-400'}">${escapar(resumenReimpresion(u))}</span>
                  </label>
                </li>`
                )
                .join('')}
            </ul>
          </section>`;
      })
      .join('');
    if (dibujadas < grupos.reduce((n, g) => n + g.unidades.length, 0)) {
      reimpLista.insertAdjacentHTML('beforeend', `<p class="text-center text-xs text-slate-500 dark:text-slate-400">Se muestran las primeras ${MAX_FILAS_REIMPRESION} unidades: afina la búsqueda para ver el resto.</p>`);
    }
    actualizarCuentaReimp();
  }

  async function abrirReimprimir(soloProducto?: string) {
    reimpSoloProducto = soloProducto;
    reimpSeleccion = new Set();
    reimpBuscar.value = '';
    reimpUnidades = [];
    reimpLista.innerHTML = '';
    reimpEstado.classList.remove('hidden');
    reimpEstado.textContent = 'Cargando unidades…';
    actualizarCuentaReimp();
    reimp.showModal();
    try {
      reimpUnidades = await inventoryService.listarUnidades({ estado: 'DISPONIBLE' });
      pintarReimp();
    } catch (err) {
      reimpEstado.textContent = err instanceof Error ? `No se pudieron cargar las unidades (${err.message}).` : 'No se pudieron cargar las unidades.';
    }
  }

  reimpBuscar.addEventListener('input', pintarReimp);
  reimpLista.addEventListener('change', (e) => {
    const casilla = e.target as HTMLInputElement;
    if (casilla.dataset.reimpUnidad) {
      if (casilla.checked) reimpSeleccion.add(casilla.dataset.reimpUnidad);
      else reimpSeleccion.delete(casilla.dataset.reimpUnidad);
      const grupo = reimpLista.querySelector<HTMLInputElement>(`[data-reimp-grupo="${casilla.dataset.producto}"]`);
      if (grupo) {
        const unidades = [...reimpLista.querySelectorAll<HTMLInputElement>(`[data-reimp-unidad][data-producto="${casilla.dataset.producto}"]`)];
        grupo.checked = unidades.every((u) => u.checked);
      }
    } else if (casilla.dataset.reimpGrupo) {
      for (const u of reimpLista.querySelectorAll<HTMLInputElement>(`[data-reimp-unidad][data-producto="${casilla.dataset.reimpGrupo}"]`)) {
        u.checked = casilla.checked;
        if (casilla.checked) reimpSeleccion.add(u.dataset.reimpUnidad!);
        else reimpSeleccion.delete(u.dataset.reimpUnidad!);
      }
    }
    actualizarCuentaReimp();
  });
  $('ig-reimp-cerrar').addEventListener('click', () => reimp.close());
  $('ig-reimprimir-abrir').addEventListener('click', () => void abrirReimprimir());
  reimpImprimir.addEventListener('click', () => {
    const nombres = new Map(productos.map((p) => [p.id, p.nombre]));
    const elegidas = reimpUnidades
      .filter((u) => reimpSeleccion.has(u.codigo))
      .map((u) => ({ codigo: u.codigo, nombre: nombres.get(u.producto_id) ?? 'Producto' }));
    if (elegidas.length === 0) return;
    reimp.close();
    void abrirGaleria(elegidas, true);
  });
  $('ig-reimprimir-estas').addEventListener('click', () => {
    if (ultimasImpresas.length > 0) void abrirGaleria(ultimasImpresas, true);
  });

  function pintarPrevia() {
    const formato = formatoElegido();
    const primeraLinea = lote.find((l) => producto(l.id));
    const primerProducto = primeraLinea ? producto(primeraLinea.id) : undefined;
    const codigoEjemplo = primeraLinea
      ? (primeraLinea.unidades?.[0] ?? sinEtiqueta.get(primeraLinea.id)?.[0] ?? `${primerProducto?.prefijo_codigo ?? 'INF'}000001`)
      : 'INF000001';
    const primera = { codigo: codigoEjemplo, nombre: primerProducto?.nombre ?? 'Forro silicona iPhone 13' };
    const tipo = buscarTipoCodigo(selectTipo.value);
    $('ig-previa').innerHTML = htmlEtiqueta(primera, formato, tipo);
    $('ig-tipo-nota').textContent = TIPOS_CODIGO_ETIQUETA.find((t) => t.id === tipo)?.ayuda ?? '';
    $('ig-formato-nota').textContent = formato.hoja
      ? `Hoja A4 con ${formato.hoja.columnas * formato.hoja.filas} etiquetas de ${formato.anchoMm} × ${formato.altoMm} mm, sin márgenes de página.`
      : `Una etiqueta por página de ${formato.anchoMm} × ${formato.altoMm} mm: configura ese tamaño de papel en la impresora.`;
  }

  selectTipo.addEventListener('change', () => {
    try {
      localStorage.setItem(LS_TIPO_CODIGO, selectTipo.value);
    } catch {
      /* sin almacenamiento */
    }
    pintarPrevia();
  });

  /** Muestra los campos de ancho y alto solo con "Tamaño personalizado". */
  function mostrarCamposPersonalizados() {
    $('ig-personalizado').classList.toggle('hidden', selectFormato.value !== FORMATO_PERSONALIZADO_ID);
  }

  selectFormato.addEventListener('change', () => {
    try {
      localStorage.setItem(LS_FORMATO, selectFormato.value);
    } catch {
      /* sin almacenamiento */
    }
    mostrarCamposPersonalizados();
    pintarPrevia();
    actualizarResumen();
  });

  // Al terminar de escribir, el tamaño se corrige a los límites, se recuerda y se redibuja la vista previa
  for (const campo of [campoAncho, campoAlto]) {
    campo.addEventListener('input', () => {
      pintarPrevia();
    });
    campo.addEventListener('change', () => {
      const formato = formatoElegido();
      campoAncho.value = String(formato.anchoMm);
      campoAlto.value = String(formato.altoMm);
      try {
        localStorage.setItem(LS_TAMANO_PERSONALIZADO, JSON.stringify({ anchoMm: formato.anchoMm, altoMm: formato.altoMm }));
      } catch {
        /* sin almacenamiento */
      }
      pintarPrevia();
      actualizarResumen();
    });
  }

  // --- Producto nuevo / editado desde el formulario ---------------------------------------------
  // Mercancía que ya está en el sistema pero nunca se etiquetó: se agrega cada producto con unidades sin etiqueta, con cantidad
  // de ingreso 0 (no suma stock) y tantas etiquetas como unidades le faltan.
  $('ig-pendientes').addEventListener('click', async () => {
    error.classList.add('hidden');
    aviso.classList.add('hidden');
    await cargarSinEtiqueta();
    let productos = 0;
    let unidades = 0;
    for (const [id, codigos] of sinEtiqueta) {
      if (!producto(id) || codigos.length === 0) continue;
      const existente = lote.find((l) => l.id === id);
      if (existente) {
        if (existente.cantidad > 0) continue; // ya tiene un ingreso en curso: se deja como está
        existente.copias = codigos.length;
        existente.manual = true;
      } else {
        lote.push({ id, cantidad: 0, copias: codigos.length, manual: true });
      }
      productos += 1;
      unidades += codigos.length;
    }
    if (productos === 0) {
      avisar('No hay unidades sin etiqueta en este local: todo lo que tienes ya tiene su etiqueta impresa.');
      return;
    }
    guardarLote();
    pintarLote();
    mostrarExito(
      `Agregados ${productos} producto${productos === 1 ? '' : 's'} con ${unidades} unidad${unidades === 1 ? '' : 'es'} sin etiqueta. Pulsa "Imprimir etiquetas" (se preparan hasta 40 por vez; al terminar, vuelve a pulsar para las siguientes).`
    );
  });

  $('ig-nuevo').addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('easystem:abrir-producto', { detail: { sinStock: true, codigo: ultimoCodigoDesconocido || undefined } }));
    ultimoCodigoDesconocido = '';
    aviso.classList.add('hidden');
  });

  window.addEventListener('easystem:producto-guardado', (async (e: CustomEvent<{ productoId: string; nuevo: boolean }>) => {
    productos = await inventoryService.listarProductos({ catalogoCompleto: true });
    if (e.detail.nuevo) agregar(e.detail.productoId);
    else pintarLote();
  }) as unknown as EventListener);

  /**
   * Actualización en vivo: otro dispositivo vendió o ingresó mercancía. Se renuevan las existencias mostradas
   * (los campos de cantidad que se estén escribiendo no se tocan); si un producto del lote desapareció, se quita.
   */
  async function refrescarExistencias() {
    productos = await inventoryService.listarProductos({ catalogoCompleto: true });
    if (lote.some((l) => !producto(l.id))) {
      lote = lote.filter((l) => producto(l.id));
      guardarLote();
      pintarLote();
      return;
    }
    for (const l of lote) {
      const p = producto(l.id)!;
      const celda = filas.querySelector<HTMLElement>(`[data-stock="${l.id}"]`);
      if (celda) celda.innerHTML = `${p.stock_actual}${l.cantidad > 0 ? ` <span class="text-emerald-600 dark:text-emerald-400">→ ${p.stock_actual + l.cantidad}</span>` : ''}`;
    }
    await cargarSinEtiqueta();
  }

  // --- Arranque ------------------------------------------------------------------------------------
  Promise.all([inventoryService.listarProductos({ catalogoCompleto: true }), inventoryService.obtenerContextoLocal()]).then(([lista, contexto]) => {
    if (!esGerencia(contexto?.sesion.rol)) return;
    LS_LOTE = `easystem:ingreso-lote:${contexto!.sesion.id}`;
    productos = lista;
    hayLocal = !!contexto?.local;
    $('ig-local').textContent = hayLocal
      ? `El ingreso se suma al stock de: ${contexto!.local!.nombre}.`
      : 'Estás en la vista "Todos los locales": puedes preparar el lote e imprimir etiquetas, pero para registrar el ingreso elige un local en el selector del encabezado.';

    try {
      selectTipo.value = buscarTipoCodigo(localStorage.getItem(LS_TIPO_CODIGO) ?? TIPO_CODIGO_POR_DEFECTO);
    } catch {
      selectTipo.value = TIPO_CODIGO_POR_DEFECTO;
    }
    try {
      selectFormato.value = localStorage.getItem(LS_FORMATO) ?? FORMATO_ETIQUETA_POR_DEFECTO;
    } catch {
      selectFormato.value = FORMATO_ETIQUETA_POR_DEFECTO;
    }
    if (!selectFormato.value) selectFormato.value = FORMATO_ETIQUETA_POR_DEFECTO;
    try {
      const guardado = JSON.parse(localStorage.getItem(LS_TAMANO_PERSONALIZADO) ?? 'null');
      if (guardado) {
        const formato = buscarFormatoEtiqueta(FORMATO_PERSONALIZADO_ID, guardado);
        campoAncho.value = String(formato.anchoMm);
        campoAlto.value = String(formato.altoMm);
      }
    } catch {
      /* sin tamaño guardado: quedan 50 × 30 */
    }
    mostrarCamposPersonalizados();

    alCambiarDatos(['inventario_local', 'productos', 'compatibilidades', 'unidades_producto'], refrescarExistencias);
    lote = leerLote().filter((l) => lista.some((p) => p.id === l.id));
    cargarSinEtiqueta();
    const parametros = new URLSearchParams(window.location.search);
    const pedido = parametros.get('producto');
    const reimprimir = parametros.get('reimprimir');
    if (reimprimir && lista.some((p) => p.id === reimprimir)) {
      history.replaceState(null, '', window.location.pathname);
      pintarLote();
      void abrirReimprimir(reimprimir);
    } else if (pedido && lista.some((p) => p.id === pedido)) {
      history.replaceState(null, '', window.location.pathname);
      agregar(pedido);
    } else {
      pintarLote();
    }
  });

  // --- Pestañas de Mercancía: Ingreso (esta pantalla), Descargo (traslados y bajas) e Inventario (hoja de conteo), estos dos como componentes aparte ---
  const CLASE_TAB_ACTIVA = ['border-brand-600', 'bg-brand-600', 'text-white', 'shadow-sm'];
  const CLASE_TAB_INACTIVA = ['border-slate-200', 'bg-white', 'text-slate-700', 'hover:bg-slate-50', 'dark:border-slate-700', 'dark:bg-slate-900', 'dark:text-slate-200', 'dark:hover:bg-slate-800'];
  type Pestana = 'ingreso' | 'descargo' | 'inventario';
  const pestanaDelHash = (): Pestana => (location.hash === '#descargo' ? 'descargo' : location.hash === '#inventario' ? 'inventario' : 'ingreso');
  function mostrarPestana(pestana: Pestana) {
    for (const id of ['ingreso', 'descargo', 'inventario'] as const) {
      const activa = pestana === id;
      const tab = document.getElementById(`mc-tab-${id}`)!;
      tab.setAttribute('aria-selected', String(activa));
      tab.classList.remove(...CLASE_TAB_ACTIVA, ...CLASE_TAB_INACTIVA);
      tab.classList.add(...(activa ? CLASE_TAB_ACTIVA : CLASE_TAB_INACTIVA));
      document.getElementById(`mc-panel-${id}`)!.classList.toggle('hidden', !activa);
    }
    history.replaceState(null, '', pestana === 'ingreso' ? location.pathname + location.search : `#${pestana}`);
    window.dispatchEvent(new CustomEvent('easystem:mercancia-pestana', { detail: { pestana } }));
  }
  document.getElementById('mc-tab-ingreso')!.addEventListener('click', () => mostrarPestana('ingreso'));
  document.getElementById('mc-tab-descargo')!.addEventListener('click', () => mostrarPestana('descargo'));
  document.getElementById('mc-tab-inventario')!.addEventListener('click', () => mostrarPestana('inventario'));
  mostrarPestana(pestanaDelHash());
  window.addEventListener('hashchange', () => mostrarPestana(pestanaDelHash()));
</script>
