---
import '../styles/global.css';

// Chequeo en build/servidor de si Supabase está configurado, solo para
// decidir si mostrar la pista de credenciales demo (no requiere localStorage).
const supabaseConfigurado = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1871d3" />
    <title>Iniciar sesión · EASYSTEM</title>
    <script is:inline>
      try {
        const tema = localStorage.getItem('easystem:tema');
        if (tema === 'dark') document.documentElement.classList.add('dark');
      } catch (_) {}
    </script>
  </head>
  <body class="relative flex min-h-screen items-center justify-center overflow-hidden bg-slate-50 px-4 dark:bg-slate-950">
    <!-- Resplandores de fondo con los colores del logo -->
    <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-accent-400/20 blur-3xl"></div>

    <div class="relative w-full max-w-sm">
      <div class="anim-subir mb-6 flex flex-col items-center gap-3 text-center">
        <img
          src="/logo.png"
          alt="Logo Edward Accesorios"
          width="480"
          height="234"
          class="anim-flotar h-20 w-auto drop-shadow-[0_8px_16px_rgba(24,113,211,0.25)]"
        />
        <div>
          <p class="texto-marca text-xl font-bold tracking-wide">EASYSTEM</p>
          <p class="text-sm text-slate-500 dark:text-slate-400">Edward Accesorios</p>
        </div>
      </div>

      <div class="anim-subir overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900" style="animation-delay: 120ms">
        <div class="bg-marca h-1"></div>
        <div class="p-6">
        <h1 class="text-base font-semibold text-slate-900 dark:text-white">Acceso del personal</h1>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Uso interno de Edward Accesorios. Si no tienes cuenta, pídesela al administrador.
        </p>

        <form id="form-login" class="mt-5 space-y-4">
          <div>
            <label for="login-email" class="block text-xs font-medium text-slate-600 dark:text-slate-400">Correo electrónico</label>
            <input id="login-email" type="email" required autocomplete="email" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          </div>
          <div>
            <label for="login-password" class="block text-xs font-medium text-slate-600 dark:text-slate-400">Contraseña</label>
            <input id="login-password" type="password" required autocomplete="current-password" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
          </div>
          <button id="login-enviar" type="submit" class="bg-marca w-full rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:brightness-110 hover:shadow-md disabled:cursor-not-allowed disabled:opacity-60">
            Iniciar sesión
          </button>
        </form>

        <p id="auth-error" class="mt-4 hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>

        {!supabaseConfigurado && (
          <div class="mt-5 rounded-lg border border-dashed border-slate-300 px-3 py-2.5 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">
            <p class="font-medium text-slate-600 dark:text-slate-300">Modo demo (sin Supabase configurado):</p>
            <p class="mt-1">Administrador: admin@edwardaccesorios.com / admin123</p>
            <p>Vendedor: vendedor@edwardaccesorios.com / vendedor123</p>
          </div>
        )}
        </div>
      </div>
    </div>

    <script>
      import { iniciarSesion, obtenerSesionActual } from '../lib/auth';
      import { reanimar } from '../utils/animaciones';

      const form = document.getElementById('form-login') as HTMLFormElement;
      const enviar = document.getElementById('login-enviar') as HTMLButtonElement;
      const error = document.getElementById('auth-error') as HTMLParagraphElement;

      // Solo rutas internas: evita que /login?next=https://sitio-malo redirija fuera.
      function siguienteRuta(): string {
        const next = new URLSearchParams(window.location.search).get('next') || '/';
        return next.startsWith('/') && !next.startsWith('//') ? next : '/';
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        error.classList.add('hidden');
        enviar.disabled = true;
        enviar.textContent = 'Entrando...';

        const email = (document.getElementById('login-email') as HTMLInputElement).value.trim();
        const password = (document.getElementById('login-password') as HTMLInputElement).value;

        try {
          await iniciarSesion(email, password);
          window.location.href = siguienteRuta();
        } catch (err) {
          error.textContent = err instanceof Error ? err.message : 'No se pudo iniciar sesión.';
          error.classList.remove('hidden');
          reanimar(error, 'anim-sacudir');
          enviar.disabled = false;
          enviar.textContent = 'Iniciar sesión';
        }
      });

      // Si ya hay sesión activa, no tiene sentido quedarse en /login.
      obtenerSesionActual().then((sesion) => {
        if (sesion) window.location.href = siguienteRuta();
      });
    </script>
  </body>
</html>
