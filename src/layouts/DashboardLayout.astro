---
import Sidebar from '../components/layout/Sidebar.astro';
import Header from '../components/layout/Header.astro';
import TasaDelDia from '../components/layout/TasaDelDia.astro';
import ContextoLocal from '../components/layout/ContextoLocal.astro';
import '../styles/global.css';
import type { Rol } from '../lib/auth';

interface Props {
  titulo: string;
  subtitulo?: string;
  /** Texto completo de la pestaña del navegador; por defecto "<titulo> · EASYSTEM". */
  tituloPestana?: string;
  /** Si se define, solo esos roles pueden ver la página (los demás son enviados a "/"). */
  roles?: Rol[];
}

const { titulo, subtitulo, roles, tituloPestana } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1871d3" />
    <title>{tituloPestana ?? `${titulo} · EASYSTEM`}</title>
    <meta name="description" content="EASYSTEM — Gestión de inventario para Edward Accesorios" />
    <script is:inline>
      // Evita el "flash" de tema incorrecto: aplica la clase antes de pintar la página.
      try {
        const tema = localStorage.getItem('easystem:tema');
        if (tema === 'dark') document.documentElement.classList.add('dark');
      } catch (_) {}
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 dark:bg-slate-950">
    <!-- oculto hasta que el guard de auth confirme sesión (evita destello de contenido protegido) -->
    <div id="app-shell" data-roles={roles?.join(',') ?? ''} class="flex min-h-screen" style="visibility:hidden">
      <Sidebar />
      <div class="flex min-w-0 flex-1 flex-col">
        <Header titulo={titulo} subtitulo={subtitulo} />
        <main class="min-w-0 flex-1 space-y-6 p-4 sm:p-6 print:p-0">
          <slot />
        </main>
      </div>
    </div>

    <!-- Tasa del dólar: ventana obligatoria en la primera entrada de cada día -->
    <TasaDelDia />

    <!-- Contexto de local (sesión, locales y local activo) y aviso si el usuario no tiene local asignado -->
    <ContextoLocal />

    <script>
      import { protegerPagina, type Rol } from '../lib/auth';

      const shell = document.getElementById('app-shell') as HTMLDivElement;
      const roles = (shell.dataset.roles ? shell.dataset.roles.split(',') : undefined) as Rol[] | undefined;

      protegerPagina({ roles })
        .then(() => {
          shell.style.visibility = 'visible';
          // Dispara la entrada escalonada del contenido (ver .shell-listo en global.css)
          shell.classList.add('shell-listo');
        })
        .catch(() => {
          // protegerPagina ya redirigió a /login o "/"; no hay nada más que hacer aquí.
        });
    </script>
  </body>
</html>
