---
// Devolución o cambio de producto sobre una venta ya registrada, solo administrador. Se abre con
// "easystem:abrir-devolucion" ({ detail: { venta } }) y avisa con "easystem:ventas-cambiaron"
// ({ detail: { folio } }) al guardar. El inventario se ajusta con movimientos (ENTRADA lo devuelto,
// SALIDA lo entregado a cambio) dentro de inventoryService.registrarDevolucion.
const claseCampo =
  'mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white';
const claseEtiqueta = 'block text-xs font-medium text-slate-600 dark:text-slate-400';
const claseTitulo = 'text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400';
---

<dialog
  id="dv-dialogo"
  aria-labelledby="dv-titulo"
  class="anim-escalar m-auto w-[min(34rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
>
  <form id="dv-form" class="flex max-h-[92dvh] flex-col" novalidate>
    <header class="flex items-start justify-between gap-3 border-b border-slate-200 px-5 py-4 dark:border-slate-800">
      <div class="min-w-0">
        <h2 id="dv-titulo" class="text-base font-semibold">Devolución o cambio de producto</h2>
        <p id="dv-subtitulo" class="mt-0.5 truncate text-xs text-slate-500 dark:text-slate-400"></p>
      </div>
      <button type="button" id="dv-cerrar" aria-label="Cerrar" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800">✕</button>
    </header>

    <div class="space-y-5 overflow-y-auto px-5 py-4">
      <!-- 1. Lo que devuelve el cliente -->
      <section>
        <p class={claseTitulo}>1. Producto que devuelve el cliente</p>
        <ul id="dv-lineas" class="mt-2 divide-y divide-slate-100 rounded-lg border border-slate-200 text-sm dark:divide-slate-800 dark:border-slate-700"></ul>
        <div class="mt-3">
          <label for="dv-motivo" class={claseEtiqueta}>Motivo *</label>
          <input id="dv-motivo" type="text" list="dv-motivos" maxlength="200" autocomplete="off" placeholder="Ej. Se vendió el producto equivocado" class={claseCampo} />
          <datalist id="dv-motivos">
            <option value="Producto equivocado"></option>
            <option value="Producto defectuoso"></option>
            <option value="El cliente cambió de opinión"></option>
            <option value="Error al registrar la venta"></option>
          </datalist>
        </div>
      </section>

      <!-- 2. Producto que se entrega a cambio -->
      <section>
        <p class={claseTitulo}>2. Producto que se entrega a cambio <span class="font-normal normal-case text-slate-400">(opcional)</span></p>
        <input id="dv-buscar" type="search" autocomplete="off" placeholder="Buscar el producto correcto por nombre, código o modelo..." class={claseCampo} />
        <ul id="dv-resultados" class="mt-2 hidden max-h-44 divide-y divide-slate-100 overflow-y-auto rounded-lg border border-slate-200 dark:divide-slate-800 dark:border-slate-700"></ul>
        <ul id="dv-nuevos" class="mt-2 divide-y divide-slate-100 rounded-lg border border-slate-200 text-sm empty:hidden dark:divide-slate-800 dark:border-slate-700"></ul>
      </section>

      <!-- 3. Resultado en dinero -->
      <section class="space-y-3 rounded-xl border border-slate-200 bg-slate-50/60 p-3 dark:border-slate-700 dark:bg-slate-800/30">
        <div class="grid grid-cols-3 gap-2 text-center">
          <div><p class="text-[11px] uppercase text-slate-500 dark:text-slate-400">Se devuelve</p><p id="dv-total-dev" class="text-sm font-semibold">$0.00</p></div>
          <div><p class="text-[11px] uppercase text-slate-500 dark:text-slate-400">Se entrega</p><p id="dv-total-nuevo" class="text-sm font-semibold">$0.00</p></div>
          <div><p class="text-[11px] uppercase text-slate-500 dark:text-slate-400">Diferencia</p><p id="dv-dif" class="text-sm font-semibold">$0.00</p></div>
        </div>
        <p id="dv-dif-texto" class="text-center text-sm font-medium text-slate-600 dark:text-slate-300"></p>

        <!-- Cliente paga más: forma de pago -->
        <div id="dv-cobro" class="hidden"><div id="dv-formulario-pagos"></div></div>

        <!-- Se le devuelve dinero al cliente -->
        <div id="dv-reembolso" class="hidden">
          <label for="dv-reembolso-metodo" class={claseEtiqueta}>Devolver el dinero con *</label>
          <select id="dv-reembolso-metodo" class={claseCampo}></select>
          <p id="dv-reembolso-monto" class="mt-2 rounded-lg bg-brand-50 px-3 py-2 text-sm font-semibold text-brand-800 dark:bg-brand-500/10 dark:text-brand-200"></p>
        </div>
      </section>

      <p id="dv-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Al registrar, lo devuelto vuelve al inventario y lo entregado a cambio se descuenta. Esta acción queda en el historial y no se puede editar ni borrar.
      </p>
    </div>

    <footer class="flex gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-800/40">
      <button id="dv-cancelar" type="button" class="flex-1 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
        Cancelar
      </button>
      <button id="dv-guardar" type="submit" class="bg-marca flex-1 rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60">
        Registrar devolución
      </button>
    </footer>
  </form>
</dialog>

<script>
  import * as inventoryService from '../../lib/inventoryService';
  import { obtenerSesionActual } from '../../lib/auth';
  import { tasaActual } from '../../stores/tasa';
  import { convertirABs, formatearBolivares, formatearMoneda } from '../../utils/format';
  import { FormularioPagos } from '../../utils/formularioPagos';
  import { esMetodoBolivares, etiquetaMetodoPago, METODOS_REEMBOLSO } from '../../utils/pagos';
  import { escaparHtml, normalizarTexto } from '../../utils/productosUI';
  import type { MetodoPago, ProductoConRelaciones, Venta, VentaItem } from '../../types/database.types';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const dialogo = $<HTMLDialogElement>('dv-dialogo');
  const form = $<HTMLFormElement>('dv-form');
  const errorEl = $('dv-error');
  const guardar = $<HTMLButtonElement>('dv-guardar');
  const buscador = $<HTMLInputElement>('dv-buscar');
  const selectReembolso = $<HTMLSelectElement>('dv-reembolso-metodo');
  const formPagos = new FormularioPagos($('dv-formulario-pagos'));
  const redondear = (n: number) => Math.round(n * 100) / 100;

  let venta: Venta | null = null;
  /** producto_id -> cuántas unidades ya se devolvieron en devoluciones anteriores */
  let yaDevuelto = new Map<string, number>();
  /** producto_id -> unidades que se devuelven ahora */
  let aDevolver = new Map<string, number>();
  /** producto_id -> producto de reemplazo con su cantidad */
  let reemplazos = new Map<string, { producto: ProductoConRelaciones; cantidad: number }>();
  let catalogo: ProductoConRelaciones[] = [];

  selectReembolso.innerHTML = METODOS_REEMBOLSO.map((m) => `<option value="${m}">${etiquetaMetodoPago(m)}</option>`).join('');

  function mostrarError(mensaje: string) {
    errorEl.textContent = mensaje;
    errorEl.classList.remove('hidden');
  }

  // --- 1. lo que devuelve --------------------------------------------------------------------------
  function disponible(item: VentaItem): number {
    return item.cantidad - (yaDevuelto.get(item.producto_id) ?? 0);
  }

  function pintarLineas() {
    $('dv-lineas').innerHTML = venta!.items
      .map((item) => {
        const disp = disponible(item);
        const ya = item.cantidad - disp;
        return `
          <li class="flex items-center gap-3 px-3 py-2.5">
            <div class="min-w-0 flex-1">
              <p class="truncate font-medium ${disp === 0 ? 'text-slate-400' : 'text-slate-900 dark:text-white'}">${escaparHtml(item.nombre)}</p>
              <p class="text-[11px] text-slate-500 dark:text-slate-400">${formatearMoneda(item.precio_unitario)} c/u · vendidas ${item.cantidad}${ya > 0 ? ` · ya devueltas ${ya}` : ''}</p>
            </div>
            <label class="flex shrink-0 items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
              Devuelve
              <input type="number" min="0" max="${disp}" step="1" inputmode="numeric" data-devolver="${item.producto_id}" value="${aDevolver.get(item.producto_id) ?? 0}" ${disp === 0 ? 'disabled' : ''}
                class="w-16 rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-center text-base tabular-nums text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 disabled:opacity-40 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            </label>
          </li>`;
      })
      .join('');
  }

  $('dv-lineas').addEventListener('input', (e) => {
    const input = (e.target as HTMLElement).closest<HTMLInputElement>('[data-devolver]');
    if (!input) return;
    const item = venta!.items.find((i) => i.producto_id === input.dataset.devolver)!;
    const valor = Math.max(0, Math.min(disponible(item), Math.floor(Number(input.value) || 0)));
    aDevolver.set(item.producto_id, valor);
    if (input.value !== '' && Number(input.value) !== valor) input.value = String(valor); // muestra el máximo permitido
    actualizarResumen();
  });

  // --- 2. lo que se entrega a cambio ---------------------------------------------------------------------
  function pintarResultados() {
    const q = normalizarTexto(buscador.value.trim());
    const lista = $('dv-resultados');
    if (!q) {
      lista.classList.add('hidden');
      return;
    }
    const coincidencias = catalogo
      .filter((p) => {
        if (p.stock_actual <= 0 || reemplazos.has(p.id)) return false;
        const texto = normalizarTexto(`${p.nombre} ${p.codigo_barras} ${p.categoria} ${p.modelos_compatibles.map((m) => `${m.marca} ${m.modelo}`).join(' ')}`);
        return q.split(/\s+/).every((t) => texto.includes(t));
      })
      .slice(0, 8);
    lista.classList.remove('hidden');
    lista.innerHTML = coincidencias.length
      ? coincidencias
          .map(
            (p) => `
              <li class="flex items-center justify-between gap-3 px-3 py-2">
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-slate-900 dark:text-white">${escaparHtml(p.nombre)}</p>
                  <p class="text-[11px] text-slate-500 dark:text-slate-400">${formatearMoneda(p.precio_venta)} · ${p.stock_actual} disponibles</p>
                </div>
                <button type="button" data-agregar="${p.id}" class="shrink-0 rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-brand-700">+ Agregar</button>
              </li>`
          )
          .join('')
      : '<li class="px-3 py-3 text-xs text-slate-500 dark:text-slate-400">No hay productos con stock que coincidan.</li>';
  }

  function pintarReemplazos() {
    $('dv-nuevos').innerHTML = [...reemplazos.values()]
      .map(
        ({ producto, cantidad }) => `
          <li class="flex items-center gap-3 px-3 py-2.5">
            <div class="min-w-0 flex-1">
              <p class="truncate font-medium text-slate-900 dark:text-white">${escaparHtml(producto.nombre)}</p>
              <p class="text-[11px] text-slate-500 dark:text-slate-400">${formatearMoneda(producto.precio_venta)} c/u · ${producto.stock_actual} disponibles</p>
            </div>
            <input type="number" min="1" max="${producto.stock_actual}" step="1" inputmode="numeric" data-cantidad-nuevo="${producto.id}" value="${cantidad}" aria-label="Cantidad"
              class="w-16 rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-center text-base tabular-nums text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
            <button type="button" data-quitar-nuevo="${producto.id}" aria-label="Quitar" class="text-slate-400 hover:text-red-600">✕</button>
          </li>`
      )
      .join('');
  }

  buscador.addEventListener('input', pintarResultados);
  $('dv-resultados').addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-agregar]')?.dataset.agregar;
    const producto = catalogo.find((p) => p.id === id);
    if (!producto) return;
    reemplazos.set(producto.id, { producto, cantidad: 1 });
    buscador.value = '';
    pintarResultados();
    pintarReemplazos();
    actualizarResumen();
  });
  $('dv-nuevos').addEventListener('input', (e) => {
    const input = (e.target as HTMLElement).closest<HTMLInputElement>('[data-cantidad-nuevo]');
    if (!input) return;
    const r = reemplazos.get(input.dataset.cantidadNuevo!);
    if (!r) return;
    r.cantidad = Math.max(1, Math.min(r.producto.stock_actual, Math.floor(Number(input.value) || 1)));
    if (input.value !== '' && Number(input.value) !== r.cantidad) input.value = String(r.cantidad);
    actualizarResumen();
  });
  $('dv-nuevos').addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-quitar-nuevo]')?.dataset.quitarNuevo;
    if (!id) return;
    reemplazos.delete(id);
    pintarReemplazos();
    actualizarResumen();
  });

  // --- 3. dinero -------------------------------------------------------------------------------------------
  function totales() {
    const devuelto = redondear(venta!.items.reduce((suma, i) => suma + i.precio_unitario * (aDevolver.get(i.producto_id) ?? 0), 0));
    const nuevo = redondear([...reemplazos.values()].reduce((suma, r) => suma + r.producto.precio_venta * r.cantidad, 0));
    return { devuelto, nuevo, dif: redondear(nuevo - devuelto) };
  }

  function actualizarResumen() {
    errorEl.classList.add('hidden');
    const { devuelto, nuevo, dif } = totales();
    const tasa = tasaActual.get();
    $('dv-total-dev').textContent = formatearMoneda(devuelto);
    $('dv-total-nuevo').textContent = formatearMoneda(nuevo);
    $('dv-dif').textContent = `${dif > 0 ? '+' : ''}${formatearMoneda(dif)}`;

    const cobra = dif > 0.01;
    const reembolsa = dif < -0.01;
    $('dv-cobro').classList.toggle('hidden', !cobra);
    $('dv-reembolso').classList.toggle('hidden', !reembolsa);
    $('dv-dif-texto').textContent =
      devuelto === 0
        ? 'Indica cuántas unidades devuelve el cliente.'
        : cobra
          ? `El cliente debe pagar ${formatearMoneda(dif)}${tasa ? ` (≈ ${formatearBolivares(convertirABs(dif, tasa))})` : ''}.`
          : reembolsa
            ? `Se le devuelve al cliente ${formatearMoneda(-dif)}.`
            : 'Cambio sin diferencia de precio: no se cobra ni se devuelve dinero.';

    if (cobra) formPagos.establecerTotal(dif);
    if (reembolsa) {
      const usd = -dif;
      const metodo = selectReembolso.value as MetodoPago;
      $('dv-reembolso-monto').textContent =
        esMetodoBolivares(metodo) && tasa
          ? `Entregar ${formatearBolivares(convertirABs(usd, tasa))} (≈ ${formatearMoneda(usd)}, tasa ${formatearBolivares(tasa)})`
          : `Entregar ${formatearMoneda(usd)}`;
    }
  }

  selectReembolso.addEventListener('change', actualizarResumen);
  tasaActual.listen(() => {
    if (dialogo.open) {
      formPagos.refrescar();
      actualizarResumen();
    }
  });

  // --- abrir / guardar ---------------------------------------------------------------------------------------
  async function abrir(v: Venta) {
    const sesion = await obtenerSesionActual();
    if (sesion?.rol !== 'administrador') return;
    venta = v;
    aDevolver = new Map();
    reemplazos = new Map();
    formPagos.reiniciar();
    buscador.value = '';
    $<HTMLInputElement>('dv-motivo').value = '';
    $('dv-subtitulo').textContent = `Venta #${String(v.folio).padStart(4, '0')} · ${v.cliente_nombre} · ${formatearMoneda(v.total)}`;
    errorEl.classList.add('hidden');
    try {
      const [devoluciones, productos] = await Promise.all([inventoryService.listarDevoluciones({ ventaId: v.id }), inventoryService.listarProductos()]);
      yaDevuelto = new Map();
      for (const d of devoluciones) for (const i of d.items_devueltos) yaDevuelto.set(i.producto_id, (yaDevuelto.get(i.producto_id) ?? 0) + i.cantidad);
      catalogo = productos;
    } catch (err) {
      yaDevuelto = new Map();
      catalogo = [];
      mostrarError(`No se pudo cargar la información: ${err instanceof Error ? err.message : err}`);
    }
    pintarLineas();
    pintarResultados();
    pintarReemplazos();
    actualizarResumen();
    dialogo.showModal();
  }

  window.addEventListener('easystem:abrir-devolucion', ((e: CustomEvent<{ venta: Venta }>) => {
    void abrir(e.detail.venta);
  }) as EventListener);
  $('dv-cerrar').addEventListener('click', () => dialogo.close());
  $('dv-cancelar').addEventListener('click', () => dialogo.close());

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!venta) return;
    errorEl.classList.add('hidden');

    const devueltos = [...aDevolver].filter(([, c]) => c > 0).map(([producto_id, cantidad]) => ({ producto_id, cantidad }));
    if (devueltos.length === 0) return mostrarError('Indica cuántas unidades devuelve el cliente.');
    const motivo = $<HTMLInputElement>('dv-motivo').value.trim();
    if (motivo.length < 3) {
      mostrarError('Escribe el motivo de la devolución.');
      return $('dv-motivo').focus();
    }
    const tasa = tasaActual.get();
    if (!tasa) {
      window.dispatchEvent(new Event('easystem:abrir-tasa'));
      return mostrarError('Falta la tasa del dólar del día.');
    }

    const { dif } = totales();
    let pagos, vuelto, reembolsoMetodo: MetodoPago | null = null;
    if (dif > 0.01) {
      const lectura = formPagos.leer();
      if (!lectura.ok) {
        lectura.foco?.focus();
        return mostrarError(lectura.mensaje);
      }
      pagos = lectura.pagos;
      vuelto = lectura.vuelto;
    } else if (dif < -0.01) {
      reembolsoMetodo = selectReembolso.value as MetodoPago;
    }

    const nuevos: VentaItem[] = [...reemplazos.values()].map(({ producto, cantidad }) => ({
      producto_id: producto.id,
      nombre: producto.nombre,
      codigo_barras: producto.codigo_barras,
      cantidad,
      precio_unitario: producto.precio_venta,
    }));

    guardar.disabled = true;
    guardar.textContent = 'Registrando...';
    try {
      const sesion = await obtenerSesionActual();
      const devolucion = await inventoryService.registrarDevolucion({
        venta,
        devueltos,
        nuevos,
        motivo,
        tasa_cambio: tasa,
        pagos,
        vuelto,
        reembolso_metodo: reembolsoMetodo,
        registrado_nombre: sesion?.nombre,
      });
      dialogo.close();
      window.dispatchEvent(new CustomEvent('easystem:ventas-cambiaron', { detail: { folio: devolucion.folio, ventaFolio: devolucion.venta_folio } }));
    } catch (err) {
      mostrarError(err instanceof Error ? err.message : 'No se pudo registrar la devolución.');
    } finally {
      guardar.disabled = false;
      guardar.textContent = 'Registrar devolución';
    }
  });
</script>
