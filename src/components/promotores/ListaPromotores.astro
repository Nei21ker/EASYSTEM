---
// Promotores con sus datos de pago (banco receptor) y lo que queda pendiente con cada uno: comisiones por pagarles y mercancía que se
// llevaron. La usan Pendientes (pestaña "Promotores") y Nómina (trabajadores independientes). Quien la incluye puede filtrarla con el
// evento `easystem:promotores-filtro` { localId?: string | null, buscar?: string } (undefined = el local activo; null = todos).
// Abre FormularioPromotor (`easystem:abrir-promotor`) y CerrarPendiente (`easystem:cerrar-pendiente`), que deben estar en la página.
---

<section id="lp-raiz" class="space-y-3" aria-label="Promotores">
  <div class="flex flex-wrap items-center gap-2">
    <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Promotores</h2>
    <span id="lp-contador" class="text-xs text-slate-500 dark:text-slate-400"></span>
    <button id="lp-agregar" type="button" class="bg-marca ml-auto rounded-lg px-3 py-2 text-xs font-semibold text-white shadow-sm transition hover:brightness-110">+ Agregar promotor</button>
  </div>
  <p id="lp-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
  <p id="lp-vacio" class="hidden rounded-xl border border-dashed border-slate-300 px-4 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400"></p>
  <div id="lp-lista" class="grid grid-cols-1 gap-3 xl:grid-cols-2"></div>

  <!-- Comisiones cuya venta no anotó la cédula del promotor: se atan a uno registrado -->
  <div id="lp-huerfanas" class="hidden space-y-2 rounded-xl border border-amber-200 bg-amber-50/60 p-4 dark:border-amber-500/30 dark:bg-amber-500/5">
    <h3 class="text-sm font-semibold text-amber-900 dark:text-amber-200">Comisiones sin datos del promotor</h3>
    <p class="text-xs text-amber-800 dark:text-amber-300">La venta no anotó su cédula. Elige quién es para que quede su banco y se le pueda pagar.</p>
    <div id="lp-huerfanas-lista" class="space-y-2"></div>
  </div>
</section>

<script>
  import * as inventoryService from '../../lib/inventoryService';
  import { alCambiarDatos } from '../../lib/realtime';
  import { formatearFecha } from '../../utils/format';
  import { activarBotonesCopiar, htmlBotonesCopiarPago, partesUsdYBs, textoUsdYBs } from '../../utils/pagoMovil';
  import { tasaActual } from '../../stores/tasa';
  import { escaparHtml } from '../../utils/productosUI';
  import type { Pendiente, PromotorResumen } from '../../types/database.types';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const lista = $('lp-lista');
  const vacio = $('lp-vacio');
  const error = $('lp-error');
  let promotores: PromotorResumen[] = [];
  let abiertos: Pendiente[] = [];
  let rol = '';
  let localId: string | null | undefined;
  let buscar = '';

  // Quién puede cerrar qué (el servidor lo vuelve a exigir)
  const esGlobalRol = () => rol === 'administrador' || rol === 'gerente';
  const puedePagar = (p: Pendiente) => (p.tipo === 'MERCANCIA' ? esGlobalRol() || rol === 'encargado' : esGlobalRol() || rol === 'contador');
  const puedeAnular = (p: Pendiente) => (p.tipo === 'MERCANCIA' ? esGlobalRol() || rol === 'encargado' : esGlobalRol());

  const claseBoton = 'rounded-lg border px-2.5 py-1.5 text-xs font-semibold transition';
  const botonPagar = `${claseBoton} border-emerald-300 text-emerald-700 hover:bg-emerald-50 dark:border-emerald-700 dark:text-emerald-300 dark:hover:bg-emerald-500/10`;
  const botonNeutro = `${claseBoton} border-slate-200 text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800`;

  /** "$3.78" y debajo "Bs. 3.400,00" al cambio de hoy (anclado al dólar) */
  function htmlMontoDual(usd: number): string {
    const { usd: d, bs } = partesUsdYBs(usd, tasaActual.get());
    return `<span class="block">${d}</span>${bs ? `<span class="block text-[11px] font-medium text-slate-500 dark:text-slate-400">${bs}</span>` : ''}`;
  }

  function htmlPendiente(p: Pendiente): string {
    const comision = p.tipo === 'COMISION';
    const etiqueta = comision
      ? '<span class="rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800 dark:bg-amber-500/15 dark:text-amber-300">Comisión por pagar</span>'
      : '<span class="rounded-full bg-rose-100 px-2 py-0.5 text-[11px] font-semibold text-rose-800 dark:bg-rose-500/15 dark:text-rose-300">Mercancía por cobrar</span>';
    return `<li class="rounded-lg border border-slate-100 px-3 py-2 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-2">${etiqueta}
        <span class="text-xs text-slate-500 dark:text-slate-400">${escaparHtml(formatearFecha(p.fecha))}${p.venta_folio ? ` · venta #${p.venta_folio}` : ''}</span>
        <strong class="ml-auto text-right tabular-nums">${htmlMontoDual(p.monto_usd)}</strong></div>
      <p class="mt-1 text-xs text-slate-600 dark:text-slate-300">${escaparHtml(p.descripcion)}</p>
      <div class="mt-2 flex flex-wrap gap-2">
        ${puedePagar(p) ? `<button type="button" data-accion="pagar" data-id="${p.id}" class="${botonPagar}">${comision ? 'Marcar pagada' : 'Marcar cobrada'}</button>` : ''}
        ${puedeAnular(p) ? `<button type="button" data-accion="anular" data-id="${p.id}" class="${botonNeutro}">Anular</button>` : ''}
      </div></li>`;
  }

  function htmlPromotor(p: PromotorResumen): string {
    const suyos = abiertos.filter((x) => x.promotor_id === p.id);
    const comisionesPagables = suyos.filter((x) => x.tipo === 'COMISION');
    const chips = [
      p.comision_pendiente > 0 ? `<span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800 dark:bg-amber-500/15 dark:text-amber-300">Comisión por pagar ${textoUsdYBs(p.comision_pendiente, tasaActual.get())}</span>` : '',
      p.mercancia_pendiente > 0 ? `<span class="rounded-full bg-rose-100 px-2.5 py-1 text-xs font-semibold text-rose-800 dark:bg-rose-500/15 dark:text-rose-300">Mercancía por cobrar ${textoUsdYBs(p.mercancia_pendiente, tasaActual.get())}</span>` : '',
    ].join('');
    return `<article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-start gap-2">
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">${escaparHtml(`${p.nombre} ${p.apellido}`.trim() || 'Sin nombre')}</p>
          <p class="text-xs text-slate-500 dark:text-slate-400">${escaparHtml(p.cedula)}${p.telefono ? ` · ${escaparHtml(p.telefono)}` : ''}</p>
        </div>
        <button type="button" data-editar="${p.id}" class="${botonNeutro} ml-auto shrink-0">Editar</button>
      </div>
      <p class="mt-2 text-xs ${p.banco ? 'text-slate-700 dark:text-slate-200' : 'text-amber-700 dark:text-amber-400'}">
        <span class="text-slate-500 dark:text-slate-400">Banco receptor:</span> ${p.banco ? `<strong>${escaparHtml(p.banco)}</strong>` : 'sin registrar'}</p>
      <div class="mt-2 flex flex-wrap gap-2">${chips || '<span class="text-xs text-slate-400">Sin pendientes</span>'}</div>
      <div class="mt-3">${htmlBotonesCopiarPago({ nombre: `${p.nombre} ${p.apellido}`.trim(), cedula: p.cedula, telefono: p.telefono, banco: p.banco, montoUsd: p.comision_pendiente > 0 ? p.comision_pendiente : null }, tasaActual.get())}</div>
      ${comisionesPagables.length >= 1 && puedePagar(comisionesPagables[0]) ? `<button type="button" data-pagar-todo="${p.id}" class="${botonPagar} mt-2 w-full">Marcar todo pagado${comisionesPagables.length > 1 ? ` (${comisionesPagables.length} comisiones)` : ''}</button>` : ''}
      ${suyos.length ? `<ul class="mt-3 space-y-2">${suyos.map(htmlPendiente).join('')}</ul>` : ''}
    </article>`;
  }

  function pintar() {
    const q = buscar.trim().toLowerCase();
    const visibles = promotores;
    $('lp-contador').textContent = visibles.length ? `${visibles.length} registrado${visibles.length === 1 ? '' : 's'}` : '';
    vacio.classList.toggle('hidden', visibles.length > 0);
    vacio.textContent = q ? 'Ningún promotor coincide con la búsqueda.' : 'Todavía no hay promotores. Se registran solos al vender con precio de promotor y escribir su cédula, o con "+ Agregar promotor".';
    lista.innerHTML = visibles.map(htmlPromotor).join('');

    const huerfanas = abiertos.filter((x) => !x.promotor_id);
    $('lp-huerfanas').classList.toggle('hidden', huerfanas.length === 0);
    $('lp-huerfanas-lista').innerHTML = huerfanas
      .map(
        (p) => `<div class="rounded-lg bg-white px-3 py-2 dark:bg-slate-900">
        <div class="flex flex-wrap items-center gap-2"><span class="text-xs text-slate-500 dark:text-slate-400">${escaparHtml(formatearFecha(p.fecha))}${p.venta_folio ? ` · venta #${p.venta_folio}` : ''}${p.promotor_nombre ? ` · anotó: ${escaparHtml(p.promotor_nombre)}` : ''}</span><strong class="ml-auto text-right tabular-nums">${htmlMontoDual(p.monto_usd)}</strong></div>
        <p class="mt-1 text-xs text-slate-600 dark:text-slate-300">${escaparHtml(p.descripcion)}</p>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <select data-asignar-select="${p.id}" class="min-w-0 flex-1 rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-xs dark:border-slate-700 dark:bg-slate-800 dark:text-white">
            <option value="">Elige el promotor…</option>${promotores.map((x) => `<option value="${x.id}">${escaparHtml(`${x.nombre} ${x.apellido}`.trim())} · ${escaparHtml(x.cedula)}</option>`).join('')}
          </select>
          <button type="button" data-asignar="${p.id}" class="${botonNeutro}">Asignar</button>
          ${puedePagar(p) ? `<button type="button" data-accion="pagar" data-id="${p.id}" class="${botonPagar}">Marcar pagada</button>` : ''}
        </div></div>`
      )
      .join('');
  }

  async function recargar() {
    try {
      [promotores, abiertos] = await Promise.all([
        inventoryService.listarPromotores({ localId, buscar }),
        inventoryService.listarPendientes({ estado: 'PENDIENTE', localId, limite: 2000 }),
      ]);
      error.classList.add('hidden');
      pintar();
    } catch (err) {
      error.textContent = err instanceof Error ? err.message : 'No se pudieron cargar los promotores.';
      error.classList.remove('hidden');
    }
  }

  activarBotonesCopiar($('lp-raiz'));
  // Con una tasa nueva los Bs. de hoy cambian
  tasaActual.listen(() => pintar());
  $('lp-agregar').addEventListener('click', () => window.dispatchEvent(new CustomEvent('easystem:abrir-promotor')));

  $('lp-raiz').addEventListener('click', async (e) => {
    const destino = (e.target as HTMLElement).closest<HTMLElement>('[data-editar], [data-accion], [data-asignar], [data-pagar-todo]');
    if (!destino) return;
    if (destino.dataset.pagarTodo) {
      const promotor = promotores.find((x) => x.id === destino.dataset.pagarTodo);
      const pendientes = abiertos.filter((x) => x.promotor_id === destino.dataset.pagarTodo && x.tipo === 'COMISION');
      if (promotor && pendientes.length) window.dispatchEvent(new CustomEvent('easystem:cerrar-pendiente', { detail: { lote: { promotor, pendientes }, accion: 'pagar' } }));
    } else if (destino.dataset.editar) {
      const p = promotores.find((x) => x.id === destino.dataset.editar);
      if (p) window.dispatchEvent(new CustomEvent('easystem:abrir-promotor', { detail: { promotor: p } }));
    } else if (destino.dataset.accion) {
      const pendiente = abiertos.find((x) => x.id === destino.dataset.id);
      if (pendiente) window.dispatchEvent(new CustomEvent('easystem:cerrar-pendiente', { detail: { pendiente, accion: destino.dataset.accion } }));
    } else if (destino.dataset.asignar) {
      const id = destino.dataset.asignar;
      const promotorId = ($('lp-huerfanas-lista').querySelector<HTMLSelectElement>(`[data-asignar-select="${id}"]`))?.value;
      if (!promotorId) {
        error.textContent = 'Elige primero a qué promotor corresponde.';
        error.classList.remove('hidden');
        return;
      }
      try {
        await inventoryService.asignarPromotorAPendiente(id, promotorId);
        await recargar();
      } catch (err) {
        error.textContent = err instanceof Error ? err.message : 'No se pudo asignar el promotor.';
        error.classList.remove('hidden');
      }
    }
  });

  window.addEventListener('easystem:promotores-filtro', (e) => {
    const d = (e as CustomEvent<{ localId?: string | null; buscar?: string }>).detail ?? {};
    localId = d.localId;
    buscar = d.buscar ?? '';
    void recargar();
  });
  // Un pago o un promotor guardado desde las ventanas de la página
  window.addEventListener('easystem:pendiente-cambiado', () => void recargar());
  window.addEventListener('easystem:promotor-guardado', () => void recargar());

  inventoryService
    .obtenerContextoLocal()
    .then(async (contexto) => {
      if (!contexto) return;
      rol = contexto.sesion.rol;
      // Nómina define su propio filtro de local y lo envía enseguida; la primera carga usa el alcance activo
      await recargar();
      alCambiarDatos(['pendientes', 'promotores'], recargar);
    })
    .catch(() => {});
</script>
