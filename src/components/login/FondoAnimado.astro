---
// Fondo del login: red de nodos ("plexus") en canvas. Los puntos derivan despacio
// y se unen con líneas cuando están cerca; el cursor (o el dedo) los atrae y se
// conecta con ellos, y un clic/toque suelta nuevos nodos. Usa los colores del
// logo y se adapta al tema claro/oscuro. Con "reducir movimiento" dibuja un solo
// cuadro estático.
---

<div class="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
  <!-- Resplandor suave detrás del formulario -->
  <div class="absolute left-1/2 top-1/2 h-[42rem] w-[42rem] max-w-[120vw] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-500/10 blur-3xl dark:bg-brand-500/15"></div>
  <canvas id="fondo-red" class="absolute inset-0 h-full w-full"></canvas>
</div>

<script>
  const canvas = document.getElementById('fondo-red') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    interface Nodo {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
    }

    const reducirMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const MAX_NODOS_EXTRA = 40; // nodos creados con clic/toque
    let ancho = 0;
    let alto = 0;
    let nodos: Nodo[] = [];
    let extras = 0;
    let distanciaEnlace = 150;
    let radioCursor = 190;
    const cursor = { x: -9999, y: -9999, activo: false };
    let rafId = 0;

    const esOscuro = () => document.documentElement.classList.contains('dark');

    function nuevoNodo(x: number, y: number, rapido = false): Nodo {
      const ang = Math.random() * Math.PI * 2;
      const vel = (rapido ? 0.9 : 0.15) + Math.random() * 0.3;
      return { x, y, vx: Math.cos(ang) * vel, vy: Math.sin(ang) * vel, r: 1.2 + Math.random() * 1.6 };
    }

    function ajustar() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      ancho = window.innerWidth;
      alto = window.innerHeight;
      canvas!.width = Math.round(ancho * dpr);
      canvas!.height = Math.round(alto * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const movil = ancho < 640;
      distanciaEnlace = movil ? 110 : 165;
      radioCursor = movil ? 150 : 190;
      const objetivo = Math.min(movil ? 60 : 170, Math.round((ancho * alto) / (movil ? 8000 : 9000)));

      // Conserva los nodos existentes; solo agrega o quita hasta el objetivo.
      while (nodos.length < objetivo) nodos.push(nuevoNodo(Math.random() * ancho, Math.random() * alto));
      if (nodos.length > objetivo) nodos.length = objetivo;
    }

    function actualizar() {
      for (const n of nodos) {
        // Atracción suave hacia el cursor: los nodos cercanos se agrupan a su alrededor.
        if (cursor.activo) {
          const dx = cursor.x - n.x;
          const dy = cursor.y - n.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < radioCursor * radioCursor && d2 > 400) {
            const f = 0.012 * (1 - Math.sqrt(d2) / radioCursor);
            n.vx += dx * f * 0.05;
            n.vy += dy * f * 0.05;
          }
        }
        // Amortigua para volver a la velocidad de crucero.
        n.vx *= 0.995;
        n.vy *= 0.995;
        const vel = Math.hypot(n.vx, n.vy);
        if (vel < 0.12) {
          n.vx += (Math.random() - 0.5) * 0.03;
          n.vy += (Math.random() - 0.5) * 0.03;
        }
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < -20) n.x = ancho + 20;
        else if (n.x > ancho + 20) n.x = -20;
        if (n.y < -20) n.y = alto + 20;
        else if (n.y > alto + 20) n.y = -20;
      }
    }

    function dibujar() {
      const oscuro = esOscuro();
      const nodoRGB = oscuro ? '143, 207, 251' : '24, 113, 211';
      const lineaRGB = oscuro ? '79, 180, 243' : '24, 113, 211';
      const cursorRGB = oscuro ? '27, 228, 238' : '15, 165, 184';
      const alfaBase = oscuro ? 0.7 : 0.4;

      ctx!.clearRect(0, 0, ancho, alto);
      ctx!.lineWidth = 1;

      // Enlaces entre nodos cercanos
      const max2 = distanciaEnlace * distanciaEnlace;
      for (let i = 0; i < nodos.length; i++) {
        const a = nodos[i];
        for (let j = i + 1; j < nodos.length; j++) {
          const b = nodos[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < max2) {
            const alfa = (1 - Math.sqrt(d2) / distanciaEnlace) * alfaBase;
            ctx!.strokeStyle = `rgba(${lineaRGB}, ${alfa})`;
            ctx!.beginPath();
            ctx!.moveTo(a.x, a.y);
            ctx!.lineTo(b.x, b.y);
            ctx!.stroke();
          }
        }
      }

      // Enlaces del cursor con los nodos a su alcance (más brillantes, en cian)
      if (cursor.activo) {
        for (const n of nodos) {
          const d = Math.hypot(n.x - cursor.x, n.y - cursor.y);
          if (d < radioCursor) {
            const alfa = (1 - d / radioCursor) * (oscuro ? 0.85 : 0.6);
            ctx!.strokeStyle = `rgba(${cursorRGB}, ${alfa})`;
            ctx!.beginPath();
            ctx!.moveTo(cursor.x, cursor.y);
            ctx!.lineTo(n.x, n.y);
            ctx!.stroke();
          }
        }
        ctx!.fillStyle = `rgba(${cursorRGB}, 0.9)`;
        ctx!.beginPath();
        ctx!.arc(cursor.x, cursor.y, 2.6, 0, Math.PI * 2);
        ctx!.fill();
      }

      // Nodos
      ctx!.fillStyle = `rgba(${nodoRGB}, ${oscuro ? 0.9 : 0.7})`;
      for (const n of nodos) {
        ctx!.beginPath();
        ctx!.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx!.fill();
      }
    }

    function cuadro() {
      actualizar();
      dibujar();
      rafId = requestAnimationFrame(cuadro);
    }

    function iniciar() {
      if (reducirMovimiento || rafId) return;
      rafId = requestAnimationFrame(cuadro);
    }
    function detener() {
      cancelAnimationFrame(rafId);
      rafId = 0;
    }

    ajustar();
    // Calienta la simulación para que no se vea "armarse" al cargar.
    for (let i = 0; i < 60; i++) actualizar();
    dibujar();
    iniciar();

    let temporizador = 0;
    window.addEventListener('resize', () => {
      clearTimeout(temporizador);
      temporizador = window.setTimeout(() => {
        ajustar();
        if (reducirMovimiento) dibujar();
      }, 150);
    });

    // Ahorra batería: sin animar cuando la pestaña está oculta
    document.addEventListener('visibilitychange', () => (document.hidden ? detener() : iniciar()));

    window.addEventListener('pointermove', (e) => {
      cursor.x = e.clientX;
      cursor.y = e.clientY;
      cursor.activo = true;
    });
    // Al salir de la ventana o levantar el dedo, el cursor deja de interactuar
    document.documentElement.addEventListener('pointerleave', () => (cursor.activo = false));
    window.addEventListener('pointerup', (e) => {
      if (e.pointerType === 'touch') cursor.activo = false;
    });

    // Clic/toque en zona libre: suelta nodos nuevos (los más viejos se retiran solos)
    window.addEventListener('pointerdown', (e) => {
      if (reducirMovimiento) return;
      if (e.target instanceof Element && e.target.closest('form, a, button, input, label, dialog')) return;
      for (let i = 0; i < 4; i++) {
        nodos.push(nuevoNodo(e.clientX, e.clientY, true));
        extras++;
      }
      while (extras > MAX_NODOS_EXTRA) {
        nodos.splice(0, 1);
        extras--;
      }
    });
  }
</script>
