---
// Registro de ENTRADAS de mercancía (reabastecimiento), solo administrador.
// Se abre con "easystem:abrir-entrada" ({ detail: { productoId? } }). Es una
// ventana pensada para cargar varias entradas seguidas: tras registrar una,
// queda lista para la siguiente. El stock cambia vía movimiento ENTRADA.
const claseCampo =
  'mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white';
const claseEtiqueta = 'block text-xs font-medium text-slate-600 dark:text-slate-400';
---

<dialog
  id="es-dialogo"
  class="anim-escalar m-auto w-[min(30rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/60 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
>
  <form id="es-form" class="flex max-h-[90vh] flex-col" novalidate>
    <header class="flex items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-slate-800">
      <h2 class="text-base font-semibold">Registrar entrada de stock</h2>
      <button type="button" id="es-cerrar" aria-label="Cerrar" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800">✕</button>
    </header>

    <div class="space-y-4 overflow-y-auto px-5 py-4">
      <div id="es-buscador-bloque">
        <label for="es-buscar" class={claseEtiqueta}>Producto (nombre, categoría, modelo o código de barras)</label>
        <input id="es-buscar" type="search" autocomplete="off" placeholder="Escribe o escanea el código..." class={claseCampo} />
        <ul id="es-resultados" class="mt-2 max-h-48 divide-y divide-slate-100 overflow-y-auto rounded-lg border border-slate-200 dark:divide-slate-800 dark:border-slate-700"></ul>
      </div>

      <div id="es-elegido" class="hidden rounded-lg border border-brand-200 bg-brand-50 p-3 dark:border-brand-500/30 dark:bg-brand-500/10">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p id="es-elegido-nombre" class="truncate text-sm font-semibold text-slate-900 dark:text-white"></p>
            <p id="es-elegido-detalle" class="font-mono text-xs text-slate-500 dark:text-slate-400"></p>
          </div>
          <button type="button" id="es-cambiar" class="shrink-0 text-xs font-medium text-brand-700 hover:underline dark:text-brand-300">Cambiar</button>
        </div>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-300">
          Stock actual: <strong id="es-actual">0</strong> → quedará en <strong id="es-resultante" class="text-brand-700 dark:text-brand-300">0</strong>
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div>
          <label for="es-cantidad" class={claseEtiqueta}>Cantidad *</label>
          <input id="es-cantidad" type="number" inputmode="numeric" min="1" step="1" class={claseCampo} />
        </div>
        <div class="sm:col-span-2">
          <label for="es-motivo" class={claseEtiqueta}>Motivo</label>
          <input id="es-motivo" type="text" list="es-motivos" value="Compra a proveedor" class={claseCampo} />
          <datalist id="es-motivos">
            <option value="Compra a proveedor"></option>
            <option value="Reabastecimiento"></option>
            <option value="Devolución de cliente"></option>
            <option value="Ajuste de inventario"></option>
          </datalist>
        </div>
      </div>
    </div>

    <footer class="space-y-3 border-t border-slate-200 px-5 py-4 dark:border-slate-800">
      <p id="es-error" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
      <p id="es-exito" class="hidden rounded-lg bg-emerald-50 px-3 py-2 text-xs text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"></p>
      <div class="flex justify-end gap-2">
        <button type="button" id="es-cancelar" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">
          Cerrar
        </button>
        <button type="submit" id="es-guardar" class="bg-marca rounded-lg px-5 py-2 text-sm font-semibold text-white shadow-sm hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60">
          Registrar entrada
        </button>
      </div>
    </footer>
  </form>
</dialog>

<script>
  import * as inventoryService from '../../lib/inventoryService';
  import { obtenerSesionActual } from '../../lib/auth';
  import { reanimar } from '../../utils/animaciones';
  import type { ProductoConRelaciones } from '../../types/database.types';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const dialogo = $<HTMLDialogElement>('es-dialogo');
  const form = $<HTMLFormElement>('es-form');
  const buscar = $<HTMLInputElement>('es-buscar');
  const resultados = $<HTMLUListElement>('es-resultados');
  const bloqueBuscador = $('es-buscador-bloque');
  const bloqueElegido = $('es-elegido');
  const cantidad = $<HTMLInputElement>('es-cantidad');
  const motivo = $<HTMLInputElement>('es-motivo');
  const error = $('es-error');
  const exito = $('es-exito');
  const guardar = $<HTMLButtonElement>('es-guardar');

  let productos: ProductoConRelaciones[] = [];
  let elegido: ProductoConRelaciones | null = null;

  const normalizar = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const escapar = (t: string) => {
    const d = document.createElement('div');
    d.textContent = t;
    return d.innerHTML;
  };

  function mostrarError(msg: string) {
    exito.classList.add('hidden');
    error.textContent = msg;
    error.classList.remove('hidden');
    reanimar(error, 'anim-sacudir');
  }

  function pintarResultados() {
    const q = normalizar(buscar.value.trim());
    if (!q) {
      resultados.innerHTML = '';
      resultados.classList.add('hidden');
      return;
    }
    const lista = productos
      .filter(
        (p) =>
          normalizar(p.nombre).includes(q) ||
          p.codigo_barras.includes(q) ||
          normalizar(p.categoria).includes(q) ||
          p.modelos_compatibles.some((m) => normalizar(`${m.marca} ${m.modelo}`).includes(q))
      )
      .slice(0, 8);

    resultados.classList.remove('hidden');
    resultados.innerHTML = lista.length
      ? lista
          .map(
            (p) => `
          <li>
            <button type="button" data-id="${p.id}" class="flex w-full items-center justify-between gap-3 px-3 py-2 text-left hover:bg-slate-50 dark:hover:bg-slate-800">
              <span class="min-w-0">
                <span class="block truncate text-sm font-medium text-slate-900 dark:text-white">${escapar(p.nombre)}</span>
                <span class="block font-mono text-xs text-slate-500">${escapar(p.codigo_barras)}</span>
              </span>
              <span class="shrink-0 text-xs text-slate-500">${p.stock_actual} u.</span>
            </button>
          </li>`
          )
          .join('')
      : '<li class="px-3 py-3 text-sm text-slate-500">Sin coincidencias.</li>';
  }

  function elegir(producto: ProductoConRelaciones | null) {
    elegido = producto;
    bloqueElegido.classList.toggle('hidden', !producto);
    bloqueBuscador.classList.toggle('hidden', !!producto);
    if (producto) {
      $('es-elegido-nombre').textContent = producto.nombre;
      $('es-elegido-detalle').textContent = `${producto.codigo_barras} · ${producto.categoria}`;
      actualizarResultante();
      cantidad.focus();
    } else {
      buscar.value = '';
      pintarResultados();
      buscar.focus();
    }
  }

  function actualizarResultante() {
    if (!elegido) return;
    const n = Number(cantidad.value || 0);
    $('es-actual').textContent = String(elegido.stock_actual);
    $('es-resultante').textContent = String(elegido.stock_actual + (Number.isFinite(n) && n > 0 ? n : 0));
  }

  buscar.addEventListener('input', () => {
    pintarResultados();
    // Un lector de código de barras escribe el código completo: selección automática
    const exacto = productos.find((p) => p.codigo_barras === buscar.value.trim());
    if (exacto) elegir(exacto);
  });
  resultados.addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-id]')?.dataset.id;
    const p = productos.find((x) => x.id === id);
    if (p) elegir(p);
  });
  $('es-cambiar').addEventListener('click', () => elegir(null));
  cantidad.addEventListener('input', actualizarResultante);

  async function abrir(productoId?: string) {
    const sesion = await obtenerSesionActual();
    if (sesion?.rol !== 'administrador') return;

    productos = await inventoryService.listarProductos();
    error.classList.add('hidden');
    exito.classList.add('hidden');
    cantidad.value = '';
    motivo.value = 'Compra a proveedor';
    elegir(productoId ? (productos.find((p) => p.id === productoId) ?? null) : null);
    if (!dialogo.open) dialogo.showModal();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.classList.add('hidden');
    exito.classList.add('hidden');

    const n = Number(cantidad.value);
    if (!elegido) return mostrarError('Elige primero el producto.');
    if (!Number.isInteger(n) || n <= 0) return mostrarError('La cantidad debe ser un entero mayor a 0.');

    const sesion = await obtenerSesionActual();
    if (sesion?.rol !== 'administrador') return mostrarError('Solo un administrador puede registrar entradas.');

    guardar.disabled = true;
    try {
      await inventoryService.registrarMovimiento({
        producto_id: elegido.id,
        tipo: 'ENTRADA',
        cantidad: n,
        motivo: motivo.value.trim() || 'Reabastecimiento',
      });
      exito.textContent = `+${n} de "${elegido.nombre}" registradas.`;
      exito.classList.remove('hidden');
      reanimar(exito, 'anim-subir');
      window.dispatchEvent(new Event('easystem:productos-cambiaron'));

      // Lista para la siguiente entrada
      productos = await inventoryService.listarProductos();
      cantidad.value = '';
      elegir(null);
    } catch (err) {
      mostrarError(err instanceof Error ? err.message : 'No se pudo registrar la entrada.');
    } finally {
      guardar.disabled = false;
    }
  });

  $('es-cerrar').addEventListener('click', () => dialogo.close());
  $('es-cancelar').addEventListener('click', () => dialogo.close());
  dialogo.addEventListener('mousedown', (e) => {
    if (e.target === dialogo) dialogo.close();
  });

  window.addEventListener('easystem:abrir-entrada', ((e: CustomEvent<{ productoId?: string }>) => {
    abrir(e.detail?.productoId);
  }) as EventListener);
</script>
