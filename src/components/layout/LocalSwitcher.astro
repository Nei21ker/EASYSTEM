---
// Selector de local ("Store Switcher") del encabezado.
//  · Administrador: menú desplegable "Todos los locales / Local Accesorios / Local Vidrios / Local Servicio Técnico".
//    Al cambiar, se guarda la elección y se recarga la vista: Dashboard, POS, Inventario, Movimientos, Ventas y
//    Reportes se vuelven a pedir ya filtrados por ese local.
//  · Resto de roles: el selector queda deshabilitado y muestra de forma fija el nombre de su local asignado;
//    todo lo que ven está limitado a ese local (además lo exige la base de datos con RLS).
---

<label id="ls-raiz" class="order-3 hidden w-full min-w-0 items-center gap-2 text-xs text-slate-500 sm:order-1 sm:ml-auto sm:mr-3 sm:w-auto sm:gap-1.5 dark:text-slate-400">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 shrink-0 text-brand-600 dark:text-brand-300" aria-hidden="true">
    <path d="M3 9l1-5h16l1 5M3 9v11h18V9M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0M9 20v-6h6v6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="sr-only">Local</span>
  <select
    id="ls-select"
    class="min-w-0 flex-1 truncate rounded-lg border border-slate-200 bg-white px-2.5 py-2 text-sm font-semibold sm:flex-none sm:px-2 sm:py-1.5 sm:text-xs text-slate-700 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 disabled:cursor-not-allowed disabled:opacity-100 disabled:bg-slate-50 sm:max-w-[13rem] text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:disabled:bg-slate-800/60"
  ></select>
</label>

<script>
  import { $contextoLocal } from '../../stores/local';
  import { cambiarLocalActivo, obtenerContextoLocal } from '../../lib/inventoryService';
  import { ALCANCE_TODOS, localVigente } from '../../lib/constantes-locales';

  const raiz = document.getElementById('ls-raiz') as HTMLElement;
  const select = document.getElementById('ls-select') as HTMLSelectElement;

  function escapar(texto: string) {
    const div = document.createElement('div');
    div.textContent = texto;
    return div.innerHTML;
  }

  function pintar() {
    const contexto = $contextoLocal.get();
    if (!contexto) return;
    if (contexto.sesion.rol === 'super_admin') return; // administra suscripciones, no elige local de trabajo
    const esAdmin = contexto.sesion.rol === 'administrador';

    if (esAdmin) {
      select.innerHTML =
        `<option value="${ALCANCE_TODOS}">Todos los locales</option>` +
        contexto.locales
          .map((l) => (localVigente(l) ? `<option value="${l.id}">${escapar(l.nombre)}</option>` : `<option value="${l.id}" disabled>${escapar(l.nombre)} (suspendido)</option>`))
          .join('');
      select.value = contexto.alcance ?? ALCANCE_TODOS;
      select.disabled = false;
      select.title = 'Filtra todo el sistema por local';
    } else {
      select.innerHTML = `<option>${escapar(contexto.local?.nombre ?? 'Sin local asignado')}</option>`;
      select.disabled = true;
      select.title = 'Tu local asignado (solo un administrador puede cambiar de local)';
    }
    raiz.classList.remove('hidden');
    raiz.classList.add('flex');
  }

  select.addEventListener('change', () => cambiarLocalActivo(select.value));

  obtenerContextoLocal().then(pintar);
</script>
