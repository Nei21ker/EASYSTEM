---
// Tasa del dólar del día (Bs por $). Se pide de forma OBLIGATORIA la primera vez que
// alguien entra cada día: la ventana no se puede cerrar hasta registrar la tasa
// (muestra la anterior para confirmarla o cambiarla). Cualquier usuario puede
// hacerlo, así nadie queda bloqueado esperando al administrador. Después se puede
// corregir desde el botón de la tasa en el encabezado (evento "easystem:abrir-tasa").
const claseCampo =
  'w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-lg font-semibold tabular-nums text-slate-900 placeholder:font-normal placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white';
---

<dialog
  id="td-dialogo"
  aria-labelledby="td-titulo"
  class="anim-escalar m-auto w-[min(26rem,calc(100vw-1.5rem))] origin-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/70 backdrop:backdrop-blur-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100"
>
  <form id="td-form" novalidate>
    <div class="space-y-4 px-5 pb-4 pt-5">
      <div class="flex items-start gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700 dark:bg-brand-500/15 dark:text-brand-300" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
            <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <div class="min-w-0">
          <h2 id="td-titulo" class="text-base font-semibold">Tasa del dólar de hoy</h2>
          <p id="td-subtitulo" class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">
            Antes de continuar, registra a cuántos bolívares equivale 1 dólar hoy.
          </p>
        </div>
      </div>

      <div>
        <label for="td-tasa" class="block text-xs font-medium text-slate-600 dark:text-slate-400">Bolívares por 1 $ *</label>
        <div class="relative mt-1">
          <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm font-semibold text-slate-400">Bs.</span>
          <input id="td-tasa" type="text" inputmode="decimal" autocomplete="off" placeholder="36,50" class={`${claseCampo} pl-11`} />
        </div>
        <p id="td-anterior" class="mt-1.5 hidden text-xs text-slate-500 dark:text-slate-400"></p>
        <p id="td-ejemplo" class="mt-1.5 hidden text-xs font-medium text-brand-700 dark:text-brand-300"></p>
      </div>

      <p id="td-aviso" role="alert" class="hidden rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:bg-amber-500/10 dark:text-amber-300"></p>
      <p id="td-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-400"></p>
    </div>

    <div class="flex gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-800/40">
      <button id="td-cancelar" type="button" class="hidden flex-1 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
        Cancelar
      </button>
      <button id="td-guardar" type="submit" class="bg-marca flex-1 rounded-lg px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60">
        Guardar tasa
      </button>
    </div>
  </form>
</dialog>

<script>
  import * as inventoryService from '../../lib/inventoryService';
  import { obtenerSesionActual } from '../../lib/auth';
  import { tasaActual } from '../../stores/tasa';
  import { convertirABs, formatearBolivares, formatearFecha, parsearTasa } from '../../utils/format';
  import type { TasaCambio } from '../../types/database.types';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const dialogo = $<HTMLDialogElement>('td-dialogo');
  const form = $<HTMLFormElement>('td-form');
  const campo = $<HTMLInputElement>('td-tasa');
  const anterior = $('td-anterior');
  const ejemplo = $('td-ejemplo');
  const aviso = $('td-aviso');
  const error = $('td-error');
  const guardar = $<HTMLButtonElement>('td-guardar');
  const cancelar = $('td-cancelar');
  const subtitulo = $('td-subtitulo');

  /** Un cambio mayor a este porcentaje pide una segunda confirmación (evita un cero o una coma de más). */
  const CAMBIO_SOSPECHOSO = 0.25;

  let obligatoria = false;
  let referencia: TasaCambio | null = null;
  let valorAvisado: number | null = null;

  const texto = (n: number) => n.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 4 });

  function abrir(modoObligatorio: boolean, ultima: TasaCambio | null) {
    if (dialogo.open) return;
    obligatoria = modoObligatorio;
    referencia = ultima;
    valorAvisado = null;
    aviso.classList.add('hidden');
    error.classList.add('hidden');
    cancelar.classList.toggle('hidden', modoObligatorio);
    subtitulo.textContent = modoObligatorio
      ? 'Antes de continuar, registra a cuántos bolívares equivale 1 dólar hoy.'
      : 'Corrige la tasa si cambió durante el día. Los precios en Bs. se recalculan al instante.';

    campo.value = ultima ? texto(ultima.tasa) : '';
    anterior.classList.toggle('hidden', !ultima);
    if (ultima) {
      const quien = ultima.registrado_nombre ? ` · ${ultima.registrado_nombre}` : '';
      anterior.textContent = modoObligatorio
        ? `Última tasa: ${formatearBolivares(ultima.tasa)} (${formatearFecha(ultima.created_at)}${quien}). Confírmala o escribe la nueva.`
        : `Tasa actual: ${formatearBolivares(ultima.tasa)} (${formatearFecha(ultima.created_at)}${quien}).`;
    }
    actualizarEjemplo();
    dialogo.showModal();
    campo.focus();
    campo.select();
  }

  function actualizarEjemplo() {
    const t = parsearTasa(campo.value);
    ejemplo.classList.toggle('hidden', t === null);
    if (t !== null) ejemplo.textContent = `Ejemplo: $10.00 = ${formatearBolivares(convertirABs(10, t))}`;
  }

  campo.addEventListener('input', () => {
    error.classList.add('hidden');
    aviso.classList.add('hidden');
    valorAvisado = null;
    actualizarEjemplo();
  });

  // La ventana obligatoria no se cierra con Esc ni con clic fuera
  dialogo.addEventListener('cancel', (e) => {
    if (obligatoria) e.preventDefault();
  });
  dialogo.addEventListener('click', (e) => {
    if (!obligatoria && e.target === dialogo) dialogo.close();
  });
  cancelar.addEventListener('click', () => dialogo.close());

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const tasa = parsearTasa(campo.value);
    if (tasa === null) {
      error.textContent = 'Escribe una tasa válida mayor a 0 (por ejemplo 36,50).';
      error.classList.remove('hidden');
      campo.focus();
      return;
    }

    // Cambio muy grande frente a la tasa anterior: pedir confirmar el mismo valor una vez más
    if (referencia && Math.abs(tasa - referencia.tasa) / referencia.tasa > CAMBIO_SOSPECHOSO && valorAvisado !== tasa) {
      valorAvisado = tasa;
      const pct = Math.round(((tasa - referencia.tasa) / referencia.tasa) * 100);
      aviso.textContent = `Ojo: es ${pct > 0 ? '+' : ''}${pct}% frente a la anterior (${formatearBolivares(referencia.tasa)}). Si es correcta, pulsa "Guardar tasa" otra vez.`;
      aviso.classList.remove('hidden');
      return;
    }

    guardar.disabled = true;
    guardar.textContent = 'Guardando...';
    try {
      const sesion = await obtenerSesionActual();
      const guardada = await inventoryService.registrarTasa(tasa, sesion?.nombre);
      tasaActual.set(guardada.tasa);
      dialogo.close();
    } catch (err) {
      error.textContent = err instanceof Error ? err.message : 'No se pudo guardar la tasa.';
      error.classList.remove('hidden');
    } finally {
      guardar.disabled = false;
      guardar.textContent = 'Guardar tasa';
    }
  });

  // Botón de la tasa en el encabezado
  window.addEventListener('easystem:abrir-tasa', () => abrir(false, referenciaActual));

  let referenciaActual: TasaCambio | null = null;

  // Arranque: ¿ya hay tasa de hoy? Si no, ventana obligatoria.
  obtenerSesionActual().then(async (sesion) => {
    if (!sesion) return;
    try {
      const { hoy, ultima } = await inventoryService.obtenerTasaVigente();
      referenciaActual = ultima;
      if (hoy) {
        tasaActual.set(hoy.tasa);
      } else {
        abrir(true, ultima);
      }
    } catch (err) {
      // Sin poder consultar la tasa, no bloqueamos el sistema; el botón del encabezado permite fijarla.
      console.error('[EASYSTEM] No se pudo consultar la tasa del día.', err);
    }
  });

  tasaActual.listen(async () => {
    // Mantiene "tasa actual" al día para la ventana de corrección
    const { ultima } = await inventoryService.obtenerTasaVigente().catch(() => ({ ultima: null }));
    if (ultima) referenciaActual = ultima;
  });
</script>
