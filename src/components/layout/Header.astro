---
import ThemeToggle from '../ui/ThemeToggle.astro';
import NotificationsBell from './NotificationsBell.astro';
import ConnectionStatus from './ConnectionStatus.astro';
import LocalSwitcher from './LocalSwitcher.astro';

interface Props {
  titulo: string;
  subtitulo?: string;
}

const { titulo, subtitulo } = Astro.props;
---

<header class="flex flex-wrap items-center justify-between gap-y-3 border-b border-slate-200 bg-white/80 px-4 py-4 backdrop-blur print:hidden sm:px-6 dark:border-slate-800 dark:bg-slate-900/80">
  <div class="flex min-w-0 items-center gap-3">
    <button
      id="nav-hamburguesa"
      type="button"
      aria-label="Abrir menú de navegación"
      class="-ml-1 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 lg:hidden dark:text-slate-300 dark:hover:bg-slate-800"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <div class="min-w-0">
      <h1 class="truncate text-base font-semibold text-slate-900 sm:text-lg dark:text-white">{titulo}</h1>
      {subtitulo && <p class="hidden truncate text-sm text-slate-500 sm:block dark:text-slate-400">{subtitulo}</p>}
    </div>
  </div>
  <div class="order-2 flex shrink-0 items-center gap-2 sm:gap-3">
    <button
      id="tasa-chip"
      type="button"
      title="Tasa del dólar del día: clic para corregirla"
      class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden h-3.5 w-3.5 text-brand-600 sm:block dark:text-brand-300" aria-hidden="true">
        <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="hidden sm:inline">$1 =</span><span id="tasa-chip-texto" class="whitespace-nowrap tabular-nums">—</span>
    </button>
    <ConnectionStatus />
    <NotificationsBell />
    <ThemeToggle />
  </div>
  <!-- En el celular va en su propia fila (ancho completo); en pantallas grandes, junto a los controles -->
  <LocalSwitcher />
</header>

<script>
  import { tasaActual } from '../../stores/tasa';
  import { formatearBolivares } from '../../utils/format';
  import { obtenerSesionActual } from '../../lib/auth';

  const texto = document.getElementById('tasa-chip-texto') as HTMLSpanElement;
  const pintar = (tasa: number | null) => (texto.textContent = tasa ? formatearBolivares(tasa) : 'Sin tasa');

  pintar(tasaActual.get());
  tasaActual.listen(pintar);
  const chip = document.getElementById('tasa-chip')!;
  chip.addEventListener('click', () => window.dispatchEvent(new Event('easystem:abrir-tasa')));
  // El contador solo trabaja en la nómina: no ve la tasa del negocio
  obtenerSesionActual().then((sesion) => {
    if (sesion?.rol === 'contador') chip.style.display = 'none';
  });
</script>
